;;; Occurrence typing: a branch knows what its test said of a variable.
(define (inc n) (+ n 1))
(define (first-or x) (if (pair? x) (car x) x))
(define a (first-or (list inc)))
(define b (first-or 3))
(define (call-if f) (if (procedure? f) (f 1) f))
(define c (call-if inc))
(define d (call-if "no"))
(define (maybe x) (if x (x 2) 0))
(define e (maybe #f))
(define f (maybe inc))
(define (not-null l) (if (not (null? l)) (car l) 'none))
(define g (not-null '()))
(define-record-type box (make-box v) box? (v box-v))
(define (unbox x) (if (box? x) (box-v x) x))
(define h (unbox (make-box inc)))
(define i (unbox 5))
(define (counted n) (set! n (if (pair? n) 0 n)) (if (pair? n) n 1))

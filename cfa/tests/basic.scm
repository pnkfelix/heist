(define (twice f x) (f (f x)))
(define (inc n) (+ n 1))
(define (dec n) (- n 1))
(define a (twice inc 1))
(define b (twice dec 2))
(define handlers (list inc dec))
(define (run-all x) (map (lambda (h) (h x)) handlers))
(define (first-handler) (car handlers))
(define counter 0)
(define (bump!) (set! counter (+ counter 1)) counter)
(define (local y) (define (sq z) (* z z)) (sq y))
(define s (string-append "a" "b"))

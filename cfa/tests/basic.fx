(define twice (lambda (f x) (f (f x))))
(define inc (lambda (n) (+ n 1)))
(define dec (lambda (n) (- n 1)))
(define a (twice inc 1))
(define b (twice dec 2))
(define-datatype shape (circle int) (square int))
(define area (lambda (s) (tagcase s (circle (r) (* r r)) (square (w) (* w w)))))
(define c (area (circle 3)))
(define box (new inc))
(define d ((get box) 5))

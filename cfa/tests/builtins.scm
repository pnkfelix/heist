;;; s7st's built-ins that call what they are given, and records.
(define (inc n) (+ n 1))
(define (dbl n) (* n 2))
(define fs (list inc dbl))
(define a (call-with-values (lambda () (values 1 2)) (lambda (x y) (+ x y))))
(define b (dynamic-wind (lambda () 0) (lambda () inc) (lambda () 0)))
(define c (call/cc (lambda (k) (k dbl))))
(define d (filter (lambda (f) (procedure? f)) fs))
(define e (fold (lambda (f acc) (f acc)) 0 fs))
(define f (assoc 2 '((1 . one) (2 . two)) (lambda (x y) (= x y))))
(define-record-type point (make-point x y) point? (x point-x) (y point-y set-point-y!))
(define p (make-point inc 2))
(define g ((point-x p) 3))
(set-point-y! p dbl)
(define h (point-y p))
(define i (with-exception-handler (lambda (c) 0) (lambda () (inc 1))))

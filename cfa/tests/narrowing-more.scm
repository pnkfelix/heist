;;; The rest of yank's narrowing: after a branch that cannot return;
;;; comparisons with constants (quoted symbols values of their own); fields
;;; nothing modifies; the program's own predicates; `and`, `or`.
(define (inc n) (+ n 1))
(define (must-pair x) (unless (pair? x) (error "not a pair")) (car x))
(define a (must-pair (list inc)))
(define b (must-pair 3))
(define (use k) (if (eq? k 'add) k 'other))
(define c (use 'add))
(define d (use 'sub))
(define (pick k) (case k ((add sub) k) (else 'none)))
(define e (pick 'add))
(define f (pick 'mul))
(define (first-proc x) (if (procedure? (car x)) ((car x) 1) 0))
(define g (first-proc (list inc 2)))
(define (my-pair? x) (pair? x))
(define (via-own x) (if (my-pair? x) (car x) x))
(define h (via-own (list inc)))
(define i (via-own 4))
(define (both x) (if (and (pair? x) (procedure? (car x))) ((car x) 2) 0))
(define j (both (list inc 3)))
(define (either x) (if (or (number? x) (string? x)) x (x 1)))
(define k (either inc))
(define l (either 5))

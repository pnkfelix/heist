;;; hashtables.fx: R6RS's (rnrs hashtables), for checked programs:
;;; shakedown's `(shakedown hashtables)`.
;;;
;;; A hashtable holds a cell (a one-slot array, so the store logs and
;;; merges its writes as any other, and contracts and loops watch them)
;;; whose value is an alist of entries, newest first: (key . value), or
;;; (key . deleted) after a delete. A lookup takes the first entry whose
;;; key is equivalent to the one asked for: with symbolic keys, the merge
;;; of the entries' values under the conditions that their keys are
;;; equivalent and no newer one's is. A set or delete drops the entries
;;; whose keys are certainly equivalent, so with concrete keys the alist is
;;; what a table would hold. The hash function is never called: keys are
;;; compared by the equivalence (eqv?, equal?, or the program's own
;;; procedure). hashtable-keys and hashtable-entries list the keys oldest
;;; first, which need not be Larceny's order.

(module-parameters ((m-core (load-moduleof "core.fx")) (m-term (load-moduleof "term.fx" m-core))
                    (m-value (load-moduleof "value.fx" m-core m-term))
                    (m-print (load-moduleof "print.fx" m-core))
                    (m-syntax (load-moduleof "syntax.fx" m-core m-print))
                    (m-numbers (load-moduleof "numbers.fx" m-core))
                    (m-reader (load-moduleof "reader.fx" m-core m-numbers))
                    (m-machine (load-moduleof "machine.fx" m-core m-term m-value))
                    (m-prims (load-moduleof "prims.fx" m-core m-term m-value m-print m-syntax m-numbers m-reader m-machine))))

(hide (define kit-lists (load-module "../kit/lists.fx"))
      (import kit-lists map for-each))

"Applies a procedure value (eval.fx's apply-value)."
(define-type applier (subr rf-eff (rf-ctx rf-value rf-vals rf-value) rf-value))

(define table-of (subr rf-st (rf-value) rf-table)
  (lambda (v) (tagcase v (table t t) (else x (product (equiv rf-false) (cell no-slots) (mutable #f))))))

"The primitives, newest first; apply-value applies a procedure value."
(define hashtable-primitives (subr rf-st (applier) prim-entries)
  (lambda (apply-value)
    (let ((prims (the (ref prim-entries @rf) (new nil))))
      (letrec ((define! (subr rf-st (symbol arity prim-body) unit)
                 (lambda (name arity proc)
                   (set prims (cons (product (name name) (value (make-checked-prim name arity proc))) (get prims)))))
               ;; Whether a and b are equivalent keys of table t: a Bool term.
               (same (subr rf-eff (rf-ctx rf-value rf-table rf-value rf-value) rf-value)
                 (lambda (ctx src t a b)
                   (let ((e (extract t equiv)))
                     (cond ((rf-eqv? e (rf-sym 'eqv)) (eqv-value a b))
                           ((rf-eqv? e (rf-sym 'equal)) (equal-value a b))
                           (else (truth (apply-value ctx e (list a b) src)))))))
               ;; (k ctx t entries) for the table argument and its entries.
               (with-table (subr rf-eff (rf-ctx rf-value rf-value (subr rf-eff (rf-ctx rf-table rf-value) rf-value)) rf-value)
                 (lambda (ctx src v k)
                   (lift ctx (list v)
                         (lambda ((ctx rf-ctx) (vs rf-vals))
                           (let ((t (car vs)))
                             (begin
                               (tagcase t (table x #u) (else x (fail! ctx 'error (describe-call src "argument is not a hashtable"))))
                               (let ((entries (array-ref (extract (table-of t) cell) 0)))
                                 (if (rf-union? entries)
                                     (join-union ctx entries (lambda ((ctx rf-ctx) (es rf-value)) (k ctx (table-of t) es)))
                                     (k ctx (table-of t) entries)))))))))
               ;; The value for key in entries, or default.
               (lookup (subr rf-eff (rf-ctx rf-value rf-table rf-value rf-value rf-value) rf-value)
                 (lambda (ctx src t entries key default)
                   (letrec ((loop (subr rf-eff (rf-value) rf-value)
                              (lambda (es)
                                (if (not (rf-pair? es)) default
                                    (let* ((v (if (rf-deleted? (rf-cdar es)) default (rf-cdar es)))
                                           (c (same ctx src t key (rf-caar es))))
                                      (cond ((rf-true? c) v)
                                            ((rf-false? c) (loop (rf-cdr es)))
                                            (else (let ((rest (loop (rf-cdr es)))) (merge c v rest)))))))))
                     (loop entries))))
               ;; Whether key has an entry (not deleted): a Bool term.
               (has? (subr rf-eff (rf-ctx rf-value rf-table rf-value rf-value) rf-value)
                 (lambda (ctx src t entries key)
                   (letrec ((loop (subr rf-eff (rf-value) rf-value)
                              (lambda (es)
                                (if (not (rf-pair? es)) rf-false
                                    (let* ((live (rf-bool (not (rf-deleted? (rf-cdar es)))))
                                           (c (same ctx src t key (rf-caar es))))
                                      (cond ((rf-true? c) live)
                                            ((rf-false? c) (loop (rf-cdr es)))
                                            (else (let ((rest (loop (rf-cdr es)))) (t-ite c live rest)))))))))
                     (loop entries))))
               ;; Store entry (key . v) (v may be deleted).
               (put! (subr rf-eff (rf-ctx rf-value rf-table rf-value rf-value rf-value) rf-value)
                 (lambda (ctx src t entries key v)
                   (begin
                     (if (extract t mutable) #u (fail! ctx 'error (describe-call src "the hashtable is immutable")))
                     (write! ctx (extract t cell) 0
                             (rf-cons (rf-cons key v)
                                      (letrec ((drop (subr rf-eff (rf-value) rf-value)
                                                 (lambda (es)
                                                   (cond ((not (rf-pair? es)) rf-nil)
                                                         ((rf-true? (same ctx src t key (rf-caar es))) (drop (rf-cdr es)))
                                                         (else (let ((rest (drop (rf-cdr es)))) (rf-cons (rf-car es) rest)))))))
                                        (drop entries))))
                     rf-unspecified)))
               ;; The live entries, oldest first, as a value (a union where
               ;; which are live is symbolic) of a list of (key . value).
               (live-entries (subr rf-eff (rf-ctx rf-value rf-table rf-value) rf-value)
                 (lambda (ctx src t entries)
                   (letrec ((loop (subr rf-eff (rf-value rf-vals rf-value) rf-value)
                              (lambda (es newer acc)
                                (if (not (rf-pair? es)) acc
                                    (let* ((e (rf-car es))
                                           (live (t-and (rf-bool (not (rf-deleted? (rf-cdr e))))
                                                        (t-and* (map (lambda ((k rf-value)) (t-not (same ctx src t (rf-car e) k))) newer)))))
                                      (loop (rf-cdr es) (cons (rf-car e) newer) (merge live (rf-cons e acc) acc)))))))
                     (loop entries nil rf-nil))))
               (vector-of (subr rf-eff (rf-ctx rf-value) rf-value)
                 (lambda (ctx l)
                   (merge-members (map (lambda ((m rf-member)) (member (extract m g) (new-vector (rf-elements (extract m v)))))
                                       (guarded-members rf-true l)))))
               (map-members (subr rf-eff ((subr rf-st (rf-value) rf-value) rf-value) rf-value)
                 (lambda (f l)
                   (merge-members (map (lambda ((m rf-member)) (member (extract m g) (rf-list (map f (rf-elements (extract m v))))))
                                       (guarded-members rf-true l)))))
               (new (subr rf-st (rf-value) rf-value)
                 (lambda (equiv)
                   (sum table (product (equiv equiv) (cell (note-allocation! (the rf-slots (make-array 1 rf-nil)))) (mutable #t)))))
               (size (subr rf-eff (rf-ctx rf-value rf-vals) rf-value)
                 (lambda (ctx src args)
                   (with-table ctx src (car args)
                               (lambda ((ctx rf-ctx) (t rf-table) (es rf-value))
                                 (let ((live (live-entries ctx src t es)))
                                   (merge-members (map (lambda ((m rf-member)) (member (extract m g) (rf-int (rf-length (extract m v)))))
                                                       (guarded-members rf-true live)))))))))
        (begin
          (define! 'make-eq-hashtable (between 0 1) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (new (rf-sym 'eqv))))
          (define! 'make-eqv-hashtable (between 0 1) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (new (rf-sym 'eqv))))
          (define! 'make-hashtable (between 2 3)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (let ((equiv (car (cdr args))))
                (new (cond ((and (rf-prim? equiv) (or (eq? (prim-name equiv) 'eq?) (eq? (prim-name equiv) 'eqv?))) (rf-sym 'eqv))
                           ((and (rf-prim? equiv) (eq? (prim-name equiv) 'equal?)) (rf-sym 'equal))
                           (else equiv))))))
          (define! 'hashtable? (exactly 1)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (merge-members (map (lambda ((m rf-member)) (member (extract m g) (rf-bool (tagcase (extract m v) (table t #t) (else x #f)))))
                                  (guarded-members rf-true (car args))))))
          (define! 'hashtable-ref (between 2 3)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (with-table ctx src (car args)
                          (lambda ((ctx rf-ctx) (t rf-table) (es rf-value))
                            (lookup ctx src t es (car (cdr args)) (if (pair? (cdr (cdr args))) (car (cdr (cdr args))) rf-false))))))
          (define! 'hashtable-contains? (exactly 2)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (with-table ctx src (car args) (lambda ((ctx rf-ctx) (t rf-table) (es rf-value)) (has? ctx src t es (car (cdr args)))))))
          (define! 'hashtable-set! (exactly 3)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (with-table ctx src (car args)
                          (lambda ((ctx rf-ctx) (t rf-table) (es rf-value)) (put! ctx src t es (car (cdr args)) (car (cdr (cdr args))))))))
          (define! 'hashtable-delete! (exactly 2)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (with-table ctx src (car args) (lambda ((ctx rf-ctx) (t rf-table) (es rf-value)) (put! ctx src t es (car (cdr args)) rf-deleted)))))
          (define! 'hashtable-update! (exactly 4)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (with-table ctx src (car args)
                          (lambda ((ctx rf-ctx) (t rf-table) (es rf-value))
                            (let ((v (apply-value ctx (car (cdr (cdr args)))
                                                  (list (lookup ctx src t es (car (cdr args)) (car (cdr (cdr (cdr args))))))
                                                  src)))
                              (put! ctx src t es (car (cdr args)) v))))))
          (define! 'hashtable-clear! (between 1 2)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (with-table ctx src (car args)
                          (lambda ((ctx rf-ctx) (t rf-table) (es rf-value))
                            (begin
                              (if (extract t mutable) #u (fail! ctx 'error (describe-call src "the hashtable is immutable")))
                              (write! ctx (extract t cell) 0 rf-nil)
                              rf-unspecified)))))
          (define! 'hashtable-copy (between 1 2)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (with-table ctx src (car args)
                          (lambda ((ctx rf-ctx) (t rf-table) (es rf-value))
                            (sum table (product (equiv (extract t equiv)) (cell (note-allocation! (the rf-slots (make-array 1 es))))
                                                (mutable (and (pair? (cdr args)) (not (rf-false? (truth (car (cdr args)))))))))))))
          (define! 'hashtable-size (exactly 1) size)
          (define! 'hashtable-count (exactly 1) size)
          (define! 'hashtable-keys (exactly 1)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (with-table ctx src (car args)
                          (lambda ((ctx rf-ctx) (t rf-table) (es rf-value)) (vector-of ctx (map-members rf-car (live-entries ctx src t es)))))))
          (define! 'hashtable-entries (exactly 1)
            (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
              (with-table ctx src (car args)
                          (lambda ((ctx rf-ctx) (t rf-table) (es rf-value))
                            (let* ((live (live-entries ctx src t es))
                                   (keys (vector-of ctx (map-members rf-car live)))
                                   (vals (vector-of ctx (map-members rf-cdr live))))
                              (sum multiple (list keys vals)))))))
          ;; Hash functions, of concrete values only.
          (for-each (lambda ((name symbol))
                      (define! name (exactly 1)
                        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
                          (lift ctx args
                                (lambda ((ctx rf-ctx) (args rf-vals))
                                  (if (rf-term? (car args))
                                      (begin (fail! ctx 'unsupported (describe-call src "a hash of a symbolic value")) rf-unspecified)
                                      (rf-int (modulo (string-hash (datum->string (car args))) 536870912))))))))
                    (list 'equal-hash 'string-hash 'symbol-hash))
          (get prims))))))

;;; ratfink.fx: the ratfink program, each file made once, in order, from
;;; those before it (as combo/combo.fx makes combo).
(define m-core ((load-module "core.fx")))
(define m-term ((load-module "term.fx") m-core))
(define m-value ((load-module "value.fx") m-core m-term))
(define m-print ((load-module "print.fx") m-core))
(define m-syntax ((load-module "syntax.fx") m-core m-print))
(define m-numbers ((load-module "numbers.fx") m-core))
(define m-reader ((load-module "reader.fx") m-core m-numbers))
(define m-machine ((load-module "machine.fx") m-core m-term m-value))
(define m-prims ((load-module "prims.fx") m-core m-term m-value m-print m-syntax m-numbers m-reader m-machine))
(define m-hashtables ((load-module "hashtables.fx") m-core m-term m-value m-print m-syntax m-numbers m-reader m-machine m-prims))
(define m-ports ((load-module "ports.fx") m-core m-term m-value m-print m-syntax m-numbers m-reader m-machine m-prims m-hashtables))
(define m-prelude ((load-module "prelude.fx") m-core m-numbers m-reader))
(define m-library ((load-module "library.fx") m-core m-print m-syntax m-numbers m-reader))
(define m-smt ((load-module "smt.fx") m-core m-term m-print m-numbers m-reader))
(define m-eval ((load-module "eval.fx") m-core m-term m-value m-print m-syntax m-numbers m-reader m-machine m-prims m-hashtables m-ports m-prelude m-library))
(define m-playback ((load-module "playback.fx") m-core m-term m-value m-print m-syntax m-numbers m-reader m-machine m-prims m-hashtables m-ports m-prelude m-library m-eval))
(define m-check ((load-module "check.fx") m-core m-term m-value m-print m-syntax m-numbers m-reader m-machine m-prims m-hashtables m-ports m-prelude m-library m-smt m-eval m-playback))
(define m-main ((load-module "main.fx") m-core m-term m-value m-print m-syntax m-numbers m-reader m-machine m-prims m-hashtables m-ports m-prelude m-library m-smt m-eval m-playback m-check))
(import m-core (effect rf-eff))
(define main (subr rf-eff () int)
  (lambda () ((with m-main ratfink-main) (the (listof string acyclic) (args)))))

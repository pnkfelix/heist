;;; prims.fx: the primitive procedures of checked programs: shakedown's
;;; `(shakedown prims)`.
;;;
;;; Each primitive works on symbolic values where it can: arithmetic and
;;; comparisons on integers build terms, list operations work on lists
;;; whose elements (or, through unions, whose lengths) are symbolic. Most
;;; are lifted over unions: given a union argument, the primitive runs once
;;; for each member, and the results are merged. A primitive applied to
;;; something it cannot take fails a check of kind error, as the program
;;; would at run time; one that cannot work symbolically fails a check of
;;; kind unsupported.
;;;
;;; What shakedown leaves to Larceny's own procedures (on concrete values)
;;; is done here as Larceny does it, with its messages where it fails (so
;;; the labels of those failures are shakedown's).

(module-parameters ((m-core (load-moduleof "core.fx")) (m-term (load-moduleof "term.fx" m-core))
                    (m-value (load-moduleof "value.fx" m-core m-term))
                    (m-print (load-moduleof "print.fx" m-core))
                    (m-syntax (load-moduleof "syntax.fx" m-core m-print))
                    (m-numbers (load-moduleof "numbers.fx" m-core))
                    (m-reader (load-moduleof "reader.fx" m-core m-numbers))
                    (m-machine (load-moduleof "machine.fx" m-core m-term m-value))))

;;; ------------------------------------------------------------ the table

"A primitive's procedure as defined: of the context, the call's source and
the arguments."
(define-type prim-body (subr rf-eff (rf-ctx rf-value rf-vals) rf-value))
(define-type prim-entry (productof (name symbol) (value rf-value)))
(define-type prim-entries (listof prim-entry acyclic))
(define primitive-table (ref prim-entries @rf) (new nil))
(define primitives (subr rf-st () prim-entries) (lambda () (get primitive-table)))
"The primitive of a name (the latest defined)."
(define primitive-named (subr rf-st (symbol) rf-value)
  (lambda (name)
    (letrec ((find (subr rf-st (prim-entries) rf-value)
               (lambda (l) (cond ((null? l) rf-unspecified) ((eq? (extract (car l) name) name) (extract (car l) value)) (else (find (cdr l)))))))
      (find (get primitive-table)))))

"An arity: n to m arguments, m -1 for any number."
(define-type arity (productof (min int) (max int)))
(define exactly (subr rf-st (int) arity) (lambda (n) (product (min n) (max n))))
(define at-least (subr rf-st (int) arity) (lambda (n) (product (min n) (max -1))))
(define between (subr rf-st (int int) arity) (lambda (n m) (product (min n) (max m))))
(define arity-ok? (subr rf-st (arity int) bool)
  (lambda (a n) (and (>= n (extract a min)) (or (< (extract a max) 0) (<= n (extract a max))))))

"A primitive value: with its arity checked."
(define make-checked-prim (subr rf-st (symbol arity prim-body) rf-value)
  (lambda (name arity proc)
    (sum prim (product (name name)
                       (proc (lambda ((ctx rf-ctx) (args rf-vals) (src rf-value))
                               (if (arity-ok? arity (list-length args))
                                   (proc ctx src args)
                                   (fail! ctx 'error (describe-call src "wrong number of arguments")))))))))
(define make-primitive (subr rf-st (symbol rf-pproc) rf-value)
  (lambda (name proc) (sum prim (product (name name) (proc proc)))))
(define define-primitive! (subr rf-st (symbol arity prim-body) unit)
  (lambda (name arity proc)
    (set primitive-table (cons (product (name name) (value (make-checked-prim name arity proc))) (get primitive-table)))))
"A primitive whose arguments are never unions."
(define define-lifted! (subr rf-st (symbol arity prim-body) unit)
  (lambda (name arity proc)
    (define-primitive! name arity
      (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
        (lift ctx args (lambda ((ctx rf-ctx) (args rf-vals)) (proc ctx src args)))))))
(define prim-name (subr rf-st (rf-value) symbol) (lambda (v) (tagcase v (prim p (extract p name)) (else x '||))))
(define prim-proc (subr rf-st (rf-value) rf-pproc)
  (lambda (v) (tagcase v (prim p (extract p proc)) (else x (lambda ((c rf-ctx) (a rf-vals) (s rf-value)) rf-unspecified)))))

"(k ctx args), once for each choice of members of the union arguments."
(define lift (subr rf-eff (rf-ctx rf-vals (subr rf-eff (rf-ctx rf-vals) rf-value)) rf-value)
  (lambda (ctx args k)
    (letrec ((loop (subr rf-eff (rf-vals rf-vals) rf-value)
               (lambda (before after)
                 (cond ((null? after) (k ctx args))
                       ((rf-union? (car after))
                        (join-union ctx (car after)
                                    (lambda ((ctx rf-ctx) (v rf-value)) (lift ctx (vals-append (vals-reverse before) (cons v (cdr after))) k))))
                       ((rf-choice? (car after))
                        (tagcase (symbol-choice-members (car after))
                          (none u (begin (fail! ctx 'unsupported "a choice of too many symbols") rf-unspecified))
                          (some members
                            (join-union ctx (make-union members)
                                        (lambda ((ctx rf-ctx) (v rf-value)) (lift ctx (vals-append (vals-reverse before) (cons v (cdr after))) k))))))
                       (else (loop (cons (car after) before) (cdr after)))))))
      (loop nil args))))

(define describe-call (subr rf-eff (rf-value string) string)
  (lambda (src message) (string-append (datum->string src) ": " message)))

;;; ------------------------------------------------------------ numbers

(define memp-term? (subr rf-st (rf-vals) bool)
  (lambda (l) (and (pair? l) (or (rf-term? (car l)) (memp-term? (cdr l))))))
(define all-int-like? (subr rf-st (rf-vals) bool)
  (lambda (l) (or (null? l) (and (int-like? (car l)) (all-int-like? (cdr l))))))
"Fails unless the arguments are numbers; true if they are all concrete,
false if some are integer terms. Terms with other numbers are unsupported."
(define check-number-args (subr rf-eff (rf-ctx rf-value rf-vals) bool)
  (lambda (ctx src args)
    (begin
      (for-each (lambda ((a rf-value))
                  (if (or (rf-number? a) (int-term? a)) #u (fail! ctx 'error (describe-call src "argument is not a number"))))
                args)
      (cond ((not (memp-term? args)) #t)
            ((all-int-like? args) #f)
            (else (begin (fail! ctx 'unsupported (describe-call src "symbolic integers with inexact or non-integer numbers")) #f))))))
(define check-integer-args (subr rf-eff (rf-ctx rf-value rf-vals) unit)
  (lambda (ctx src args)
    (for-each (lambda ((a rf-value)) (if (int-like? a) #u (fail! ctx 'error (describe-call src "argument is not an integer")))) args)))

(define fold (subr rf-eff ((subr rf-eff (rf-value rf-value) rf-value) rf-value rf-vals) rf-value)
  (lambda (f init xs) (if (null? xs) init (fold f (f init (car xs)) (cdr xs)))))

"A primitive on numbers: host on concrete ones, symbolic on terms."
(define define-arithmetic! (subr rf-st (symbol arity (subr rf-eff (rf-ctx rf-value rf-vals) rf-value) (subr rf-eff (rf-vals) rf-value)) unit)
  (lambda (name arity host symbolic)
    (define-lifted! name arity
      (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
        (if (check-number-args ctx src args) (host ctx src args) (symbolic args))))))
"A host procedure of concrete numbers that cannot fail."
(define pure-host (subr rf-st ((subr rf-eff (rf-vals) rf-value)) (subr rf-eff (rf-ctx rf-value rf-vals) rf-value))
  (lambda (f) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (f args))))

(define host-sub (subr rf-eff (rf-vals) rf-value)
  (lambda (args) (if (null? (cdr args)) (num-neg (car args)) (fold num-sub (car args) (cdr args)))))
(define sym-sub (subr rf-eff (rf-vals) rf-value)
  (lambda (args) (if (null? (cdr args)) (t-neg (car args)) (fold t-- (car args) (cdr args)))))

(define pairwise (subr rf-eff ((subr rf-eff (rf-value rf-value) rf-value) rf-vals) rf-value)
  (lambda (f args)
    (if (or (null? args) (null? (cdr args))) rf-true
        (let* ((a (f (car args) (car (cdr args)))) (b (pairwise f (cdr args)))) (t-and a b)))))
"A chain of comparisons of concrete numbers: test of num-compare's answer."
(define host-chain (subr rf-st ((subr rf-st (int) bool)) (subr rf-eff (rf-vals) rf-value))
  (lambda (ok?)
    (lambda ((args rf-vals))
      (letrec ((go (subr rf-eff (rf-vals) bool)
                 (lambda (l) (or (null? l) (null? (cdr l)) (and (ok? (num-compare (car l) (car (cdr l)))) (go (cdr l)))))))
        (rf-bool (go args))))))
(define define-comparison! (subr rf-st (symbol (subr rf-st (int) bool) (subr rf-eff (rf-value rf-value) rf-value)) unit)
  (lambda (name ok? symbolic)
    (define-arithmetic! name (at-least 1) (pure-host (host-chain ok?)) (lambda ((args rf-vals)) (pairwise symbolic args)))))
(define define-unary! (subr rf-st (symbol (subr rf-eff (rf-value) rf-value) (subr rf-eff (rf-value) rf-value)) unit)
  (lambda (name host symbolic)
    (define-arithmetic! name (exactly 1) (pure-host (lambda ((args rf-vals)) (host (car args)))) (lambda ((args rf-vals)) (symbolic (car args))))))

(define t-max (subr rf-eff (rf-value rf-value) rf-value) (lambda (a b) (let ((c (t-< a b))) (t-ite c b a))))
(define t-min (subr rf-eff (rf-value rf-value) rf-value) (lambda (a b) (let ((c (t-< b a))) (t-ite c b a))))
(define t-even? (subr rf-eff (rf-value) rf-value) (lambda (x) (t-= (t-mod x (rf-int 2)) (rf-int 0))))

"Scheme's division operators from SMT-LIB's div and mod."
(define t-quotient (subr rf-eff (rf-value rf-value) rf-value)
  (lambda (a b)
    (let* ((aa (t-abs a)) (ab (t-abs b)) (q (t-div aa ab))
           (la (t-< a (rf-int 0))) (lb (t-< b (rf-int 0))) (c (t-= la lb)) (nq (t-neg q)))
      (t-ite c q nq))))
(define t-remainder (subr rf-eff (rf-value rf-value) rf-value)
  (lambda (a b)
    (let* ((aa (t-abs a)) (ab (t-abs b)) (r (t-mod aa ab)) (c (t-< a (rf-int 0))) (nr (t-neg r)))
      (t-ite c nr r))))
(define t-modulo (subr rf-eff (rf-value rf-value) rf-value)
  (lambda (a b)
    (if (and (rf-exact-integer? b) (> (rf-int-of b) 0))
        (t-mod a b)
        (let* ((r (t-remainder a b))
               (c1 (t-= r (rf-int 0))) (lr (t-< r (rf-int 0))) (lb (t-< b (rf-int 0))) (c2 (t-= lr lb)) (c (t-or c1 c2))
               (rb (t-+ r b)))
          (t-ite c r rb)))))
(define t-floor-quotient (subr rf-eff (rf-value rf-value) rf-value)
  (lambda (a b) (let* ((m (t-modulo a b)) (d (t-- a m))) (t-div d b))))

(define host-quotient (subr rf-st (int int) int) (lambda (a b) (quotient a b)))
(define host-remainder (subr rf-st (int int) int) (lambda (a b) (remainder a b)))
(define host-modulo (subr rf-st (int int) int) (lambda (a b) (modulo a b)))
(define host-floor-quotient (subr rf-st (int int) int) (lambda (a b) (floor-div a b)))

(define define-division! (subr rf-st (symbols (subr rf-st (int int) int) (subr rf-eff (rf-value rf-value) rf-value)) unit)
  (lambda (names host symbolic)
    (for-each
     (lambda ((name symbol))
       (define-lifted! name (exactly 2)
         (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
           (let* ((a (car args)) (b (car (cdr args)))
                  (concrete? (check-number-args ctx src args)))
             (begin
               (check-integer-args ctx src args)
               (check! ctx 'error (describe-call src "division by zero") (t-not (t-= b (rf-int 0))))
               (if concrete? (int-op host a b) (symbolic a b)))))))
     names)))
(define define-division/! (subr rf-st (symbol (subr rf-st (int int) int) (subr rf-st (int int) int)
                                        (subr rf-eff (rf-value rf-value) rf-value) (subr rf-eff (rf-value rf-value) rf-value)) unit)
  (lambda (name hq hr q r)
    (define-lifted! name (exactly 2)
      (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
        (let* ((a (car args)) (b (car (cdr args)))
               (concrete? (check-number-args ctx src args)))
          (begin
            (check-integer-args ctx src args)
            (check! ctx 'error (describe-call src "division by zero") (t-not (t-= b (rf-int 0))))
            (sum multiple (if concrete?
                              (list (int-op hq a b) (int-op hr a b))
                              (let* ((x (q a b)) (y (r a b))) (list x y))))))))))

(define max-expt int 64)

"Bitwise operations of exact integers (as Larceny's on fixnums)."
(define host-bitwise (subr rf-st ((subr rf-st (int int) int) int) (subr rf-eff (rf-vals) rf-value))
  (lambda (op identity) (lambda ((args rf-vals)) (rf-int (letrec ((go (subr rf-st (rf-vals int) int) (lambda (l acc) (if (null? l) acc (go (cdr l) (op acc (rf-int-of (car l))))))))
                                                          (go args identity))))))

(define install-number-primitives! (subr rf-st () unit)
  (lambda ()
    (begin
      (define-arithmetic! '+ (at-least 0) (pure-host (lambda ((args rf-vals)) (fold num-add (rf-int 0) args))) (lambda ((args rf-vals)) (fold t-+ (rf-int 0) args)))
      (define-arithmetic! '* (at-least 0) (pure-host (lambda ((args rf-vals)) (fold num-mul (rf-int 1) args))) (lambda ((args rf-vals)) (fold t-* (rf-int 1) args)))
      (define-arithmetic! '- (at-least 1) (pure-host host-sub) sym-sub)
      (define-arithmetic! 'real-part (exactly 1) (pure-host (lambda ((args rf-vals)) (car args))) (lambda ((args rf-vals)) (car args)))
      (define-arithmetic! 'imag-part (exactly 1) (pure-host (lambda ((args rf-vals)) (rf-int 0))) (lambda ((args rf-vals)) (rf-int 0)))
      (define-lifted! '/ (at-least 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (begin
            (if (check-number-args ctx src args)
                (if (memv-exact-zero? (if (null? (cdr args)) args (cdr args)))
                    (fail! ctx 'error (describe-call src "division by zero"))
                    #u)
                #u)
            (if (memp-term? args)
                (begin (fail! ctx 'unsupported (describe-call src "division of symbolic integers")) rf-unspecified)
                (if (null? (cdr args)) (num-div (rf-int 1) (car args)) (fold num-div (car args) (cdr args)))))))
      (define-comparison! '= (lambda ((c int)) (= c 0)) t-=)
      (define-comparison! '< (lambda ((c int)) (= c -1)) t-<)
      (define-comparison! '<= (lambda ((c int)) (or (= c -1) (= c 0))) t-<=)
      (define-comparison! '> (lambda ((c int)) (= c 1)) (lambda ((a rf-value) (b rf-value)) (t-< b a)))
      (define-comparison! '>= (lambda ((c int)) (or (= c 1) (= c 0))) (lambda ((a rf-value) (b rf-value)) (t-<= b a)))
      (define-unary! 'zero? (lambda ((a rf-value)) (rf-bool (num-zero? a))) (lambda ((a rf-value)) (t-= a (rf-int 0))))
      (define-unary! 'positive? (lambda ((a rf-value)) (rf-bool (= (num-sign a) 1))) (lambda ((a rf-value)) (t-< (rf-int 0) a)))
      (define-unary! 'negative? (lambda ((a rf-value)) (rf-bool (= (num-sign a) -1))) (lambda ((a rf-value)) (t-< a (rf-int 0))))
      (define-unary! 'abs num-abs t-abs)
      (define-unary! 'square (lambda ((a rf-value)) (num-mul a a)) (lambda ((a rf-value)) (t-* a a)))
      (define-unary! 'even? (lambda ((a rf-value)) (rf-bool (= 0 (modulo (rf-int-of (num-exact a)) 2)))) t-even?)
      (define-unary! 'odd? (lambda ((a rf-value)) (rf-bool (= 1 (modulo (rf-int-of (num-exact a)) 2)))) (lambda ((a rf-value)) (t-= (t-mod a (rf-int 2)) (rf-int 1))))
      (define-unary! 'exact num-exact (lambda ((a rf-value)) a))
      (define-unary! 'exact? (lambda ((a rf-value)) (rf-bool (exact? a))) (lambda ((a rf-value)) rf-true))
      (define-unary! 'inexact? (lambda ((a rf-value)) (rf-bool (real? a))) (lambda ((a rf-value)) rf-false))
      (define-arithmetic! 'max (at-least 1) (pure-host (lambda ((args rf-vals)) (fold num-max (car args) (cdr args)))) (lambda ((args rf-vals)) (fold t-max (car args) (cdr args))))
      (define-arithmetic! 'min (at-least 1) (pure-host (lambda ((args rf-vals)) (fold num-min (car args) (cdr args)))) (lambda ((args rf-vals)) (fold t-min (car args) (cdr args))))
      ;; (rnrs arithmetic fixnums), without checking for overflow.
      (define-arithmetic! 'fx+ (at-least 0) (pure-host (lambda ((args rf-vals)) (fold num-add (rf-int 0) args))) (lambda ((args rf-vals)) (fold t-+ (rf-int 0) args)))
      (define-arithmetic! 'fx* (at-least 0) (pure-host (lambda ((args rf-vals)) (fold num-mul (rf-int 1) args))) (lambda ((args rf-vals)) (fold t-* (rf-int 1) args)))
      (define-arithmetic! 'fx- (at-least 0) (pure-host host-sub) sym-sub)
      (define-comparison! 'fx=? (lambda ((c int)) (= c 0)) t-=)
      (define-comparison! 'fx<? (lambda ((c int)) (= c -1)) t-<)
      (define-comparison! 'fx<=? (lambda ((c int)) (or (= c -1) (= c 0))) t-<=)
      (define-comparison! 'fx>? (lambda ((c int)) (= c 1)) (lambda ((a rf-value) (b rf-value)) (t-< b a)))
      (define-comparison! 'fx>=? (lambda ((c int)) (or (= c 1) (= c 0))) (lambda ((a rf-value) (b rf-value)) (t-<= b a)))
      (define-arithmetic! 'fxzero? (exactly 1) (pure-host (lambda ((args rf-vals)) (rf-bool (num-zero? (car args))))) (lambda ((args rf-vals)) (t-= (car args) (rf-int 0))))
      (define-arithmetic! 'fxodd? (exactly 1) (pure-host (lambda ((args rf-vals)) (rf-bool (= 1 (modulo (rf-int-of (car args)) 2))))) (lambda ((args rf-vals)) (t-not (t-even? (car args)))))
      (define-arithmetic! 'fxeven? (exactly 1) (pure-host (lambda ((args rf-vals)) (rf-bool (= 0 (modulo (rf-int-of (car args)) 2))))) (lambda ((args rf-vals)) (t-even? (car args))))
      (define-arithmetic! 'fxnot (exactly 1) (pure-host (lambda ((args rf-vals)) (rf-int (bitwise-not (rf-int-of (car args)))))) (lambda ((args rf-vals)) (t-- (t-neg (car args)) (rf-int 1))))
      (define-arithmetic! 'fxmin (at-least 1) (pure-host (lambda ((args rf-vals)) (fold num-min (car args) (cdr args)))) (lambda ((args rf-vals)) (fold t-min (car args) (cdr args))))
      (define-arithmetic! 'fxmax (at-least 1) (pure-host (lambda ((args rf-vals)) (fold num-max (car args) (cdr args)))) (lambda ((args rf-vals)) (fold t-max (car args) (cdr args))))
      (define-bitwise! (list 'fxand 'bitwise-and) (host-bitwise (lambda ((a int) (b int)) (bitwise-and a b)) -1) (lambda ((x rf-value)) (t-mod x (rf-int 2))))
      (define-bitwise! (list 'fxior 'bitwise-ior) (host-bitwise (lambda ((a int) (b int)) (bitwise-ior a b)) 0)
        (lambda ((x rf-value)) (let* ((c (t-even? x)) (y (t-+ x (rf-int 1)))) (t-ite c y x))))
      (define-bitwise! (list 'fxxor 'bitwise-xor) (host-bitwise (lambda ((a int) (b int)) (bitwise-xor a b)) 0)
        (lambda ((x rf-value)) (let* ((c (t-even? x)) (y (t-+ x (rf-int 1))) (z (t-- x (rf-int 1)))) (t-ite c y z))))
      (define-shift! 'fxarithmetic-shift-left (lambda ((x int) (k int)) (arithmetic-shift x k)) t-*)
      (define-shift! 'fxarithmetic-shift-right (lambda ((x int) (k int)) (arithmetic-shift x (- 0 k))) t-div)
      (define-division! (list 'quotient 'truncate-quotient) host-quotient t-quotient)
      (define-division! (list 'remainder 'truncate-remainder) host-remainder t-remainder)
      (define-division! (list 'modulo 'floor-remainder) host-modulo t-modulo)
      (define-division! (list 'floor-quotient) host-floor-quotient t-floor-quotient)
      (define-division/! 'floor/ host-floor-quotient host-modulo t-floor-quotient t-modulo)
      (define-division/! 'truncate/ host-quotient host-remainder t-quotient t-remainder)
      ;; Rounding: a symbolic number is an integer, so its own rounding.
      (define-arithmetic! 'floor (exactly 1) (pure-host (lambda ((args rf-vals)) (num-round 0 (car args)))) (lambda ((args rf-vals)) (car args)))
      (define-arithmetic! 'ceiling (exactly 1) (pure-host (lambda ((args rf-vals)) (num-round 1 (car args)))) (lambda ((args rf-vals)) (car args)))
      (define-arithmetic! 'round (exactly 1) (pure-host (lambda ((args rf-vals)) (num-round 2 (car args)))) (lambda ((args rf-vals)) (car args)))
      (define-arithmetic! 'truncate (exactly 1) (pure-host (lambda ((args rf-vals)) (num-round 3 (car args)))) (lambda ((args rf-vals)) (car args)))
      (define-arithmetic! 'numerator (exactly 1) (pure-host (lambda ((args rf-vals)) (numerator-of (car args)))) (lambda ((args rf-vals)) (car args)))
      (define-arithmetic! 'denominator (exactly 1) (pure-host (lambda ((args rf-vals)) (denominator-of (car args)))) (lambda ((args rf-vals)) (rf-int 1)))
      ;; (expt base n): of a symbolic base, a product, for a concrete n of
      ;; at most max-expt.
      (define-lifted! 'expt (exactly 2)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (let ((base (car args)) (n (car (cdr args))))
            (cond ((check-number-args ctx src args) (num-expt base n))
                  ((and (rf-exact-integer? n) (<= 0 (rf-int-of n)) (<= (rf-int-of n) max-expt))
                   (letrec ((loop (subr rf-eff (int rf-value) rf-value)
                              (lambda (i acc) (if (= i (rf-int-of n)) acc (loop (+ i 1) (t-* acc base))))))
                     (loop 0 (rf-int 1))))
                  (else (begin (fail! ctx 'unsupported (describe-call src "a symbolic exponent")) rf-unspecified)))))))))
(define memv-exact-zero? (subr rf-st (rf-vals) bool)
  (lambda (l) (and (pair? l) (or (rf-eqv? (car l) (rf-int 0)) (memv-exact-zero? (cdr l))))))
(define numerator-of (subr rf-st (rf-value) rf-value)
  (lambda (v) (tagcase v (real r (num-inexact (numerator-of (num-exact v)))) (else x (rf-int (num-of v))))))
(define denominator-of (subr rf-st (rf-value) rf-value)
  (lambda (v) (tagcase v (real r (num-inexact (denominator-of (num-exact v)))) (else x (rf-int (den-of v))))))
"With one argument 1 and the other symbolic: x's low bit."
(define define-bitwise! (subr rf-st (symbols (subr rf-eff (rf-vals) rf-value) (subr rf-eff (rf-value) rf-value)) unit)
  (lambda (names host with-1)
    (for-each
     (lambda ((name symbol))
       (define-lifted! name (at-least 0)
         (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
           (cond ((check-number-args ctx src args) (host args))
                 ((and (= (list-length args) 2) (memq-val? (rf-int 1) args))
                  (with-1 (if (rf-eqv? (car args) (rf-int 1)) (car (cdr args)) (car args))))
                 (else (begin (fail! ctx 'unsupported (describe-call src "bitwise operations on symbolic integers")) rf-unspecified))))))
     names)))
(define define-shift! (subr rf-st (symbol (subr rf-st (int int) int) (subr rf-eff (rf-value rf-value) rf-value)) unit)
  (lambda (name host symbolic)
    (define-lifted! name (exactly 2)
      (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
        (let ((x (car args)) (k (car (cdr args))))
          (cond ((check-number-args ctx src args) (rf-int (host (rf-int-of x) (rf-int-of k))))
                ((and (rf-exact-integer? k) (<= 0 (rf-int-of k)) (<= (rf-int-of k) 62)) (symbolic x (rf-int (arithmetic-shift 1 (rf-int-of k)))))
                (else (begin (fail! ctx 'unsupported (describe-call src "a shift by a symbolic count")) rf-unspecified))))))))

;;; ------------------------------------------------------------ predicates and equivalence

(define define-predicate! (subr rf-st (symbol (subr rf-eff (rf-value) bool)) unit)
  (lambda (name p)
    (define-primitive! name (exactly 1)
      (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
        (merge-members (map (lambda ((m rf-member)) (member (extract m g) (rf-bool (p (extract m v)))))
                            (guarded-members rf-true (car args))))))))

"eqv?, on values that may be unions or terms."
(define eqv-value (subr rf-eff (rf-value rf-value) rf-value)
  (lambda (a b)
    (cond ((rf-union? a) (over-members a (lambda ((v rf-value)) (eqv-value v b))))
          ((rf-union? b) (over-members b (lambda ((v rf-value)) (eqv-value a v))))
          ((and (int-like? a) (int-like? b)) (t-= a b))
          ((and (bool-like? a) (bool-like? b)) (t-= a b))
          ((or (rf-term? a) (rf-term? b)) rf-false)
          ((and (or (rf-choice? a) (rf-choice? b)) (symbol-like? a) (symbol-like? b))
           (let* ((x (symbol-term a)) (y (symbol-term b))) (t-= x y)))
          (else (rf-bool (rf-eqv? a b))))))
(define equal-value (subr rf-eff (rf-value rf-value) rf-value)
  (lambda (a b)
    (cond ((rf-union? a) (over-members a (lambda ((v rf-value)) (equal-value v b))))
          ((rf-union? b) (over-members b (lambda ((v rf-value)) (equal-value a v))))
          ((and (rf-pair? a) (rf-pair? b))
           (let* ((x (equal-value (rf-car a) (rf-car b))) (y (equal-value (rf-cdr a) (rf-cdr b)))) (t-and x y)))
          ((and (rf-vector? a) (rf-vector? b))
           (if (= (array-length (rf-slots-of a)) (array-length (rf-slots-of b)))
               (t-and* (map2 (lambda ((x rf-value) (y rf-value)) (equal-value x y)) (slots-list (rf-slots-of a)) (slots-list (rf-slots-of b))))
               rf-false))
          ((and (rf-string? a) (rf-string? b)) (rf-bool (string=? (rf-str-of a) (rf-str-of b))))
          (else (eqv-value a b)))))
(define over-members (subr rf-eff (rf-value (subr rf-eff (rf-value) rf-value)) rf-value)
  (lambda (u f) (t-or* (map (lambda ((m rf-member)) (let ((x (f (extract m v)))) (t-and (extract m g) x))) (union-members u)))))

;;; ------------------------------------------------------------ pairs and lists

(define pair-arg (subr rf-eff (rf-ctx rf-value rf-value) rf-value)
  (lambda (ctx src v) (begin (if (rf-pair? v) #u (fail! ctx 'error (describe-call src "argument is not a pair"))) v)))

"c[ad]+r: the path applied right to left, as in the name."
(define define-cxr! (subr rf-st (symbol) unit)
  (lambda (name)
    (let* ((s (symbol->string name))
           (ops (the (listof char acyclic) (reverse (string->list (substring s 1 (- (string-length s) 1)))))))
      (define-primitive! name (exactly 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (letrec ((loop (subr rf-eff ((listof char acyclic) rf-ctx rf-value) rf-value)
                     (lambda (ops ctx v)
                       (cond ((null? ops) v)
                             ((rf-union? v) (join-union ctx v (lambda ((ctx rf-ctx) (v rf-value)) (loop ops ctx v))))
                             (else (let ((p (pair-arg ctx src v)))
                                     (loop (cdr ops) ctx (if (char=? (car ops) #\a) (rf-car p) (rf-cdr p)))))))))
            (loop ops ctx (car args))))))))

"(k ctx elements) for the elements of the list l, once for each way its
spine can be. Fails if it is not a proper list."
(define spine (subr rf-eff (rf-ctx rf-value rf-value (subr rf-eff (rf-ctx rf-vals) rf-value)) rf-value)
  (lambda (ctx src l k)
    (letrec ((walk (subr rf-eff (rf-ctx rf-value rf-vals) rf-value)
               (lambda (ctx l acc)
                 (tagcase l
                   (null u (k ctx (vals-reverse acc)))
                   (pair p (walk ctx (array-ref p 1) (cons (array-ref p 0) acc)))
                   (union ms (join-union ctx l (lambda ((ctx rf-ctx) (v rf-value)) (walk ctx v acc))))
                   (else x (begin (fail! ctx 'error (describe-call src "argument is not a proper list")) rf-unspecified))))))
      (walk ctx l nil))))

"The cases of a symbolic index i within [0, n), as integer-cases gives them."
(define index-cases (subr rf-eff (rf-value int) (sumof (none unit) (some cases)))
  (lambda (i n)
    (tagcase (integer-cases i)
      (none u (sum none #u))
      (some cs (sum some (filter (lambda ((c a-case)) (and (< -1 (extract c value)) (< (extract c value) n))) cs))))))

"The element of xs at index i, which may be symbolic."
(define select (subr rf-eff (rf-ctx rf-value rf-vals rf-value) rf-value)
  (lambda (ctx src xs i) (select-from ctx src (the rf-slots (list->array xs)) i)))
"The element of vector v at index i, which may be symbolic."
(define select-from (subr rf-eff (rf-ctx rf-value rf-slots rf-value) rf-value)
  (lambda (ctx src v i)
    (begin
      (check-integer-args ctx src (list i))
      (let ((n (array-length v)))
        (begin
          (if (= n 0) (fail! ctx 'error (describe-call src "index out of range")) #u)
          (check! ctx 'error (describe-call src "index out of range")
                  (let* ((lo (t-<= (rf-int 0) i)) (hi (t-< i (rf-int n)))) (t-and lo hi)))
          (cond ((rf-exact-integer? i) (array-ref v (rf-int-of i)))
                (else
                 (tagcase (index-cases i n)
                   (some cs (if (null? cs) (array-ref v 0)
                                (merge-members (map (lambda ((c a-case)) (member (extract c cond) (array-ref v (extract c value)))) cs))))
                   (none u
                     (letrec ((loop (subr rf-eff (int rf-value) rf-value)
                                (lambda (j acc) (if (< j 0) acc (loop (- j 1) (let ((c (t-= i (rf-int j)))) (merge c (array-ref v j) acc)))))))
                       (loop (- n 2) (array-ref v (- n 1)))))))))))))

;;; ------------------------------------------------------------ vectors

(define vector-arg (subr rf-eff (rf-ctx rf-value rf-value) rf-slots)
  (lambda (ctx src v) (begin (if (rf-vector? v) #u (fail! ctx 'error (describe-call src "argument is not a vector"))) (rf-slots-of v))))
(define new-vector (subr rf-st (rf-vals) rf-value)
  (lambda (xs) (sum vec (note-allocation! (the rf-slots (list->array xs))))))
"The bounds (v [start [end]]), concrete, after the arguments are checked."
(define vector-range (subr rf-eff (rf-ctx rf-value rf-value rf-vals) (productof (start int) (end int)))
  (lambda (ctx src v bounds)
    (let* ((n (array-length (vector-arg ctx src v)))
           (start (if (pair? bounds) (car bounds) (rf-int 0)))
           (end (if (and (pair? bounds) (pair? (cdr bounds))) (car (cdr bounds)) (rf-int n))))
      (begin
        (if (and (rf-exact-integer? start) (rf-exact-integer? end)) #u (fail! ctx 'unsupported (describe-call src "symbolic bounds")))
        (check! ctx 'error (describe-call src "index out of range")
                (rf-bool (and (<= 0 (rf-int-of start)) (<= (rf-int-of start) (rf-int-of end)) (<= (rf-int-of end) n))))
        (product (start (rf-int-of start)) (end (rf-int-of end)))))))
(define slots->vals (subr rf-st (rf-slots int int) rf-vals)
  (lambda (v from to) (if (>= from to) nil (cons (array-ref v from) (slots->vals v (+ from 1) to)))))

;;; ------------------------------------------------------------ concrete-only primitives

"What a host procedure gives: a value, or Larceny's message for its failure."
(define-type host-result (sumof (ok rf-value) (failed string)))
(define-type host-proc (subr rf-eff (rf-vals) host-result))

(define holds-symbolic? (subr rf-st (rf-value) bool)
  (lambda (v)
    (tagcase v
      (term t #t) (union u #t) (choice c #t)
      (pair p (or (holds-symbolic? (array-ref p 0)) (holds-symbolic? (array-ref p 1))))
      (vec a (letrec ((loop (subr rf-st (int) bool) (lambda (i) (and (< i (array-length a)) (or (holds-symbolic? (array-ref a i)) (loop (+ i 1)))))))
               (loop 0)))
      (else x #f))))

"(host arg …), whose arguments are lifted: unsupported if one is symbolic,
or holds something symbolic. An argument that is a choice among a few
integers is taken one value at a time, in a join."
(define apply-concrete (subr rf-eff (rf-ctx rf-value host-proc rf-vals) rf-value)
  (lambda (ctx src host args)
    (letrec ((loop (subr rf-eff (rf-vals rf-vals) rf-value)
               (lambda (before after)
                 (cond ((null? after) (apply-concrete-now ctx src host args))
                       ((and (rf-term? (car after)) (tagcase (integer-cases (car after)) (some c #t) (none u #f)))
                        (tagcase (integer-cases (car after))
                          (some cs
                            (join ctx (map (lambda ((c a-case))
                                             (make-arm (extract c cond)
                                                       (lambda ((ctx rf-ctx))
                                                         (apply-concrete ctx src host (vals-append (vals-reverse before) (cons (rf-int (extract c value)) (cdr after)))))))
                                           cs)
                                  #f))
                          (none u rf-unspecified)))
                       (else (loop (cons (car after) before) (cdr after)))))))
      (loop nil args))))
(define apply-concrete-now (subr rf-eff (rf-ctx rf-value host-proc rf-vals) rf-value)
  (lambda (ctx src host args)
    (begin
      (if (any-holds-symbolic? args) (fail! ctx 'unsupported (describe-call src "symbolic argument")) #u)
      (tagcase (host args)
        (ok v v)
        (failed message (begin (fail! ctx 'error (describe-call src message)) rf-unspecified))))))
(define any-holds-symbolic? (subr rf-st (rf-vals) bool)
  (lambda (l) (and (pair? l) (or (holds-symbolic? (car l)) (any-holds-symbolic? (cdr l))))))
(define define-concrete! (subr rf-st (symbol arity host-proc) unit)
  (lambda (name arity host)
    (define-lifted! name arity (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (apply-concrete ctx src host args)))))

"How Larceny writes a value in its messages."
(define w (subr rf-eff (rf-value) string) (lambda (v) (datum-text v #f #t larceny-record-text)))
(define ok (subr rf-st (rf-value) host-result) (lambda (v) (sum ok v)))
(define failed (subr rf-st (string) host-result) (lambda (m) (sum failed m)))

"The first argument that is not a string, or none."
(define first-non (subr rf-st ((subr rf-st (rf-value) bool) rf-vals) (sumof (none unit) (some rf-value)))
  (lambda (ok? l) (cond ((null? l) (sum none #u)) ((ok? (car l)) (first-non ok? (cdr l))) (else (sum some (car l))))))
(define not-a-string (subr rf-eff (rf-value) host-result)
  (lambda (v) (failed (string-append "string-length: not a string: " (w v) " \n"))))
(define not-a-char (subr rf-eff (string rf-value) host-result)
  (lambda (who v) (failed (string-append who ": not a char: " (w v) " \n"))))
"With every argument a string, (f strings); else Larceny's failure."
(define on-strings (subr rf-eff (rf-vals (subr rf-eff (strings) host-result)) host-result)
  (lambda (args f)
    (tagcase (first-non rf-string? args)
      (some v (not-a-string v))
      (none u (f (map (lambda ((a rf-value)) (rf-str-of a)) args))))))
(define on-chars (subr rf-eff (string rf-vals (subr rf-eff ((listof char acyclic)) host-result)) host-result)
  (lambda (who args f)
    (tagcase (first-non rf-char? args)
      (some v (not-a-char who v))
      (none u (f (map (lambda ((a rf-value)) (tagcase a (char c c) (else x #\space))) args))))))
(define chain (subr rf-eff ((subr rf-eff (string string) bool) strings) bool)
  (lambda (ok? l) (or (null? l) (null? (cdr l)) (and (ok? (car l) (car (cdr l))) (chain ok? (cdr l))))))
(define char-chain (subr rf-eff ((subr rf-eff (int int) bool) (listof char acyclic)) bool)
  (lambda (ok? l) (or (null? l) (null? (cdr l)) (and (ok? (char->integer (car l)) (char->integer (car (cdr l)))) (char-chain ok? (cdr l))))))
"A string of characters, or Larceny's failure for one that is not."
(define chars->string (subr rf-eff (rf-vals) host-result)
  (lambda (l)
    (tagcase (first-non rf-char? l)
      (some v (failed (string-append "string-set!: illegal third argument: " (w v) "  cannot be stored in a string\n")))
      (none u (ok (rf-str (list->string (map (lambda ((a rf-value)) (tagcase a (char c c) (else x #\space))) l))))))))
(define list->string-host (subr rf-eff (rf-vals) host-result) (lambda (a) (chars->string (rf-elements (car a)))))
(define string-chars (subr rf-st (string) rf-vals)
  (lambda (s) (map (lambda ((c char)) (sum char c)) (the (listof char acyclic) (string->list s)))))
(define arg2 (subr rf-st (rf-vals) rf-value) (lambda (l) (car (cdr l))))
(define arg3 (subr rf-st (rf-vals) rf-value) (lambda (l) (car (cdr (cdr l)))))
(define char-of (subr rf-st (rf-value) char) (lambda (v) (tagcase v (char c c) (else x #\space))))
(define on-char (subr rf-eff (string rf-value (subr rf-eff (char) host-result)) host-result)
  (lambda (who v f) (tagcase v (char c (f c)) (else x (not-a-char who v)))))
(define on-number (subr rf-eff (string rf-value (subr rf-eff (rf-value) host-result)) host-result)
  (lambda (who v f) (if (rf-number? v) (f v) (failed (string-append who ": not a number: " (w v) " \n")))))

(define install-concrete-primitives! (subr rf-st () unit)
  (lambda ()
    (begin
      (define-concrete! 'symbol->string (exactly 1)
        (lambda ((a rf-vals)) (tagcase (car a) (sym s (ok (rf-str (symbol->string s)))) (else x (failed (string-append "symbol->string:  " (w (car a)) " \" is not a symbol.\""))))))
      (define-concrete! 'string->symbol (exactly 1)
        (lambda ((a rf-vals)) (tagcase (car a) (str s (ok (rf-sym (string->symbol s)))) (else x (failed (string-append "string->symbol:  " (w (car a)) " \" is not a string.\""))))))
      (define-concrete! 'string-append (at-least 0) (lambda ((a rf-vals)) (on-strings a (lambda ((ss strings)) (ok (rf-str (strings-concat ss)))))))
      (define-concrete! 'string-length (exactly 1) (lambda ((a rf-vals)) (on-strings a (lambda ((ss strings)) (ok (rf-int (string-length (car ss))))))))
      (define-concrete! 'string-ref (exactly 2)
        (lambda ((a rf-vals))
          (tagcase (car a)
            (str s (let ((k (arg2 a)))
                     (if (and (rf-exact-integer? k) (<= 0 (rf-int-of k)) (< (rf-int-of k) (string-length s)))
                         (ok (sum char (string-ref s (rf-int-of k))))
                         (failed (string-append "string-ref: illegal second argument: " (w k) "  is not a valid index into string\n")))))
            (else x (failed (string-append "string-ref: illegal first argument: " (w (car a)) "  is not a string\n"))))))
      (define-concrete! 'substring (between 2 3)
        (lambda ((a rf-vals))
          (let* ((s (car a)) (i (arg2 a)) (j (if (pair? (cdr (cdr a))) (arg3 a) (rf-int (string-length (rf-str-of s))))))
            (if (and (rf-string? s) (rf-exact-integer? i) (rf-exact-integer? j) (<= 0 (rf-int-of i))
                     (<= (rf-int-of i) (rf-int-of j)) (<= (rf-int-of j) (string-length (rf-str-of s))))
                (ok (rf-str (substring (rf-str-of s) (rf-int-of i) (rf-int-of j))))
                (failed (string-append "illegal argument(s) " (w s) " " (w i) (if (pair? (cdr (cdr a))) (string-append " " (w j)) "")))))))
      (define-concrete! 'string=? (at-least 1) (lambda ((a rf-vals)) (on-strings a (lambda ((ss strings)) (ok (rf-bool (chain (lambda ((x string) (y string)) (string=? x y)) ss)))))))
      (define-concrete! 'string<? (at-least 1) (lambda ((a rf-vals)) (on-strings a (lambda ((ss strings)) (ok (rf-bool (chain (lambda ((x string) (y string)) (string<? x y)) ss)))))))
      (define-concrete! 'string<=? (at-least 1) (lambda ((a rf-vals)) (on-strings a (lambda ((ss strings)) (ok (rf-bool (chain (lambda ((x string) (y string)) (string<=? x y)) ss)))))))
      (define-concrete! 'string>? (at-least 1) (lambda ((a rf-vals)) (on-strings a (lambda ((ss strings)) (ok (rf-bool (chain (lambda ((x string) (y string)) (string>? x y)) ss)))))))
      (define-concrete! 'string>=? (at-least 1) (lambda ((a rf-vals)) (on-strings a (lambda ((ss strings)) (ok (rf-bool (chain (lambda ((x string) (y string)) (string>=? x y)) ss)))))))
      (define-concrete! 'string->list (exactly 1) (lambda ((a rf-vals)) (on-strings a (lambda ((ss strings)) (ok (rf-list (string-chars (car ss))))))))
      (define-concrete! 'string (at-least 0) chars->string)
      (define-concrete! 'number->string (between 1 2)
        (lambda ((a rf-vals))
          (if (rf-number? (car a))
              (ok (rf-str (number->string-radix (car a) (if (pair? (cdr a)) (rf-int-of (arg2 a)) 10))))
              (failed (string-append "number->string: not a number:  " (w (car a)))))))
      (define-concrete! 'string->number (between 1 2)
        (lambda ((a rf-vals))
          (tagcase (car a)
            (str s (tagcase (parse-number-radix s (if (pair? (cdr a)) (rf-int-of (arg2 a)) 10)) (some v (ok v)) (none u (ok rf-false))))
            (else x (not-a-string (car a))))))
      (define-concrete! 'string-copy (exactly 1) (lambda ((a rf-vals)) (on-strings a (lambda ((ss strings)) (ok (rf-str (substring (car ss) 0 (string-length (car ss)))))))))
      (define-concrete! 'char=? (at-least 1) (lambda ((a rf-vals)) (on-chars "char=?" a (lambda ((cs (listof char acyclic))) (ok (rf-bool (char-chain (lambda ((x int) (y int)) (= x y)) cs)))))))
      (define-concrete! 'char<? (at-least 1) (lambda ((a rf-vals)) (on-chars "char<?" a (lambda ((cs (listof char acyclic))) (ok (rf-bool (char-chain (lambda ((x int) (y int)) (< x y)) cs)))))))
      (define-concrete! 'char<=? (at-least 1) (lambda ((a rf-vals)) (on-chars "char<=?" a (lambda ((cs (listof char acyclic))) (ok (rf-bool (char-chain (lambda ((x int) (y int)) (<= x y)) cs)))))))
      (define-concrete! 'char>? (at-least 1) (lambda ((a rf-vals)) (on-chars "char>?" a (lambda ((cs (listof char acyclic))) (ok (rf-bool (char-chain (lambda ((x int) (y int)) (> x y)) cs)))))))
      (define-concrete! 'char>=? (at-least 1) (lambda ((a rf-vals)) (on-chars "char>=?" a (lambda ((cs (listof char acyclic))) (ok (rf-bool (char-chain (lambda ((x int) (y int)) (>= x y)) cs)))))))
      (define-concrete! 'char->integer (exactly 1) (lambda ((a rf-vals)) (on-char "char->integer" (car a) (lambda ((c char)) (ok (rf-int (char->integer c)))))))
      (define-concrete! 'integer->char (exactly 1)
        (lambda ((a rf-vals))
          (let ((n (car a)))
            (if (and (rf-exact-integer? n) (<= 0 (rf-int-of n)) (< (rf-int-of n) 1114112)
                     (not (and (<= 55296 (rf-int-of n)) (<= (rf-int-of n) 57343))))
                (ok (sum char (integer->char (rf-int-of n))))
                (failed (string-append "integer->char: illegal first argument: " (w n) "  is not a Unicode scalar value\n"))))))
      (define-concrete! 'char-upcase (exactly 1) (lambda ((a rf-vals)) (on-char "char->integer" (car a) (lambda ((c char)) (ok (sum char (char-upcase c)))))))
      (define-concrete! 'char-downcase (exactly 1) (lambda ((a rf-vals)) (on-char "char->integer" (car a) (lambda ((c char)) (ok (sum char (char-downcase c)))))))
      (define-concrete! 'char-alphabetic? (exactly 1) (lambda ((a rf-vals)) (on-char "char->integer" (car a) (lambda ((c char)) (ok (rf-bool (char-alphabetic? c)))))))
      (define-concrete! 'char-upper-case? (exactly 1) (lambda ((a rf-vals)) (on-char "char->integer" (car a) (lambda ((c char)) (ok (rf-bool (and (char-alphabetic? c) (char=? c (char-upcase c)) (not (char=? c (char-downcase c))))))))))
      (define-concrete! 'char-lower-case? (exactly 1) (lambda ((a rf-vals)) (on-char "char->integer" (car a) (lambda ((c char)) (ok (rf-bool (and (char-alphabetic? c) (char=? c (char-downcase c)) (not (char=? c (char-upcase c))))))))))
      (define-concrete! 'char-numeric? (exactly 1) (lambda ((a rf-vals)) (on-char "char->integer" (car a) (lambda ((c char)) (ok (rf-bool (char-numeric? c)))))))
      (define-concrete! 'char-whitespace? (exactly 1) (lambda ((a rf-vals)) (on-char "char->integer" (car a) (lambda ((c char)) (ok (rf-bool (char-whitespace? c)))))))
      (define-concrete! 'sqrt (exactly 1)
        (lambda ((a rf-vals)) (on-number "sqrt" (car a) (lambda ((v rf-value)) (if (< (num-sign v) 0) (failed "sqrt: complex results are not supported") (ok (num-sqrt v)))))))
      (define-concrete! 'exp (exactly 1) (lambda ((a rf-vals)) (on-number "exp" (car a) (lambda ((v rf-value)) (ok (sum real (f64-exp (->flonum v))))))))
      (define-concrete! 'log (between 1 2)
        (lambda ((a rf-vals))
          (on-number "log" (car a)
                     (lambda ((v rf-value))
                       (if (num-zero? v) (failed (string-append "log: domain error: " (w v)))
                           (if (pair? (cdr a))
                               (ok (sum real (f64/ (f64-log (->flonum v)) (f64-log (->flonum (arg2 a))))))
                               (ok (sum real (f64-log (->flonum v))))))))))
      (define-concrete! 'exact->inexact (exactly 1) (lambda ((a rf-vals)) (on-number "exact->inexact" (car a) (lambda ((v rf-value)) (ok (num-inexact v))))))
      (define-concrete! 'inexact (exactly 1) (lambda ((a rf-vals)) (on-number "inexact" (car a) (lambda ((v rf-value)) (ok (num-inexact v))))))
      (define-concrete! 'symbol=? (at-least 1)
        (lambda ((a rf-vals)) (ok (rf-bool (letrec ((go (subr rf-st (rf-vals) bool) (lambda (l) (or (null? l) (null? (cdr l)) (and (rf-eqv? (car l) (car (cdr l))) (go (cdr l))))))) (go a))))))
      (define-concrete! 'gcd (at-least 0) (lambda ((a rf-vals)) (ok (rf-int (letrec ((go (subr rf-st (rf-vals int) int) (lambda (l acc) (if (null? l) acc (go (cdr l) (gcd acc (rf-int-of (car l)))))))) (go a 0))))))
      (define-concrete! 'lcm (at-least 0)
        (lambda ((a rf-vals)) (ok (rf-int (letrec ((go (subr rf-st (rf-vals int) int)
                                                     (lambda (l acc) (if (null? l) acc
                                                                         (let ((x (iabs-n (rf-int-of (car l)))))
                                                                           (go (cdr l) (if (or (= x 0) (= acc 0)) 0 (quotient (* acc x) (gcd acc x)))))))))
                                             (go a 1))))))
      (define-concrete! 'exact-integer-sqrt (exactly 1)
        (lambda ((a rf-vals)) (let* ((n (rf-int-of (car a))) (s (isqrt n))) (ok (sum multiple (list (rf-int s) (rf-int (- n (* s s)))))))))
      (define-concrete! 'rationalize (exactly 2) (lambda ((a rf-vals)) (ok (car a))))
      (define-concrete! 'make-rectangular (exactly 2)
        (lambda ((a rf-vals)) (if (num-zero? (arg2 a)) (ok (car a)) (failed "make-rectangular: complex numbers are not supported"))))
      (define-concrete! 'make-polar (exactly 2)
        (lambda ((a rf-vals)) (if (num-zero? (arg2 a)) (ok (car a)) (failed "make-polar: complex numbers are not supported"))))
      (define-concrete! 'magnitude (exactly 1) (lambda ((a rf-vals)) (on-number "magnitude" (car a) (lambda ((v rf-value)) (ok (num-abs v))))))
      (define-concrete! 'angle (exactly 1)
        (lambda ((a rf-vals)) (on-number "angle" (car a) (lambda ((v rf-value)) (ok (if (< (num-sign v) 0) (sum real 3.141592653589793) (rf-int 0))))))))))

(define parse-number-radix (subr rf-st (string int) (sumof (none unit) (some rf-value)))
  (lambda (s radix)
    (if (= radix 10) (parse-number s)
        (parse-number (string-append (cond ((= radix 16) "#x") ((= radix 8) "#o") ((= radix 2) "#b") (else "")) s)))))

;;; ------------------------------------------------------------ the environment

"The environment ratfink runs in, as the program's: FX-26 cannot read it,
so bin/ratfink gives it (env -0's output, --environment)."
(define-type env-entry (productof (name string) (value string)))
(define environment (ref (listof env-entry acyclic) @rf) (new nil))
"Take the environment from text: NAME=VALUE entries, each ended by a NUL."
(define set-environment! (subr rf-st (string) unit)
  (lambda (text)
    (letrec ((loop (subr rf-st (int int (listof env-entry acyclic)) (listof env-entry acyclic))
               (lambda (i start acc)
                 (cond ((>= i (string-length text)) (the (listof env-entry acyclic) (reverse acc)))
                       ((= 0 (char->integer (string-ref text i)))
                        (let* ((entry (substring text start i))
                               (eq (letrec ((find (subr rf-st (int) int) (lambda (j) (cond ((>= j (string-length entry)) -1) ((char=? (string-ref entry j) #\=) j) (else (find (+ j 1)))))))
                                     (find 0))))
                          (loop (+ i 1) (+ i 1)
                                (if (< eq 0) acc
                                    (the (listof env-entry acyclic) (cons (product (name (substring entry 0 eq)) (value (substring entry (+ eq 1) (string-length entry)))) acc))))))
                       (else (loop (+ i 1) start acc))))))
      (set environment (loop 0 0 nil)))))
(define environment-variable (subr rf-st (string) rf-value)
  (lambda (name)
    (letrec ((find (subr rf-st ((listof env-entry acyclic)) rf-value)
               (lambda (l) (cond ((null? l) rf-false) ((string=? (extract (car l) name) name) (rf-str (extract (car l) value))) (else (find (cdr l)))))))
      (find (get environment)))))

;;; ------------------------------------------------------------ output and errors

"A value as shakedown shows it: terms with ? for their constants, unions
and symbol choices as #<union a | b>, and the rest as write writes it."
(define show (subr rf-eff (rf-value) string)
  (lambda (v)
    (datum-text v #f #f
                (lambda ((x rf-value))
                  (tagcase x
                    (term t (show (term->datum x (lambda ((k rf-value)) (rf-sym '?)))))
                    (union ms (string-append "#<union" (show-members ms) ">"))
                    (choice c (string-append "#<union" (show-members (tagcase (symbol-choice-members x) (some ms ms) (none u nil))) ">"))
                    (closure c "#<procedure>")
                    (prim p (string-append "#<primitive " (write-symbol-string (extract p name)) ">"))
                    (unspec u "#<unspecified>")
                    (multiple vs (string-append "#<values" (strings-concat (map (lambda ((v rf-value)) (string-append " " (show v))) vs)) ">"))
                    (else y (host-record-text y)))))))
(define show-members (subr rf-eff (rf-members) string)
  (lambda (ms)
    (letrec ((loop (subr rf-eff (rf-members string) strings)
               (lambda (ms sep) (if (null? ms) nil (cons (string-append sep (show (extract (car ms) v))) (loop (cdr ms) " | "))))))
      (strings-concat (loop ms " ")))))
"How Larceny writes what is not data in shakedown: its own records."
(define host-record-text (subr rf-st (rf-value) string) (lambda (v) (larceny-record-text v)))

(define install-other-primitives! (subr rf-st () unit)
  (lambda ()
    (begin
      (define-lifted! 'get-environment-variable (exactly 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (begin (if (rf-string? (car args)) #u (fail! ctx 'error (describe-call src "argument is not a string")))
                 (environment-variable (rf-str-of (car args))))))
      (define-primitive! 'values (at-least 0)
        (lambda ((ctx rf-ctx) (src rf-value) (vs rf-vals))
          (if (and (pair? vs) (null? (cdr vs))) (car vs) (sum multiple vs))))
      (define-primitive! 'error (at-least 0)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (raise! ctx
                  (make-error-value (if (pair? args) (car args) (rf-str "")) (if (pair? args) (rf-list (cdr args)) rf-nil)
                                    (rf-str (let ((words (map (lambda ((a rf-value)) (tagcase a (str s s) (else x (show a)))) args)))
                                              (if (null? words) ""
                                                  (string-append (car words) (strings-concat (map (lambda ((w string)) (string-append " " w)) (cdr words))))))))
                  #f rf-true)))
      (define-primitive! 'raise (exactly 1) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (raise! ctx (car args) #f rf-true)))
      (define-primitive! 'raise-continuable (exactly 1) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (raise! ctx (car args) #t rf-true)))
      (define-lifted! 'error-object? (exactly 1) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (rf-bool (error-value? (car args)))))
      (error-field 'error-object-message 0)
      (error-field 'error-object-irritants 1)
      (define-lifted! 'file-error? (exactly 1) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) rf-false))
      (define-lifted! 'read-error? (exactly 1) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) rf-false))
      (define-primitive! 'disjoint? (exactly 2)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (let* ((bs (footprint rf-true (arg2 args))) (as (footprint rf-true (car args))))
            (t-and* (apply-append-vals
                     (map (lambda ((x footprint-entry))
                            (map (lambda ((y footprint-entry))
                                   (tagcase (extract x obj)
                                     (some o (if (tagcase (extract y obj) (some p (eq? o p)) (none u #f))
                                                 (t-not (t-and (extract x g) (extract y g)))
                                                 rf-true))
                                     (none u rf-true)))
                                 bs))
                          as)))))))))
(define apply-append-vals (subr rf-st ((listof rf-vals acyclic)) rf-vals)
  (lambda (ls) (if (null? ls) nil (vals-append (car ls) (apply-append-vals (cdr ls))))))
(define error-field (subr rf-st (symbol int) unit)
  (lambda (name i)
    (define-lifted! name (exactly 1)
      (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
        (begin (if (error-value? (car args)) #u (fail! ctx 'error (describe-call src "argument is not an error object")))
               (array-ref (instance-fields (car args)) i))))))

;;; ------------------------------------------------------------ footprints, for contracts' modifies clauses

"The mutable objects v names, as (guard . slots-vector): v is a vector, a
record, or a list of them, under guard g. A member that is none of these
gives (guard . none)."
(define-type footprint-entry (productof (g rf-value) (obj (sumof (none unit) (some rf-slots)))))
(define-type footprint-entries (listof footprint-entry acyclic))
(define footprint (subr rf-eff (rf-value rf-value) footprint-entries)
  (lambda (g v)
    (letrec ((loop (subr rf-eff (rf-members) footprint-entries)
               (lambda (ms)
                 (if (null? ms) nil
                     (let ((g (extract (car ms) g)) (x (extract (car ms) v)))
                       (append (tagcase x
                                 (vec a (list (product (g g) (obj (sum some a)))))
                                 (inst i (list (product (g g) (obj (sum some (extract i fields))))))
                                 (pair p (let* ((a (footprint g (array-ref p 0))) (d (footprint g (array-ref p 1)))) (append a d)))
                                 (null u (the footprint-entries nil))
                                 (else y (list (product (g g) (obj (sum none #u))))))
                               (loop (cdr ms))))))))
      (loop (guarded-members g v)))))

"(old e) in a postcondition is the value e had on entry. Each (old e) in
the expressions xs is replaced by a variable; the new expressions, and a
list of (variable . e), in order."
(define-type old-entry (productof (var symbol) (expr rf-value)))
(define-type olds-result (productof (exprs rf-vals) (olds (listof old-entry acyclic))))
(define extract-olds (subr rf-eff (rf-vals) olds-result)
  (lambda (xs)
    (let ((olds (the (ref (listof old-entry acyclic) @rf) (new nil))))
      (letrec ((walk (subr rf-eff (rf-value) rf-value)
                 (lambda (x)
                   (cond ((not (rf-pair? x)) x)
                         ((rf-eqv? (rf-car x) (rf-sym 'quote)) x)
                         ((and (rf-eqv? (rf-car x) (rf-sym 'old)) (rf-pair? (rf-cdr x)) (rf-null? (rf-cddr x)))
                          (let ((v (string->symbol (string-append "ratfink-old-" (int->string (+ 1 (list-length (get olds))))))))
                            (begin (set olds (cons (product (var v) (expr (rf-cadr x))) (get olds)))
                                   (rf-sym v))))
                         (else (letrec ((loop (subr rf-eff (rf-value) rf-value)
                                          (lambda (x) (if (rf-pair? x) (let* ((a (walk (rf-car x))) (d (loop (rf-cdr x)))) (rf-cons a d)) x))))
                                 (loop x)))))))
        (let ((new (map walk xs)))
          (product (exprs new) (olds (the (listof old-entry acyclic) (reverse (get olds))))))))))

"Install the primitives (in shakedown's order: the table is its own, newest
first)."
(define install-primitives! (subr rf-st () unit)
  (lambda ()
    (begin
      (set primitive-table nil)
      (install-number-primitives!)
      (define-predicate! 'number? (lambda ((v rf-value)) (or (rf-number? v) (int-term? v))))
      (define-predicate! 'integer? (lambda ((v rf-value)) (or (num-integer? v) (int-term? v))))
      (define-predicate! 'exact-integer? int-like?)
      (define-predicate! 'rational? (lambda ((v rf-value)) (or (exact? v) (tagcase v (real r (f64-finite? r)) (else x #f)) (int-term? v))))
      (define-predicate! 'real? (lambda ((v rf-value)) (or (rf-number? v) (int-term? v))))
      (define-predicate! 'boolean? bool-like?)
      (define-predicate! 'pair? rf-pair?)
      (define-predicate! 'null? rf-null?)
      (define-predicate! 'symbol? symbol-like?)
      (define-predicate! 'string? rf-string?)
      (define-predicate! 'char? rf-char?)
      (define-predicate! 'vector? rf-vector?)
      (define-predicate! 'procedure? procedure-value?)
      (define-primitive! 'not (exactly 1) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (t-not (truth (car args)))))
      (define-primitive! 'eq? (exactly 2) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (eqv-value (car args) (arg2 args))))
      (define-primitive! 'eqv? (exactly 2) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (eqv-value (car args) (arg2 args))))
      (define-primitive! 'equal? (exactly 2) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (equal-value (car args) (arg2 args))))
      (define-primitive! 'cons (exactly 2) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (rf-cons (car args) (arg2 args))))
      (define-primitive! 'list (at-least 0) (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (rf-list args)))
      (for-each define-cxr! (list 'car 'cdr 'caar 'cadr 'cdar 'cddr 'caaar 'caadr 'cadar 'caddr 'cdaar 'cdadr 'cddar 'cdddr 'cadddr 'cddddr))
      (define-pair-setter! 'set-car! 0)
      (define-pair-setter! 'set-cdr! 1)
      (define-primitive! 'list? (exactly 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (letrec ((walk (subr rf-eff (rf-value) rf-value)
                     (lambda (l) (tagcase l (null u rf-true) (pair p (walk (array-ref p 1))) (union ms (over-members l walk)) (else x rf-false)))))
            (walk (car args)))))
      (define-primitive! 'length (exactly 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (spine ctx src (car args) (lambda ((ctx rf-ctx) (xs rf-vals)) (rf-int (list-length xs))))))
      (define-primitive! 'reverse (exactly 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (spine ctx src (car args) (lambda ((ctx rf-ctx) (xs rf-vals)) (rf-list (vals-reverse xs))))))
      (define-primitive! 'list-copy (exactly 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (spine ctx src (car args) (lambda ((ctx rf-ctx) (xs rf-vals)) (rf-list xs)))))
      (define-primitive! 'append (at-least 0)
        (lambda ((ctx rf-ctx) (src rf-value) (ls rf-vals))
          (cond ((null? ls) rf-nil)
                ((null? (cdr ls)) (car ls))
                (else (spine ctx src (car ls)
                             (lambda ((ctx rf-ctx) (xs rf-vals))
                               (rf-append2 (rf-list xs) ((prim-proc (primitive-named 'append)) ctx (cdr ls) src))))))))
      (define-primitive! 'list-ref (exactly 2)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (spine ctx src (car args) (lambda ((ctx rf-ctx) (xs rf-vals)) (select ctx src xs (arg2 args))))))
      (define-primitive! 'list-tail (exactly 2)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (let ((l (car args)))
            (lift ctx (list (arg2 args))
                  (lambda ((ctx rf-ctx) (ks rf-vals))
                    (let ((k (car ks)))
                      (if (rf-exact-integer? k)
                          (letrec ((loop (subr rf-eff (rf-ctx rf-value int) rf-value)
                                     (lambda (ctx l k)
                                       (cond ((= k 0) l)
                                             ((rf-pair? l) (loop ctx (rf-cdr l) (- k 1)))
                                             ((rf-union? l) (join-union ctx l (lambda ((ctx rf-ctx) (v rf-value)) (loop ctx v k))))
                                             (else (begin (fail! ctx 'error (describe-call src "index out of range")) rf-unspecified))))))
                            (loop ctx l (rf-int-of k)))
                          ;; At a symbolic index, the one of its tails the index picks.
                          (letrec ((walk (subr rf-eff (rf-ctx rf-value rf-vals) rf-value)
                                     (lambda (ctx l tails)
                                       (cond ((rf-pair? l) (walk ctx (rf-cdr l) (cons l tails)))
                                             ((rf-union? l) (join-union ctx l (lambda ((ctx rf-ctx) (v rf-value)) (walk ctx v tails))))
                                             (else (select ctx src (vals-reverse (cons l tails)) k))))))
                            (walk ctx l nil)))))))))
      (define-primitive! 'vector (at-least 0) (lambda ((ctx rf-ctx) (src rf-value) (xs rf-vals)) (new-vector xs)))
      ;; Of a length that is a choice of a few integers, a vector of each, in a join.
      (define-lifted! 'make-vector (between 1 2)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (let ((n (car args)) (fill (if (pair? (cdr args)) (arg2 args) (rf-int 0))))
            (begin
              (check-integer-args ctx src (list n))
              (let ((make (lambda ((ctx rf-ctx) (n int))
                            (begin (check! ctx 'error (describe-call src "negative length") (rf-bool (<= 0 n)))
                                   (sum vec (note-allocation! (the rf-slots (make-array n fill))))))))
                (cond ((rf-exact-integer? n) (make ctx (rf-int-of n)))
                      (else (tagcase (integer-cases n)
                              (some cs (join ctx (map (lambda ((c a-case)) (make-arm (extract c cond) (lambda ((ctx rf-ctx)) (make ctx (extract c value))))) cs) #f))
                              (none u (begin (fail! ctx 'unsupported (describe-call src "vector of symbolic length")) rf-unspecified))))))))))
      (define-lifted! 'vector-length (exactly 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (rf-int (array-length (vector-arg ctx src (car args))))))
      (define-lifted! 'vector-ref (exactly 2)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (select-from ctx src (vector-arg ctx src (car args)) (arg2 args))))
      (define-lifted! 'vector-set! (exactly 3)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (let* ((v (vector-arg ctx src (car args))) (n (array-length v)) (i (arg2 args)) (x (arg3 args)))
            (begin
              (check-integer-args ctx src (list i))
              (check! ctx 'error (describe-call src "index out of range") (let* ((lo (t-<= (rf-int 0) i)) (hi (t-< i (rf-int n)))) (t-and lo hi)))
              (cond ((rf-exact-integer? i) (write! ctx v (rf-int-of i) x))
                    (else
                     (tagcase (index-cases i n)
                       (some cs (for-each (lambda ((c a-case)) (write! ctx v (extract c value) (merge (extract c cond) x (array-ref v (extract c value))))) cs))
                       (none u (letrec ((loop (subr rf-eff (int) unit)
                                          (lambda (j) (if (= j n) #u
                                                          (begin (write! ctx v j (let ((c (t-= i (rf-int j)))) (merge c x (array-ref v j)))) (loop (+ j 1)))))))
                                 (loop 0))))))
              rf-unspecified))))
      (define-lifted! 'vector-fill! (exactly 2)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (let ((v (vector-arg ctx src (car args))))
            (letrec ((loop (subr rf-eff (int) rf-value) (lambda (j) (if (= j (array-length v)) rf-unspecified (begin (write! ctx v j (arg2 args)) (loop (+ j 1)))))))
              (loop 0)))))
      (define-lifted! 'vector-copy (between 1 3)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (let ((r (vector-range ctx src (car args) (cdr args))))
            (new-vector (slots->vals (rf-slots-of (car args)) (extract r start) (extract r end))))))
      (define-lifted! 'vector-copy! (between 3 5)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (let* ((to (car args)) (at (arg2 args)) (from (arg3 args))
                 (r (vector-range ctx src from (cdr (cdr (cdr args))))))
            (begin
              (if (rf-exact-integer? at) #u (fail! ctx 'unsupported (describe-call src "symbolic index")))
              (check! ctx 'error (describe-call src "index out of range")
                      (rf-bool (and (<= 0 (rf-int-of at)) (<= (rf-int-of at) (- (array-length (vector-arg ctx src to)) (- (extract r end) (extract r start)))))))
              (letrec ((loop (subr rf-eff (int rf-vals) unit)
                         (lambda (i xs) (if (null? xs) #u (begin (write! ctx (rf-slots-of to) i (car xs)) (loop (+ i 1) (cdr xs)))))))
                (loop (rf-int-of at) (slots->vals (rf-slots-of from) (extract r start) (extract r end))))
              rf-unspecified))))
      (define-lifted! 'vector-append (at-least 0)
        (lambda ((ctx rf-ctx) (src rf-value) (vs rf-vals))
          (begin (for-each (lambda ((v rf-value)) (begin (vector-arg ctx src v) #u)) vs)
                 (new-vector (apply-append-vals (map (lambda ((v rf-value)) (slots-list (rf-slots-of v))) vs))))))
      (define-lifted! 'vector->list (exactly 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (rf-list (slots-list (vector-arg ctx src (car args))))))
      (define-primitive! 'list->vector (exactly 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals)) (spine ctx src (car args) (lambda ((ctx rf-ctx) (xs rf-vals)) (new-vector xs)))))
      (define-lifted! 'string->vector (between 1 3)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (let ((v (apply-concrete ctx src
                                   (lambda ((a rf-vals))
                                     (tagcase (car a)
                                       (str s (let* ((n (string-length s))
                                                     (i (if (pair? (cdr a)) (rf-int-of (arg2 a)) 0))
                                                     (j (if (and (pair? (cdr a)) (pair? (cdr (cdr a)))) (rf-int-of (arg3 a)) n)))
                                                (ok (rf-list (string-chars (substring s i j))))))
                                       (else x (not-a-string (car a)))))
                                   args)))
            (new-vector (rf-elements v)))))
      ;; Of a vector that may hold choices of characters: once for each choice.
      (define-lifted! 'vector->string (between 1 3)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (let* ((v (vector-arg ctx src (car args)))
                 (i (if (pair? (cdr args)) (rf-int-of (arg2 args)) 0))
                 (j (if (and (pair? (cdr args)) (pair? (cdr (cdr args)))) (rf-int-of (arg3 args)) (array-length v))))
            (lift ctx (slots->vals v i j) (lambda ((ctx rf-ctx) (cs rf-vals)) (apply-concrete ctx src list->string-host (list (rf-list cs))))))))
      (install-concrete-primitives!)
      ;; Of a list of characters that may be choices: once for each choice.
      (define-primitive! 'list->string (exactly 1)
        (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
          (spine ctx src (car args)
                 (lambda ((ctx rf-ctx) (cs rf-vals))
                   (lift ctx cs (lambda ((ctx rf-ctx) (cs rf-vals)) (apply-concrete ctx src list->string-host (list (rf-list cs)))))))))
      (install-other-primitives!))))

"A pair's car and cdr are slots of the store."
(define define-pair-setter! (subr rf-st (symbol int) unit)
  (lambda (name i)
    (define-primitive! name (exactly 2)
      (lambda ((ctx rf-ctx) (src rf-value) (args rf-vals))
        (lift ctx (list (car args))
              (lambda ((ctx rf-ctx) (ps rf-vals))
                (begin
                  (if (rf-pair? (car ps)) #u (fail! ctx 'error (describe-call src "argument is not a pair")))
                  (write! ctx (rf-slots-of (car ps)) i (arg2 args))
                  rf-unspecified)))))))

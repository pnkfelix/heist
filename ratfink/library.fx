;;; library.fx: R7RS libraries' declarations, import sets and files:
;;; shakedown's `(shakedown library)`. eval.fx gives libraries their
;;; environments; this is the part that is only about forms.

(module-parameters ((m-core (load-moduleof "core.fx")) (m-print (load-moduleof "print.fx" m-core))
                    (m-syntax (load-moduleof "syntax.fx" m-core m-print))
                    (m-numbers (load-moduleof "numbers.fx" m-core))
                    (m-reader (load-moduleof "reader.fx" m-core m-numbers))))

"The directories to look for libraries in."
(define the-library-path (ref strings @rf) (new (list ".")))
(define library-path (subr rf-st () strings) (lambda () (get the-library-path)))
(define set-library-path! (subr rf-st (strings) unit) (lambda (dirs) (set the-library-path dirs)))

(define library-features symbols (list 'r7rs 'exact-closed 'exact-complex 'ratios 'full-unicode 'larceny 'ratfink))

"Libraries ratfink has itself: their names are all its primitives and
prelude, whichever of them is imported."
(define builtin-library? (subr rf-st (rf-value) bool)
  (lambda (name)
    (and (rf-pair? name)
         (symbols-member? (rf-sym-of (rf-car name)) (list 'scheme 'srfi 'rnrs 'larceny 'primitives)))))

(define part->string (subr rf-eff (rf-value) string)
  (lambda (p) (tagcase p (sym s (symbol->string s)) (else x (datum->string p)))))
"The file of library name, dir/part/.../last.sld (or .scm), in the first
directory of the library path that has one; or \"\"."
(define find-library-file (subr rf-eff (rf-value) string)
  (lambda (name)
    (let ((stem (letrec ((loop (subr rf-eff (rf-value string) string)
                           (lambda (parts acc)
                             (if (not (rf-pair? parts)) acc
                                 (loop (rf-cdr parts) (string-append acc (if (string=? acc "") "" "/") (part->string (rf-car parts))))))))
                  (loop name ""))))
      (letrec ((loop (subr rf-eff (strings) string)
                 (lambda (dirs)
                   (if (null? dirs) ""
                       (let ((sld (string-append (car dirs) "/" stem ".sld"))
                             (scm (string-append (car dirs) "/" stem ".scm")))
                         (cond ((file-exists? sld) sld)
                               ((file-exists? scm) scm)
                               (else (loop (cdr dirs)))))))))
        (loop (get the-library-path))))))

(define read-forms (subr rf-eff (string) rf-vals) (lambda (file) (read-file-data file #f)))

(define all-strings? (subr rf-st (rf-value) bool)
  (lambda (l) (tagcase l (null u #t) (pair p (and (rf-string? (array-ref p 0)) (all-strings? (array-ref p 1)))) (else x #f))))

(define directory-of (subr rf-st (string) string)
  (lambda (file)
    (letrec ((loop (subr rf-st (int) string)
               (lambda (i) (cond ((< i 0) ".") ((char=? (string-ref file i) #\/) (substring file 0 i)) (else (loop (- i 1)))))))
      (loop (- (string-length file) 1)))))
(define resolve-file (subr rf-st (string string) string)
  (lambda (dir f) (if (and (> (string-length f) 0) (char=? (string-ref f 0) #\/)) f (string-append dir "/" f))))

"The forms of (include file …), (include-ci file …) or (load file), each
file relative to the directory of the file x was read from."
(define included-forms (subr rf-eff (rf-value syntax-error-proc) rf-vals)
  (lambda (x error)
    (let ((load? (keyword? (rf-car x) 'load)))
      (begin
        (if (not (and (rf-list? x) (rf-pair? (rf-cdr x)) (all-strings? (rf-cdr x))
                      (or (not load?) (rf-null? (rf-cddr x)))))
            (error (if load? "load is supported only at the top level, of a string" "bad include (expected file names)") (strip x))
            #u)
        (let ((dir (let ((file (source-file x))) (if (string=? file "") "." (directory-of file))))
              (ci? (keyword? (rf-car x) 'include-ci)))
          (apply-append-forms (map (lambda ((f rf-value)) (read-file-data (resolve-file dir (rf-str-of f)) ci?)) (rf-elements (rf-cdr x)))))))))
(define apply-append-forms (subr rf-st ((listof rf-vals acyclic)) rf-vals)
  (lambda (ls) (if (null? ls) nil (vals-append (car ls) (apply-append-forms (cdr ls))))))

"A library's declarations with include, include-ci and
include-library-declarations done (relative to dir) and cond-expand
chosen: a list of export, import and begin forms."
(define expand-declarations (subr rf-eff (rf-vals string (subr rf-eff (rf-value) bool) syntax-error-proc) rf-vals)
  (lambda (decls dir known? error)
    (letrec ((loop (subr rf-eff (rf-vals rf-vals) rf-vals)
               (lambda (decls acc)
                 (if (null? decls) (vals-reverse acc)
                     (let ((d (car decls)))
                       (begin
                         (if (and (rf-pair? d) (rf-symbol? (rf-car d)) (rf-list? d)) #u (error "bad library declaration" d))
                         (let ((head (strip-name (rf-sym-of (rf-car d)))))
                           (cond ((or (eq? head 'export) (eq? head 'import) (eq? head 'begin)) (loop (cdr decls) (cons d acc)))
                                 ((or (eq? head 'include) (eq? head 'include-ci))
                                  (loop (cdr decls)
                                        (cons (rf-cons (rf-sym 'begin)
                                                       (rf-list (apply-append-forms
                                                                 (map (lambda ((f rf-value)) (read-file-data (resolve-file dir (rf-str-of f)) (eq? head 'include-ci)))
                                                                      (rf-elements (rf-cdr d))))))
                                              acc)))
                                 ((eq? head 'include-library-declarations)
                                  (loop (vals-append (apply-append-forms (map (lambda ((f rf-value)) (read-forms (resolve-file dir (rf-str-of f))))
                                                                              (rf-elements (rf-cdr d))))
                                                     (cdr decls))
                                        acc))
                                 ((eq? head 'cond-expand)
                                  (loop (vals-append (cond-expand-choice (rf-cdr d) known? error) (cdr decls)) acc))
                                 (else (begin (error "unknown library declaration" d) nil))))))))))
      (loop decls nil))))

"The forms of the first clause of a cond-expand whose requirement holds."
(define cond-expand-choice (subr rf-eff (rf-value (subr rf-eff (rf-value) bool) syntax-error-proc) rf-vals)
  (lambda (clauses known? error)
    (letrec ((holds? (subr rf-eff (rf-value) bool)
               (lambda (req)
                 (cond ((rf-symbol? req)
                        (let ((s (strip-name (rf-sym-of req)))) (or (eq? s 'else) (symbols-member? s library-features))))
                       ((and (rf-pair? req) (rf-symbol? (rf-car req)))
                        (let ((h (strip-name (rf-sym-of (rf-car req)))))
                          (cond ((eq? h 'and) (letrec ((all (subr rf-eff (rf-value) bool) (lambda (rs) (or (not (rf-pair? rs)) (and (holds? (rf-car rs)) (all (rf-cdr rs)))))))
                                                (all (rf-cdr req))))
                                ((eq? h 'or) (letrec ((any (subr rf-eff (rf-value) bool) (lambda (rs) (and (rf-pair? rs) (or (holds? (rf-car rs)) (any (rf-cdr rs)))))))
                                               (any (rf-cdr req))))
                                ((eq? h 'not) (not (holds? (rf-cadr req))))
                                ((eq? h 'library) (known? (strip (rf-cadr req))))
                                (else (begin (error "bad cond-expand requirement" req) #f)))))
                       (else (begin (error "bad cond-expand requirement" req) #f)))))
             (loop (subr rf-eff (rf-value) rf-vals)
               (lambda (clauses)
                 (cond ((not (rf-pair? clauses)) nil)
                       ((not (rf-pair? (rf-car clauses))) (begin (error "bad cond-expand clause" (rf-car clauses)) nil))
                       ((holds? (rf-caar clauses)) (rf-elements (rf-cdar clauses)))
                       (else (loop (rf-cdr clauses)))))))
      (loop clauses))))

(define import-modifier? (subr rf-st (rf-value) bool)
  (lambda (set)
    (and (rf-pair? set) (rf-symbol? (rf-car set))
         (symbols-member? (strip-name (rf-sym-of (rf-car set))) (list 'only 'except 'prefix 'rename))
         (rf-pair? (rf-cdr set)) (rf-pair? (rf-cadr set)))))
"The library an import set imports from."
(define import-set-library (subr rf-eff (rf-value syntax-error-proc) rf-value)
  (lambda (set error)
    (if (import-modifier? set)
        (import-set-library (rf-cadr set) error)
        (if (rf-list? set) (strip set) (begin (error "bad import set" set) rf-nil)))))

"What an import set binds: (name . exported name)s, given the names the
library exports."
(define-type binding-name (productof (local symbol) (name symbol)))
(define-type binding-names (listof binding-name acyclic))
(define bn-assq (subr rf-st (symbol binding-names) bool)
  (lambda (n l) (and (pair? l) (or (eq? (extract (car l) local) n) (bn-assq n (cdr l))))))
(define import-set-names (subr rf-eff (rf-value symbols syntax-error-proc) binding-names)
  (lambda (set exported error)
    (if (import-modifier? set)
        (let* ((inner (import-set-names (rf-cadr set) exported error))
               (args (rf-elements (strip (rf-cddr set))))
               (head (strip-name (rf-sym-of (rf-car set)))))
          (cond ((eq? head 'only)
                 (begin
                   (for-each (lambda ((n rf-value)) (if (bn-assq (rf-sym-of n) inner) #u (error "not exported, for only:" n))) args)
                   (filter (lambda ((b binding-name)) (memq-val? (rf-sym (extract b local)) args)) inner)))
                ((eq? head 'except)
                 (begin
                   (for-each (lambda ((n rf-value)) (if (bn-assq (rf-sym-of n) inner) #u (error "not exported, for except:" n))) args)
                   (filter (lambda ((b binding-name)) (not (memq-val? (rf-sym (extract b local)) args))) inner)))
                ((eq? head 'prefix)
                 (map (lambda ((b binding-name))
                        (product (local (string->symbol (string-append (symbol->string (rf-sym-of (car args))) (symbol->string (extract b local)))))
                                 (name (extract b name))))
                      inner))
                (else
                 (map (lambda ((b binding-name))
                        (letrec ((find (subr rf-st (rf-vals) binding-name)
                                   (lambda (rs) (cond ((null? rs) b)
                                                      ((rf-eqv? (rf-car (car rs)) (rf-sym (extract b local)))
                                                       (product (local (rf-sym-of (rf-cadr (car rs)))) (name (extract b name))))
                                                      (else (find (cdr rs)))))))
                          (find args)))
                      inner))))
        (map (lambda ((n symbol)) (product (local n) (name n))) exported))))

"A library's export specs, as (exported name . own name)s."
(define parse-exports (subr rf-eff (rf-vals syntax-error-proc) binding-names)
  (lambda (specs error)
    (map (lambda ((s rf-value))
           (cond ((rf-symbol? s) (product (local (strip-name (rf-sym-of s))) (name (strip-name (rf-sym-of s)))))
                 ((and (rf-pair? s) (keyword? (rf-car s) 'rename) (= (rf-length s) 3))
                  (product (local (strip-name (rf-sym-of (rf-caddr s)))) (name (strip-name (rf-sym-of (rf-cadr s))))))
                 (else (begin (error "bad export spec" s) (product (local '||) (name '||))))))
         specs)))

"The names forms define at top level, as variables and macros: define,
define-values, define-record-type, define/contract, define-proof,
define-syntax, in begin and include too (not through macro uses)."
(define-type defined (productof (vars symbols) (macros symbols)))
(define defined-names (subr rf-eff (rf-vals syntax-error-proc) defined)
  (lambda (forms error)
    (letrec ((loop (subr rf-eff (rf-vals symbols symbols) defined)
               (lambda (forms vars macros)
                 (if (null? forms)
                     (product (vars (symbols-reverse vars)) (macros (symbols-reverse macros)))
                     (let* ((f (car forms))
                            (head (if (and (rf-pair? f) (rf-symbol? (rf-car f))) (strip-name (rf-sym-of (rf-car f))) '||)))
                       (cond ((eq? head 'begin) (loop (vals-append (rf-elements (rf-cdr f)) (cdr forms)) vars macros))
                             ((or (eq? head 'include) (eq? head 'include-ci))
                              (loop (vals-append (included-forms f error) (cdr forms)) vars macros))
                             ((or (eq? head 'define) (eq? head 'define/contract) (eq? head 'define-proof))
                              (letrec ((name (subr rf-eff (rf-value) defined)
                                         (lambda (t)
                                           (cond ((rf-symbol? t) (loop (cdr forms) (cons (strip-name (rf-sym-of t)) vars) macros))
                                                 ((rf-pair? t) (name (rf-car t)))
                                                 (else (loop (cdr forms) vars macros))))))
                                (name (if (rf-pair? (rf-cdr f)) (rf-cadr f) rf-false))))
                             ((eq? head 'define-values)
                              (loop (cdr forms)
                                    (if (rf-pair? (rf-cdr f))
                                        (letrec ((names (subr rf-eff (rf-value symbols) symbols)
                                                   (lambda (t vars)
                                                     (cond ((rf-symbol? t) (cons (strip-name (rf-sym-of t)) vars))
                                                           ((rf-pair? t) (names (rf-cdr t) (if (rf-symbol? (rf-car t)) (cons (strip-name (rf-sym-of (rf-car t))) vars) vars)))
                                                           (else vars)))))
                                          (names (rf-cadr f) vars))
                                        vars)
                                    macros))
                             ((eq? head 'define-syntax)
                              (loop (cdr forms) vars (if (and (rf-pair? (rf-cdr f)) (rf-symbol? (rf-cadr f))) (cons (strip-name (rf-sym-of (rf-cadr f))) macros) macros)))
                             ((eq? head 'define-record-type)
                              (loop (cdr forms) (append (symbols-reverse (record-type-names (strip f))) vars) macros))
                             (else (loop (cdr forms) vars macros))))))))
      (loop forms nil nil))))

(define record-type-names (subr rf-eff (rf-value) symbols)
  (lambda (form)
    (if (< (rf-length form) 4) nil
        (let ((ctor (rf-caddr form)))
          (append (cond ((rf-pair? ctor) (list (rf-sym-of (rf-car ctor)))) ((rf-symbol? ctor) (list (rf-sym-of ctor))) (else nil))
                  (list (rf-sym-of (rf-cadddr form)))
                  (apply-append-symbols (map (lambda ((spec rf-value)) (if (rf-pair? spec) (map (lambda ((s rf-value)) (rf-sym-of s)) (rf-elements (rf-cdr spec))) nil))
                                             (rf-elements (rf-cddddr form)))))))))
(define apply-append-symbols (subr rf-st ((listof symbols acyclic)) symbols)
  (lambda (ls) (if (null? ls) nil (append (car ls) (apply-append-symbols (cdr ls))))))

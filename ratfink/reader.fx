;;; reader.fx: reading programs with the place of each list, for reports:
;;; shakedown's `(shakedown reader)`.
;;;
;;; read-file reads a file's data as Scheme's read does, and notes the file
;;; and line of each list (each pair it makes) in a table keyed by the pair,
;;; which source-location looks up: the lists are the program's forms,
;;; which evaluation keeps (macros and rewrites make new lists around
;;; them). shakedown reads the structure itself and gives each atom's text
;;; to Larceny's read; here atoms are read as Larceny reads them (numbers,
;;; characters, strings, booleans, symbols, with #!fold-case for
;;; include-ci).

(module-parameters ((m-core (load-moduleof "core.fx")) (m-numbers (load-moduleof "numbers.fx" m-core))))

;;; ------------------------------------------------------------ places

"Pairs to \"file:line\"."
(define locations (ref (eqtable rf-slots string @rf @rf) @rf)
  (new (the (eqtable rf-slots string @rf @rf) (make-eqtable (array-identity)))))
(define reset-locations! (subr rf-st () unit)
  (lambda () (set locations (the (eqtable rf-slots string @rf @rf) (make-eqtable (array-identity))))))

"Where a list was read, \"file:line\", or \"\"."
(define source-location (subr rf-st (rf-value) string)
  (lambda (x) (tagcase x (pair p (eqtable-ref (get locations) p "")) (else y ""))))
"The file x was read from, or \"\"."
(define source-file (subr rf-st (rf-value) string)
  (lambda (x)
    (let ((at (source-location x)))
      (letrec ((loop (subr rf-st (int) string)
                 (lambda (i) (cond ((< i 0) "") ((char=? (string-ref at i) #\:) (substring at 0 i)) (else (loop (- i 1)))))))
        (loop (- (string-length at) 1))))))

;;; ------------------------------------------------------------ atoms

(define digit-value (subr rf-st (char int) int)
  (lambda (c radix)
    (let* ((n (char->integer c))
           (d (cond ((and (>= n 48) (<= n 57)) (- n 48))
                    ((and (>= n 97) (<= n 102)) (- n 87))
                    ((and (>= n 65) (<= n 70)) (- n 55))
                    (else 99))))
      (if (< d radix) d -1))))
(define exact->flonum (subr rf-st (rf-value) f64) (lambda (v) (->flonum v)))

"The integer of digits s[i..j) in radix, or none."
(define parse-digits (subr rf-st (string int int int) (sumof (none unit) (some int)))
  (lambda (s i j radix)
    (if (>= i j) (sum none #u)
        (letrec ((go (subr rf-st (int int) (sumof (none unit) (some int)))
                   (lambda (k acc)
                     (if (>= k j) (sum some acc)
                         (let ((d (digit-value (string-ref s k) radix)))
                           (if (< d 0) (sum none #u) (go (+ k 1) (+ (* acc radix) d))))))))
          (go i 0)))))

"Whether s[i..j) is a decimal: digits, a point, digits (one at least in
all), then an exponent."
(define decimal? (subr rf-st (string int int) bool)
  (lambda (s i j)
    (letrec ((digits (subr rf-st (int) int)
               (lambda (k) (if (and (< k j) (char-numeric? (string-ref s k))) (digits (+ k 1)) k))))
      (let* ((a (digits i))
             (b (if (and (< a j) (char=? (string-ref s a) #\.)) (digits (+ a 1)) a))
             (some-digits (or (> a i) (> b (+ a 1)))))
        (and some-digits
             (or (= b j)
                 (and (or (char=? (string-ref s b) #\e) (char=? (string-ref s b) #\E))
                      (let* ((c (+ b 1))
                             (c (if (and (< c j) (or (char=? (string-ref s c) #\+) (char=? (string-ref s c) #\-))) (+ c 1) c)))
                        (and (< c j) (= (digits c) j))))))))))

"A decimal s[i..j) as an exact rational."
(define decimal->exact (subr rf-st (string int int) rf-value)
  (lambda (s i j)
    (letrec ((go (subr rf-st (int int int bool) rf-value)
               ;; mantissa so far, digits after the point, in the fraction?
               (lambda (k m scale frac?)
                 (if (>= k j) (make-ratio m (expt10 scale))
                     (let ((c (string-ref s k)))
                       (cond ((char=? c #\.) (go (+ k 1) m scale #t))
                             ((or (char=? c #\e) (char=? c #\E))
                              (let ((e (tagcase (parse-signed s (+ k 1) j) (some e e) (none u 0))))
                                (if (>= e scale) (make-ratio (* m (expt10 (- e scale))) 1) (make-ratio m (expt10 (- scale e))))))
                             (else (go (+ k 1) (+ (* m 10) (digit-value c 10)) (if frac? (+ scale 1) scale) frac?))))))))
      (go i 0 0 #f))))
(define expt10 (subr rf-st (int) int) (lambda (k) (if (<= k 0) 1 (* 10 (expt10 (- k 1))))))
(define parse-signed (subr rf-st (string int int) (sumof (none unit) (some int)))
  (lambda (s i j)
    (cond ((>= i j) (sum none #u))
          ((char=? (string-ref s i) #\-) (tagcase (parse-digits s (+ i 1) j 10) (some n (sum some (- 0 n))) (none u (sum none #u))))
          ((char=? (string-ref s i) #\+) (parse-digits s (+ i 1) j 10))
          (else (parse-digits s i j 10)))))

"The number s is, or none."
(define parse-number (subr rf-st (string) (sumof (none unit) (some rf-value)))
  (lambda (s)
    (letrec ((prefixes (subr rf-st (int int int) (sumof (none unit) (some rf-value)))
               ;; i: where we are; radix; exactness: 0 none, 1 exact, 2 inexact.
               (lambda (i radix exactness)
                 (if (and (< (+ i 1) (string-length s)) (char=? (string-ref s i) #\#))
                     (let ((c (char-downcase (string-ref s (+ i 1)))))
                       (cond ((char=? c #\x) (prefixes (+ i 2) 16 exactness))
                             ((char=? c #\b) (prefixes (+ i 2) 2 exactness))
                             ((char=? c #\o) (prefixes (+ i 2) 8 exactness))
                             ((char=? c #\d) (prefixes (+ i 2) 10 exactness))
                             ((char=? c #\e) (prefixes (+ i 2) radix 1))
                             ((char=? c #\i) (prefixes (+ i 2) radix 2))
                             (else (sum none #u))))
                     (body i radix exactness))))
             (body (subr rf-st (int int int) (sumof (none unit) (some rf-value)))
               (lambda (i radix exactness)
                 (let* ((j (string-length s))
                        (rest (substring s i j)))
                   (cond ((string=? rest "+inf.0") (sum some (sum real (f64/ 1.0 0.0))))
                         ((string=? rest "-inf.0") (sum some (sum real (f64/ -1.0 0.0))))
                         ((or (string=? rest "+nan.0") (string=? rest "-nan.0")) (sum some (sum real (f64/ 0.0 0.0))))
                         ((>= i j) (sum none #u))
                         (else
                          (let* ((neg (char=? (string-ref s i) #\-))
                                 (k (if (or neg (char=? (string-ref s i) #\+)) (+ i 1) i))
                                 (slash (index-from s #\/ k)))
                            (cond ((>= k j) (sum none #u))
                                  ((>= slash 0)
                                   (tagcase (parse-digits s k slash radix)
                                     (none u (sum none #u))
                                     (some n (tagcase (parse-digits s (+ slash 1) j radix)
                                               (none u (sum none #u))
                                               (some d (if (= d 0) (sum none #u)
                                                           (exactness-of (make-ratio (if neg (- 0 n) n) d) exactness)))))))
                                  (else
                                   (tagcase (parse-digits s k j radix)
                                     (some n (exactness-of (rf-int (if neg (- 0 n) n)) exactness))
                                     (none u
                                       (if (and (= radix 10) (decimal? s k j))
                                           (if (= exactness 1)
                                               (let ((q (decimal->exact s k j)))
                                                 (sum some (if neg (negate q) q)))
                                               (let ((fs (the (listof f64 acyclic) (string->f64 (substring s i j)))))
                                                 (if (null? fs) (sum none #u) (sum some (sum real (car fs))))))
                                           (sum none #u)))))))))))))
      (prefixes 0 10 0))))
(define negate (subr rf-st (rf-value) rf-value)
  (lambda (v) (tagcase v (int i (rf-int (- 0 i))) (ratio q (make-ratio (- 0 (extract q num)) (extract q den))) (else x v))))
(define exactness-of (subr rf-st (rf-value int) (sumof (none unit) (some rf-value)))
  (lambda (v exactness) (sum some (if (= exactness 2) (sum real (exact->flonum v)) v))))
(define index-from (subr rf-st (string char int) int)
  (lambda (s c i) (cond ((>= i (string-length s)) -1) ((char=? (string-ref s i) c) i) (else (index-from s c (+ i 1))))))

(define char-named (subr rf-st (string) int)
  (lambda (n)
    (cond ((string=? n "space") 32) ((string=? n "newline") 10) ((string=? n "tab") 9)
          ((or (string=? n "nul") (string=? n "null")) 0) ((string=? n "alarm") 7)
          ((string=? n "backspace") 8) ((or (string=? n "delete") (string=? n "rubout")) 127)
          ((or (string=? n "escape") (string=? n "altmode")) 27) ((string=? n "linefeed") 10)
          ((string=? n "page") 12) ((string=? n "return") 13)
          (else -1))))

"The text of a string or |symbol| between its delimiters, with its escapes."
(define unescape (subr rf-st (string int int) string)
  (lambda (s i j)
    (letrec ((go (subr rf-st (int (listof char acyclic)) (listof char acyclic))
               (lambda (k acc)
                 (if (>= k j) acc
                     (let ((c (string-ref s k)))
                       (if (and (char=? c #\\) (< (+ k 1) j))
                           (let ((d (string-ref s (+ k 1))))
                             (cond ((char=? d #\a) (go (+ k 2) (cons (integer->char 7) acc)))
                                   ((char=? d #\b) (go (+ k 2) (cons (integer->char 8) acc)))
                                   ((char=? d #\t) (go (+ k 2) (cons (integer->char 9) acc)))
                                   ((char=? d #\n) (go (+ k 2) (cons (integer->char 10) acc)))
                                   ((char=? d #\r) (go (+ k 2) (cons (integer->char 13) acc)))
                                   ((char=? d #\x)
                                    (let ((semi (index-from s #\; (+ k 2))))
                                      (tagcase (if (< semi 0) (sum none #u) (parse-digits s (+ k 2) semi 16))
                                        (some n (go (+ semi 1) (cons (integer->char n) acc)))
                                        (none u (go (+ k 2) (cons d acc))))))
                                   ((or (char=? d #\newline) (char=? d #\space) (char=? d #\tab))
                                    ;; A line ending escaped: it and the space around it go.
                                    (letrec ((skip (subr rf-st (int bool) int)
                                               (lambda (m nl?)
                                                 (cond ((>= m j) m)
                                                       ((char=? (string-ref s m) #\newline) (if nl? m (skip (+ m 1) #t)))
                                                       ((or (char=? (string-ref s m) #\space) (char=? (string-ref s m) #\tab)) (skip (+ m 1) nl?))
                                                       (else m)))))
                                      (go (skip (+ k 1) #f) acc)))
                                   (else (go (+ k 2) (cons d acc)))))
                           (go (+ k 1) (cons c acc))))))))
      (list->string (reverse (go i nil))))))

"Whether FX-26 is being read: then #u is the unit value (as eval.fx has
it, the unspecified value)."
(define fx26-syntax? (ref bool @rf) (new #f))
(define set-fx26-syntax! (subr rf-st (bool) unit) (lambda (b) (set fx26-syntax? b)))

"An atom's text as a datum; none if it is no datum."
(define parse-atom (subr rf-st (string bool) (sumof (none unit) (some rf-value)))
  (lambda (text fold?)
    (let ((n (string-length text)))
      (cond ((= n 0) (sum none #u))
            ((char=? (string-ref text 0) #\") (sum some (rf-str (unescape text 1 (- n 1)))))
            ((char=? (string-ref text 0) #\|)
             (sum some (rf-sym (string->symbol (unescape text 1 (- n 1))))))
            ((and (>= n 3) (char=? (string-ref text 0) #\#) (char=? (string-ref text 1) #\\))
             (let* ((name (substring text 2 n))
                    (lname (if fold? (string-downcase name) name)))
               (cond ((= (string-length name) 1) (sum some (sum char (string-ref name 0))))
                     ((>= (char-named lname) 0) (sum some (sum char (integer->char (char-named lname)))))
                     ((and (char=? (string-ref name 0) #\x) (tagcase (parse-digits name 1 (string-length name) 16) (some d #t) (none u #f)))
                      (tagcase (parse-digits name 1 (string-length name) 16)
                        (some d (sum some (sum char (integer->char d))))
                        (none u (sum none #u))))
                     ;; A character not ASCII: its UTF-8 text is one character.
                     ((= (list-length (string->list name)) 1) (sum some (sum char (string-ref name 0))))
                     (else (sum none #u)))))
            ((and (string=? text "#u") (get fx26-syntax?)) (sum some rf-unspecified))
            ((or (string=? text "#t") (string=? text "#true")) (sum some rf-true))
            ((or (string=? text "#f") (string=? text "#false")) (sum some rf-false))
            (else
             (tagcase (parse-number text)
               (some v (sum some v))
               (none u
                 (if (char=? (string-ref text 0) #\#)
                     (sum none #u)
                     (sum some (rf-sym (string->symbol (if fold? (string-downcase text) text))))))))))))

;;; ------------------------------------------------------------ reading

"A reader: its text, where it is, the line there, whether skip! took a #
not yet read, the file (for places and messages), and fold-case."
(define-type reader
  (productof (text string) (pos (ref int @rf)) (line (ref int @rf)) (pending-hash (ref bool @rf))
             (file string) (fold (ref bool @rf)) (note? bool)))

(define rd-peek (subr rf-st (reader) int)
  (lambda (r) (let ((i (get (extract r pos)))) (if (< i (string-length (extract r text))) (char->integer (string-ref (extract r text) i)) -1))))
(define rd-next! (subr rf-st (reader) int)
  (lambda (r)
    (let ((c (rd-peek r)))
      (begin
        (if (>= c 0) (set (extract r pos) (+ 1 (get (extract r pos)))) #u)
        (if (= c 10) (set (extract r line) (+ 1 (get (extract r line)))) #u)
        c))))
(define rd-fail (subr rf-eff (reader string) void)
  (lambda (r message)
    (rf-error (string-append "ratfink: " (extract r file) ":" (int->string (get (extract r line))) ": " message) nil)))
(define note! (subr rf-st (rf-value int reader) rf-value)
  (lambda (x at r)
    (tagcase x
      (pair p (begin (if (extract r note?) (eqtable-set! (get locations) p (string-append (extract r file) ":" (int->string at))) #u) x))
      (else y x))))
(define is? (subr rf-st (int char) bool) (lambda (c ch) (= c (char->integer ch))))
(define whitespace? (subr rf-st (int) bool) (lambda (c) (and (>= c 0) (char-whitespace? (integer->char c)))))
(define delimiter? (subr rf-st (int) bool)
  (lambda (c) (or (< c 0) (whitespace? c) (is? c #\() (is? c #\)) (is? c #\[) (is? c #\]) (is? c #\") (is? c #\;) (is? c #\'))))

"Skip whitespace and comments; the next character, -1 at the end."
(define skip! (subr rf-eff (reader) int)
  (lambda (r)
    (let ((c (rd-peek r)))
      (cond ((< c 0) c)
            ((whitespace? c) (begin (rd-next! r) (skip! r)))
            ((is? c #\;)
             (letrec ((loop (subr rf-st () unit) (lambda () (let ((c (rd-next! r))) (if (or (< c 0) (= c 10)) #u (loop))))))
               (begin (loop) (skip! r))))
            ((is? c #\#)
             (begin
               (rd-next! r)
               (let ((d (rd-peek r)))
                 (cond ((is? d #\|) (begin (rd-next! r) (block-comment! r) (skip! r)))
                       ((is? d #\;) (begin (rd-next! r) (datum r) (skip! r)))
                       (else (begin (set (extract r pending-hash) #t) c))))))
            (else c)))))
(define block-comment! (subr rf-eff (reader) unit)
  (lambda (r)
    (letrec ((loop (subr rf-eff (int) unit)
               (lambda (depth)
                 (let ((c (rd-next! r)))
                   (cond ((< c 0) (rd-fail r "unterminated #| comment"))
                         ((and (is? c #\|) (is? (rd-peek r) #\#)) (begin (rd-next! r) (if (= depth 1) #u (loop (- depth 1)))))
                         ((and (is? c #\#) (is? (rd-peek r) #\|)) (begin (rd-next! r) (loop (+ depth 1))))
                         (else (loop depth)))))))
      (loop 1))))
"The text of an atom from here, after prefix."
(define token (subr rf-st (reader string) string)
  (lambda (r prefix)
    (letrec ((loop (subr rf-st ((listof char acyclic)) (listof char acyclic))
               (lambda (acc) (if (delimiter? (rd-peek r)) acc (loop (cons (integer->char (rd-next! r)) acc))))))
      (string-append prefix (list->string (reverse (loop nil)))))))
(define atom (subr rf-eff (reader string) rf-value)
  (lambda (r text)
    (tagcase (parse-atom text (get (extract r fold)))
      (some v v)
      (none u
        (cond ((string=? text "#!fold-case") (begin (set (extract r fold) #t) (datum r)))
              ((string=? text "#!no-fold-case") (begin (set (extract r fold) #f) (datum r)))
              (else (rd-fail r (string-append "bad datum: " text))))))))

"The next datum; eof at the end."
(define datum (subr rf-eff (reader) rf-value)
  (lambda (r)
    (let ((c (skip! r)))
      (cond ((< c 0) rf-eof)
            ((get (extract r pending-hash)) (begin (set (extract r pending-hash) #f) (hash-datum r)))
            (else
             (let ((at (get (extract r line))))
               (cond ((or (is? c #\() (is? c #\[)) (begin (rd-next! r) (note! (read-list r) at r)))
                     ((or (is? c #\)) (is? c #\])) (begin (rd-next! r) (rd-fail r "unexpected close parenthesis")))
                     ((is? c #\') (begin (rd-next! r) (read-abbreviation r 'quote at)))
                     ((is? c #\`) (begin (rd-next! r) (read-abbreviation r 'quasiquote at)))
                     ((is? c #\,) (begin (rd-next! r)
                                         (if (is? (rd-peek r) #\@)
                                             (begin (rd-next! r) (read-abbreviation r 'unquote-splicing at))
                                             (read-abbreviation r 'unquote at))))
                     ((is? c #\") (atom r (read-string-text r)))
                     ((is? c #\|) (begin (rd-next! r) (atom r (string-append "|" (read-bar-text r)))))
                     (else (atom r (token r ""))))))))))
(define read-abbreviation (subr rf-eff (reader symbol int) rf-value)
  (lambda (r name at)
    (let ((x (datum r)))
      (begin (if (rf-eof? x) (rd-fail r "end of file after an abbreviation") #u)
             (note! (rf-list2 (rf-sym name) x) at r)))))
"After #: a vector, a bytevector (as a vector), a character or another atom."
(define hash-datum (subr rf-eff (reader) rf-value)
  (lambda (r)
    (let ((c (rd-peek r)))
      (cond ((is? c #\() (begin (rd-next! r) (sum vec (list->array (rf-elements (read-list r))))))
            ((is? c #\\)
             (begin (rd-next! r)
                    (let ((first (rd-next! r)))
                      (begin (if (< first 0) (rd-fail r "end of file in a character") #u)
                             (atom r (token r (string-append "#\\" (char->string (integer->char first)))))))))
            ((is? c #\u)
             (let ((text (token r "#")))
               (if (and (string=? text "#u8") (is? (rd-peek r) #\())
                   (begin (rd-next! r) (sum vec (list->array (rf-elements (read-list r)))))
                   (atom r text))))
            (else (atom r (token r "#")))))))
(define read-list (subr rf-eff (reader) rf-value)
  (lambda (r)
    (letrec ((loop (subr rf-eff (rf-value) rf-value)
               (lambda (acc)
                 (let ((c (skip! r)))
                   (cond ((< c 0) (rd-fail r "end of file in a list"))
                         ((get (extract r pending-hash)) (loop (rf-cons (datum r) acc)))
                         ((or (is? c #\)) (is? c #\])) (begin (rd-next! r) (rf-reverse acc)))
                         ((and (is? c #\.) (begin (rd-next! r) (delimiter? (rd-peek r))))
                          (let ((tail (datum r)))
                            (begin
                              (let ((d (skip! r))) (if (not (or (is? d #\)) (is? d #\]))) (rd-fail r "bad dotted list") #u))
                              (rd-next! r)
                              (append-reverse acc tail))))
                         ((is? c #\.) (loop (rf-cons (atom r (token r ".")) acc)))
                         (else (loop (rf-cons (datum r) acc))))))))
      (loop rf-nil))))
(define append-reverse (subr rf-st (rf-value rf-value) rf-value)
  (lambda (rev tail) (if (rf-pair? rev) (append-reverse (rf-cdr rev) (rf-cons (rf-car rev) tail)) tail)))
(define read-string-text (subr rf-eff (reader) string)
  (lambda (r)
    (begin
      (rd-next! r)
      (letrec ((loop (subr rf-eff ((listof char acyclic)) string)
                 (lambda (acc)
                   (let ((c (rd-next! r)))
                     (cond ((< c 0) (rd-fail r "end of file in a string"))
                           ((is? c #\\) (let ((d (rd-next! r))) (loop (cons (integer->char (if (< d 0) 32 d)) (cons #\\ acc)))))
                           ((is? c #\") (list->string (reverse (the (listof char acyclic) (cons #\" acc)))))
                           (else (loop (cons (integer->char c) acc))))))))
        (loop (list #\"))))))
(define read-bar-text (subr rf-eff (reader) string)
  (lambda (r)
    (letrec ((loop (subr rf-eff ((listof char acyclic)) string)
               (lambda (acc)
                 (let ((c (rd-next! r)))
                   (cond ((< c 0) (rd-fail r "end of file in a |symbol|"))
                         ((is? c #\\) (let ((d (rd-next! r))) (loop (cons (integer->char (if (< d 0) 32 d)) (cons #\\ acc)))))
                         ((is? c #\|) (list->string (reverse (the (listof char acyclic) (cons #\| acc)))))
                         (else (loop (cons (integer->char c) acc))))))))
      (loop nil))))

"The data of text, in order, its lists noted as read from file; with
fold-case, its symbols and character names folded to lower case."
(define read-text (subr rf-eff (string string bool) rf-vals)
  (lambda (text file fold?) (read-text* text file fold? #t)))
"The data of text, its lists noted as read from file if note?."
(define read-text* (subr rf-eff (string string bool bool) rf-vals)
  (lambda (text file fold? note?)
    (let ((r (the reader (product (text text) (pos (new 0)) (line (new 1)) (pending-hash (new #f)) (file file) (fold (new fold?)) (note? note?)))))
      (letrec ((loop (subr rf-eff (rf-vals) rf-vals)
                 (lambda (acc) (let ((x (datum r))) (if (rf-eof? x) (vals-reverse acc) (loop (cons x acc)))))))
        (loop nil)))))

"The text of a file, or none if it cannot be read."
(define file-text (subr rf-eff (string) (sumof (none unit) (some string)))
  (lambda (file)
    (tagcase (the (sumof (data (bytevectorof @rf)) (failed io-error)) (read-file file))
      (data d (tagcase (utf8->string d) (text s (sum some s)) (else y (sum none #u))))
      (else y (sum none #u)))))
(define file-exists? (subr rf-eff (string) bool)
  (lambda (file) (tagcase (file-text file) (some s #t) (none u #f))))

"The data of a file (shakedown's read-file)."
(define read-file-data (subr rf-eff (string bool) rf-vals)
  (lambda (file fold?)
    (tagcase (file-text file)
      (some text (read-text text file fold?))
      (none u (begin (rf-error (string-append "cannot open file " file) nil) nil)))))

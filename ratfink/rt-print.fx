(define m-core ((load-module "core.fx")))
(define m-print ((load-module "print.fx") m-core))
(define m-numbers ((load-module "numbers.fx") m-core))
(define m-reader ((load-module "reader.fx") m-core m-numbers))
(import m-core (type rf-value) (effect rf-eff) rf-catch)
(import m-print datum-text)
(import m-reader read-file-data)
(define say (subr rf-eff (string) unit) (lambda (s) (tagcase (write-out s) (done u #u) (failed e #u))))
(define main (subr rf-eff () int)
  (lambda ()
    (letrec ((go (subr rf-eff ((listof rf-value acyclic)) unit)
               (lambda (l) (if (null? l) #u
                               (begin (say (datum-text (car l) #f #t (lambda ((v rf-value)) "?"))) (say "  ")
                                      (say (datum-text (car l) #t #t (lambda ((v rf-value)) "?"))) (say "\n") (go (cdr l)))))))
      (begin (go (read-file-data (car (args)) #f)) 0))))

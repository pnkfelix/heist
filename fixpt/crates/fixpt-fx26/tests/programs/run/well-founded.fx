;;; Well-founded recursion needs no `spin`: over the parts of finite data
;;; (a list at an `acyclic` region, a tree of sums and products), and over
;;; integers counting down to a bound below or up to one above
;;; (size-change termination: `src/terminate.rs`).
(define len (subr pure ((listof int acyclic) int) int)
  (letrec ((len (subr pure ((listof int acyclic) int) int)
             (lambda (xs n) (if (null? xs) n (len (cdr xs) (+ n 1))))))
    len))
(define count (subr pure (int) int)
  (letrec ((count (subr pure (int) int)
             (lambda (n) (if (> n 0) (+ 1 (count (- n 1))) 0))))
    count))
(define up (subr pure (int int) int)
  (letrec ((up (subr pure (int int) int)
             (lambda (i acc) (if (< i 10) (up (+ i 1) (+ acc i)) acc))))
    up))
(define-type tree (sumof (leaf int) (node (tupleof tree tree))))
(define total (subr pure (tree) int)
  (letrec ((total (subr pure (tree) int)
             (lambda (t) (tagcase t (leaf n n) (node (a b) (+ (total a) (total b)))))))
    total))
;; Mutual recursion too, in a local `letrec`: through globals it would
;; read them, and so say `spin`.
(define ev (subr pure (int) bool)
  (letrec ((ev (subr pure (int) bool) (lambda (n) (if (<= n 0) #t (od (- n 1)))))
           (od (subr pure (int) bool) (lambda (n) (if (<= n 0) #f (ev (- n 1))))))
    ev))
(define ack (subr pure (int int) int)
  (letrec ((ack (subr pure (int int) int)
             (lambda (m n)
               (cond ((<= m 0) (+ n 1))
                     ((<= n 0) (ack (- m 1) 1))
                     (else (ack (- m 1) (ack m (- n 1))))))))
    ack))
(define built (subr pure (int) (listof int acyclic))
  (lambda (n) (letfreeze r (the (listof int r) (list n (+ n 1))))))
(let ((two-leaves (sum node (tuple (sum leaf 1) (sum leaf 2))))
      (even (if (ev 10) 1 0)))
  (+ (len (built 3) 0) (+ (count 5) (+ (up 0 0) (+ (total two-leaves) (+ even (ack 2 2)))))))

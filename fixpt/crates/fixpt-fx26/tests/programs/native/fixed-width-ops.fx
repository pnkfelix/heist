;;; Every operation of the fixed-width integers, and `int`'s `*`,
;;; `quotient` and `modulo`, as native code makes them in line (`prim1`,
;;; `prim2`, `prim2imm`) or calls them without a collection: on values at
;;; the edges of each type, bignums among the 64-bit ones, and constants as
;;; second operands. One checksum an operation, for each type, to compare
;;; with the Rust machine's.
(define-type ints (listof int @heap))
(define-type i32s (listof i32 @heap))
(define-type u32s (listof u32 @heap))
(define-type i64s (listof i64 @heap))
(define-type u64s (listof u64 @heap))
(define edges (subr (alloc @heap) () ints)
  (lambda ()
    (list 0 1 -1 7 -8 13 2147483647 -2147483648 2147483648 4294967295 3000000000
          123456789 -987654321 1152921504606846975 -1152921504606846976)))
(define mix (subr pure (int int) int)
  (lambda (h r) (modulo (+ (* h 31) (modulo r 1000003)) 1000003)))
;; A 64-bit value as an int, in two parts: `T->int` past a fixnum fails.
(define i64-fold (subr pure (i64) int)
  (lambda (r)
    (+ (* (i64->int (i64-shr r 40)) 1000003) (i64->int (i64-and r (int->i64 1099511627775))))))
(define u64-fold (subr pure (u64) int)
  (lambda (r)
    (+ (* (u64->int (u64-shr r 40)) 1000003) (u64->int (u64-and r (int->u64 1099511627775))))))
(define i32-fold (subr pure (i32) int) (lambda (r) (i32->int r)))
(define u32-fold (subr pure (u32) int) (lambda (r) (u32->int r)))
(define i64-big (subr pure () i64) (lambda () (i64* (int->i64 3037000499) (int->i64 3037000499))))
(define u64-big (subr pure () u64) (lambda () (int->u64 -1)))
(define* i32-op (subr pure (int i32 i32) int)
  (lambda (k a b)
    (let ((zero (int->i32 0))
          (count (i32->int (i32-and b (int->i32 255)))))
      (cond ((= k 0) (i32-fold (i32+ a b)))
            ((= k 1) (i32-fold (i32- a b)))
            ((= k 2) (i32-fold (i32* a b)))
            ((= k 3) (if (i32= b zero) 0 (i32-fold (i32-quotient a b))))
            ((= k 4) (if (i32= b zero) 0 (i32-fold (i32-remainder a b))))
            ((= k 5) (i32-fold (i32-and a b)))
            ((= k 6) (i32-fold (i32-or a b)))
            ((= k 7) (i32-fold (i32-xor a b)))
            ((= k 8) (i32-fold (i32-not a)))
            ((= k 9) (i32-fold (i32-shl a count)))
            ((= k 10) (i32-fold (i32-shr a count)))
            ((= k 11) (if (i32< a b) 1 0))
            ((= k 12) (if (i32<= a b) 1 0))
            ((= k 13) (if (i32> a b) 1 0))
            ((= k 14) (if (i32>= a b) 1 0))
            ((= k 15) (if (i32= a b) 1 0))
            ((= k 16) (i32-fold (int->i32 (i32->int (i32-shr a 8)))))
            ((= k 17) (i32-fold (i32* a (int->i32 16777619))))
            ((= k 18) (i32-fold (i32-shr a 3)))
            ((= k 19) (i32-fold (i32-shl a 45)))
            ((= k 20) (i32-fold (i32+ a (int->i32 -5))))
            (else (i32-fold (i32-quotient a (int->i32 -7))))))))
(define* i32-values (subr (maxeff (read @heap) (alloc @heap) spin) (ints) i32s)
  (lambda (xs)
    (if (null? xs) nil (cons (int->i32 (car xs)) (i32-values (cdr xs))))))
(define* i32-inner (subr (maxeff (read @heap) spin) (int i32 i32s int) int)
  (lambda (k a bs h)
    (if (null? bs) h (i32-inner k a (cdr bs) (mix h (i32-op k a (car bs)))))))
(define* i32-outer (subr (maxeff (read @heap) spin) (int i32s i32s int) int)
  (lambda (k as bs h)
    (if (null? as) h (i32-outer k (cdr as) bs (i32-inner k (car as) bs h)))))
(define* i32-sums (subr (maxeff (read @heap) (alloc @heap) spin) (int i32s) ints)
  (lambda (k vs)
    (if (= k 22) nil (cons (i32-outer k vs vs 0) (i32-sums (+ k 1) vs)))))
(define* u32-op (subr pure (int u32 u32) int)
  (lambda (k a b)
    (let ((zero (int->u32 0))
          (count (u32->int (u32-and b (int->u32 255)))))
      (cond ((= k 0) (u32-fold (u32+ a b)))
            ((= k 1) (u32-fold (u32- a b)))
            ((= k 2) (u32-fold (u32* a b)))
            ((= k 3) (if (u32= b zero) 0 (u32-fold (u32-quotient a b))))
            ((= k 4) (if (u32= b zero) 0 (u32-fold (u32-remainder a b))))
            ((= k 5) (u32-fold (u32-and a b)))
            ((= k 6) (u32-fold (u32-or a b)))
            ((= k 7) (u32-fold (u32-xor a b)))
            ((= k 8) (u32-fold (u32-not a)))
            ((= k 9) (u32-fold (u32-shl a count)))
            ((= k 10) (u32-fold (u32-shr a count)))
            ((= k 11) (if (u32< a b) 1 0))
            ((= k 12) (if (u32<= a b) 1 0))
            ((= k 13) (if (u32> a b) 1 0))
            ((= k 14) (if (u32>= a b) 1 0))
            ((= k 15) (if (u32= a b) 1 0))
            ((= k 16) (u32-fold (int->u32 (u32->int (u32-shr a 8)))))
            ((= k 17) (u32-fold (u32* a (int->u32 16777619))))
            ((= k 18) (u32-fold (u32-shr a 3)))
            ((= k 19) (u32-fold (u32-shl a 45)))
            ((= k 20) (u32-fold (u32+ a (int->u32 -5))))
            (else (u32-fold (u32-quotient a (int->u32 -7))))))))
(define* u32-values (subr (maxeff (read @heap) (alloc @heap) spin) (ints) u32s)
  (lambda (xs)
    (if (null? xs) nil (cons (int->u32 (car xs)) (u32-values (cdr xs))))))
(define* u32-inner (subr (maxeff (read @heap) spin) (int u32 u32s int) int)
  (lambda (k a bs h)
    (if (null? bs) h (u32-inner k a (cdr bs) (mix h (u32-op k a (car bs)))))))
(define* u32-outer (subr (maxeff (read @heap) spin) (int u32s u32s int) int)
  (lambda (k as bs h)
    (if (null? as) h (u32-outer k (cdr as) bs (u32-inner k (car as) bs h)))))
(define* u32-sums (subr (maxeff (read @heap) (alloc @heap) spin) (int u32s) ints)
  (lambda (k vs)
    (if (= k 22) nil (cons (u32-outer k vs vs 0) (u32-sums (+ k 1) vs)))))
(define* i64-op (subr pure (int i64 i64) int)
  (lambda (k a b)
    (let ((zero (int->i64 0))
          (count (i64->int (i64-and b (int->i64 255)))))
      (cond ((= k 0) (i64-fold (i64+ a b)))
            ((= k 1) (i64-fold (i64- a b)))
            ((= k 2) (i64-fold (i64* a b)))
            ((= k 3) (if (i64= b zero) 0 (i64-fold (i64-quotient a b))))
            ((= k 4) (if (i64= b zero) 0 (i64-fold (i64-remainder a b))))
            ((= k 5) (i64-fold (i64-and a b)))
            ((= k 6) (i64-fold (i64-or a b)))
            ((= k 7) (i64-fold (i64-xor a b)))
            ((= k 8) (i64-fold (i64-not a)))
            ((= k 9) (i64-fold (i64-shl a count)))
            ((= k 10) (i64-fold (i64-shr a count)))
            ((= k 11) (if (i64< a b) 1 0))
            ((= k 12) (if (i64<= a b) 1 0))
            ((= k 13) (if (i64> a b) 1 0))
            ((= k 14) (if (i64>= a b) 1 0))
            ((= k 15) (if (i64= a b) 1 0))
            ((= k 16) (i64-fold (int->i64 (i64->int (i64-shr a 8)))))
            ((= k 17) (i64-fold (i64* a (int->i64 16777619))))
            ((= k 18) (i64-fold (i64-shr a 3)))
            ((= k 19) (i64-fold (i64-shl a 45)))
            ((= k 20) (i64-fold (i64+ a (int->i64 -5))))
            (else (i64-fold (i64-quotient a (int->i64 -7))))))))
(define* i64-values (subr (maxeff (read @heap) (alloc @heap) spin) (ints) i64s)
  (lambda (xs)
    (if (null? xs)
        (list (i64- (int->i64 0) (i64-big)) (i64-big))
        (cons (int->i64 (car xs)) (i64-values (cdr xs))))))
(define* i64-inner (subr (maxeff (read @heap) spin) (int i64 i64s int) int)
  (lambda (k a bs h)
    (if (null? bs) h (i64-inner k a (cdr bs) (mix h (i64-op k a (car bs)))))))
(define* i64-outer (subr (maxeff (read @heap) spin) (int i64s i64s int) int)
  (lambda (k as bs h)
    (if (null? as) h (i64-outer k (cdr as) bs (i64-inner k (car as) bs h)))))
(define* i64-sums (subr (maxeff (read @heap) (alloc @heap) spin) (int i64s) ints)
  (lambda (k vs)
    (if (= k 22) nil (cons (i64-outer k vs vs 0) (i64-sums (+ k 1) vs)))))
(define* u64-op (subr pure (int u64 u64) int)
  (lambda (k a b)
    (let ((zero (int->u64 0))
          (count (u64->int (u64-and b (int->u64 255)))))
      (cond ((= k 0) (u64-fold (u64+ a b)))
            ((= k 1) (u64-fold (u64- a b)))
            ((= k 2) (u64-fold (u64* a b)))
            ((= k 3) (if (u64= b zero) 0 (u64-fold (u64-quotient a b))))
            ((= k 4) (if (u64= b zero) 0 (u64-fold (u64-remainder a b))))
            ((= k 5) (u64-fold (u64-and a b)))
            ((= k 6) (u64-fold (u64-or a b)))
            ((= k 7) (u64-fold (u64-xor a b)))
            ((= k 8) (u64-fold (u64-not a)))
            ((= k 9) (u64-fold (u64-shl a count)))
            ((= k 10) (u64-fold (u64-shr a count)))
            ((= k 11) (if (u64< a b) 1 0))
            ((= k 12) (if (u64<= a b) 1 0))
            ((= k 13) (if (u64> a b) 1 0))
            ((= k 14) (if (u64>= a b) 1 0))
            ((= k 15) (if (u64= a b) 1 0))
            ((= k 16) (u64-fold (int->u64 (u64->int (u64-shr a 8)))))
            ((= k 17) (u64-fold (u64* a (int->u64 16777619))))
            ((= k 18) (u64-fold (u64-shr a 3)))
            ((= k 19) (u64-fold (u64-shl a 45)))
            ((= k 20) (u64-fold (u64+ a (int->u64 -5))))
            (else (u64-fold (u64-quotient a (int->u64 -7))))))))
(define* u64-values (subr (maxeff (read @heap) (alloc @heap) spin) (ints) u64s)
  (lambda (xs)
    (if (null? xs)
        (list (u64- (int->u64 0) (u64-big)) (u64-big))
        (cons (int->u64 (car xs)) (u64-values (cdr xs))))))
(define* u64-inner (subr (maxeff (read @heap) spin) (int u64 u64s int) int)
  (lambda (k a bs h)
    (if (null? bs) h (u64-inner k a (cdr bs) (mix h (u64-op k a (car bs)))))))
(define* u64-outer (subr (maxeff (read @heap) spin) (int u64s u64s int) int)
  (lambda (k as bs h)
    (if (null? as) h (u64-outer k (cdr as) bs (u64-inner k (car as) bs h)))))
(define* u64-sums (subr (maxeff (read @heap) (alloc @heap) spin) (int u64s) ints)
  (lambda (k vs)
    (if (= k 22) nil (cons (u64-outer k vs vs 0) (u64-sums (+ k 1) vs)))))
(define int-op (subr pure (int int int) int)
  (lambda (k a b)
    (cond ((= k 0) (* (modulo a 100000) (quotient b 1000000)))
          ((= k 1) (if (or (= b 0) (= b -1)) 0 (quotient a b)))
          ((= k 2) (if (= b 0) 0 (modulo a b)))
          ((= k 3) (quotient a -7))
          ((= k 4) (modulo a 10))
          (else (modulo a -10)))))
(define* int-inner (subr (maxeff (read @heap) spin) (int int ints int) int)
  (lambda (k a bs h)
    (if (null? bs) h (int-inner k a (cdr bs) (mix h (int-op k a (car bs)))))))
(define* int-outer (subr (maxeff (read @heap) spin) (int ints ints int) int)
  (lambda (k as bs h)
    (if (null? as) h (int-outer k (cdr as) bs (int-inner k (car as) bs h)))))
(define* int-sums (subr (maxeff (read @heap) (alloc @heap) spin) (int ints) ints)
  (lambda (k vs)
    (if (= k 6) nil (cons (int-outer k vs vs 0) (int-sums (+ k 1) vs)))))
(define* fixed-width-ops (subr (maxeff (read @heap) (alloc @heap) spin) (int) (listof ints @heap))
  (lambda (k)
    (let ((xs (edges)))
      (list (int-sums k xs) (i32-sums k (i32-values xs)) (u32-sums k (u32-values xs))
            (i64-sums k (i64-values xs)) (u64-sums k (u64-values xs))))))
(fixed-width-ops 0)

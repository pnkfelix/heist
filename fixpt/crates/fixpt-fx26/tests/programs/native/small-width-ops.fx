;;; Every operation of `i8` and `u8` (`TODO.md` §84), as native code makes
;;; them in line or calls them, and as every machine and the evaluator
;;; written in FX-26 give them: `fixed-width-ops.fx`'s for `i32` and `u32`,
;;; at the edges of a byte. One checksum an operation, for each type.
(define-type ints (listof int @heap))
(define-type i8s (listof i8 @heap))
(define-type u8s (listof u8 @heap))
(define edges (subr (alloc @heap) () ints)
  (lambda () (list 0 1 -1 7 -8 13 127 -128 128 255 256 -129 200 99 -77 1000)))
(define mix (subr pure (int int) int)
  (lambda (h r) (modulo (+ (* h 31) (modulo r 1000003)) 1000003)))
(define i8-fold (subr pure (i8) int) (lambda (r) (i8->int r)))
(define u8-fold (subr pure (u8) int) (lambda (r) (u8->int r)))
(define* i8-op (subr pure (int i8 i8) int)
  (lambda (k a b)
    (let ((zero (int->i8 0))
          (count (i8->int (i8-and b (int->i8 255)))))
      (cond ((= k 0) (i8-fold (i8+ a b)))
            ((= k 1) (i8-fold (i8- a b)))
            ((= k 2) (i8-fold (i8* a b)))
            ((= k 3) (if (i8= b zero) 0 (i8-fold (i8-quotient a b))))
            ((= k 4) (if (i8= b zero) 0 (i8-fold (i8-remainder a b))))
            ((= k 5) (i8-fold (i8-and a b)))
            ((= k 6) (i8-fold (i8-or a b)))
            ((= k 7) (i8-fold (i8-xor a b)))
            ((= k 8) (i8-fold (i8-not a)))
            ((= k 9) (i8-fold (i8-shl a count)))
            ((= k 10) (i8-fold (i8-shr a count)))
            ((= k 11) (if (i8< a b) 1 0))
            ((= k 12) (if (i8<= a b) 1 0))
            ((= k 13) (if (i8> a b) 1 0))
            ((= k 14) (if (i8>= a b) 1 0))
            ((= k 15) (if (i8= a b) 1 0))
            ((= k 16) (i8-fold (int->i8 (i8->int (i8-shr a 8)))))
            ((= k 17) (i8-fold (i8* a (int->i8 16777619))))
            ((= k 18) (i8-fold (i8-shr a 3)))
            ((= k 19) (i8-fold (i8-shl a 45)))
            ((= k 20) (i8-fold (i8+ a (int->i8 -5))))
            (else (i8-fold (i8-quotient a (int->i8 -7))))))))
(define* i8-values (subr (maxeff (read @heap) (alloc @heap) spin) (ints) i8s)
  (lambda (xs)
    (if (null? xs) nil (cons (int->i8 (car xs)) (i8-values (cdr xs))))))
(define* i8-inner (subr (maxeff (read @heap) spin) (int i8 i8s int) int)
  (lambda (k a bs h)
    (if (null? bs) h (i8-inner k a (cdr bs) (mix h (i8-op k a (car bs)))))))
(define* i8-outer (subr (maxeff (read @heap) spin) (int i8s i8s int) int)
  (lambda (k as bs h)
    (if (null? as) h (i8-outer k (cdr as) bs (i8-inner k (car as) bs h)))))
(define* i8-sums (subr (maxeff (read @heap) (alloc @heap) spin) (int i8s) ints)
  (lambda (k vs)
    (if (= k 22) nil (cons (i8-outer k vs vs 0) (i8-sums (+ k 1) vs)))))
(define* u8-op (subr pure (int u8 u8) int)
  (lambda (k a b)
    (let ((zero (int->u8 0))
          (count (u8->int (u8-and b (int->u8 255)))))
      (cond ((= k 0) (u8-fold (u8+ a b)))
            ((= k 1) (u8-fold (u8- a b)))
            ((= k 2) (u8-fold (u8* a b)))
            ((= k 3) (if (u8= b zero) 0 (u8-fold (u8-quotient a b))))
            ((= k 4) (if (u8= b zero) 0 (u8-fold (u8-remainder a b))))
            ((= k 5) (u8-fold (u8-and a b)))
            ((= k 6) (u8-fold (u8-or a b)))
            ((= k 7) (u8-fold (u8-xor a b)))
            ((= k 8) (u8-fold (u8-not a)))
            ((= k 9) (u8-fold (u8-shl a count)))
            ((= k 10) (u8-fold (u8-shr a count)))
            ((= k 11) (if (u8< a b) 1 0))
            ((= k 12) (if (u8<= a b) 1 0))
            ((= k 13) (if (u8> a b) 1 0))
            ((= k 14) (if (u8>= a b) 1 0))
            ((= k 15) (if (u8= a b) 1 0))
            ((= k 16) (u8-fold (int->u8 (u8->int (u8-shr a 8)))))
            ((= k 17) (u8-fold (u8* a (int->u8 16777619))))
            ((= k 18) (u8-fold (u8-shr a 3)))
            ((= k 19) (u8-fold (u8-shl a 45)))
            ((= k 20) (u8-fold (u8+ a (int->u8 -5))))
            (else (u8-fold (u8-quotient a (int->u8 -7))))))))
(define* u8-values (subr (maxeff (read @heap) (alloc @heap) spin) (ints) u8s)
  (lambda (xs)
    (if (null? xs) nil (cons (int->u8 (car xs)) (u8-values (cdr xs))))))
(define* u8-inner (subr (maxeff (read @heap) spin) (int u8 u8s int) int)
  (lambda (k a bs h)
    (if (null? bs) h (u8-inner k a (cdr bs) (mix h (u8-op k a (car bs)))))))
(define* u8-outer (subr (maxeff (read @heap) spin) (int u8s u8s int) int)
  (lambda (k as bs h)
    (if (null? as) h (u8-outer k (cdr as) bs (u8-inner k (car as) bs h)))))
(define* u8-sums (subr (maxeff (read @heap) (alloc @heap) spin) (int u8s) ints)
  (lambda (k vs)
    (if (= k 22) nil (cons (u8-outer k vs vs 0) (u8-sums (+ k 1) vs)))))
(define* small-width-ops (subr (maxeff (read @heap) (alloc @heap) spin) (int) (listof ints @heap))
  (lambda (k)
    (let ((xs (edges)))
      (list (i8-sums k (i8-values xs)) (u8-sums k (u8-values xs))))))
(small-width-ops 0)

;;; Generated by `fixpt_native::cellular::x64::fx26_regs_module` from the
;;; x86_64 machine's register code; `FIXPT_BLESS=1 cargo test -p fixpt-fx26
;;; --test layout` rewrites it. A module file, which the conductor loads (`TODO.md` §68).

(define r-result int 0)  ; a register
(define r-rdi int 7)  ; a register
(define r-rsi int 6)  ; a register
(define r-r8 int 8)  ; a register
(define r-rcx int 1)  ; a register
(define r-rdx int 2)  ; a register
(define r-t int 14)  ; a register
(define r-sp int 4)  ; a register
(define r-st-regs int 776)  ; a State field's offset
(define r-st-leaf-link int 752)  ; a State field's offset
(define r-st-pure int 760)  ; a State field's offset
(define r-st-top int 176)  ; a State field's offset
(define r-st-alloc-limit int 184)  ; a State field's offset
(define r-st-words int 192)  ; a State field's offset
(define r-st-regions int 200)  ; a State field's offset
(define r-st-reserve int 768)  ; a State field's offset
(define r-st-slice int 856)  ; a State field's offset
(define r-null int 19)  ; a Value's bits
(define r-unspecified int 43)  ; a Value's bits
(define r-char0 int 67)  ; a Value's bits
(define r-f32-0 int 75)  ; a Value's bits
(define r-tag-header int 6)  ; a tag
(define r-kind-extension int 255)  ; a header's kind when F is in an extension word
(define r-region-slots int 256)  ; regions with a slot in the heap's table
(define r-regs int 8)  ; registers of register code
(define r-trap-prim int 10)  ; a trap's code

;; How many operand cells follow register-code instruction `n`.
(define r-operands (subr pure (int) int)
  (lambda (n)
    (case n
      ((0) 1)  ; args
      ((1) 1)  ; const
      ((2) 1)  ; global
      ((3) 1)  ; setglbl
      ((4) 1)  ; reg
      ((5) 1)  ; setreg
      ((6) 2)  ; movereg
      ((7) 1)  ; lexical
      ((8) 1)  ; save
      ((9) 1)  ; pop
      ((10) 1)  ; stack
      ((11) 1)  ; setstk
      ((12) 2)  ; load
      ((13) 2)  ; store
      ((14) 1)  ; op1
      ((15) 2)  ; op2
      ((16) 2)  ; op2imm
      ((17) 1)  ; field
      ((18) 2)  ; setfield
      ((19) 2)  ; prim
      ((20) 3)  ; lambda
      ((21) 2)  ; invoke
      ((22) 2)  ; tailinvoke
      ((24) 1)  ; branch
      ((25) 1)  ; branchf
      ((26) 2)  ; cellular
      ((27) 1)  ; invokeself
      ((28) 3)  ; global-guard
      ((29) 1)  ; brancht
      ((31) 1)  ; prim1
      ((32) 2)  ; prim2
      ((33) 2)  ; prim2imm
      ((34) 3)  ; prim3imm
      (else 0))))

;; The name of runtime primitive `p`, if register code names it; else "".
(define r-prim-name (subr pure (int) string)
  (lambda (p)
    (case p
      ((4) "pair?")
      ((5) "null?")
      ((6) "boolean?")
      ((7) "symbol?")
      ((8) "string?")
      ((9) "char?")
      ((21) "exact-integer?")
      ((34) "modulo")
      ((65) "char-numeric?")
      ((66) "char-whitespace?")
      ((69) "string-length")
      ((70) "string-ref")
      ((78) "string=?")
      ((164) "%make-bloblet")
      ((166) "%fx26-char-in?")
      ((310) "%fx26-bitwise-and")
      ((311) "%fx26-bitwise-ior")
      ((312) "%fx26-bitwise-xor")
      ((313) "%fx26-bitwise-not")
      ((314) "%fx26-arithmetic-shift")
      ((368) "%fx26-add")
      ((369) "%fx26-sub")
      ((370) "%fx26-mul")
      ((371) "%fx26-quotient")
      ((372) "%fx26-int-less")
      ((373) "%fx26-int-eq")
      ((395) "%fx26-fixnum?")
      ((398) "%fx26-procedure?")
      ((399) "%fx26-array?")
      ((400) "%fx26-f32?")
      ((401) "%fx26-box?")
      ((402) "%fx26-sum?")
      ((403) "%fx26-product?")
      ((433) "%make-frozen")
      ((446) "%bloblet-fields")
      ((449) "%bloblet-set!")
      ((476) "%make-box")
      ((499) "%region-cons")
      ((500) "%region-new")
      ((504) "%region-closure")
      ((507) "%symbol-hash")
      (else ""))))

;; The number of the runtime primitive register code names `name`.
(define r-prim-number (subr pure (string) int)
  (lambda (name)
    (case name
      (("string-length") 69)
      (("string-ref") 70)
      (("%region-cons") 499)
      (("%bloblet-fields") 446)
      (("%bloblet-set!") 449)
      (("char-whitespace?") 66)
      (("char-numeric?") 65)
      (("%symbol-hash") 507)
      (("%fx26-fixnum?") 395)
      (("char?") 9)
      (("boolean?") 6)
      (("symbol?") 7)
      (("string?") 8)
      (("pair?") 4)
      (("null?") 5)
      (("%fx26-bitwise-and") 310)
      (("%fx26-bitwise-ior") 311)
      (("%fx26-bitwise-xor") 312)
      (("%fx26-bitwise-not") 313)
      (("exact-integer?") 21)
      (("%fx26-array?") 399)
      (("%fx26-f32?") 400)
      (("%fx26-box?") 401)
      (("%fx26-sum?") 402)
      (("%fx26-product?") 403)
      (("%fx26-procedure?") 398)
      (("%fx26-char-in?") 166)
      (("string=?") 78)
      (("modulo") 34)
      (("%make-box") 476)
      (("%region-new") 500)
      (("%region-closure") 504)
      (("%make-frozen") 433)
      (("%make-bloblet") 164)
      (("%fx26-quotient") 371)
      (("%fx26-mul") 370)
      (("%fx26-arithmetic-shift") 314)
      (("%fx26-add") 368)
      (("%fx26-sub") 369)
      (("%fx26-int-less") 372)
      (("%fx26-int-eq") 373)
      (else -1))))


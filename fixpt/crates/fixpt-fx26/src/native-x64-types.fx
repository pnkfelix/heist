;;; The types of `native-x64.fx`, the signature of what it is given of the
;;; x86_64 machine (`native-x64-layout.fx`, generated), and its own as its
;;; clients use it: a module file of no state (`TODO.md` §68).

(define-effect x-assembles (maxeff (read @globals) (read @k) (write @k) (alloc @k)))
;; Writing the assembler's arrays, and looping; reading them to make lists.
(define-effect x-writes (maxeff (read @globals) (read @k) (write @k) spin))
(define-effect x-lists (maxeff (read @globals) (read @k) (alloc @k) spin))
;; The assembler's arrays; the bytes it gives; and those with where each
;; cell's code starts.
(define-type x-ints (arrayof int @k))
(define-type x-bools (arrayof bool @k))
(define-type x-out (listof int @k))
(define-type x-assembled (productof (1 x-out) (2 x-out)))
;; A 32-bit displacement to patch: where it is, and its label; newest first.
(define-type x-fix-list (listof (productof (1 int) (2 int)) @k))
;; Traps raised in the code being emitted, placed after it: label, code,
;; detail; newest first.
(define-type x-stub-list (listof (productof (1 int) (2 int) (3 int)) @k))
;; Register code's polls that may leave the machine (`native-x64-regs.fx`):
;; each one's way out, where it goes on, its code back, the registers it
;; keeps, its resume point's field, and whether it keeps a leaf's link (1).
(define-type x-poll-list (listof (productof (1 int) (2 int) (3 int) (4 int) (5 int) (6 int)) @k))

;;; ------------------------------------------------------------ signatures

;; What `native-x64.fx` uses of the x86_64 machine's registers, state and
;; traps: `native-layout-sig`'s, but for the heap's base and the fuel, which
;; have no registers here, and with the state's `#f` and `#t`.
(define-type native-x64-layout-sig
  (moduleof (val n-ip int)
            (val n-cur int)
            (val n-dsp int)
            (val n-rsp int)
            (val n-st int)
            (val n-table int)
            (val n-fp int)
            (val n-clo int)
            (val n-w int)
            (val n-x10 int)
            (val n-x11 int)
            (val n-x13 int)
            (val n-x14 int)
            (val n-x15 int)
            (val n-x16 int)
            (val n-st-base int)
            (val n-st-cur int)
            (val n-st-d int)
            (val n-st-dsp int)
            (val n-st-rsp int)
            (val n-st-table int)
            (val n-st-fuel int)
            (val n-st-callout int)
            (val n-st-ds-base int)
            (val n-st-ds-limit int)
            (val n-st-rs-limit int)
            (val n-st-fp int)
            (val n-st-clo int)
            (val n-st-resume int)
            (val n-st-trap int)
            (val n-st-exit int)
            (val n-st-cards int)
            (val n-st-code-lo int)
            (val n-false int)
            (val n-true int)
            (val n-prompt-mark int)
            (val n-mark-mark int)
            (val n-tag-bloblet int)
            (val n-tag-pair int)
            (val n-tag-trailer int)
            (val n-kind-word int)
            (val n-kind-closure int)
            (val n-closure-word int)
            (val n-closure-free0 int)
            (val n-word-entry int)
            (val n-word-cell0 int)
            (val n-primitives int)
            (val n-trap-type int)
            (val n-trap-overflow int)
            (val n-trap-underflow int)
            (val n-trap-field int)
            (val n-trap-no-routine int)
            (val n-trap-not-a-word int)
            (val n-trap-out-of-fuel int)
            (val n-trap-stack-overflow int)
            (val n-trap-too-deep int)
            (val n-operands (subr pure (int) int))
            (val n-control? (subr pure (int) bool))
            (val n-st-fal int)
            (val n-st-tru int)))

;; What the conductor names of the assembler, for Rust.
(define-type native-x64-sig
  (moduleof (val native-assemble-x64 (subr (maxeff x-assembles spin) (tword) x-assembled))))

;; What `native-x64-regs.fx` uses of `native-x64.fx`'s assembler: its
;; bytes, labels and traps, and the machine sequences the two share.
(define-type native-x64-asm-sig
  (moduleof (val x-c-o int)
            (val x-c-b int)
            (val x-c-ae int)
            (val x-c-e int)
            (val x-c-ne int)
            (val x-c-be int)
            (val x-c-a int)
            (val x-c-l int)
            (val x-c-g int)
            (val x-add int)
            (val x-or int)
            (val x-and int)
            (val x-sub int)
            (val x-cmp int)
            (val x-shr int)
            (val x-sar int)
            (val x-trap-common (ref int @k))
            (val x-exit-common (ref int @k))
            (val x-here (subr (maxeff (read @globals) (read @k)) () int))
            (val x-e (subr (maxeff x-assembles spin) (x-out) unit))
            (val x-label (subr (maxeff x-assembles spin) () int))
            (val x-bind (subr (maxeff x-assembles spin) (int) unit))
            (val x-to (subr (maxeff x-assembles spin) (int x-out) unit))
            (val x-jmp (subr (maxeff x-assembles spin) (int) unit))
            (val x-jcc (subr (maxeff x-assembles spin) (int int) unit))
            (val x-trap (subr (maxeff x-assembles spin) (int int) unit))
            (val x-trap-if (subr (maxeff x-assembles spin) (int int int) unit))
            (val x-label-at (subr (maxeff (read @globals) (read @k)) (int) int))
            (val x-flush-stubs (subr (maxeff x-assembles spin) () unit))
            (val x-finish (subr (maxeff x-assembles spin) () x-out))
            (val x-reset (subr (maxeff x-assembles spin) () unit))
            (val x-field (subr pure (int) int))
            (val x-load (subr (maxeff x-assembles spin) (int int int) unit))
            (val x-store (subr (maxeff x-assembles spin) (int int int) unit))
            (val x-mov (subr (maxeff x-assembles spin) (int int) unit))
            (val x-alu (subr (maxeff x-assembles spin) (int int int) unit))
            (val x-alu-imm (subr (maxeff x-assembles spin) (int int int) unit))
            (val x-lea (subr (maxeff x-assembles spin) (int int int) unit))
            (val x-enter-cur (subr (maxeff x-assembles spin) (int) unit))
            (val x-fp-encode (subr (maxeff x-assembles spin) (int) unit))
            (val x-fp-decode (subr (maxeff x-assembles spin) (int) unit))
            (val x-save (subr (maxeff x-assembles spin) () unit))
            (val x-load-state (subr (maxeff x-assembles spin) () unit))
            (val x-cmp-value (subr (maxeff x-assembles spin) (int int) unit))
            (val x-boolean (subr (maxeff x-assembles spin) (int int) unit))
            (val x-push-ds (subr (maxeff x-assembles spin) (int) unit))
            (val x-pop-ds (subr (maxeff x-assembles spin) (int) unit))
            (val x-pass-mark (subr (maxeff x-assembles spin) (int int) unit))
            (val x-fuel (subr (maxeff x-assembles spin) () unit))
            (val x-ds-limit (subr (maxeff x-assembles spin) () unit))
            (val x-rs-limit (subr (maxeff x-assembles spin) () unit))))

;; A register word's machine code (`native-x64-regs.fx`): its bytes, where
;; each cell's resume point is (-1 for none), and why it cannot be
;; compiled ("" if it can).
(define-type x-regs-assembled (productof (1 x-out) (2 x-out) (3 string)))

;; What `native-x64-regs.fx` is given of the x86_64 machine's register code
;; (`native-x64-regs-layout.fx`, generated).
(define-type native-x64-regs-layout-sig
  (moduleof (val r-result int)
            (val r-rdi int)
            (val r-rsi int)
            (val r-r8 int)
            (val r-rcx int)
            (val r-rdx int)
            (val r-t int)
            (val r-sp int)
            (val r-st-regs int)
            (val r-st-leaf-link int)
            (val r-st-pure int)
            (val r-st-top int)
            (val r-st-alloc-limit int)
            (val r-st-words int)
            (val r-st-regions int)
            (val r-st-reserve int)
            (val r-st-slice int)
            (val r-null int)
            (val r-unspecified int)
            (val r-char0 int)
            (val r-f32-0 int)
            (val r-tag-header int)
            (val r-kind-extension int)
            (val r-region-slots int)
            (val r-regs int)
            (val r-trap-prim int)
            (val r-operands (subr pure (int) int))
            (val r-prim-name (subr pure (int) string))
            (val r-prim-number (subr pure (string) int))
            (val r-never-collects? (subr pure (int) bool))
            (val r-shape-kind (subr pure (string int) int))))

;; What the conductor names of the register code's compiler, for Rust.
(define-type native-x64-regs-sig
  (moduleof (val native-assemble-x64-regs (subr (maxeff x-assembles spin) (tword) x-regs-assembled))
            (val native-adapter-x64 (subr (maxeff x-assembles spin) (int int) x-out))))

;; What `native-x64-regs.fx` uses of `native-x64-regs-ops.fx`: the helpers
;; the two share, register code's fast paths, and what it does inline.
(define-type native-x64-regs-ops-sig
  (moduleof (val rg-c-ns int)
            (val rg-c-ge int)
            (val rg-xor int)
            (val rg-shl int)
            (val rg-pow2-times (subr (maxeff (read @globals) spin) (int int) int))
            (val rg-pow2 (subr (maxeff (read @globals) spin) (int) int))
            (val rg-signed (subr pure (int) int))
            (val rg-header (subr (maxeff (read @globals) spin) (int int) int))
            (val rg-in-reg (subr pure (int) int))
            (val rg-reg-off (subr pure (int) int))
            (val rg-bits (subr pure (tword int) int))
            (val rg-get (subr (maxeff x-assembles spin) (int int) int))
            (val rg-put (subr (maxeff x-assembles spin) (int int) unit))
            (val rg-cell (subr (maxeff x-assembles spin) (int int) unit))
            (val rg-constant (subr (maxeff x-assembles spin) (int tword int) unit))
            (val rg-value (subr (maxeff x-assembles spin) (int int) unit))
            (val rg-card-mark (subr (maxeff x-assembles spin) (int int int int) unit))
            (val rg-int-fast (subr (maxeff x-assembles spin) (string int int) bool))
            (val rg-kinds (subr (maxeff x-assembles spin) (string int int) unit))
            (val rg-shape-test (subr (maxeff x-assembles spin) (int string int) bool))
            (val rg-bump-words (subr (maxeff x-assembles spin) (int bool int) unit))
            (val rg-bloblet-at (subr (maxeff x-assembles spin) (int) unit))
            (val rg-bloblet-done (subr (maxeff x-assembles spin) (int) unit))
            (val rg-field-at (subr (maxeff x-assembles spin) (int int int) unit))
            (val rg-reg-field-at (subr (maxeff x-assembles spin) (int int int) unit))
            (val rg-reg-fields (subr (maxeff x-assembles spin) (int int int) unit))
            (val rg-frees (subr (maxeff x-assembles spin) (int int int int) unit))
            (val rg-yes-no (subr (maxeff x-assembles spin) (int int int) unit))
            (val rg-two-fixnums (subr (maxeff x-assembles spin) (int) unit))
            (val rg-field-check (subr (maxeff x-assembles spin) (int) unit))
            (val rg-ascii (subr (maxeff x-assembles spin) (int) unit))
            (val rg-shape-name (subr pure (string) string))
            (val rg-inline-op (subr (maxeff x-assembles spin) (string int int int) unit))
            (val rg-inline-name (subr pure (int int int) string))))

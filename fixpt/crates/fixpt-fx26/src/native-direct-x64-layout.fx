      ((514) 9) ((515) 2) ((516) 2) ((517) 1) ((518) 1) ((519) 2) ((520) 1) ((521) 2) ((522) 1)
      ((523) 1) ((524) 1) ((525) 1) ((526) 2) ((527) 1) ((528) 2) ((529) 1)
      (else -1))))

;; Routine `n`'s name, "?" past them.
(define d-routine-name (subr pure (int) string)
  (lambda (n)
    (case n
      ((0) "docol") ((1) "exit") ((2) "halt") ((3) "lit") ((4) "branch") ((5) "0branch")
      ((6) "execute") ((7) "dup") ((8) "drop") ((9) "swap") ((10) "over") ((11) "+") ((12) "-")
      ((13) "<") ((14) "eq") ((15) "field@") ((16) "field!") ((17) "cons") ((18) "car") ((19) "cdr")
      ((20) "slot") ((21) "slot!") ((22) "free") ((23) "global") ((24) "global!") ((25) "closure")
      ((26) "call") ((27) "tailcall") ((28) "return") ((29) "prim") ((30) "prompt") ((31) "abort")
      ((32) "callcomp") ((33) "callcc") ((34) "withmark") ((35) "firstmark") ((36) "currentmarks")
      ((37) "marksof") ((38) "withmark-tail") ((39) "tcall") ((40) "ttailcall") ((41) "resume")
      ((42) "undefined") ((43) "int-add") ((44) "int-sub") ((45) "int-less") ((46) "pair-car")
      ((47) "pair-cdr") ((48) "field") ((49) "rest") ((50) "int-eq") ((51) "nclosure")
      ((52) "ncallcomp") ((53) "ncallcc") ((54) "callone") ((55) "ncallone")
      (else "?"))))

;; Register-code instruction `n`'s name.
(define d-op-name (subr pure (int) string)
  (lambda (n)
    (case n
      ((0) "args") ((1) "const") ((2) "global") ((3) "setglbl") ((4) "reg") ((5) "setreg")
      ((6) "movereg") ((7) "lexical") ((8) "save") ((9) "pop") ((10) "stack") ((11) "setstk")
      ((12) "load") ((13) "store") ((14) "op1") ((15) "op2") ((16) "op2imm") ((17) "field")
      ((18) "setfield") ((19) "prim") ((20) "lambda") ((21) "invoke") ((22) "tailinvoke")
      ((23) "return") ((24) "branch") ((25) "branchf") ((26) "cellular") ((27) "invokeself")
      ((28) "global-guard") ((29) "brancht") ((30) "vargs") ((31) "prim1") ((32) "prim2")
      ((33) "prim2imm") ((34) "prim3imm")
      (else "?"))))

;; How many operand cells follow register-code instruction `n`.
(define d-operands (subr pure (int) int)
  (lambda (n)
    (case n
      ((0) 1) ((1) 1) ((2) 1) ((3) 1) ((4) 1) ((5) 1) ((6) 2) ((7) 1) ((8) 1) ((9) 1) ((10) 1)
      ((11) 1) ((12) 2) ((13) 2) ((14) 1) ((15) 2) ((16) 2) ((17) 1) ((18) 2) ((19) 2) ((20) 3)
      ((21) 2) ((22) 2) ((24) 1) ((25) 1) ((26) 2) ((27) 1) ((28) 3) ((29) 1) ((31) 1) ((32) 2)
      ((33) 2) ((34) 3)
      (else 0))))

;; The number of the register-code instruction named `n`.
(define d-op-number (subr pure (string) int)
  (lambda (n)
    (case n
      (("args") 0) (("const") 1) (("global") 2) (("setglbl") 3) (("reg") 4) (("setreg") 5)
      (("movereg") 6) (("lexical") 7) (("save") 8) (("pop") 9) (("stack") 10) (("setstk") 11)
      (("load") 12) (("store") 13) (("op1") 14) (("op2") 15) (("op2imm") 16) (("field") 17)
      (("setfield") 18) (("prim") 19) (("lambda") 20) (("invoke") 21) (("tailinvoke") 22)
      (("return") 23) (("branch") 24) (("branchf") 25) (("cellular") 26) (("invokeself") 27)
      (("global-guard") 28) (("brancht") 29) (("vargs") 30) (("prim1") 31) (("prim2") 32)
      (("prim2imm") 33) (("prim3imm") 34)
      (else -1))))

;; The number of the routine named `n`, -1 for none.
(define d-routine-number (subr pure (string) int)
  (lambda (n)
    (case n
      (("docol") 0) (("exit") 1) (("halt") 2) (("lit") 3) (("branch") 4) (("0branch") 5)
      (("execute") 6) (("dup") 7) (("drop") 8) (("swap") 9) (("over") 10) (("+") 11) (("-") 12)
      (("<") 13) (("eq") 14) (("field@") 15) (("field!") 16) (("cons") 17) (("car") 18) (("cdr") 19)
      (("slot") 20) (("slot!") 21) (("free") 22) (("global") 23) (("global!") 24) (("closure") 25)
      (("call") 26) (("tailcall") 27) (("return") 28) (("prim") 29) (("prompt") 30) (("abort") 31)
      (("callcomp") 32) (("callcc") 33) (("withmark") 34) (("firstmark") 35) (("currentmarks") 36)
      (("marksof") 37) (("withmark-tail") 38) (("tcall") 39) (("ttailcall") 40) (("resume") 41)
      (("undefined") 42) (("int-add") 43) (("int-sub") 44) (("int-less") 45) (("pair-car") 46)
      (("pair-cdr") 47) (("field") 48) (("rest") 49) (("int-eq") 50) (("nclosure") 51)
      (("ncallcomp") 52) (("ncallcc") 53) (("callone") 54) (("ncallone") 55)
      (else -1))))

;;; The checker, in FX-26: its types as reps (`docs/research/heap-types.md`,
;;; `TODO.md` §202, step 2): a type's nodes, as the Rust checker's export
;;; makes them (`reps.rs`, whose table of heads this follows), given to the
;;; runtime, which makes the rep canonical (`rep-of-nodes`, `fixpt-reps`).
;;; Both checkers' reps of one type are one rep: the agreement, by reps.
;;; And a rep imported, a type of this checker's (`k-rep-ty`).
;;; Made by `check-program.fx`, of what it is given (`load-input`).

(let* ((check-types-types (load-module "fx26:check-types-types.fx"))
       (check-effects-types (load-module "fx26:check-effects-types.fx")))
  (lambda ((check-types (select check-types-types check-types-sig))
           (check-effects (select check-effects-types check-effects-sig)))
    (module
(hide (include check-types-types))
(hide (include check-types))
(import check-effects k-insert)

;; A node as the runtime takes it (`rep-of-nodes`): its slot, its head, whether
;; it is a set, its binders' names, its operands.
(define-type k-rarg
  (sumof (node int) (bound (productof (1 int) (2 int))) (hole int)
         (const (productof (1 string) (2 int) (3 string))) (sym symbol) (int int) (flag bool)))
(define-type k-rargs (listof k-rarg acyclic))
(define-type k-rnode (productof (1 int) (2 symbol) (3 bool) (4 k-names) (5 k-rargs)))
(define-type k-rnodes (listof k-rnode acyclic))

;; The export's state: the nodes made, newest first; the next slot; each
;; type's slot, once given one; the variables bound where the walk is,
;; innermost first, each with its binder's slot and place; the holes, each
;; variable's number, and their names, newest first.
(define rp-nodes (ref k-rnodes @t) (new nil))
(define rp-next (ref int @t) (new 0))
(define rp-memo (ref (listof (pairof int int @t) acyclic) @t) (new nil))
;; Each generative type's definition's slot, once made (`rp-gendef`).
(define rp-gendefs (ref (listof (pairof int int @t) acyclic) @t) (new nil))
(define rp-scope (ref (listof (productof (1 int) (2 int) (3 int)) acyclic) @t) (new nil))
(define rp-holes (ref (listof (pairof int int @t) acyclic) @t) (new nil))
(define rp-hole-names (ref k-names @t) (new nil))
(define rp-nholes (ref int @t) (new 0))
;; Whether the type exported last has a part a rep does not take (an
;; unresolved `select`), its rep then no type's.
(define rp-declined (ref bool @t) (new #f))

(define rp-reserve (->* () int)
  (lambda () (let ((n (get rp-next))) (begin (set rp-next (+ n 1)) n))))
(define rp-fill (->* (int symbol bool k-names k-rargs) unit)
  (lambda (slot head unordered binders args)
    (set rp-nodes (cons (product (1 slot) (2 head) (3 unordered) (4 binders) (5 args))
                        (get rp-nodes)))))
;; A node of no binders, as an operand.
(define rp-node (->* (string k-rargs) k-rarg)
  (lambda (head args)
    (let ((slot (rp-reserve)))
      (begin (rp-fill slot (string->symbol head) #f nil args) (sum node slot)))))
(define rp-set (->* (string k-rargs) k-rarg)
  (lambda (head args)
    (let ((slot (rp-reserve)))
      (begin (rp-fill slot (string->symbol head) #t nil args) (sum node slot)))))
(define rp-sym (->* (string) k-rarg) (lambda (s) (sum sym (string->symbol s))))

(define rp-assoc (->* ((listof (pairof int int @t) acyclic) int) int)
  (lambda (xs k)
    (cond ((null? xs) -1) ((= (car (car xs)) k) (cdr (car xs))) (else (rp-assoc (cdr xs) k)))))
;; Variable `v`: bound, by its binder; else a hole, one for it.
(define rp-var (->* (int) k-rarg)
  (lambda (v)
    (letrec ((find (->* ((listof (productof (1 int) (2 int) (3 int)) acyclic)) k-rarg)
               (lambda (s)
                 (cond ((null? s)
                        (let ((h (rp-assoc (get rp-holes) v)))
                          (if (>= h 0)
                              (sum hole h)
                              (let ((n (get rp-nholes)))
                                (begin (set rp-holes (cons (cons v n) (get rp-holes)))
                                       (set rp-hole-names
                                            (cons (k-dvar-name v) (get rp-hole-names)))
                                       (set rp-nholes (+ n 1))
                                       (sum hole n))))))
                       ((= (extract (car s) 1) v)
                        (sum bound (product (1 (extract (car s) 2)) (2 (extract (car s) 3)))))
                       (else (find (cdr s)))))))
      (find (get rp-scope)))))

(define rp-kind-name (->* (int) string)
  (lambda (k)
    (case k ((0) "region") ((1) "effect") ((3) "place") ((4) "data") ((5) "size") ((6) "conv")
            ((7) "flat") ((8) "sendable") (else "type"))))
(define-rec
  (rp-kind (->* (int) k-rarg)
    (lambda (k)
      (if (k-arrow-kind? k)
          (rp-node "=>" (rp-kinds-then (k-arrow-params k) (k-arrow-result k)))
          (rp-node (rp-kind-name k) nil))))
  (rp-kinds-then (->* (k-ids int) k-rargs)
    (lambda (ks r)
      (if (null? ks) (list (rp-kind r)) (cons (rp-kind (car ks)) (rp-kinds-then (cdr ks) r))))))

(define rp-region (->* (k-region) k-rarg)
  (lambda (r)
    (tagcase r
      (r-var (v) (rp-var v))
      (r-const (s) (rp-node "rconst" (list (sum sym s))))
      (r-fresh (n s) (rp-node "rfresh" (list (sum int n) (rp-sym s))))
      (r-frozen (p f)
        (rp-node "frozen" (if (< p 0) (list (sum flag f)) (list (sum flag f) (rp-var p)))))
      (r-heap () (rp-node "heap" nil))
      (r-global (g) (rp-node "global" (list (sum sym g))))
      (r-globals () (rp-node "globals" nil)))))

(define-rec
  ;; An effect: a set of its atoms (`reps.rs`), in no order of this checker's.
  (rp-effect (->* (k-eff) k-rarg)
    (lambda (e) (rp-set "effect" (rp-atoms e))))
  (rp-atoms (->* (k-eff) k-rargs)
    (lambda (e) (if (null? e) nil (cons (rp-atom (car e)) (rp-atoms (cdr e))))))
  (rp-atom (->* (k-atom) k-rarg)
    (lambda (a)
      (tagcase a
        (a-read (r) (rp-node "read" (list (rp-region r))))
        (a-write (r) (rp-node "write" (list (rp-region r))))
        (a-alloc (r) (rp-node "alloc" (list (rp-region r))))
        (a-goto (r) (rp-node "goto" (list (rp-region r))))
        (a-comefrom (r) (rp-node "comefrom" (list (rp-region r))))
        (a-await (r) (rp-node "await" (list (rp-region r))))
        (a-init (r) (rp-node "init" (list (rp-region r))))
        (a-send (r) (rp-node "send" (list (rp-region r))))
        (a-receive (r) (rp-node "receive" (list (rp-region r))))
        (a-spin () (rp-node "spin" nil))
        (a-io (k) (rp-node "io" (list (rp-sym (k-io-kind-name k)))))
        (a-nondet () (rp-node "nondet" nil))
        (a-stage () (rp-node "stage" nil))
        (a-var (v) (rp-var v))
        (a-app (v ds) (rp-node "eapp" (cons (rp-var v) (rp-eargs ds)))))))
  (rp-eargs (->* (k-descs) k-rargs)
    (lambda (ds) (if (null? ds) nil (cons (rp-earg (car ds)) (rp-eargs (cdr ds))))))
  (rp-earg (->* (k-desc) k-rarg)
    (lambda (d)
      (tagcase d
        (dr (r) (rp-node "e-region" (list (rp-region r))))
        (de (e) (rp-node "e-effect" (list (rp-effect e))))
        (dz (z) (rp-node "e-size" (list (rp-size z))))
        (dc (c) (rp-node "e-conv" (list (rp-conv c))))
        (else y (rp-node "e-type" nil)))))
  (rp-size (->* (k-size) k-rarg)
    (lambda (z)
      (tagcase z
        (sz-finite () (rp-node "finite" nil))
        (sz-lin (k ts) (rp-node "lin" (list (sum int k) (rp-set "terms" (rp-terms ts))))))))
  (rp-terms (->* (k-terms) k-rargs)
    (lambda (ts)
      (if (null? ts)
          nil
          (cons (rp-node "term" (list (rp-var (car (car ts))) (sum int (cdr (car ts)))))
                (rp-terms (cdr ts))))))
  (rp-conv (->* (k-conv) k-rarg)
    (lambda (c)
      (tagcase c
        (cv-cellular () (rp-node "cellular" nil))
        (cv-native () (rp-node "native" nil))
        (cv-fx () (rp-node "fx" nil))
        (cv-var (v) (rp-var v))))))

;; The relation of code `o`, as the Rust checker's `Rel` writes it.
(define rp-rel-name (->* (int) string)
  (lambda (o) (case o ((0) "lt") ((1) "le") ((2) "eq") (else "ne"))))
(define-rec
  (rp-formula (->* (k-sf) k-rarg)
    (lambda (f)
      (tagcase f
        (sf-true () (rp-node "true" nil))
        (sf-false () (rp-node "false" nil))
        (sf-rel (o a b) (rp-node "rel" (list (rp-sym (rp-rel-name o)) (rp-expr a) (rp-expr b))))
        (sf-holds (x) (rp-node "holds" (list (rp-named x))))
        (sf-not (g) (rp-node "not" (list (rp-formula g))))
        (sf-and (gs) (rp-node "and" (rp-formulas gs)))
        (sf-or (gs) (rp-node "or" (rp-formulas gs)))
        (sf-implies (g h) (rp-node "implies" (list (rp-formula g) (rp-formula h)))))))
  (rp-formulas (->* (k-sfs) k-rargs)
    (lambda (gs) (if (null? gs) nil (cons (rp-formula (car gs)) (rp-formulas (cdr gs))))))
  ;; An expression: arithmetic, or a name the Rust checker's `Named` is, as
  ;; `(atom …)`.
  (rp-expr (->* (k-sx) k-rarg)
    (lambda (x)
      (tagcase x
        (sx-lit (k) (rp-node "lit" (list (sum int k))))
        (sx-add (a b) (rp-node "add" (list (rp-expr a) (rp-expr b))))
        (sx-sub (a b) (rp-node "sub" (list (rp-expr a) (rp-expr b))))
        (sx-mul (a b) (rp-node "mul" (list (rp-expr a) (rp-expr b))))
        (else y (rp-node "atom" (list (rp-named x)))))))
  (rp-exprs (->* (k-sxs) k-rargs)
    (lambda (xs) (if (null? xs) nil (cons (rp-expr (car xs)) (rp-exprs (cdr xs))))))
  (rp-named (->* (k-sx) k-rarg)
    (lambda (x)
      (tagcase x
        (sx-param (i) (rp-node "param" (list (sum int i))))
        (sx-result () (rp-node "result" nil))
        (sx-length (i) (rp-node "length" (list (sum int i))))
        (sx-shape (i j) (rp-node "shape" (list (sum int i) (sum int j))))
        (sx-acyclic (i) (rp-node "acyclic" (list (sum int i))))
        (sx-nat (i) (rp-node "nat" (list (sum int i))))
        (sx-length-is (i j) (rp-node "length-is" (list (sum int i) (sum int j))))
        (sx-call (f xs) (rp-node "call" (cons (sum sym f) (rp-exprs xs))))
        (else y (rp-node "atom" (list (rp-expr x))))))))

;; A specification: its names (parameters', then the result's) its binders'.
(define rp-spec (->* (k-spec) k-rarg)
  (lambda (s)
    (let ((slot (rp-reserve)))
      (begin
        (rp-fill slot 'spec #f (append (extract s 1) (list (extract s 2)))
                (list (rp-formula (extract s 3)) (rp-formula (extract s 4))))
        (sum node slot)))))

;; The binders `bs` of node `slot` in scope, from place `pos`; their nodes.
(define rp-bind (->* (k-binders int int) unit)
  (lambda (bs slot pos)
    (if (null? bs)
        #u
        (begin (set rp-scope (cons (product (1 (extract (car bs) 1)) (2 slot) (3 pos))
                                   (get rp-scope)))
               (rp-bind (cdr bs) slot (+ pos 1))))))
(define rp-binder-nodes (->* (k-binders) k-rargs)
  (lambda (bs)
    (if (null? bs)
        nil
        (let* ((v (extract (car bs) 1))
               (bound (k-bound-of v))
               (args (cons (rp-kind (extract (car bs) 2))
                           (cons (sum flag (k-distinct-var? v))
                                 (if (null? bound) nil (list (rp-region (car bound))))))))
          (cons (rp-node "binder" args) (rp-binder-nodes (cdr bs)))))))
(define rp-binder-names (->* (k-binders) k-names)
  (lambda (bs)
    (if (null? bs) nil (cons (k-dvar-name (extract (car bs) 1)) (rp-binder-names (cdr bs))))))
;; A module's abstract types as binders: each variable and its kind.
(define rp-abs-binders (->* (k-parts) k-binders)
  (lambda (ps)
    (if (null? ps)
        nil
        (let* ((v (extract (car ps) 2)) (k (k-dvar-kind v)))
          (cons (product (1 v) (2 (if (< k 0) 2 k))) (rp-abs-binders (cdr ps)))))))
;; Variances as `reps.rs` writes them: `+`, `-`, `=` (0, 1, 2).
(define rp-variances (->* (k-ids) k-rargs)
  (lambda (vs)
    (if (null? vs)
        nil
        (cons (rp-sym (case (car vs) ((0) "+") ((1) "-") (else "="))) (rp-variances (cdr vs))))))
(define rp-labels (->* (k-parts) k-names)
  (lambda (ps) (if (null? ps) nil (cons (extract (car ps) 1) (rp-labels (cdr ps))))))

(define-rec
  ;; Type `t`'s node, as an operand.
  (rp-ty (->* (int) k-rarg)
    (lambda (t0)
      (let* ((t (k-resolve t0)) (had (rp-assoc (get rp-memo) t)))
        (if (>= had 0)
            (sum node had)
            (let ((slot (rp-reserve)))
              (begin (set rp-memo (cons (cons t slot) (get rp-memo)))
                     (rp-ty-at t slot)
                     (sum node slot)))))))
  (rp-tys (->* (k-ids) k-rargs)
    (lambda (ts) (if (null? ts) nil (cons (rp-ty (car ts)) (rp-tys (cdr ts))))))
  ;; Generative type `g`'s definition, for a checker that has not got it to
  ;; make it (`reps.rs`'s `gendef`): `(gendef {params} binder… (variances
  ;; v…) rep)`; once for each, so a recursive one's representation names
  ;; it again.
  (rp-gendef (->* (int) k-rarg)
    (lambda (g)
      (let ((had (rp-assoc (get rp-gendefs) g)))
        (if (>= had 0)
            (sum node had)
            (let* ((gen (k-gen-of g)) (slot (rp-reserve))
                   (u (set rp-gendefs (cons (cons g slot) (get rp-gendefs))))
                   (saved (get rp-scope)) (bs (extract gen 2)) (b (rp-bind bs slot 0))
                   (nodes (rp-binder-nodes bs))
                   (vs (rp-node "variances" (rp-variances (extract gen 3))))
                   (r (rp-ty (extract gen 4))))
              (begin (set rp-scope saved)
                     (rp-fill slot 'gendef #f (rp-binder-names bs) (append nodes (list vs r)))
                     (sum node slot)))))))
  (rp-parts (->* (k-parts) k-rargs)
    (lambda (ps)
      (if (null? ps)
          nil
          (cons (sum sym (extract (car ps) 1))
                (cons (rp-ty (extract (car ps) 2)) (rp-parts (cdr ps)))))))
  (rp-desc (->* (k-desc) k-rarg)
    (lambda (d)
      (tagcase d
        (dr (r) (rp-node "d-region" (list (rp-region r))))
        (de (e) (rp-node "d-effect" (list (rp-effect e))))
        (dt (t) (rp-node "d-type" (list (rp-ty t))))
        (dz (z) (rp-node "d-size" (list (rp-size z))))
        (dc (c) (rp-node "d-conv" (list (rp-conv c))))
        (df (f) (rp-node "d-fun" (list (rp-ty f)))))))
  (rp-descs (->* (k-descs) k-rargs)
    (lambda (ds) (if (null? ds) nil (cons (rp-desc (car ds)) (rp-descs (cdr ds))))))
  ;; Node `slot`, type `t`'s, filled.
  (rp-ty-at (->* (int int) unit)
    (lambda (t slot)
      (tagcase (k-get t)
        (ty-base (s) (rp-fill slot 'base #f nil (list (sum sym s))))
        (ty-void () (rp-fill slot 'void #f nil nil))
        (ty-nil () (rp-fill slot 'nil #f nil nil))
        (ty-false () (rp-fill slot 'false #f nil nil))
        (ty-union (ms) (rp-fill slot 'oneof #f nil (rp-tys ms)))
        (ty-allof (ms) (rp-fill slot 'allof #f nil (rp-tys ms)))
        (ty-var (v) (rp-fill slot 'var #f nil (list (rp-var v))))
        (ty-subr (e ps r cv spc)
          (rp-fill slot 'subr #f nil
                  (append (list (rp-conv cv) (rp-effect e) (rp-node "params" (rp-tys ps)) (rp-ty r))
                          (if (null? spc) nil (list (rp-spec (car spc)))))))
        (ty-poly (bs body)
          (let* ((saved (get rp-scope)) (u (rp-bind bs slot 0)) (nodes (rp-binder-nodes bs))
                 (b (rp-ty body)))
            (begin (set rp-scope saved)
                   (rp-fill slot 'poly #f (rp-binder-names bs) (append nodes (list b))))))
        (ty-ref (a r) (rp-fill slot 'ref #f nil (list (rp-ty a) (rp-region r))))
        (ty-pair (a b r nl)
          (rp-fill slot 'pairof #f nil (list (rp-ty a) (rp-ty b) (rp-region r) (sum flag nl))))
        (ty-tag (a h e r)
          (rp-fill slot 'prompt-tag #f nil (list (rp-ty a) (rp-ty h) (rp-effect e) (rp-region r))))
        (ty-comp (x a e r once)
          (rp-fill slot 'composable #f nil
                  (list (rp-ty x) (rp-ty a) (rp-effect e) (rp-region r) (sum flag once))))
        (ty-markkey (a r) (rp-fill slot 'mark-key #f nil (list (rp-ty a) (rp-region r))))
        (ty-product (ps) (rp-fill slot 'productof #f nil (rp-parts ps)))
        (ty-sum (ps) (rp-fill slot 'sumof #f nil (rp-parts ps)))
        (ty-array (a z r)
          (rp-fill slot 'narrayof #f nil (list (rp-ty a) (rp-size z) (rp-region r))))
        (ty-icell (a r) (rp-fill slot 'icell #f nil (list (rp-ty a) (rp-region r))))
        (ty-place (r) (rp-fill slot 'place #f nil (list (rp-region r))))
        (ty-nat (z) (rp-fill slot 'nat #f nil (list (rp-size z))))
        (ty-bloblet (fs z r)
          (rp-fill slot 'bloblet #f nil (cons (sum flag z) (cons (rp-region r) (rp-tys fs)))))
        (ty-named (g ds)
          (let* ((gen (k-gen-of g))
                 (n (k-length (extract gen 2)))
                 (kind (if (= n 0) "type" (string-append "generative/" (int->string n))))
                 (c (sum const (product (1 (symbol->string (extract gen 1))) (2 g) (3 kind)))))
            (rp-fill slot 'named #f nil (cons c (cons (rp-gendef g) (rp-descs ds))))))
        (ty-nlist (a z r) (rp-fill slot 'nlist #f nil (list (rp-ty a) (rp-size z) (rp-region r))))
        (ty-module (abs ds vs)
          (let* ((saved (get rp-scope)) (bs (rp-abs-binders abs)) (u (rp-bind bs slot 0))
                 (nodes (rp-binder-nodes bs))
                 (descs (rp-node "descs" (rp-parts ds)))
                 (vals (rp-node "vals" (rp-parts vs))))
            (begin (set rp-scope saved)
                   (rp-fill slot 'moduleof #f (rp-labels abs) (append nodes (list descs vals))))))
        (ty-param (k n) (rp-fill slot 'param-sel #f nil (list (sum int k) (sum sym n))))
        (ty-lam (bs body)
          (let* ((saved (get rp-scope)) (u (rp-bind bs slot 0)) (nodes (rp-binder-nodes bs))
                 (b (rp-desc body)))
            (begin (set rp-scope saved)
                   (rp-fill slot 'dlambda #f (rp-binder-names bs) (append nodes (list b))))))
        (ty-app (g ds) (rp-fill slot 'app #f nil (cons (rp-ty g) (rp-descs ds))))
        (else y (begin (set rp-declined #t) (rp-fill slot 'declined #f nil nil)))))))

;; Type `t` as a rep, in its binary form: its nodes given the runtime, which
;; makes it canonical (`rep-of-nodes`).
(define k-ty-rep (->* (int) (bytevectorof @t))
  (lambda (t)
    (begin
      (rp-begin!)
      (let ((root (rp-ty t)))
        (tagcase root
          (node slot (rep-of-nodes (get rp-nodes) (reverse (get rp-hole-names)) slot))
          (else y (rep-of-nodes (get rp-nodes) nil 0)))))))
;; The export's state, as an export begins.
(define rp-begin! (->* () unit)
  (lambda ()
    (begin
      (set rp-nodes nil) (set rp-next 0) (set rp-memo nil) (set rp-gendefs nil) (set rp-scope nil)
      (set rp-holes nil) (set rp-hole-names nil) (set rp-nholes 0) (set rp-declined #f))))
;; A piece of evidence as a rep (`fixpt-reps`'s `fill`): its root an
;; `evidence` node of one operand, what `d` is, a type, an effect or a
;; region; its holes the variables it names, as `k-rep-holes` gives them.
(define k-evidence-rep (->* (k-desc) (bytevectorof @t))
  (lambda (d)
    (begin
      (rp-begin!)
      (let* ((of (tagcase d
                   (dt (t) (rp-ty t))
                   (de (e) (rp-effect e))
                   (dr (r) (rp-region r))
                   (else z (begin (set rp-declined #t) (rp-sym "none")))))
             (slot (rp-reserve)))
        (begin (rp-fill slot 'evidence #f nil (list of))
               (rep-of-nodes (get rp-nodes) (reverse (get rp-hole-names)) slot))))))
;; Whether the type `k-ty-rep` exported last has a part a rep does not
;; take (an unresolved `select`): its rep is then no type's.
(define k-rep-declined? (->* () bool) (lambda () (get rp-declined)))
;; The holes of the type `k-ty-rep` exported last, in order: the variables
;; each stands for.
(define k-rep-holes (->* () k-ids)
  (lambda ()
    (letrec ((at (->* (int) int)
                 (lambda (n)
                   (letrec ((find (->* ((listof (pairof int int @t) acyclic)) int)
                              (lambda (xs)
                                (cond ((null? xs) -1) ((= (cdr (car xs)) n) (car (car xs)))
                                                 (else (find (cdr xs)))))))
                     (find (get rp-holes)))))
             (from (->* (int k-ids) k-ids)
               (lambda (n acc) (if (< n 0) acc (from (- n 1) (cons (at n) acc))))))
      (from (- (get rp-nholes) 1) nil))))

;;; ------------------------------------------------------------ importing

;; The import's state: the rep's nodes, by slot; each node's type, once
;; made (-1 none); whether one is being made; its link, if met again while
;; it is (a cycle); the variables bound, by binder and place; the holes'.
(define ri-nodes (ref (arrayof k-rnode @t) @t)
  (new (make-array 0 (product (1 0) (2 'none) (3 #f) (4 (the k-names nil)) (5 (the k-rargs nil))))))
(define ri-done (ref (arrayof int @t) @t) (new (make-array 0 -1)))
(define ri-busy (ref (arrayof bool @t) @t) (new (make-array 0 #f)))
(define ri-links (ref (arrayof int @t) @t) (new (make-array 0 -1)))
(define ri-bound (ref (listof (productof (1 int) (2 int) (3 int)) acyclic) @t) (new nil))
(define ri-holes (ref k-ids @t) (new nil))
;; Each generative type made in this import from its definition
;; (`ri-generative`), by the definition's node: one type for every use.
(define ri-gendefs (ref (listof (pairof int int @t) acyclic) @t) (new nil))
;; Whether an import may make a generative type this checker has not got:
;; not where the rep is of this program's own types, which must find theirs
;; (a `.fasl`'s, `k-rep-making!`).
(define ri-making (ref bool @t) (new #t))
(define k-rep-making! (->* (bool) unit) (lambda (on) (set ri-making on)))

(define ri-node (->* (int) k-rnode) (lambda (k) (array-ref (get ri-nodes) k)))
(define ri-head (->* (int) string) (lambda (k) (symbol->string (extract (ri-node k) 2))))
(define ri-args (->* (int) k-rargs) (lambda (k) (extract (ri-node k) 5)))
(define ri-fail (->* (string) void) (lambda (why) (k-fail (string-append "a rep: " why) 0 0)))
(define ri-nth (->* (k-rargs int) k-rarg)
  (lambda (xs i)
    (cond ((null? xs) (begin (ri-fail "an operand missing") (sum flag #f)))
          ((= i 0) (car xs))
          (else (ri-nth (cdr xs) (- i 1))))))
(define ri-drop (->* (k-rargs int) k-rargs)
  (lambda (xs i) (if (or (= i 0) (null? xs)) xs (ri-drop (cdr xs) (- i 1)))))
(define ri-child (->* (k-rarg) int)
  (lambda (a) (tagcase a (node k k) (else y (begin (ri-fail "a node expected") 0)))))
(define ri-int (->* (k-rarg) int)
  (lambda (a) (tagcase a (int k k) (else y (begin (ri-fail "an integer expected") 0)))))
(define ri-flag (->* (k-rarg) bool)
  (lambda (a) (tagcase a (flag b b) (else y (begin (ri-fail "a flag expected") #f)))))
(define ri-sym (->* (k-rarg) symbol)
  (lambda (a) (tagcase a (sym s s) (else y (begin (ri-fail "a name expected") 'none)))))
;; Variances as `rp-variances` writes them, back: 0, 1, 2.
(define ri-variances (->* (k-rargs) k-ids)
  (lambda (xs)
    (if (null? xs)
        nil
        (let ((v (symbol->string (ri-sym (car xs)))))
          (cons (cond ((string=? v "+") 0) ((string=? v "-") 1) (else 2))
                (ri-variances (cdr xs)))))))
(define ri-var (->* (k-rarg) int)
  (lambda (a)
    (tagcase a
      (bound bp
        (letrec ((find (->* ((listof (productof (1 int) (2 int) (3 int)) acyclic)) int)
                   (lambda (bs)
                     (cond ((null? bs) (begin (ri-fail "a variable not bound") 0))
                           ((and (= (extract (car bs) 1) (extract bp 1))
                                 (= (extract (car bs) 2) (extract bp 2)))
                            (extract (car bs) 3))
                           (else (find (cdr bs)))))))
          (find (get ri-bound))))
      (hole i (k-nth (get ri-holes) i))
      (else y (begin (ri-fail "a variable expected") 0)))))
(define ri-variable? (->* (k-rarg) bool)
  (lambda (a) (tagcase a (bound bp #t) (hole i #t) (else y #f))))

(define ri-kind-code (->* (string) int)
  (lambda (n)
    (cond ((string=? n "region") 0) ((string=? n "effect") 1) ((string=? n "place") 3)
          ((string=? n "data") 4) ((string=? n "size") 5) ((string=? n "conv") 6)
          ((string=? n "flat") 7) ((string=? n "sendable") 8) (else 2))))
(define-rec
  (ri-kind (->* (k-rarg) int)
    (lambda (a)
      (let ((k (ri-child a)))
        (if (string=? (ri-head k) "=>")
            (let ((ks (ri-kinds (ri-args k))))
              (k-arrow (k-but-last ks) (k-last ks)))
            (ri-kind-code (ri-head k))))))
  (ri-kinds (->* (k-rargs) k-ids)
    (lambda (xs) (if (null? xs) nil (cons (ri-kind (car xs)) (ri-kinds (cdr xs)))))))
(define k-but-last (->* (k-ids) k-ids)
  (lambda (xs) (if (or (null? xs) (null? (cdr xs))) nil (cons (car xs) (k-but-last (cdr xs))))))
(define k-last (->* (k-ids) int)
  (lambda (xs) (cond ((null? xs) 2) ((null? (cdr xs)) (car xs)) (else (k-last (cdr xs))))))

(define ri-region (->* (k-rarg) k-region)
  (lambda (a)
    (if (ri-variable? a)
        (r-var (ri-var a))
        (let* ((k (ri-child a)) (h (ri-head k)) (args (ri-args k)))
          (cond ((string=? h "rconst") (r-const (ri-sym (ri-nth args 0))))
                ((string=? h "rfresh")
                 (r-fresh (ri-int (ri-nth args 0)) (symbol->string (ri-sym (ri-nth args 1)))))
                ((string=? h "frozen")
                 (r-frozen (if (null? (cdr args)) -1 (ri-var (ri-nth args 1)))
                           (ri-flag (ri-nth args 0))))
                ((string=? h "heap") (r-heap))
                ((string=? h "global") (r-global (ri-sym (ri-nth args 0))))
                ((string=? h "globals") (r-globals))
                (else (begin (ri-fail (string-append "no region " h)) (r-heap))))))))
;; The region operand `i` of `args`.
(define ri-region-in (->* (k-rargs int) k-region) (lambda (args i) (ri-region (ri-nth args i))))

(define-rec
  (ri-effect (->* (k-rarg) k-eff)
    (lambda (a) (ri-atoms (ri-args (ri-child a)) nil)))
  (ri-atoms (->* (k-rargs k-eff) k-eff)
    (lambda (xs e) (if (null? xs) e (ri-atoms (cdr xs) (k-insert (ri-atom (car xs)) e)))))
  (ri-atom (->* (k-rarg) k-atom)
    (lambda (a)
      (if (ri-variable? a)
          (a-var (ri-var a))
          (let* ((k (ri-child a)) (h (ri-head k)) (args (ri-args k)))
            (cond ((string=? h "read") (a-read (ri-region-in args 0)))
                  ((string=? h "write") (a-write (ri-region-in args 0)))
                  ((string=? h "alloc") (a-alloc (ri-region-in args 0)))
                  ((string=? h "goto") (a-goto (ri-region-in args 0)))
                  ((string=? h "comefrom") (a-comefrom (ri-region-in args 0)))
                  ((string=? h "await") (a-await (ri-region-in args 0)))
                  ((string=? h "init") (a-init (ri-region-in args 0)))
                  ((string=? h "send") (a-send (ri-region-in args 0)))
                  ((string=? h "receive") (a-receive (ri-region-in args 0)))
                  ((string=? h "spin") (a-spin))
                  ((string=? h "io")
                   (a-io (k-io-kind-code (symbol->string (ri-sym (ri-nth args 0))))))
                  ((string=? h "nondet") (a-nondet))
                  ((string=? h "stage") (a-stage))
                  ((string=? h "eapp") (a-app (ri-var (ri-nth args 0)) (ri-eargs (cdr args))))
                  (else (begin (ri-fail (string-append "no atom " h)) (a-spin))))))))
  (ri-eargs (->* (k-rargs) k-descs)
    (lambda (xs) (if (null? xs) nil (cons (ri-earg (car xs)) (ri-eargs (cdr xs))))))
  (ri-earg (->* (k-rarg) k-desc)
    (lambda (a)
      (let* ((k (ri-child a)) (h (ri-head k)) (x (ri-nth (ri-args k) 0)))
        (cond ((string=? h "e-region") (dr (ri-region x)))
              ((string=? h "e-effect") (de (ri-effect x)))
              ((string=? h "e-size") (dz (ri-size x)))
              (else (dc (ri-conv x)))))))
  (ri-size (->* (k-rarg) k-size)
    (lambda (a)
      (let* ((k (ri-child a)) (args (ri-args k)))
        (if (string=? (ri-head k) "finite")
            (sz-finite)
            (sz-lin (ri-int (ri-nth args 0)) (ri-terms (ri-args (ri-child (ri-nth args 1)))))))))
  (ri-terms (->* (k-rargs) k-terms)
    (lambda (xs)
      (if (null? xs)
          nil
          (let ((t (ri-args (ri-child (car xs)))))
            (cons (cons (ri-var (ri-nth t 0)) (ri-int (ri-nth t 1))) (ri-terms (cdr xs)))))))
  (ri-conv (->* (k-rarg) k-conv)
    (lambda (a)
      (if (ri-variable? a)
          (cv-var (ri-var a))
          (let ((h (ri-head (ri-child a))))
            (cond ((string=? h "cellular") (cv-cellular))
                  ((string=? h "native") (cv-native))
                  (else (cv-fx))))))))

(define ri-rel-code (->* (string) int)
  (lambda (n) (cond ((string=? n "lt") 0) ((string=? n "le") 1) ((string=? n "eq") 2) (else 3))))
(define-rec
  (ri-formula (->* (k-rarg) k-sf)
    (lambda (a)
      (let* ((k (ri-child a)) (h (ri-head k)) (args (ri-args k)))
        (cond ((string=? h "true") (sf-true))
              ((string=? h "false") (sf-false))
              ((string=? h "rel")
               (sf-rel (ri-rel-code (symbol->string (ri-sym (ri-nth args 0))))
                       (ri-expr (ri-nth args 1)) (ri-expr (ri-nth args 2))))
              ((string=? h "holds") (sf-holds (ri-named (ri-nth args 0))))
              ((string=? h "not") (sf-not (ri-formula (ri-nth args 0))))
              ((string=? h "and") (sf-and (ri-formulas args)))
              ((string=? h "or") (sf-or (ri-formulas args)))
              (else (sf-implies (ri-formula (ri-nth args 0)) (ri-formula (ri-nth args 1))))))))
  (ri-formulas (->* (k-rargs) k-sfs)
    (lambda (xs) (if (null? xs) nil (cons (ri-formula (car xs)) (ri-formulas (cdr xs))))))
  (ri-expr (->* (k-rarg) k-sx)
    (lambda (a)
      (let* ((k (ri-child a)) (h (ri-head k)) (args (ri-args k)))
        (cond ((string=? h "atom") (ri-named (ri-nth args 0)))
              ((string=? h "lit") (sx-lit (ri-int (ri-nth args 0))))
              ((string=? h "add") (sx-add (ri-expr (ri-nth args 0)) (ri-expr (ri-nth args 1))))
              ((string=? h "sub") (sx-sub (ri-expr (ri-nth args 0)) (ri-expr (ri-nth args 1))))
              (else (sx-mul (ri-expr (ri-nth args 0)) (ri-expr (ri-nth args 1))))))))
  (ri-exprs (->* (k-rargs) k-sxs)
    (lambda (xs) (if (null? xs) nil (cons (ri-expr (car xs)) (ri-exprs (cdr xs))))))
  (ri-named (->* (k-rarg) k-sx)
    (lambda (a)
      (let* ((k (ri-child a)) (h (ri-head k)) (args (ri-args k)))
        (cond ((string=? h "param") (sx-param (ri-int (ri-nth args 0))))
              ((string=? h "result") (sx-result))
              ((string=? h "length") (sx-length (ri-int (ri-nth args 0))))
              ((string=? h "shape") (sx-shape (ri-int (ri-nth args 0)) (ri-int (ri-nth args 1))))
              ((string=? h "acyclic") (sx-acyclic (ri-int (ri-nth args 0))))
              ((string=? h "nat") (sx-nat (ri-int (ri-nth args 0))))
              ((string=? h "length-is")
               (sx-length-is (ri-int (ri-nth args 0)) (ri-int (ri-nth args 1))))
              (else (sx-call (ri-sym (ri-nth args 0)) (ri-exprs (cdr args)))))))))

;; Node `k`'s binders made variables, bound; them and their kinds.
(define ri-binders (->* (int) k-binders)
  (lambda (k)
    (letrec ((make (->* (k-names k-rargs int) k-binders)
                   (lambda (ns xs pos)
                     (if (null? ns)
                         nil
                         (let* ((b (ri-args (ri-child (car xs))))
                                (kind (ri-kind (ri-nth b 0)))
                                (v (k-new-dvar-of (car ns) kind)))
                           (begin (set ri-bound (cons (product (1 k) (2 pos) (3 v)) (get ri-bound)))
                                  (cons (product (1 v) (2 kind))
                                        (make (cdr ns) (cdr xs) (+ pos 1))))))))
             (marks (->* (k-binders k-rargs) unit)
                    (lambda (bs xs)
                      (if (null? bs)
                          #u
                          (let* ((b (ri-args (ri-child (car xs)))) (v (extract (car bs) 1)))
                            (begin (if (ri-flag (ri-nth b 1)) (k-set-distinct v) #u)
                                   (if (null? (cdr (cdr b)))
                                       #u
                                       (let ((r (ri-region (ri-nth b 2))))
                                         (set k-bounds (cons (cons v r) (get k-bounds)))))
                                   (marks (cdr bs) (cdr xs))))))))
      (let ((bs (make (extract (ri-node k) 4) (ri-args k) 0)))
        (begin (marks bs (ri-args k)) bs)))))

(define-rec
  ;; Node `k`'s type.
  ;; A generative type this checker has not got, `name`, made from its
  ;; definition, node `def` (`rp-gendef`): its parameters, their variances
  ;; and its representation; once for each.
  (ri-generative (->* (string int) int)
    (lambda (name def)
      (let ((had (rp-assoc (get ri-gendefs) def)))
        (cond
          ((>= had 0) had)
          ((not (get ri-making))
           (begin (ri-fail (string-append "no generative type " name " here")) 0))
          (else
            (let* ((bs (ri-binders def)) (n (k-length bs)) (args (ri-args def))
                   (vs (ri-variances (ri-args (ri-child (ri-nth args n)))))
                   (g (get k-ngens)) (slot (k-slot)))
              (begin
                (set k-gens (cons (product (1 (string->symbol name)) (2 bs) (3 vs) (4 slot))
                                  (get k-gens)))
                (set k-ngens (+ g 1))
                (set ri-gendefs (cons (cons def g) (get ri-gendefs)))
                (k-set-link slot (ri-ty (ri-child (ri-nth args (+ n 1)))))
                g)))))))
  (ri-ty (->* (int) int)
    (lambda (k)
      (let ((done (array-ref (get ri-done) k)))
        (cond ((>= done 0) done)
              ((array-ref (get ri-busy) k)
               (let ((l (array-ref (get ri-links) k)))
                 (if (>= l 0) l (let ((s (k-slot))) (begin (array-set! (get ri-links) k s) s)))))
              (else
               (begin
                 (array-set! (get ri-busy) k #t)
                 (let* ((t (k-ty-new (ri-ty-of k)))
                        (l (array-ref (get ri-links) k))
                        (t (if (>= l 0) (begin (k-set-link l t) l) t)))
                   (begin (array-set! (get ri-busy) k #f) (array-set! (get ri-done) k t) t))))))))
  (ri-tys (->* (k-rargs) k-ids)
    (lambda (xs) (if (null? xs) nil (cons (ri-ty (ri-child (car xs))) (ri-tys (cdr xs))))))
  ;; The type of node operand `i` of `args`.
  (ri-ty-in (->* (k-rargs int) int) (lambda (args i) (ri-ty (ri-child (ri-nth args i)))))
  (ri-parts (->* (k-rargs) k-parts)
    (lambda (xs)
      (if (or (null? xs) (null? (cdr xs)))
          nil
          (cons (product (1 (ri-sym (car xs))) (2 (ri-ty (ri-child (car (cdr xs))))))
                (ri-parts (cdr (cdr xs)))))))
  (ri-desc (->* (k-rarg) k-desc)
    (lambda (a)
      (let* ((k (ri-child a)) (h (ri-head k)) (x (ri-nth (ri-args k) 0)))
        (cond ((string=? h "d-region") (dr (ri-region x)))
              ((string=? h "d-effect") (de (ri-effect x)))
              ((string=? h "d-type") (dt (ri-ty (ri-child x))))
              ((string=? h "d-size") (dz (ri-size x)))
              ((string=? h "d-conv") (dc (ri-conv x)))
              (else (df (ri-ty (ri-child x))))))))
  (ri-descs (->* (k-rargs) k-descs)
    (lambda (xs) (if (null? xs) nil (cons (ri-desc (car xs)) (ri-descs (cdr xs))))))
  (ri-spec (->* (int) k-spec)
    (lambda (k)
      (let* ((ns (extract (ri-node k) 4)) (args (ri-args k)))
        (product (1 (k-but-last-names ns)) (2 (k-last-name ns))
                 (3 (ri-formula (ri-nth args 0))) (4 (ri-formula (ri-nth args 1)))))))
  ;; What node `k` is, its parts made.
  (ri-ty-of (->* (int) k-ty)
    (lambda (k)
      (let* ((h (ri-head k)) (args (ri-args k)))
        (cond
          ((string=? h "base") (ty-base (ri-sym (ri-nth args 0))))
          ((string=? h "void") (ty-void))
          ((string=? h "nil") (ty-nil))
          ((string=? h "false") (ty-false))
          ((or (string=? h "oneof") (string=? h "union") (string=? h "anyof"))
           (ty-union (ri-tys args)))
          ((string=? h "allof") (ty-allof (ri-tys args)))
          ((string=? h "var") (ty-var (ri-var (ri-nth args 0))))
          ((string=? h "subr")
           (ty-subr (ri-effect (ri-nth args 1)) (ri-tys (ri-args (ri-child (ri-nth args 2))))
                    (ri-ty-in args 3) (ri-conv (ri-nth args 0))
                    (if (null? (ri-drop args 4)) nil (list (ri-spec (ri-child (ri-nth args 4)))))))
          ((string=? h "poly")
           (let* ((bs (ri-binders k)) (n (k-length bs)))
             (ty-poly bs (ri-ty (ri-child (ri-nth args n))))))
          ((string=? h "ref") (ty-ref (ri-ty-in args 0) (ri-region-in args 1)))
          ((string=? h "pairof")
           (ty-pair (ri-ty-in args 0) (ri-ty-in args 1)
                    (ri-region-in args 2) (ri-flag (ri-nth args 3))))
          ((string=? h "prompt-tag")
           (ty-tag (ri-ty-in args 0) (ri-ty-in args 1)
                   (ri-effect (ri-nth args 2)) (ri-region-in args 3)))
          ((string=? h "composable")
           (ty-comp (ri-ty-in args 0) (ri-ty-in args 1)
                    (ri-effect (ri-nth args 2)) (ri-region-in args 3) (ri-flag (ri-nth args 4))))
          ((string=? h "mark-key") (ty-markkey (ri-ty-in args 0) (ri-region-in args 1)))
          ((string=? h "productof") (ty-product (ri-parts args)))
          ((string=? h "sumof") (ty-sum (ri-parts args)))
          ((string=? h "narrayof")
           (ty-array (ri-ty-in args 0) (ri-size (ri-nth args 1)) (ri-region-in args 2)))
          ((string=? h "icell") (ty-icell (ri-ty-in args 0) (ri-region-in args 1)))
          ((string=? h "place") (ty-place (ri-region-in args 0)))
          ((string=? h "nat") (ty-nat (ri-size (ri-nth args 0))))
          ((string=? h "bloblet")
           (ty-bloblet (ri-tys (ri-drop args 2)) (ri-flag (ri-nth args 0)) (ri-region-in args 1)))
          ((string=? h "named")
           (tagcase (ri-nth args 0)
             (const c
               (ty-named (if (< (extract c 2) 0)
                             (ri-generative (extract c 1) (ri-child (ri-nth args 1)))
                             (extract c 2))
                         (ri-descs (cdr (cdr args)))))
             (else y (begin (ri-fail "a generative type expected") (ty-void)))))
          ((string=? h "nlist")
           (ty-nlist (ri-ty-in args 0) (ri-size (ri-nth args 1)) (ri-region-in args 2)))
          ((string=? h "moduleof")
           (let* ((bs (ri-binders k)) (n (k-length bs))
                  (abs (ri-abs (extract (ri-node k) 4) bs))
                  (ds (ri-parts (ri-args (ri-child (ri-nth args n)))))
                  (vs (ri-parts (ri-args (ri-child (ri-nth args (+ n 1)))))))
             (ty-module abs ds vs)))
          ((string=? h "param-sel") (ty-param (ri-int (ri-nth args 0)) (ri-sym (ri-nth args 1))))
          ((string=? h "dlambda")
           (let* ((bs (ri-binders k)) (n (k-length bs)))
             (ty-lam bs (ri-desc (ri-nth args n)))))
          ((string=? h "app") (ty-app (ri-ty-in args 0) (ri-descs (cdr args))))
          (else (begin (ri-fail (string-append "no type " h)) (ty-void))))))))
(define ri-abs (->* (k-names k-binders) k-parts)
  (lambda (ls bs)
    (if (or (null? ls) (null? bs))
        nil
        (cons (product (1 (car ls)) (2 (extract (car bs) 1))) (ri-abs (cdr ls) (cdr bs))))))
(define k-but-last-names (->* (k-names) k-names)
  (lambda (xs)
    (if (or (null? xs) (null? (cdr xs))) nil (cons (car xs) (k-but-last-names (cdr xs))))))
(define k-last-name (->* (k-names) symbol)
  (lambda (xs) (cond ((null? xs) '||) ((null? (cdr xs)) (car xs)) (else (k-last-name (cdr xs))))))

;; The generative types' names, in their table's order: what a rep's
;; constants are found by (`rep-nodes`).
(define ri-gen-names (->* () (listof string acyclic))
  (lambda ()
    (letrec ((go (->* ((listof k-gen acyclic) (listof string acyclic)) (listof string acyclic))
               (lambda (gs acc)
                 (if (null? gs)
                     acc
                     (go (cdr gs) (cons (symbol->string (extract (car gs) 1)) acc))))))
      (go (get k-gens) nil))))
(define ri-fill-array (->* ((arrayof k-rnode @t) k-rnodes) unit)
  (lambda (a ns)
    (if (null? ns)
        #u
        (begin (array-set! a (extract (car ns) 1) (car ns)) (ri-fill-array a (cdr ns))))))

;; Rep `bytes` (its binary form) as a type of this checker's, its holes the
;; variables `holes`.
(define k-rep-ty (->* ((bytevectorof @t) k-ids) int)
  (lambda (bytes holes)
    (let ((n (ri-begin! bytes holes))) (if (= n 0) (k-ty-new (ty-void)) (ri-ty 0)))))
;; A rep, its holes none, as a description: an effect, if it is evidence of
;; one (`fixpt-reps`'s `part`), else the type it is or is evidence of.
(define k-rep-desc (->* ((bytevectorof @t)) k-desc)
  (lambda (bytes)
    (let ((n (ri-begin! bytes nil)))
      (cond ((= n 0) (dt (k-ty-new (ty-void))))
            ((string=? (ri-head 0) "evidence")
             (let ((a (car (ri-args 0))))
               (if (string=? (ri-head (ri-child a)) "effect")
                   (de (ri-effect a))
                   (dt (ri-ty (ri-child a))))))
            (else (dt (ri-ty 0)))))))
;; Each type of a rep of several (`reps.rs`'s `export_tys`, its root a
;; `fasl-types` node), in order, its holes none: a `.fasl`'s definitions'.
(define k-rep-tys (->* ((bytevectorof @t)) k-ids)
  (lambda (bytes)
    (let ((n (ri-begin! bytes nil)))
      (letrec ((each (->* (k-rargs) k-ids)
                     (lambda (xs)
                       (if (null? xs) nil (cons (ri-ty (ri-child (car xs))) (each (cdr xs)))))))
        (if (= n 0) nil (each (ri-args 0)))))))
;; The import's state, for the nodes of rep `bytes`, its holes the variables
;; `holes`: how many nodes.
(define ri-begin! (->* ((bytevectorof @t) k-ids) int)
  (lambda (bytes holes)
    (let* ((got (rep-nodes bytes (ri-gen-names)))
           (nodes (extract got 1))
           (n (k-length nodes))
           (none (product (1 0) (2 'none) (3 #f) (4 (the k-names nil)) (5 (the k-rargs nil))))
           (arr (the (arrayof k-rnode @t) (make-array n none))))
      (begin
        (ri-fill-array arr nodes)
        (set ri-nodes arr)
        (set ri-done (make-array n -1))
        (set ri-busy (make-array n #f))
        (set ri-links (make-array n -1))
        (set ri-bound nil) (set ri-gendefs nil)
        (set ri-holes holes)
        n))))
)))

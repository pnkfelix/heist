      ((33) #t)  ; callcc
      ((34) #t)  ; withmark
      ((38) #t)  ; withmark-tail
      ((39) #t)  ; tcall
      ((40) #t)  ; ttailcall
      ((41) #t)  ; resume
      ((42) #t)  ; undefined

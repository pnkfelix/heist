;; How many operand cells follow routine `n`.
(define n-operands (subr pure (int) int)
  (lambda (n)
    (case n
      ((3) 1)  ; lit
      ((4) 1)  ; branch
      ((5) 1)  ; 0branch
      ((20) 1)  ; slot
      ((21) 1)  ; slot!
      ((22) 1)  ; free
      ((23) 1)  ; global
      ((24) 1)  ; global!
      ((25) 2)  ; closure
      ((26) 1)  ; call
      ((27) 1)  ; tailcall
      ((29) 2)  ; prim
      ((39) 1)  ; tcall
      ((40) 1)  ; ttailcall
      ((48) 1)  ; field
      ((51) 2)  ; nclosure
      (else 0))))

;; Whether routine `n`'s call-out may leave the machine anywhere.
(define n-control? (subr pure (int) bool)
  (lambda (n)
    (case n
      ((0) #t)  ; docol
      ((1) #t)  ; exit
      ((2) #t)  ; halt
      ((6) #t)  ; execute
      ((26) #t)  ; call
      ((27) #t)  ; tailcall
      ((28) #t)  ; return
      ((30) #t)  ; prompt

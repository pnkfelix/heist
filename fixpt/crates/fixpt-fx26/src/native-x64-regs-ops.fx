;;; Register code's fast paths and what it does inline, compiled to x86_64
;;; machine code, in FX-26: `fixpt-native/src/cellular/x64/regcode.rs`'s
;;; `int_fast`, `shape_test`, `bump_words` and `inline_op`, and the helpers
;;; they share with the rest of it, which `native-x64-regs.fx` is. Of no
;;; state of its own: it emits into `native-x64.fx`'s assembler.
;;;
;;; A file of one expression (`load-input`, `TODO.md` §68): what makes the
;;; module, which the conductor applies to the encoders, the layouts and
;;; `native-x64.fx`'s assembler.

(let* ((native-x64-types (load-module "fx26:native-x64-types.fx"))
       (x86-64-types (load-module "fx26:x86_64-types.fx"))
       (layout-types (load-module "fx26:layout-types.fx")))
  (lambda ((x86 (select x86-64-types x86-64-sig))
           (layout (select layout-types layout-sig))
           (native-layout (select native-x64-types native-x64-layout-sig))
           (regs-layout (select native-x64-types native-x64-regs-layout-sig))
           (asm (select native-x64-types native-x64-asm-sig)))
    (module
(hide (include native-x64-types))
(hide (include x86) (include layout) (include native-layout) (include regs-layout) (include asm))

(define rg-c-ns int 9)
(define rg-c-ge int 13)
(define rg-xor int 6)
(define rg-shl int 4)

(define rg-pow2-times (subr (maxeff (read @globals) spin) (int int) int)
  (lambda (n acc) (if (= n 0) acc (rg-pow2-times (- n 1) (* 2 acc)))))
(define rg-pow2 (subr (maxeff (read @globals) spin) (int) int) (lambda (n) (rg-pow2-times n 1)))
;; An unsigned 64-bit pattern as the signed value the encoders take.
(define rg-signed (subr pure (int) int)
  (lambda (b) (if (>= b 9223372036854775808) (- b 18446744073709551616) b)))
;; A header of `kind` and `fields` fields, no suffix (`make_header`).
(define rg-header (subr (maxeff (read @globals) spin) (int int) int)
  (lambda (kind fields)
    (+ r-tag-header (+ (* kind (rg-pow2 header-kind-lo)) (* fields (rg-pow2 header-fields-lo))))))

;; The register `REGk` lives in, or -1 for a word of the state.
(define rg-in-reg (subr pure (int) int)
  (lambda (k) (case k ((0) n-clo) ((1) r-rdi) ((2) r-rsi) ((3) r-r8) (else -1))))
(define rg-reg-off (subr pure (int) int) (lambda (k) (+ r-st-regs (* 8 k))))

;; Field `f` of the register word, from the word, its bits signed.
(define rg-bits (subr pure (tword int) int) (lambda (rw f) (rg-signed (tword-bits rw f))))

;; `REGk` in a register: its own, or `tmp`, loaded.
(define rg-get (subr (maxeff x-assembles spin) (int int) int)
  (lambda (k tmp)
    (let ((r (rg-in-reg k)))
      (if (>= r 0) r (begin (x-load tmp n-st (rg-reg-off k)) tmp)))))
;; `REGk` := `src`.
(define rg-put (subr (maxeff x-assembles spin) (int int) unit)
  (lambda (k src)
    (let ((r (rg-in-reg k)))
      (if (>= r 0)
          (if (= r src) #u (x-mov r src))
          (x-store n-st (rg-reg-off k) src)))))
;; `dst` := field `f` of the running register word.
(define rg-cell (subr (maxeff x-assembles spin) (int int) unit)
  (lambda (dst f) (x-load dst n-cur (x-field f))))
;; `dst` := the operand in field `f`: in the instruction if it is
;; immediate, else from the word.
(define rg-constant (subr (maxeff x-assembles spin) (int tword int) unit)
  (lambda (dst rw f)
    (let ((b (rg-bits rw f)))
      (if (or (tword-int? rw f) (= (modulo b 8) 3))
          (x-e (x86-mov-imm dst b))
          (rg-cell dst f)))))
(define rg-value (subr (maxeff x-assembles spin) (int int) unit)
  (lambda (dst v) (x-e (x86-mov-imm dst v))))
;; The write barrier, as `x86_64::card_mark` makes it.
(define rg-card-mark (subr (maxeff x-assembles spin) (int int int int) unit)
  (lambda (obj disp t1 t2)
    (begin
      (x-lea t1 obj disp)
      (x-e (x86-shift-imm x-shr t1 9))
      (x-load t2 n-st n-st-cards)
      (x-e (x86-store8-imm t2 t1 1 0 1)))))

;; `modulo`, `quotient`, `*` and `arithmetic-shift` of the fixnums in
;; `RESULT` and `y`, as `int_fast` does them: whether this is one.
(define rg-int-fast (subr (maxeff x-assembles spin) (string int int) bool)
  (lambda (name y slow)
    (if (not (or (string=? name "modulo") (string=? name "%fx26-quotient")
                 (string=? name "%fx26-mul") (string=? name "%fx26-arithmetic-shift")))
        #f
        (let ((x r-result))
          (begin
            (x-mov r-rcx x)
            (x-alu x-or r-rcx y)
            (x-e (x86-test-imm r-rcx 7))
            (x-jcc x-c-ne slow)
            (cond
              ((string=? name "%fx26-mul")
               (begin
                 (x-mov r-rdx y)
                 (x-e (x86-shift-imm x-sar r-rdx 3))
                 (x-mov r-rcx x)
                 (x-e (x86-imul r-rcx r-rdx))
                 (x-jcc x-c-o slow)
                 (x-mov r-result r-rcx)))
              ((or (string=? name "%fx26-quotient") (string=? name "modulo"))
               (begin
                 (x-e (x86-test y y))
                 (x-jcc x-c-e slow)
                 (x-mov n-x16 x)
                 (x-e (x86-cqo))
                 (x-e (x86-idiv y))
                 (if (string=? name "%fx26-quotient")
                     (let ((ok (x-label)) (restore (x-label)))
                       (begin
                         (x-mov r-rcx r-result)
                         (x-e (x86-shift-imm rg-shl r-rcx 3))
                         (x-e (x86-shift-imm x-sar r-rcx 3))
                         (x-alu x-cmp r-rcx r-result)
                         (x-jcc x-c-ne restore)
                         (x-e (x86-shift-imm rg-shl r-result 3))
                         (x-jmp ok)
                         (x-bind restore)
                         (x-mov r-result n-x16)
                         (x-jmp slow)
                         (x-bind ok)))
                     (let ((signed (x-label)))
                       (begin
                         (x-e (x86-test r-rdx r-rdx))
                         (x-jcc x-c-e signed)
                         (x-mov r-rcx r-rdx)
                         (x-alu rg-xor r-rcx y)
                         (x-jcc rg-c-ns signed)
                         (x-alu x-add r-rdx y)
                         (x-bind signed)
                         (x-mov r-result r-rdx))))))
              (else
               (let ((right (x-label)) (done (x-label)))
                 (begin
                   (x-mov r-rcx y)
                   (x-e (x86-shift-imm x-sar r-rcx 3))
                   (x-e (x86-test r-rcx r-rcx))
                   (x-jcc x-c-l right)
                   (x-alu-imm x-cmp r-rcx 61)
                   (x-jcc rg-c-ge slow)
                   (x-mov r-rdx x)
                   (x-e (x86-shift-cl rg-shl r-rdx))
                   (x-mov n-x16 r-rdx)
                   (x-e (x86-shift-cl x-sar n-x16))
                   (x-alu x-cmp n-x16 x)
                   (x-jcc x-c-ne slow)
                   (x-mov r-result r-rdx)
                   (x-jmp done)
                   (x-bind right)
                   (x-e (x86-neg r-rcx))
                   (x-alu-imm x-cmp r-rcx 63)
                   (x-jcc x-c-ae slow)
                   (x-mov r-rdx x)
                   (x-e (x86-shift-cl x-sar r-rdx))
                   (x-e (x86-shift-imm x-sar r-rdx 3))
                   (x-e (x86-shift-imm rg-shl r-rdx 3))
                   (x-mov r-result r-rdx)
                   (x-bind done)))))
            #t)))))

;; Compare the kind in `RCX` with shape `name`'s, from its `i`th on, to
;; `yes` on any.
(define rg-kinds (subr (maxeff x-assembles spin) (string int int) unit)
  (lambda (name i yes)
    (let ((c (r-shape-kind name i)))
      (if (< c 0)
          #u
          (begin (x-alu-imm x-cmp r-rcx c) (x-jcc x-c-e yes) (rg-kinds name (+ i 1) yes))))))

;; Shape predicate `name` of `src` into `RESULT` (`shape_test`): whether
;; this is one.
(define rg-shape-test (subr (maxeff x-assembles spin) (int string int) bool)
  (lambda (src name slow)
    (cond
      ((or (string=? name "pair?") (string=? name "char?")
           (string=? name "%fx26-f32?") (string=? name "null?"))
       (begin
         (cond ((string=? name "pair?")
                (begin (x-mov r-rcx src)
                       (x-alu-imm x-and r-rcx 7)
                       (x-alu-imm x-cmp r-rcx n-tag-pair)))
               ((string=? name "null?") (x-cmp-value src r-null))
               (else
                (begin
                  (x-e (x86-movzx8 r-rcx src))
                  (x-alu-imm x-cmp r-rcx
                             (modulo (if (string=? name "char?") r-char0 r-f32-0) 256)))))
         (x-boolean r-result x-c-e)
         #t))
      ((string=? name "boolean?")
       (begin
         (x-load r-rcx n-st n-st-fal)
         (x-cmp-value src n-false)
         (x-e (x86-cmov-m x-c-e r-rcx n-st n-st-tru))
         (x-cmp-value src n-true)
         (x-e (x86-cmov-m x-c-e r-rcx n-st n-st-tru))
         (x-mov r-result r-rcx)
         #t))
      ((< (r-shape-kind name 0) 0) #f)
      (else
       (let ((yes (x-label)) (no (x-label)) (have (x-label)) (end (x-label)))
         (begin
           (if (string=? name "exact-integer?")
               (begin (x-e (x86-test-imm src 7)) (x-jcc x-c-e yes))
               #u)
           (x-mov r-rcx src)
           (x-alu-imm x-and r-rcx 7)
           (x-alu-imm x-cmp r-rcx n-tag-bloblet)
           (x-jcc x-c-ne no)
           (x-load n-x16 src (x-field 1))
           (x-mov r-rcx n-x16)
           (x-alu-imm x-and r-rcx 7)
           (x-alu-imm x-cmp r-rcx r-tag-header)
           (x-jcc x-c-e have)
           (x-alu-imm x-cmp r-rcx n-tag-trailer)
           (x-jcc x-c-ne slow)
           (x-alu-imm x-sub n-x16 n-tag-trailer)
           (x-mov r-rdx src)
           (x-alu x-sub r-rdx n-x16)
           (x-load n-x16 r-rdx (x-field 1))
           (x-bind have)
           (x-mov r-rcx n-x16)
           (x-e (x86-shift-imm x-shr r-rcx header-kind-lo))
           (x-alu-imm x-and r-rcx (- (rg-pow2 header-kind-width) 1))
           (x-alu-imm x-cmp r-rcx r-kind-extension)
           (x-jcc x-c-e slow)
           (rg-kinds name 0 yes)
           (x-bind no)
           (rg-value r-result n-false)
           (x-jmp end)
           (x-bind yes)
           (rg-value r-result n-true)
           (x-bind end)
           #t))))))

;; Room for `n` words, from the heap's free space or, with `region?`, from
;; the current chunk of the region whose handle is in `REG1`: its address
;; in `RESULT`, the free space bumped; to `slow` if there is none.
(define rg-bump-words (subr (maxeff x-assembles spin) (int bool int) unit)
  (lambda (n region? slow)
    (begin
      (if region?
          (begin
            (x-e (x86-test-imm r-rdi 7))
            (x-jcc x-c-ne slow)
            (x-alu-imm x-cmp r-rdi (* 8 r-region-slots))
            (x-jcc x-c-ae slow)
            (x-load r-rcx n-st r-st-regions)
            (x-e (x86-lea-ix r-rcx r-rcx r-rdi 2 0))
            (x-load r-rdx r-rcx 0)
            (x-load r-t r-rcx 8))
          (begin
            (x-load r-rcx n-st r-st-top)
            (x-load r-rdx r-rcx 0)
            (x-load r-t n-st r-st-alloc-limit)))
      (x-lea n-x16 r-rdx n)
      (x-alu x-cmp n-x16 r-t)
      (x-jcc x-c-a slow)
      (x-load r-t n-st r-st-words)
      (x-e (x86-lea-ix r-result r-t r-rdx 8 0))
      (x-store r-rcx 0 n-x16))))
;; A bloblet of `total` fields at `RESULT`: its header (in `T`) and its
;; trailer; then, its fields stored, its pointer.
(define rg-bloblet-at (subr (maxeff x-assembles spin) (int) unit)
  (lambda (total)
    (begin
      (x-store r-result 0 r-t)
      (x-e (x86-mov-imm r-t (+ n-tag-trailer (* 8 total))))
      (x-store r-result (* 8 total) r-t))))
(define rg-bloblet-done (subr (maxeff x-assembles spin) (int) unit)
  (lambda (total) (x-alu-imm x-add r-result (+ (* 8 (+ 1 total)) n-tag-bloblet))))
(define rg-field-at (subr (maxeff x-assembles spin) (int int int) unit)
  (lambda (r k total) (x-store r-result (* 8 (- (+ 1 total) k)) r)))
(define rg-reg-field-at (subr (maxeff x-assembles spin) (int int int) unit)
  (lambda (j k total) (rg-field-at (rg-get j r-rcx) k total)))
;; `REGj` as field `j` for `j` from `j` to `count` (`frozen`, `bloblet`).
(define rg-reg-fields (subr (maxeff x-assembles spin) (int int int) unit)
  (lambda (j count total)
    (if (> j count) #u (begin (rg-reg-field-at j j total) (rg-reg-fields (+ j 1) count total)))))
;; The free values `REGj`… as a closure's, the `i`th first.
(define rg-frees (subr (maxeff x-assembles spin) (int int int int) unit)
  (lambda (j last i total)
    (if (> j last)
        #u
        (begin (rg-reg-field-at j (+ n-closure-free0 i) total)
               (rg-frees (+ j 1) last (+ i 1) total)))))

;; A loop over the 32-bit characters at `RDX` (and `RCX`), as `char-in`
;; and `string=` make it.
(define rg-yes-no (subr (maxeff x-assembles spin) (int int int) unit)
  (lambda (yes no end)
    (begin
      (x-bind yes)
      (rg-value r-result n-true)
      (x-jmp end)
      (x-bind no)
      (rg-value r-result n-false)
      (x-bind end))))
;; Two fixnums in `REG1` and `REG2`, else `slow`.
(define rg-two-fixnums (subr (maxeff x-assembles spin) (int) unit)
  (lambda (slow)
    (begin
      (x-mov r-rcx r-rdi)
      (x-alu x-or r-rcx r-rsi)
      (x-e (x86-test-imm r-rcx 7))
      (x-jcc x-c-ne slow))))
;; The bloblet in `REG1` has a trailer, in `X16` less its tag, and `REG2`
;; (8k) is one of its fields, 2 ≤ k ≤ F: else `slow`.
(define rg-field-check (subr (maxeff x-assembles spin) (int) unit)
  (lambda (slow)
    (begin
      (x-load n-x16 r-rdi (x-field 1))
      (x-mov r-rcx n-x16)
      (x-alu-imm x-and r-rcx 7)
      (x-alu-imm x-cmp r-rcx n-tag-trailer)
      (x-jcc x-c-ne slow)
      (x-alu-imm x-cmp r-rsi 16)
      (x-jcc x-c-l slow)
      (x-alu-imm x-sub n-x16 n-tag-trailer)
      (x-alu x-cmp r-rsi n-x16)
      (x-jcc x-c-g slow))))
;; The ASCII character in `REG1`'s code in `RCX`, else `slow`.
(define rg-ascii (subr (maxeff x-assembles spin) (int) unit)
  (lambda (slow)
    (begin
      (x-mov r-rcx r-rdi)
      (x-e (x86-shift-imm x-sar r-rcx 8))
      (x-alu-imm x-cmp r-rcx 128)
      (x-jcc x-c-ae slow))))

;; The shape predicate an inline type test names.
(define rg-shape-name (subr pure (string) string)
  (lambda (what)
    (cond ((string=? what "f32?") "%fx26-f32?")
          ((string=? what "array?") "%fx26-array?")
          ((string=? what "box?") "%fx26-box?")
          ((string=? what "sum?") "%fx26-sum?")
          ((string=? what "product?") "%fx26-product?")
          ((string=? what "procedure?") "%fx26-procedure?")
          (else what))))

;; `what` on `REG1`…`REGn` (`count` of them) into `RESULT`, without calling
;; out (`inline_op`); to `slow` when it cannot be done so. `word` is the
;; field of a closure's word, for `closure`.
(define rg-inline-op (subr (maxeff x-assembles spin) (string int int int) unit)
  (lambda (what count word slow)
    (cond
      ((or (string=? what "closure") (string=? what "region-closure"))
       (let* ((region? (string=? what "region-closure"))
              (first (if region? 2 1))
              (last (if region? (- count 1) count))
              (total (+ (+ (- last first) 1) 2)))
         (begin
           (rg-bump-words (+ 1 total) region? slow)
           (x-e (x86-mov-imm r-t (rg-header n-kind-closure total)))
           (rg-bloblet-at total)
           (if region?
               (rg-reg-field-at count n-closure-word total)
               (begin (rg-cell r-rcx word) (rg-field-at r-rcx n-closure-word total)))
           (rg-frees first last 0 total)
           (rg-bloblet-done total))))
      ((string=? what "frozen")
       (begin
         (rg-bump-words (+ 1 count) #f slow)
         (x-e (x86-mov-imm r-t (+ (rg-header 0 count)
                                  (+ (rg-pow2 header-fields-frozen-lo)
                                     (rg-pow2 header-suffix-frozen-lo)))))
         (x-alu x-add r-t r-rdi)
         (rg-bloblet-at count)
         (rg-reg-fields 2 count count)
         (rg-bloblet-done count)))
      ((string=? what "bloblet")
       (begin
         (x-e (x86-test r-rdi r-rdi))
         (x-jcc x-c-ne slow)
         (rg-bump-words (+ 1 count) #f slow)
         (x-e (x86-mov-imm r-t (rg-header kind-bloblet count)))
         (rg-bloblet-at count)
         (rg-reg-fields 2 count count)
         (rg-bloblet-done count)))
      ((or (string=? what "rnew") (string=? what "box"))
       (let ((region? (string=? what "rnew")))
         (begin
           (rg-bump-words 3 region? slow)
           (x-e (x86-mov-imm r-t (rg-header kind-box 2)))
           (rg-bloblet-at 2)
           (rg-field-at (if region? r-rsi r-rdi) 2 2)
           (rg-bloblet-done 2))))
      ((string=? what "field@")
       (begin
         (rg-field-check slow)
         (x-mov r-rdx r-rdi)
         (x-alu x-sub r-rdx r-rsi)
         (x-load r-result r-rdx -4)))
      ((string=? what "fields")
       (begin
         (x-load n-x16 r-rdi (x-field 1))
         (x-mov r-rcx n-x16)
         (x-alu-imm x-and r-rcx 7)
         (x-alu-imm x-cmp r-rcx n-tag-trailer)
         (x-jcc x-c-ne slow)
         (x-mov r-result n-x16)
         (x-alu-imm x-sub r-result n-tag-trailer)))
      ((string=? what "field!")
       (begin
         (rg-field-check slow)
         ;; The header: F + 1 words before the suffix.
         (x-mov r-rdx r-rdi)
         (x-alu x-sub r-rdx n-x16)
         (x-load r-rcx r-rdx -12)
         (x-e (x86-shift-imm x-shr r-rcx header-fields-frozen-lo))
         (x-e (x86-test-imm r-rcx 1))
         (x-jcc x-c-ne slow)
         (x-mov r-rdx r-rdi)
         (x-alu x-sub r-rdx r-rsi)
         (x-store r-rdx -4 r-r8)
         (rg-card-mark r-rdx -4 r-rcx n-x16)
         (rg-value r-result r-unspecified)))
      ((string=? what "whitespace")
       (begin
         (rg-ascii slow)
         (x-lea r-rdx r-rcx -9)
         (x-alu-imm x-cmp r-rdx 4)
         (x-boolean r-result x-c-be)
         (x-alu-imm x-cmp r-rcx 32)
         (x-e (x86-cmov-m x-c-e r-result n-st n-st-tru))))
      ((string=? what "symbol-hash") (x-load r-result r-rdi (x-field 3)))
      ((string=? what "fixnum?")
       (begin (x-e (x86-test-imm r-rdi 7)) (x-boolean r-result x-c-e)))
      ((or (string=? what "bit-and") (string=? what "bit-ior") (string=? what "bit-xor"))
       (begin
         (rg-two-fixnums slow)
         (x-mov r-result r-rdi)
         (x-alu (cond ((string=? what "bit-and") x-and)
                      ((string=? what "bit-ior") x-or)
                      (else rg-xor))
                r-result r-rsi)))
      ((string=? what "bit-not")
       (begin
         (x-e (x86-test-imm r-rdi 7))
         (x-jcc x-c-ne slow)
         (x-mov r-result r-rdi)
         (x-e (x86-neg r-result))
         (x-alu-imm x-sub r-result 8)))
      ((string=? what "numeric")
       (begin
         (rg-ascii slow)
         (x-lea r-rdx r-rcx -48)
         (x-alu-imm x-cmp r-rdx 9)
         (x-boolean r-result x-c-be)))
      ((string=? what "char-in")
       (let ((again (x-label)) (yes (x-label)) (no (x-label)) (end (x-label)))
         (begin
           (x-mov r-rcx r-rdi)
           (x-e (x86-shift-imm x-sar r-rcx 8))
           (x-load r-t r-rsi -4)
           (x-mov r-rdx r-rsi)
           (x-bind again)
           (x-e (x86-test r-t r-t))
           (x-jcc x-c-e no)
           (x-e (x86-load32-ix n-x16 r-rdx -1 1 4))
           (x-alu x-cmp n-x16 r-rcx)
           (x-jcc x-c-e yes)
           (x-alu-imm x-add r-rdx 4)
           (x-alu-imm x-sub r-t 1)
           (x-jmp again)
           (rg-yes-no yes no end))))
      ((string=? what "string=")
       (let ((again (x-label)) (yes (x-label)) (no (x-label)) (end (x-label)))
         (begin
           (x-load r-t r-rdi -4)
           (x-load n-x16 r-rsi -4)
           (x-alu x-cmp r-t n-x16)
           (x-jcc x-c-ne no)
           (x-mov r-rcx r-rdi)
           (x-mov r-rdx r-rsi)
           (x-bind again)
           (x-e (x86-test r-t r-t))
           (x-jcc x-c-e yes)
           (x-e (x86-load32-ix n-x16 r-rcx -1 1 4))
           (x-e (x86-load32-ix r-result r-rdx -1 1 4))
           (x-alu x-cmp n-x16 r-result)
           (x-jcc x-c-ne no)
           (x-alu-imm x-add r-rcx 4)
           (x-alu-imm x-add r-rdx 4)
           (x-alu-imm x-sub r-t 1)
           (x-jmp again)
           (rg-yes-no yes no end))))
      ((string=? what "modulo")
       (let ((end (x-label)))
         (begin
           (rg-two-fixnums slow)
           (x-e (x86-test r-rsi r-rsi))
           (x-jcc x-c-e slow)
           (x-mov r-result r-rdi)
           (x-e (x86-cqo))
           (x-e (x86-idiv r-rsi))
           (x-mov r-result r-rdx)
           (x-e (x86-test r-result r-result))
           (x-jcc x-c-e end)
           (x-mov r-rcx r-result)
           (x-alu rg-xor r-rcx r-rsi)
           (x-jcc rg-c-ns end)
           (x-alu x-add r-result r-rsi)
           (x-bind end))))
      ((string=? what "cons")
       (begin
         (x-load r-rcx n-st r-st-top)
         (x-load r-rdx r-rcx 0)
         (x-lea n-x16 r-rdx 2)
         (x-e (x86-alu-rm x-cmp n-x16 n-st r-st-alloc-limit))
         (x-jcc x-c-a slow)
         (x-load r-result n-st r-st-words)
         (x-e (x86-lea-ix r-result r-result r-rdx 8 0))
         (x-store r-result 0 r-rdi)
         (x-store r-result 8 r-rsi)
         (x-store r-rcx 0 n-x16)
         (x-alu-imm x-add r-result n-tag-pair)))
      ((string=? what "string-length")
       (begin (x-load r-result r-rdi -4) (x-e (x86-shift-imm rg-shl r-result 3))))
      ((string=? what "string-ref")
       (begin
         (x-load n-x16 r-rdi -4)
         (x-mov r-rcx r-rsi)
         (x-e (x86-shift-imm x-sar r-rcx 3))
         (x-alu x-cmp r-rcx n-x16)
         (x-jcc x-c-ae slow)
         (x-e (x86-load32-ix r-rdx r-rdi r-rcx 4 4))
         (x-e (x86-shift-imm rg-shl r-rdx 8))
         (rg-value r-result r-char0)
         (x-alu x-add r-result r-rdx)))
      ((string=? what "rcons")
       (begin
         (x-e (x86-test-imm r-rdi 7))
         (x-jcc x-c-ne slow)
         (x-alu-imm x-cmp r-rdi (* 8 r-region-slots))
         (x-jcc x-c-ae slow)
         (x-load r-rcx n-st r-st-regions)
         (x-e (x86-lea-ix r-rcx r-rcx r-rdi 2 0))
         (x-load r-rdx r-rcx 0)
         (x-lea n-x16 r-rdx 2)
         (x-e (x86-alu-rm x-cmp n-x16 r-rcx 8))
         (x-jcc x-c-a slow)
         (x-load r-result n-st r-st-words)
         (x-e (x86-lea-ix r-result r-result r-rdx 8 0))
         (x-store r-result 0 r-rsi)
         (x-store r-result 8 r-r8)
         (x-store r-rcx 0 n-x16)
         (x-alu-imm x-add r-result n-tag-pair)))
      ;; Type tests: `shape_test`'s, of `REG1`.
      (else (if (rg-shape-test r-rdi (rg-shape-name what) slow) #u #u)))))

;; What `prim`, `lambda` or `cellular` does inline, if anything ("").
(define rg-inline-name (subr pure (int int int) string)
  (lambda (op k0 count)
    (cond
      ((= op rop-lambda) "closure")
      ((= op rop-cellular)
       (cond ((and (= count 2) (= k0 routine-cons)) "cons")
             ((and (= count 2) (= k0 routine-field-ref)) "field@")
             (else "")))
      ((not (= op rop-prim)) "")
      (else
       (let ((p (r-prim-name k0)))
         (cond
           ((= count 1)
            (cond ((string=? p "string-length") "string-length")
                  ((string=? p "%bloblet-fields") "fields")
                  ((string=? p "char-whitespace?") "whitespace")
                  ((string=? p "char-numeric?") "numeric")
                  ((string=? p "%symbol-hash") "symbol-hash")
                  ((string=? p "%fx26-fixnum?") "fixnum?")
                  ((string=? p "char?") "char?")
                  ((string=? p "boolean?") "boolean?")
                  ((string=? p "symbol?") "symbol?")
                  ((string=? p "string?") "string?")
                  ((string=? p "pair?") "pair?")
                  ((string=? p "%fx26-bitwise-not") "bit-not")
                  ((string=? p "exact-integer?") "exact-integer?")
                  ((string=? p "%fx26-array?") "array?")
                  ((string=? p "%fx26-f32?") "f32?")
                  ((string=? p "%fx26-box?") "box?")
                  ((string=? p "%fx26-sum?") "sum?")
                  ((string=? p "%fx26-product?") "product?")
                  ((string=? p "%fx26-procedure?") "procedure?")
                  ((string=? p "%make-box") "box")
                  ((string=? p "%make-frozen") "frozen")
                  ((string=? p "%make-bloblet") "bloblet")
                  (else "")))
           ((= count 2)
            (cond ((string=? p "string-ref") "string-ref")
                  ((string=? p "%fx26-bitwise-and") "bit-and")
                  ((string=? p "%fx26-bitwise-ior") "bit-ior")
                  ((string=? p "%fx26-bitwise-xor") "bit-xor")
                  ((string=? p "%fx26-char-in?") "char-in")
                  ((string=? p "string=?") "string=")
                  ((string=? p "modulo") "modulo")
                  ((string=? p "%region-new") "rnew")
                  ((string=? p "%region-closure") "region-closure")
                  ((string=? p "%make-frozen") "frozen")
                  ((string=? p "%make-bloblet") "bloblet")
                  (else "")))
           ((= count 3)
            (cond ((string=? p "%region-cons") "rcons")
                  ((string=? p "%bloblet-set!") "field!")
                  ((and (<= count r-regs) (string=? p "%region-closure")) "region-closure")
                  ((string=? p "%make-frozen") "frozen")
                  ((string=? p "%make-bloblet") "bloblet")
                  (else "")))
           (else
            (cond ((and (>= count 2) (<= count r-regs) (string=? p "%region-closure"))
                   "region-closure")
                  ((and (>= count 1) (string=? p "%make-frozen")) "frozen")
                  ((and (>= count 1) (string=? p "%make-bloblet")) "bloblet")
                  (else "")))))))))

;;; ------------------------------------------------------------ returns
)))

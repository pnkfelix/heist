; The commands, and errors, answered as z3 answers them (lockpick's outputs).
(set-option :print-success true)
(set-logic QF_LIA)
(declare-const x Int)
(declare-const y Int)
(declare-const p Bool)
(define-fun twice ((a Int)) Int (+ a a))
(define-fun big () Bool (> (twice x) 10))
(assert big)
(assert (! (< y x) :named lt))
(push 1)
(assert (and p (= y (- x 3))))
(check-sat)
(get-value (x y p (twice y) lt))
(get-model)
(pop 1)
(check-sat-assuming ((not p) (= x 6)))
(get-value (x p))
(check-sat-assuming ((< x 0)))
(get-info :reason-unknown)
(get-option :print-success)
(set-option :print-success false)
(echo "a ""quoted"" string")
(declare-const x Int)
(assert (+ x 1))
(assert (bvadd x y))
(assert undefined)
(assert (twice x x))
(pop 3)
(get-info :name)
(set-option :unknown-option 1)
(frobnicate)
(declare-const r Real)
(assert (= (* x y) 2))
(assert (= (div x y) 2))
(assert (> (/ r 2) (* 3 r)))
(check-sat)
(get-value (r (to_int r) (is_int r)))
(declare-const b (_ BitVec 8))
(assert (= ((_ extract 3 0) b) #x5))
(assert (bvslt b #x00))
(assert ((_ at-most 1) p (= b #xf5) (= b #x85)))
(check-sat)
(get-value (b ((_ zero_extend 4) ((_ extract 7 4) b)) (concat b #b1) (bvashr b #x02)))
(reset)
(declare-const x Bool)
(check-sat)
(get-model)
(exit)
(check-sat)

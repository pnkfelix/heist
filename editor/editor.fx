;;; editor.fx: the editor, each file made once, in order, from those before it.

(define m-base ((load-input "base.fx")))
(define m-buffer ((load-input "buffer.fx") m-base))
(define m-resolve ((load-input "resolve.fx") m-base m-buffer))
(define m-syntax ((load-input "syntax.fx") m-base m-buffer m-resolve))
(define m-sexp ((load-input "sexp.fx") m-base m-buffer m-resolve m-syntax))
(define m-flow ((load-input "flow.fx") m-base m-buffer m-resolve m-syntax m-sexp))
(define m-index ((load-input "index.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow))
(define m-view ((load-input "view.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index))
(define m-frame ((load-input "frame.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view))
(define m-calls ((load-input "calls.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame))
(define m-process ((load-input "process.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls))
(define m-files ((load-input "files.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls m-process))
(define m-help ((load-input "help.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls m-process m-files))
(define m-eldoc ((load-input "eldoc.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls m-process m-files m-help))
(define m-main ((load-input "main.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls m-process m-files m-help m-eldoc))
(define main (with m-main main))

;;; editor.fx: the editor, each file made once, in order, from those before it.

(define m-base ((load-input "base.fx")))
(define m-buffer ((load-module "buffer.fx") m-base))
(define m-resolve ((load-module "resolve.fx") m-base m-buffer))
(define m-syntax ((load-module "syntax.fx") m-base m-buffer m-resolve))
(define m-sexp ((load-module "sexp.fx") m-base m-buffer m-resolve m-syntax))
(define m-flow ((load-module "flow.fx") m-base m-buffer m-resolve m-syntax m-sexp))
(define m-index ((load-module "index.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow))
(define m-view ((load-module "view.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index))
(define m-frame ((load-module "frame.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view))
(define m-calls ((load-module "calls.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame))
(define m-process ((load-module "process.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls))
(define m-files ((load-module "files.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls m-process))
(define m-help ((load-module "help.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls m-process m-files))
(define m-eldoc ((load-module "eldoc.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls m-process m-files m-help))
(define m-scheme ((load-module "scheme.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls m-process m-files m-help m-eldoc))
(define m-main ((load-module "main.fx") m-base m-buffer m-resolve m-syntax m-sexp m-flow m-index m-view m-frame m-calls m-process m-files m-help m-eldoc m-scheme))
(define main (with m-main main))

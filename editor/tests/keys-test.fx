;;; keys.fx: decoding byte sequences, and kbd/key->string round trips.
(define k (load-module "../keys.fx"))
(import k kbd key->string keys->string read-key key=? meta-key (type key keys byte-source))

(define pending (ref (listof int acyclic) @t) (new nil))
(define* next (subr (maxeff (read @t) (write @t)) (int) (union false int))
  (lambda (timeout)
    (let ((p (get pending)))
      (if (null? p) #f (begin (set pending (cdr p)) (car p))))))
(define* decode (subr (maxeff (read @t) (write @t) spin (read (globals next))) ((listof int acyclic)) string)
  (lambda (bytes)
    (begin
      (set pending bytes)
      (let ((k (read-key next 0)))
        (typecase k (bool f "none") (else y (key->string y)))))))
(define* check (subr (maxeff (read @t) (write @t) spin (io stdout) (read (globals next decode))) ((listof int acyclic) string) unit)
  (lambda (bytes want)
    (let ((got (decode bytes)))
      (if (string=? got want) #u (begin (write-out (string-append "FAIL want " want " got " got "\n")) #u)))))

(check (list 97) "a")
(check (list 1) "C-a")
(check (list 13) "RET")
(check (list 127) "DEL")
(check (list 27) "ESC")
(check (list 27 120) "M-x")
(check (list 27 6) "C-M-f")
(check (list 27 91 65) "<up>")
(check (list 27 91 49 59 53 68) "C-<left>")
(check (list 27 91 51 126) "<delete>")
(check (list 27 79 80) "<f1>")
(check (list 206 187) "λ")
(check (list 226 130 172) "€")
(check (list 32) "SPC")
(check nil "none")
(write-out (string-append "kbd: " (keys->string (kbd "C-x C-f M-x <up> C-<left> a SPC")) "\n"))

;;; sexp.fx: motion, matching, paredit's keys and structural edits, each
;;; a command applied to a buffer made from a text with point marked `|`.
;;; needs: base.fx buffer.fx sexp.fx
(define* buffer-at (subr spin (string) buffer)
  ;; A buffer of `s` without its `|`, point where it was.
  (lambda (s)
    (let ((p (string-search s "|" 0)))
      (with-point (new-buffer "t" "" (string->rope (string-append (substring s 0 p) (substring s (+ p 1) (string-length s))))) p))))
(define* shown (subr spin (buffer) string)
  (lambda (b)
    (let ((s (rope->string (extract b text))) (p (extract b point)))
      (string-append (substring s 0 p) "|" (substring s p (string-length s))))))
(define try (->* (string command string) unit)
  (lambda (before c after)
    (let ((got (shown (extract (c (buffer-at before)) buffer))))
      (if (string=? got after) #u
          (begin (write-out (string-append "FAIL " before " => " got ", wanted " after "\n")) #u)))))
(define sexp-test (->* () unit)
  (lambda ()
    (begin
      (try "|(a (b c) \"s)\") d" (sexp-motion forward-sexp "") "(a (b c) \"s)\")| d")
      (try "(a (b c)| d)" (sexp-motion backward-sexp "") "(a |(b c) d)")
      (try "(a (b |c) d)" (sexp-motion up-list "") "(a |(b c) d)")
      (try "(a |(b c) d)" (sexp-motion down-list "") "(a (|b c) d)")
      (try "(f #\\( |x)" (sexp-motion up-list "") "|(f #\\( x)")
      (try "(a ; (\n |b)" (sexp-motion up-list "") "|(a ; (\n b)")
      (try "(a |(b c) d)" (kill-sexp) "(a | d)")
      (try "(a |b)" (paredit-open) "(a (|)b)")
      (try "(a \"x|\")" (paredit-open) "(a \"x(|\")")
      (try "(a b  |  )" (paredit-close) "(a b)|")
      (try "(a |)" (paredit-doublequote) "(a \"|\")")
      (try "(a \"x|\")" (paredit-doublequote) "(a \"x\"|)")
      (try "(a (|))" (paredit-backward-delete) "(a |)")
      (try "(a (b)|)" (paredit-backward-delete) "(a (b|))")
      (try "(a \"|\")" (paredit-backward-delete) "(a |)")
      (try "(a |(b))" (paredit-forward-delete) "(a (|b))")
      (try "(a |b c) d" (paredit-kill) "(a |) d")
      (try "((a|) b c)" (slurp-forward) "((a| b) c)")
      (try "((a| b) c)" (barf-forward) "((a|) b c)")
      (try "(a (b| c) d)" (splice-sexp) "(a b| c d)")
      (try "(a (b |c) d)" (raise-sexp) "(a |c d)")
      (try "(a |b c)" (wrap-round) "(a (|b) c)"))))
(sexp-test)

;;; regexp.fx: matches, groups, the errors, and searching both ways.
(define r (load-module "../regexp.fx"))
(import r make-regexp regexp-search regexp-match-at match-group regexp-fold-case? (type regexp) (type rx-match))

(define* check (subr (io stdout) (string bool) unit)
  (lambda (what ok) (if ok #u (begin (write-out (string-append "FAIL " what "\n")) #u))))

"Where `pattern` first matches `text` forward from 0, as \"start-end\";
\"none\"; or the error."
(define* found (subr spin (string string) string)
  (lambda (pattern text)
    (tagcase (make-regexp pattern #f)
      (ok re (tagcase (regexp-search re text 0 #t)
               (some m (string-append (int->string (extract m start)) "-" (int->string (extract m end))))
               (none u "none")))
      (bad why why))))

(define* is (subr (maxeff spin (io stdout)) (string string string) unit)
  (lambda (pattern text want)
    (let ((got (found pattern text)))
      (check (string-append pattern " in " text ": " got ", not " want) (string=? got want)))))

(is "abc" "xxabcx" "2-5")
(is "a.c" "abc" "0-3")
(is "a.c" "a\nc" "none")
(is "ab*c" "ac abbbc" "0-2")
(is "ab+c" "ac abbbc" "3-8")
(is "ab?c" "abbc abc" "5-8")
(is "a.*c" "abcabc" "0-6")
(is "a.*?c" "abcabc" "0-3")
(is "[0-9]+" "ab123c" "2-5")
(is "[^a-z]" "abC" "2-3")
(is "[[:digit:]]+" "x42" "1-3")
(is "[]a]" "x]" "1-2")
(is "x\\{2,3\\}" "xxxxx" "0-3")
(is "x\\{2\\}" "x xx" "2-4")
(is "x\\{,2\\}y" "xxxy" "1-4")
(is "^b" "ab\nbc" "3-4")
(is "a$" "ba\nab" "1-2")
(is "\\`a" "ba" "none")
(is "b\\'" "abb" "2-3")
(is "cat\\|dog" "hotdog" "3-6")
(is "\\(ab\\)\\1" "abab" "0-4")
(is "\\(a\\|b\\)\\1" "abba" "1-3")
(is "\\bfoo\\b" "foobar foo" "7-10")
(is "\\<b" "ab b" "3-4")
(is "a\\>" "ab a" "3-4")
(is "\\w+" "  hey!" "2-5")
(is "\\W" "ab cd" "2-3")
(is "\\s-" "ab cd" "2-3")
(is "\\_<set!\\_>" "reset! set!" "7-11")
(is "a*" "bbb" "0-0")
(is "\\(a*\\)*b" "aaab" "0-4")
(is "x*" "" "0-0")
(is "*a" "x*a" "1-3")
(is "a\\(?:bc\\)+" "abcbc" "0-5")
;; Errors.
(is "\\(a" "a" "Invalid regexp: unmatched \\(")
(is "a\\)" "a" "Invalid regexp: unmatched \\)")
(is "[a" "a" "Invalid regexp: unmatched [")
(is "\\1" "a" "Invalid regexp: \\1 refers to no group")
(is "a\\" "a" "Invalid regexp: trailing backslash")
(is "[[:nope:]]" "a" "Invalid regexp: unknown character class nope")
(is "x\\{3,1\\}" "x" "Invalid regexp: bad interval \\{")

;; Groups.
(tagcase (make-regexp "\\(def\\w*\\) +\\([a-z]+\\)" #f)
  (ok re (tagcase (regexp-search re "(define  foo)" 0 #t)
           (some m (begin (check "group 1" (tagcase (match-group m 1) (some g (and (= (extract g start) 1) (= (extract g end) 7))) (none u #f)))
                          (check "group 2" (tagcase (match-group m 2) (some g (and (= (extract g start) 9) (= (extract g end) 12))) (none u #f)))))
           (none u (check "groups: a match" #f))))
  (bad why (check why #f)))

;; Case: folded when asked; and when a search asks for it.
(tagcase (make-regexp "abc" #t)
  (ok re (check "fold" (tagcase (regexp-search re "xABC" 0 #t) (some m (= (extract m start) 1)) (none u #f))))
  (bad why (check why #f)))
(tagcase (make-regexp "[a-c]+" #t)
  (ok re (check "fold range" (tagcase (regexp-search re "xABC" 0 #t) (some m (= (extract m end) 4)) (none u #f))))
  (bad why (check why #f)))
(check "fold-case? of lower" (regexp-fold-case? "a\\Wb"))
(check "fold-case? of upper" (not (regexp-fold-case? "aB")))

;; Backward: the last start at or before `from`.
(tagcase (make-regexp "a+" #f)
  (ok re (begin (check "back" (tagcase (regexp-search re "aa b aa" 7 #f) (some m (= (extract m start) 6)) (none u #f)))
                (check "back from" (tagcase (regexp-search re "aa b aa" 4 #f) (some m (= (extract m start) 1)) (none u #f)))
                (check "at" (tagcase (regexp-match-at re "baa" 1) (some m (= (extract m end) 3)) (none u #f)))))
  (bad why (check why #f)))

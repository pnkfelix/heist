;;; kit/chars.fx: each procedure's answers.

(define chars (load-module "../chars.fx"))
(import chars digit-value char-delimiter? char-name name->char written-char)

(define digit-is (subr pure ((union false nat) int) bool)
  (lambda (x n) (if (bool? x) #f (= x n))))
(define char-is (subr pure ((union false char) char) bool)
  (lambda (x c) (if (bool? x) #f (char=? x c))))
(define name-is (subr pure ((union false string) string) bool)
  (lambda (x s) (if (bool? x) #f (string=? x s))))

(define* check (subr pure () unit)
  (lambda ()
    (begin
      (assert (digit-is (digit-value #\7) 7))
      (assert (digit-is (digit-value #\0) 0))
      ;; ARABIC-INDIC DIGIT THREE, and MATHEMATICAL BOLD DIGIT NINE.
      (assert (digit-is (digit-value (integer->char 1635)) 3))
      (assert (digit-is (digit-value (integer->char 120791)) 9))
      (assert (bool? (digit-value #\a)))
      (assert (bool? (digit-value (integer->char 47))))
      (assert (char-delimiter? #\space))
      (assert (char-delimiter? #\())
      (assert (char-delimiter? #\"))
      (assert (char-delimiter? #\|))
      (assert (not (char-delimiter? #\a)))
      (assert (name-is (char-name #\space) "space"))
      (assert (name-is (char-name (integer->char 0)) "null"))
      (assert (name-is (char-name (integer->char 127)) "delete"))
      (assert (bool? (char-name #\a)))
      (assert (char-is (name->char "newline") (integer->char 10)))
      (assert (char-is (name->char "a") #\a))
      (assert (char-is (name->char "x") #\x))
      (assert (char-is (name->char "x41") #\A))
      (assert (char-is (name->char "x3bb") (integer->char 955)))
      (assert (bool? (name->char "xzz")))
      (assert (bool? (name->char "nope")))
      (assert (bool? (name->char "")))
      (assert (string=? (written-char #\a) "#\\a"))
      (assert (string=? (written-char #\space) "#\\space"))
      (assert (string=? (written-char (integer->char 1)) "#\\x1"))
      (assert (string=? (written-char (integer->char 31)) "#\\x1f")))))

(check)
(write-out "chars: ok\n")

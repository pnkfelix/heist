;;; kit/strings.fx: each procedure's answers.

(define strings (load-module "../strings.fx"))
(import strings string-prefix? string-suffix? string-index string-index-from string-concatenate string-join
        string-split string-tokenize string-pad-right string-pad written-string
        reverse-list->string)

(define index-is (subr pure ((union false nat) int) bool)
  (lambda (x n) (if (bool? x) #f (= x n))))
"Two lists of strings, the same."
(define same-strings (subr pure ((listof string acyclic) (listof string acyclic)) bool)
  (lambda (a b)
    (letrec ((go (subr pure ((listof string acyclic) (listof string acyclic)) bool)
               (lambda (a b)
                 (cond ((null? a) (null? b)) ((null? b) #f)
                       ((string=? (car a) (car b)) (go (cdr a) (cdr b)))
                       (else #f)))))
      (go a b))))

(define* check (subr pure () unit)
  (lambda ()
    (begin
      (assert (string=? (reverse-list->string (the (listof char acyclic) (list #\c #\b #\a))) "abc"))
      (assert (string=? (reverse-list->string (the (listof char acyclic) nil)) ""))
      (assert (string-prefix? "ab" "abc"))
      (assert (string-prefix? "" "abc"))
      (assert (not (string-prefix? "abcd" "abc")))
      (assert (string-suffix? "bc" "abc"))
      (assert (not (string-suffix? "ab" "abc")))
      (assert (index-is (string-index "hello" #\l) 2))
      (assert (index-is (string-index-from "hello" #\l 3) 3))
      (assert (bool? (string-index-from "hello" #\l 4)))
      (assert (bool? (string-index "" #\a)))
      (assert (string=? (string-concatenate (the (listof string acyclic) (list "a" "bc" "" "d"))) "abcd"))
      (assert (string=? (string-concatenate (the (listof string acyclic) nil)) ""))
      (assert (string=? (string-join (the (listof string acyclic) (list "a" "b" "c")) ", ") "a, b, c"))
      (assert (string=? (string-join (the (listof string acyclic) (list "a")) ", ") "a"))
      (assert (string=? (string-join (the (listof string acyclic) nil) ", ") ""))
      (assert (same-strings (string-split "a,,b" #\,) (list "a" "" "b")))
      (assert (same-strings (string-split "" #\,) (list "")))
      (assert (same-strings (string-split "a," #\,) (list "a" "")))
      (assert (same-strings (string-tokenize "  two  words ") (list "two" "words")))
      (assert (same-strings (string-tokenize "   ") nil))
      (assert (string=? (string-pad-right "ab" 4 #\.) "ab.."))
      (assert (string=? (string-pad-right "abcdef" 4 #\.) "abcd"))
      (assert (string=? (string-pad "ab" 4 #\space) "  ab"))
      (assert (string=? (string-pad "abcdef" 4 #\space) "cdef"))
      (assert (string=? (written-string "a\"b\\c") "\"a\\\"b\\\\c\""))
      (assert (string=? (written-string (string-append "x" (char->string (integer->char 10)) (char->string (integer->char 1))))
                        "\"x\\n\\x1;\"")))))

(check)
(write-out "strings: ok\n")

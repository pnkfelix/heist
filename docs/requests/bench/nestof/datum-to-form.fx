(define-type (nestof (l type)) (mu n (listof (oneof l n) acyclic)))
(define-type atom (oneof int f64 char bool string symbol keyword))
(define-type form (nestof atom))
(define-type elem (oneof atom form))
(define-rec
  (to-elem (subr (maxeff spin (read @globals)) (datum) (sumof (none unit) (some elem)))
    (lambda (x)
      (typecase x (int i (sum some i)) (f64 r (sum some r)) (char c (sum some c)) (bool b (sum some b))
                  (string s (sum some s)) (symbol s (sum some s)) (keyword k (sum some k))
                  (else y (tagcase (to-form x) (none u (sum none #u)) (some f (sum some f)))))))
  (to-form (subr (maxeff spin (read @globals)) (datum) (sumof (none unit) (some form)))
    (lambda (x)
      (cond ((null? x) (sum some nil))
            ((pair? x) (tagcase (to-elem (car x))
                         (none u (sum none #u))
                         (some h (tagcase (to-form (cdr x)) (none u (sum none #u)) (some t (sum some (cons h t)))))))
            (else (sum none #u))))))
(write-out (tagcase (to-form (quote (a (b . c)))) (none u "dotted: refused") (some f "a form")))
(write-out (tagcase (to-form (quote (a (b c) 1))) (none u ", refused") (some f ", a form")))

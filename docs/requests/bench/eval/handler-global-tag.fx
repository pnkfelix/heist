;; Option 1, delimited control: user code calls `insert` directly; a handler
;; around it, in the turn, collects what it asked for.
(define-effect turn-eff (maxeff spin nondet (read @globals) (read @ed) (alloc @ed)))
(define-type request (sumof (insert string) (message string)))
(define-type requests (listof request acyclic))
(define-effect ctl (maxeff (goto @ev) (comefrom @ev)))
(define-type asked (productof (req request) (k (composable unit requests turn-eff @ev))))
(define ed-tag (prompt-tag requests asked turn-eff @ev) (make-continuation-prompt-tag))
(define perform! (subr (maxeff turn-eff ctl) (request) unit)
  (lambda (r)
    ((proj (proj call-with-composable-continuation @ev) requests asked turn-eff unit (maxeff turn-eff ctl))
     (lambda ((k (composable unit requests turn-eff @ev)))
       (abort-current-continuation ed-tag (product (req r) (k k))))
     ed-tag)))
(define insert (subr (maxeff turn-eff ctl) (string) unit) (lambda ((s string)) (perform! (sum insert s))))
(define message (subr (maxeff turn-eff ctl) (string) unit) (lambda ((s string)) (perform! (sum message s))))
;; The requests of `body`, run under the handler.
(define handled (subr (maxeff turn-eff ctl) ((subr (maxeff turn-eff ctl) () unit)) requests)
  (lambda (body)
    (prompt ed-tag (begin (body) nil)
      (lambda ((a asked))
        (cons (extract a req) (handled (lambda () (begin ((extract a k) #u) #u))))))))
(define user (subr (maxeff turn-eff ctl) () unit)
  (lambda () (begin (insert "a") (message "b") (insert "c"))))
(define shown (subr (maxeff (read @globals) spin) (requests) string)
  (lambda (rs) (if (null? rs) ""
                   (string-append (tagcase (car rs) (insert s (string-append "insert " s)) (message s (string-append "message " s)))
                                  "; " (shown (cdr rs))))))
(define turn (subr (maxeff turn-eff ctl) () (sumof (ok requests) (lost string)))
  (lambda ()
    (attempt (the (sumof (ok requests) (lost string)) (sum ok (handled user)))
             (lambda ((why string)) (the (sumof (ok requests) (lost string)) (sum lost why))))))
(define main (subr (maxeff turn-eff ctl (io stdout) (read @globals)) () int)
  (lambda () (begin (tagcase (turn) (ok rs (write-out (string-append (shown rs) "\n"))) (lost m (write-out m))) 0)))

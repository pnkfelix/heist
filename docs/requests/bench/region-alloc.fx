(define-type v (sumof (a int) (b bool)))
(define gt v (sum b #t))
(define arr (arrayof v @sc) (make-array 4 (sum a 1)))
(define* ms (subr (io clock) (int) int) (lambda (t0) (quotient (- (i64->int (clock)) t0) 1000000)))
(define* loop-lit (subr spin (int int) int) (lambda (i acc) (if (= i 0) acc (loop-lit (- i 1) (tagcase (sum b #t) (b x (+ acc 1)) (else y acc))))))
(define* loop-glob (subr (maxeff spin (read @globals)) (int int) int) (lambda (i acc) (if (= i 0) acc (loop-glob (- i 1) (tagcase gt (b x (+ acc 1)) (else y acc))))))
(define* loop-aref (subr (maxeff spin (read @globals) (read @sc)) (int int) int)
  (lambda (i acc) (if (= i 0) acc (loop-aref (- i 1) (tagcase (array-ref arr 2) (a x (+ acc x)) (else y acc))))))
(define* loop-alen (subr (maxeff spin (read @globals) (read @sc)) (int int) int)
  (lambda (i acc) (if (= i 0) acc (loop-alen (- i 1) (+ acc (array-length arr))))))
(define* loop-mk (subr (maxeff spin (read @globals) (alloc @sc)) (int int) int)
  (lambda (i acc) (if (= i 0) acc (loop-mk (- i 1) (+ acc (array-length (the (arrayof v @sc) (make-array 3 gt))))))))
(define* loop-new (subr (maxeff spin (read @globals) (alloc @sc) (read @sc)) (int int) int)
  (lambda (i acc) (if (= i 0) acc (loop-new (- i 1) (+ acc (tagcase (get (the (ref v @sc) (new gt))) (b x 1) (else y 0)))))))
(define* loop-sum (subr spin (int int) int) (lambda (i acc) (if (= i 0) acc (loop-sum (- i 1) (tagcase (sum a i) (a x (+ acc 1)) (else y acc))))))
(define* say (subr (io stdout) (string) unit) (lambda (s) (begin (write-out (string-append s "\n")) #u)))
(define n 10000000)
(let ((t (i64->int (clock)))) (begin (loop-lit n 0) (say (string-append "literal sum " (int->string (ms t))))))
(let ((t (i64->int (clock)))) (begin (loop-sum n 0) (say (string-append "fresh sum " (int->string (ms t))))))
(let ((t (i64->int (clock)))) (begin (loop-glob n 0) (say (string-append "global read " (int->string (ms t))))))
(let ((t (i64->int (clock)))) (begin (loop-aref n 0) (say (string-append "array-ref @sc " (int->string (ms t))))))
(let ((t (i64->int (clock)))) (begin (loop-alen n 0) (say (string-append "array-length @sc " (int->string (ms t))))))
(let ((t (i64->int (clock)))) (begin (loop-mk n 0) (say (string-append "make-array 3 @sc " (int->string (ms t))))))
(let ((t (i64->int (clock)))) (begin (loop-new n 0) (say (string-append "new ref @sc " (int->string (ms t))))))

;; H3 (`docs/research/processes.md`, "H3"): what a message costs, by its
;; size. `fixpt eval` gives the table: (n ns-per-send ns-per-build) for
;; lists of n ints, the second what sharing would leave.
(define-type msg (listof int acyclic))
(define* build (subr spin (int msg) msg)
  (lambda (n acc) (if (= n 0) acc (build (- n 1) (cons n acc)))))
(define-type req (sumof (data msg) (stop (icell int @d))))
(define sink (addr req @p)
  (spawn (box req r)
    (letrec ((go (subr (maxeff (receive r) (init @d) nondet spin) (int) unit)
               (lambda (s)
                 (tagcase (receive box)
                   (data m (go (if (null? m) s (+ s (car m)))))
                   (stop c (begin (icell-put! c s) (go 0)))))))
      (go 0))))
;; ns per message: `k` sends of one list of `n`, built once.
(define* per-send (subr (maxeff (io clock) (send @p) (alloc @d) (await @d) spin) (int int) int)
  (lambda (n k)
    (let ((m (build n nil)) (t0 (clock)))
      (letrec ((loop (subr (maxeff (send @p) spin) (int) unit)
                 (lambda (i) (if (= i 0) #u (begin (send sink (sum data m)) (loop (- i 1)))))))
        (begin
          (loop k)
          (let ((c (the (icell int @d) (make-icell))))
            (begin (send sink (sum stop c)) (icell-get c)
                   (i64->int (i64-quotient (i64- (clock) t0) (int->i64 k))))))))))
;; ns to build a list of `n`, `k` times: what sharing would leave.
(define* per-build (subr (maxeff (io clock) spin) (int int) int)
  (lambda (n k)
    (let ((t0 (clock)))
      (letrec ((loop (subr spin (int int) int)
                 (lambda (i s) (if (= i 0) s (loop (- i 1) (+ s (car (build n (list 0)))))))))
        (begin (loop k 0) (i64->int (i64-quotient (i64- (clock) t0) (int->i64 k))))))))
(list (list 0 (per-send 0 20000) (per-build 0 20000))
      (list 1 (per-send 1 20000) (per-build 1 20000))
      (list 10 (per-send 10 20000) (per-build 10 20000))
      (list 100 (per-send 100 5000) (per-build 100 5000))
      (list 1000 (per-send 1000 1000) (per-build 1000 1000))
      (list 10000 (per-send 10000 200) (per-build 10000 200)))

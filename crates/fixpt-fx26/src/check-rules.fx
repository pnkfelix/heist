;;; The checker, in FX-26: the rules, each expression's type and effect,
;;; one recursive group: every expression's (`check-synth.fx`'s helpers
;;; before it), and `module`'s and `with`'s, whose items are expressions
;;; (`check-module-rules.fx`'s helpers before it). Part of the checker,
;;; `check-types.fx` first (PLAN.md §11, step 10).

;; Its types, those it uses of the files before it, and the signatures of
;; what it is given.
(let* ((check-types-types (load-module "fx26:check-types-types.fx"))
       (check-infer-types (load-module "fx26:check-infer-types.fx"))
       (check-binders-types (load-module "fx26:check-binders-types.fx"))
       (check-synth-types (load-module "fx26:check-synth-types.fx"))
       (check-resolve-types (load-module "fx26:check-resolve-types.fx"))
       (check-env-types (load-module "fx26:check-env-types.fx"))
       (check-module-rules-types (load-module "fx26:check-module-rules-types.fx"))
       (check-subtype-types (load-module "fx26:check-subtype-types.fx"))
       (check-sub-env-types (load-module "fx26:check-sub-env-types.fx"))
       (check-test-facts-types (load-module "fx26:check-test-facts-types.fx"))
       (check-modorder-types (load-module "fx26:check-modorder-types.fx"))
       (eager-reader-types ((proj (load-module "fx26:eager-reader-types.fx") @s @e @m @c)))
       (check-errors-types (load-module "fx26:check-errors-types.fx"))
       (check-expect-types (load-module "fx26:check-expect-types.fx"))
       (check-letrec-types (load-module "fx26:check-letrec-types.fx"))
       (check-dependent-types (load-module "fx26:check-dependent-types.fx"))
       (check-read-descs-types (load-module "fx26:check-read-descs-types.fx"))
       (check-read-helpers-types (load-module "fx26:check-read-helpers-types.fx"))
       (check-proving-types (load-module "fx26:check-proving-types.fx"))
       (check-close-types (load-module "fx26:check-close-types.fx"))
       (check-print-types (load-module "fx26:check-print-types.fx"))
       (check-print-parts-types (load-module "fx26:check-print-parts-types.fx"))
       (check-terminate-types (load-module "fx26:check-terminate-types.fx"))
       (check-sc-graphs-types (load-module "fx26:check-sc-graphs-types.fx"))
       (check-unions-types (load-module "fx26:check-unions-types.fx"))
       (check-modules-types (load-module "fx26:check-modules-types.fx"))
       (check-modules-read-types (load-module "fx26:check-modules-read-types.fx"))
       (check-effects-types (load-module "fx26:check-effects-types.fx"))
       (check-data-types (load-module "fx26:check-data-types.fx"))
       (check-read-types (load-module "fx26:check-read-types.fx"))
       (check-mask-types (load-module "fx26:check-mask-types.fx"))
       (check-calls-types (load-module "fx26:check-calls-types.fx"))
       (check-bounds-types (load-module "fx26:check-bounds-types.fx"))
       (check-holds-types (load-module "fx26:check-holds-types.fx"))
       (check-subst-types (load-module "fx26:check-subst-types.fx"))
       (check-processes-types (load-module "fx26:check-processes-types.fx"))
       (check-logic-types (load-module "fx26:check-logic-types.fx")))
  ;; What it is given: the modules of the files before it that it uses.
  (lambda ((check-types (select check-types-types check-types-sig))
           (check-infer (select check-infer-types check-infer-sig))
           (check-synth (select check-synth-types check-synth-sig))
           (check-errors (select check-errors-types check-errors-sig))
           (check-resolve (select check-resolve-types check-resolve-sig))
           (check-env (select check-env-types check-env-sig))
           (check-expect (select check-expect-types check-expect-sig))
           (check-letrec (select check-letrec-types check-letrec-sig))
           (check-dependent (select check-dependent-types check-dependent-sig))
           (check-module-rules (select check-module-rules-types check-module-rules-sig))
           (check-read-descs (select check-read-descs-types check-read-descs-sig))
           (check-proving (select check-proving-types check-proving-sig))
           (check-test-facts (select check-test-facts-types check-test-facts-sig))
           (check-close (select check-close-types check-close-sig))
           (check-print (select check-print-types check-print-sig))
           (check-terminate (select check-terminate-types check-terminate-sig))
           (check-modorder (select check-modorder-types check-modorder-sig))
           (check-unions (select check-unions-types check-unions-sig))
           (check-modules (select check-modules-types check-modules-sig))
           (check-effects (select check-effects-types check-effects-sig))
           (check-data (select check-data-types check-data-sig))
           (check-read (select check-read-types check-read-sig))
           (check-mask (select check-mask-types check-mask-sig))
           (check-calls (select check-calls-types check-calls-sig))
           (check-bounds (select check-bounds-types check-bounds-sig))
           (check-holds (select check-holds-types check-holds-sig))
           (check-subtype (select check-subtype-types check-subtype-sig))
           (check-subst (select check-subst-types check-subst-sig))
           (check-sc-graphs (select check-sc-graphs-types check-sc-graphs-sig))
           (check-binders (select check-binders-types check-binders-sig))
           (check-sub-env (select check-sub-env-types check-sub-env-sig))
           (check-modules-read (select check-modules-read-types check-modules-read-sig))
           (check-read-helpers (select check-read-helpers-types check-read-helpers-sig))
           (check-print-parts (select check-print-parts-types check-print-parts-sig))
           (check-processes (select check-processes-types check-processes-sig))
           (check-logic (select check-logic-types check-logic-sig)))
    (module

;; The types it uses of the files before it.
(hide (include check-types-types) (include check-infer-types) (include check-resolve-types)
      (include check-env-types) (include check-module-rules-types) (include check-subtype-types)
      (include check-test-facts-types) (include check-modorder-types) (include eager-reader-types))
(import check-synth-types (type k-done k-types-eff))
;; What it uses of the modules it is given: all of each, hidden.
(hide (include check-types) (include check-infer) (include check-binders) (include check-synth)
      (include check-errors) (include check-env) (include check-expect) (include check-letrec)
      (include check-dependent) (include check-module-rules) (include check-read-helpers)
      (include check-proving) (include check-test-facts) (include check-close)
      (include check-print-parts) (include check-print) (include check-terminate)
      (include check-sc-graphs) (include check-unions) (include check-modules-read)
      (include check-modules) (include check-mask) (include check-calls) (include check-bounds)
      (include check-holds) (include check-subtype) (include check-subst) (include check-processes))
(import check-resolve k-as-subr k-callee-of k-conversion-name k-end k-free-vars k-rename k-start
        k-at-of k-vsubr-parts)
(import check-logic k-spec-of k-spec-delta)
(import check-modorder k-early-modules k-lambda-item? k-mod-edges k-mod-groups k-mod-hazards
        k-mod-lambdas k-mod-recs-lambdas k-mod-star-lambdas)
(import check-effects k-insert k-one k-union)
(define k-is-data? (with check-data k-is-data?))
(define k-items (with check-read k-items))
(define k-part-find (with check-sub-env k-part-find))

(define-rec
  (k-synth (->* (kx) k-te)
    (lambda (x)
      (let* ((r (k-synth-node x)) (e (k-frozen x (extract r 2))))
        (begin (k-note-effect x e) (k-kill-paths e) (k-path-te x (k-te (extract r 1) e))))))
  (k-synth-node (->* (kx) k-te)
    (lambda (x)
      (tagcase x
        (x-var (s a b abk)
          (if (and (k-second-class? s) (k-std? s) (not (k-operator? s a b abk)))
              (k-fail (k-named-only s) a b)
              (let ((t (k-lookup-used s)))
                (if (< t 0) (k-fail (k-unbound s) a b) (k-te t (k-naming-effect s t))))))
        (x-const (t v a b abk) (k-te t nil))
        (x-lambda (ps body a b abk) (k-synth-lambda-as x nil -1 nil))
        (x-app (f args a b abk) (k-synth-app x f args -1))
        (x-the (t0 e a b abk)
          (let ((t (k-resolve-selects t0 a b))) (k-sized e (k-te t (k-check e t)))))
        (x-convention (c e a b abk)
          (let* ((r (k-synth e)) (t (k-resolve (extract r 1))))
            (tagcase (k-get t)
              (ty-subr (fe ps res from spc)
                (begin (if (k-conv=? from c) #u (k-convert-at x t c))
                       (k-te (k-ty-new (ty-subr fe ps res c spc)) (extract r 2))))
              (else y (k-fail-ty "`convention` takes a procedure, and this is a " t a b)))))
        (x-plambda (bs body a b abk)
          (let ((r (k-synth body)))
            (if (k-generalizable? body (extract r 2))
                (k-te (k-ty-new (ty-poly bs (extract r 1))) (extract r 2))
                (k-fail-impure-plambda (extract r 2) a b))))
        (x-rlambda (r l a b abk) (k-synth-rlambda-by x r l -1 nil k-synth k-synth-lambda-as))
        (x-proj (body ds a b abk)
          (let* ((r (k-synth body)) (t (extract r 1)))
            (tagcase (k-get t)
              (ty-poly (bs inner)
                (if (not (= (k-length bs) (k-length ds)))
                    (k-fail (k-proj-count-error bs ds) a b)
                    (let ((result (k-projected bs ds inner a b)))
                      (k-te-masked x result (extract r 2)))))
              (else y (k-fail-ty "`proj` needs a polymorphic value, not a " t a b)))))
        (x-if (p c d a b abk)
          (let ((rp (k-synth p)))
            (if (not (k-subtype (extract rp 1) k-bool))
                (k-fail "an `if` test must be a bool" (k-start p) (k-end p))
                (let* ((tested (k-enter-then p))
                       (rc (k-synth c))
                       (between (k-enter-else tested))
                       (rd (k-synth d))
                       (left (k-leave-test tested))
                       (t (k-join-branches (extract rc 1) (extract rd 1) a b))
                       (e (k-union (extract rp 2) (k-union (extract rc 2) (extract rd 2)))))
                  (k-te-masked x t e)))))
        (x-letrec (bs0 body a b abk)
          (let ((saved (k-mark)) (rsaved (get k-recursive)) (bs (k-letrec-selected bs0 a b)))
            (begin
              ;; The group bound and checked; the body's calls of it are not recursion.
              (let* ((ie (k-letrec-checked bs saved rsaved k-check k-check-letrec
                                           k-synth-lambda-as))
                     (restored (set k-recursive rsaved))
                     (rb (k-synth body)))
                (begin
                  (k-unbind-to saved)
                  (k-te-masked x (extract rb 1) (k-union ie (extract rb 2))))))))
        (x-let (bs body a b abk)
          (let* ((inits (k-synth-lets bs)) (saved (k-mark)) (named (get k-skolems)))
            (begin
              (k-bind-named (extract inits 1))
              (k-note-let-lambdas bs)
              (let ((rb (k-synth body)))
                (begin
                  (k-unbind-to saved)
                  (let ((t (k-forget-nats named (extract rb 1) a b)))
                    (k-te-masked x t (k-union (extract inits 2) (extract rb 2)))))))))
        (x-prompt (t body h a b abk) (k-synth-prompt x t body h))
        ;; The region's name is a variable too, of type `(place r)`, when
        ;; the form makes a place.
        (x-letregion (k r i body a b abk)
          (let* ((saved (k-mark))
                 (bound (if (or (= k 0) (= k 3)) #u (k-bind-place r)))
                 (freezing (get k-freezing))
                 (pushed (if (= k 3) (set k-freezing (cons r freezing)) #u))
                 (rb (k-synth body))
                 (rt (extract rb 1))
                 (written (k-has-id? (get k-written) r))
                 (popped (set k-freezing freezing)))
            (begin
              (k-unbind-to saved)
              (let ((t (if (= k 3) (k-frozen-result r i written rt a b) rt)))
                (k-close-region x (k-region-form k) r t (extract rb 2) a b)))))
        (x-bloblet (op i args a b abk) (k-synth-bloblet x op i args -1))
        (x-product (fs a b abk)
          (let* ((r (k-synth-fields fs)) (t (k-ty-new (ty-product (extract r 1)))))
            (k-te-masked x t (extract r 2))))
        (x-extract (e l a b abk)
          (let* ((r (k-synth e)) (pt (extract r 1)))
            (tagcase (k-get pt)
              (ty-product (fs)
                (let ((t (k-part-find fs l)))
                  (if (< t 0)
                      (k-fail-no-part pt " has no " l a b)
                      (begin (k-note-field (k-at-of x) (k-part-index fs l 0))
                             (k-te-masked x t (extract r 2))))))
              (else y (k-extract-blobref x pt e l r)))))
        (x-sum (l e a b abk)
          (let* ((r (k-synth e))
                 (t (k-ty-new (ty-sum (cons (product (1 l) (2 (extract r 1))) nil)))))
            (k-te-masked x t (extract r 2))))
        (x-tagcase (s arms els a b abk) (k-synth-tagcase x s arms els -1))
        (x-begin (xs a b abk) (k-masked x (k-synth-seq xs k-unit nil)))
        (x-module (items a b abk) (k-module-rule x))
        (x-with (m body a b abk) (k-module-rule x)))))
  (k-synth-seq (->* (kxs int k-eff) k-te)
    (lambda (xs last e)
      (if (null? xs)
          (k-te last e)
          (let ((r (k-synth (car xs))))
            (k-synth-seq (cdr xs) (extract r 1) (k-union e (extract r 2)))))))
  (k-synth-fields (->* (k-let-bs) (productof (1 k-parts) (2 k-eff)))
    (lambda (fs)
      (if (null? fs)
          (product (1 nil) (2 nil))
          (let* ((r (k-synth (extract (car fs) 2))) (rest (k-synth-fields (cdr fs)))
                 (part (product (1 (extract (car fs) 1)) (2 (extract r 1)))))
            (product (1 (cons part (extract rest 1)))
                     (2 (k-union (extract r 2) (extract rest 2))))))))
  (k-synth-lets (->* (k-let-bs) (productof (1 k-bindings) (2 k-eff)))
    (lambda (bs)
      (if (null? bs)
          (product (1 nil) (2 nil))
          (let* ((r (k-synth (extract (car bs) 2))) (rest (k-synth-lets (cdr bs))))
            (product (1 (cons (cons (extract (car bs) 1) (extract r 1)) (extract rest 1)))
                     (2 (k-union (extract r 2) (extract rest 2))))))))
  (k-check-letrec (->* (k-letrec-bs) k-eff)
    (lambda (bs)
      (if (null? bs)
          nil
          (let* ((n (extract (car bs) 1)) (t (extract (car bs) 2)) (init (extract (car bs) 3))
                 ;; Only lambdas: then nothing runs before every binding
                 ;; exists, and no one sees the knot tied.
                 (e (if (k-lambda? init) (k-check-declared n t init) (k-fail-not-lambda n init)))
                 (rest (k-check-letrec (cdr bs))))
            (k-union e rest)))))
  ;; Check `init` against `t`, the type `n` is declared; an error at `init`
  ;; itself says so.
  (k-check-declared (->* (symbol int kx) k-eff)
    (lambda (n t init)
      (let ((r (k-declaring (k-settled-thunk init t k-check) (k-start init) (k-end init) n t)))
        (extract r 2))))
  ;;; ------------------------------------------------------------ lambda

  ;; A `lambda`'s type. `hint` supplies the types of parameters the program
  ;; left out; `result`, when not -1, is what the body is checked against;
  ;; `sp`, the specification its type has, which the cells' verifier proves.
  (k-synth-lambda-as (->* (kx k-ids int k-specs) k-te)
    (lambda (x hint result sp)
      (tagcase x
        (x-lambda (ps body a b abk)
          (let* ((given (k-param-types ps hint a b))
                 (saved (k-mark))
                 (named (get k-skolems))
                 ;; Bound in order, a dependent procedure's (`check-modules.fx`).
                 (dep (k-bind-params given a b))
                 (typed (extract dep 1))
                 (want (if (>= result 0) (k-instantiate-params result (extract dep 2)) -1)))
            (let* ((deeper (set k-closure-depth (+ (get k-closure-depth) 1)))
                   (r (if (>= want 0)
                          (k-te-masked body want (k-check body want))
                          (k-masked body (k-synth body)))))
              (begin
                (k-unbind-to saved) (set k-closure-depth (- (get k-closure-depth) 1))
                (set k-last-latent (extract r 2)) (k-claims-proved sp body)
                (let ((res (k-forget-nats named (k-result-back (extract r 1) (extract dep 3)) a b)))
                  (k-te (k-new-subr-spec (extract r 2) (k-binding-types typed) res sp) nil))))))
        (else y (k-fail-at "a lambda" x)))))
  ;;; ------------------------------------------------------------ application
  (k-synth-app (->* (kx kx kxs int) k-te)
    (lambda (x f args expected)
      (let ((op (begin (k-note-fx-plain-op (k-under f)) (k-std-op f))) (lop (k-library-op f args)))
        (cond
          ((string=? lop "spawn-process") (k-spawn-te x f args expected k-synth))
          ((not (string=? lop "")) (k-branches-te lop x f args k-synth))
          (else (case op
          (("certify-acyclic") (k-certify x args))
          (("certify-length") (k-certify-length x args))
          (("certify-nat") (k-certify-nat x args k-synth))
          (("+" "-")
           (if (k-sc-two? args) (k-nat-arith x op args) (k-synth-app-plain x f args expected)))
          (("cons")
           (let ((r (k-nlist-cons x args expected)))
             (if (null? r) (k-synth-app-plain x f args expected) (car r))))
          (else (k-path-te x (k-sized x (k-synth-app-plain x f args expected))))))))))
  ;; `+` and `-` of naturals: a natural, of a size when both are known. Only
  ;; what has a type of its own is asked for it; anything else is told it
  ;; is an int, as for any call.
  (k-nat-arith (->* (kx string kxs) k-te)
    (lambda (x op args)
      (let* ((ra (k-nat-operand (car args)))
             (rb (k-nat-operand (car (cdr args))))
             (za (extract ra 2)) (zb (extract rb 2))
             (sz (k-nat-arith-size op za zb))
             (t (if (null? sz) k-int (k-ty-new (ty-nat (car sz))))))
        (k-te t (k-union (extract ra 1) (extract rb 1))))))
  (k-nat-operand (->* (kx) (productof (1 k-eff) (2 k-maybe-size)))
    (lambda (x)
      (if (not (k-natural-by-itself? x))
          (product (1 (k-check x k-int)) (2 (the k-maybe-size nil)))
          (let* ((r (k-synth x)) (t (extract r 1)))
            (begin (k-expect x t k-int) (product (1 (extract r 2)) (2 (k-operand-size x t))))))))
  ;; `(certify-length v k)`: `v`'s value as a `(nlist T k)`, where `length-is?`
  ;; has just found it so; nowhere else.
  (k-certify-length (->* (kx kxs) k-te)
    (lambda (x args)
      (let* ((none (the k-cert-lens nil))
             (found (if (k-sc-two? args) (k-length-arg (car args) (car (cdr args))) none))
             (ok (and (not (null? found)) (k-cert-len-has? (get k-certified-lengths) (car found)))))
        (if (not ok)
            (k-fail-at (string-append "`certify-length` takes only a variable and a length "
                                      "`length-is?` has just confirmed")
                       x)
            (let* ((r (k-synth (car args))) (t (k-resolve (extract r 1)))
                   (k (extract (car found) 3)))
              (tagcase (k-get t)
                (ty-pair (e tail rg nl)
                  (if (and (= (k-resolve tail) t) (tagcase rg (r-frozen (p f) #t) (else y #f)))
                      (k-nlist-te e k rg (extract r 2))
                      (k-fail-not-frozen t x)))
                (ty-nlist (e z rg) (k-nlist-te e k rg (extract r 2)))
                (else y (k-fail-not-frozen t x))))))))
  ;; `cons` onto a `nlist`: one more element. Where a `nlist` is expected, the
  ;; tail is checked as one shorter; otherwise, a tail that is a variable of
  ;; `nlist` type gives a `nlist` one longer. None if neither.
  (k-nlist-cons (->* (kx kxs int) (listof k-te acyclic))
    (lambda (x args expected)
      (if (not (k-sc-two? args))
          nil
          (let ((hd (car args)) (tl (car (cdr args))))
            (let ((want (if (< expected 0) (ty-void) (k-get expected))))
              (tagcase want
                (ty-nlist (e z r)
                  (if (not (or (k-size-any? z) (k-size-nonneg? (k-size-plus z -1))))
                      (k-nlist-cons-tail hd tl)
                      (let* ((tail-ty (k-ty-new (ty-nlist e (k-size-plus z -1) r)))
                             (xe (k-check hd e))
                             (te (k-check tl tail-ty)))
                        (the (listof k-te acyclic) (cons (k-te expected (k-union xe te)) nil)))))
                (else y (k-nlist-cons-tail hd tl))))))))
  (k-nlist-cons-tail (->* (kx kx) (listof k-te acyclic))
    (lambda (hd tl)
      (tagcase tl
        (x-var (v va vb vavbk)
          (let ((t (k-lookup v)))
            (if (< t 0)
                nil
                (tagcase (k-get t)
                  (ty-nlist (e z r)
                    (let* ((xe (k-check hd e)) (rt (k-synth tl))
                           (longer (k-ty-new (ty-nlist e (k-size-plus z 1) r)))
                           (e (k-union xe (extract rt 2))))
                      (the (listof k-te acyclic) (cons (k-te longer e) nil))))
                  (else y nil)))))
        (else y nil))))
  ;; `(certify-acyclic v)`: `v`'s value at `acyclic`, where `acyclic?` has
  ;; just found `v` acyclic; nowhere else.
  (k-certify (->* (kx kxs) k-te)
    (lambda (x args)
      (if (not (k-certified-arg? (get k-certified) args))
          (k-fail-at "`certify-acyclic` takes only a variable `acyclic?` has just found acyclic" x)
          (let* ((r (k-synth (car args))) (t (extract r 1)))
            (if (k-is-data? t) (k-te (k-finitized t) (extract r 2)) (k-fail-not-data t x))))))
  ;; An application's operator, where a second-class standard operation may
  ;; be named.
  (k-synth-operator (->* (kx) k-te)
    (lambda (f)
      (let ((outer (get k-operator)))
        (begin (set k-operator (k-operator-mark f))
               (let ((r (k-synth f))) (begin (set k-operator outer) r))))))
  (k-synth-app-plain (->* (kx kx kxs int) k-te)
    (lambda (x f args expected)
      (let* ((a (k-start x)) (b (k-end x))
             (rf (k-synth-operator f))
             (n (k-length args))
             (done (product (1 (the (arrayof int @t) (make-array n -1)))
                            (2 (the (arrayof k-eff @t) (make-array n nil)))))
             (ft (tagcase (k-get (extract rf 1))
                   (ty-poly (bs body)
                     (let ((inst (k-instantiate (extract rf 1) args expected a b done f)))
                       (begin (k-no-knot inst a b) inst)))
                   (else y (extract rf 1))))
             (callee (k-dependent-callee (k-as-subr ft) args a b))
             (variadic (k-vsubr-parts ft)))
        (cond
          ;; Any number of arguments, each of the element type.
          ((not (null? variadic))
           (let ((v (car variadic)))
             (k-app-result x f ft args (k-vapp-args args (extract v 2) 0 (extract rf 2))
                           (extract v 1) (extract v 3))))
          ((null? callee) (k-fail-ty "not a subroutine: " ft a b))
          ((not (= (k-length (extract (car callee) 2)) n))
           (k-fail-arg-count (k-length (extract (car callee) 2)) n a b))
          (else
           (let* ((c (car callee))
                  (e (k-app-args args (extract c 2) 0 done (extract rf 2))))
             (begin
               (k-note-call x f ft (extract c 2))
               (k-app-result x f ft args e (extract c 1) (extract c 3)))))))))
  ;; A call's type and effect, once its arguments have effect `e`: its
  ;; callee's latent effect too, `spin` where the call may loop, and what
  ;; the call masks; its result, of type `result`.
  (k-app-result (->* (kx kx int kxs k-eff k-eff int) k-te)
    (lambda (x f ft args e latent result)
      (let* ((e (k-union e latent))
             (e (if (k-may-spin? f ft args) (k-insert (a-spin) e) e)))
        (k-te-masked x result e))))
  (k-app-args (->* (kxs k-ids int k-done k-eff) k-eff)
    (lambda (args params i done e)
      (if (null? args)
          e
          (let* ((t (array-ref (extract done 1) i))
                 (ae (k-app-arg (car args) (car params) i t (array-ref (extract done 2) i))))
            (k-app-args (cdr args) (cdr params) (+ i 1) done (k-union e ae))))))
  ;; Argument `i`, `arg`, for a parameter of type `p`: its effect. Where it was found a `t` (≥ 0)
  ;; of effect `e`, that, converted if need be; checked against `p` where not.
  (k-app-arg (->* (kx int int int k-eff) k-eff)
    (lambda (arg p i t e)
      (cond ((< t 0) (k-check-argument arg p i))
            ((k-subtype t p) e)
            (else
             (let ((c (k-conversion t p)))
               (if (null? c)
                   (k-fail-at (string-append (k-argument-error i (k-show-ty t) (k-show-ty p))
                                             (k-spec-delta t p))
                              arg)
                   (begin (k-convert-at arg t (car c)) e)))))))
  ;; A `vsubr` call's arguments, each checked as its element type `t`.
  (k-vapp-args (->* (kxs int int k-eff) k-eff)
    (lambda (args t i e)
      (if (null? args)
          e
          (k-vapp-args (cdr args) t (+ i 1) (k-union e (k-check-argument (car args) t i))))))
  ;; An argument that failed to check is reported as that argument.
  (k-check-argument (->* (kx int int) k-eff)
    (lambda (arg p i)
      (let ((r (k-rewriting (lambda () (k-te p (k-check arg p))) (k-start arg) (k-end arg)
                            (lambda (m want got) (k-argument-error i got want)))))
        (extract r 2))))
  (k-instantiate (->* (int kxs int int int k-done kx) int)
    (lambda (ft args expected a b done f)
      (let* ((bo (k-binders-of ft)) (kinds (extract bo 1)) (inner (extract bo 2))
             (callee (k-callee-of inner (k-length args))))
        (if (null? callee)
            (k-fail-ty "not a subroutine, even once projected: " ft a b)
            (let ((params (extract (car callee) 2)) (result (extract (car callee) 3))
                  (solved (k-new-bounded-solved)))
              (if (not (= (k-length params) (k-length args)))
                  (k-fail-arg-count (k-length params) (k-length args) a b)
                  (begin
                    (if (>= expected 0) (k-unify-above result expected kinds solved) #u)
                    (k-inst-asked args params 0 kinds solved done)
                    (k-partial-pair-arg f (extract done 1) params kinds solved)
                    ;; A shape conflict is the error to report, before any
                    ;; binder is found unsolved (`DONE.md` §20).
                    (k-result-shape expected result kinds solved a b)
                    (k-inst-shapes args params 0 kinds solved (extract done 1))
                    (k-inst-told args params 0 kinds solved done)
                    (k-inst-shapes args params 0 kinds solved (extract done 1))
                    (k-default-regions kinds solved)
                    (if (< expected 0) (k-widen-nil-tail result kinds solved) #u)
                    (k-solved-instance kinds solved a b ft inner))))))))
  ;; What the arguments are, except the ones that need to be told.
  (k-inst-asked (->* (kxs k-ids int k-binders k-solved k-done) unit)
    (lambda (args params i kinds solved done)
      (if (null? args)
          #u
          (begin
            (if (k-needs-telling? (car args))
                #u
                (let ((p (k-subst (car params) (get solved))))
                  (if (not (k-mentions-any-unknown? p kinds solved))
                      (k-bounded-arg (car args) (car params) p kinds solved done i k-check k-synth)
                      (let ((r (k-synth (car args))))
                        (tagcase (k-get (extract r 1))
                          (ty-poly (bs body) #u)
                          (else y (k-arg-unified (car params) kinds solved done i r)))))))
            (k-inst-asked (cdr args) (cdr params) (+ i 1) kinds solved done)))))
  ;; The arguments that needed telling: each is checked against its parameter
  ;; as solved so far, and what it turns out to be solves more.
  (k-inst-told (->* (kxs k-ids int k-binders k-solved k-done) unit)
    (lambda (args params i kinds solved done)
      (if (null? args)
          #u
          (begin
            (if (>= (array-ref (extract done 1) i) 0)
                #u
                (let* ((arg (car args))
                       (defaulted (k-default-regions kinds solved))
                       (p (k-subst (car params) (get solved))))
                  (cond
                    ;; A thunk has no parameters to be told: told nothing, it
                    ;; says what it is, as any argument does.
                    ((and (k-needs-telling? arg) (null? (k-as-subr p)) (k-thunk-lambda? arg))
                     (k-arg-unified (car params) kinds solved done i (k-synth arg)))
                    ((k-needs-telling? arg)
                     (let ((c (k-as-subr p)))
                       (if (or (null? c) (k-any-unknown-type? (extract (car c) 2) kinds solved))
                           (k-fail-not-known arg i p)
                           (let* ((res (extract (car c) 3))
                                  (known (if (k-mentions-unknown-type? res kinds solved) -1 res))
                                  (sp (k-spec-of p))
                                  (r (k-synth-lambda-as arg (extract (car c) 2) known sp)))
                             (k-arg-unified (car params) kinds solved done i r)))))
                    ((k-mentions-unknown-type? p kinds solved)
                     (k-nil-told arg i p (car params) kinds solved done))
                    ;; A variable of a polymorphic type: instantiated at the
                    ;; parameter, and what it turns out to be solves more
                    ;; (`(apply list xs)`: `apply`'s effect).
                    (else
                     (let ((pv (k-poly-var-at arg p)))
                       (if (null? pv)
                           (k-arg-found done i p (k-check arg p))
                           (k-arg-unified (car params) kinds solved done i (car pv))))))))
            (k-inst-told (cdr args) (cdr params) (+ i 1) kinds solved done)))))
  ;;; ------------------------------------------------------------ check mode
  (k-check (->* (kx int) k-eff)
    (lambda (x expected)
      (let ((e (k-frozen x (k-check-mode x expected))))
        (begin (k-note-effect x e) (k-kill-paths e) e))))
  (k-check-mode (->* (kx int) k-eff)
    (lambda (x expected)
      (let* ((et (k-get expected))
             (poly? (tagcase et (ty-poly (bs body) #t) (else y #f)))
             (plambda? (tagcase x (x-plambda (bs body a b abk) #t) (else y #f)))
             ;; A `let` passes a `poly` to its body, and must then be pure.
             (let? (tagcase x (x-let (bs body a b abk) #t) (else y #f))))
        (cond
          ((and poly? let?)
           (let ((e (k-check-node x expected et)))
             (if (k-generalizable? x e)
                 e
                 (k-fail-effect "a polymorphic value must be pure, and this has " e
                                (k-start x) (k-end x)))))
          ((and poly? (not plambda?))
           (tagcase et
             (ty-poly (bs body)
               (let ((e (k-check x body)))
                 (if (k-generalizable? x e)
                     e
                     (k-fail-effect "a polymorphic value must be pure, and this has " e
                                    (k-start x) (k-end x)))))
             (else y nil)))
          ((and poly? plambda? (k-plambda-matches? x et))
           (tagcase x
             (x-plambda (binders body a b abk)
               (tagcase et
                 (ty-poly (bs want)
                   (let* ((want (k-subst want (k-rename bs binders))) (e (k-check body want)))
                     (if (k-generalizable? body e) e (k-fail-impure-plambda e a b))))
                 (else y nil)))
             (else y nil)))
          (else (k-check-node x expected et))))))
  (k-check-node (->* (kx int k-ty) k-eff)
    (lambda (x expected et)
      (letrec ((otherwise (subr (maxeff (read @globals) checks spin) () k-eff)
                           (lambda () (k-as-expected x (k-synth x) expected))))
       (the k-eff (let ((a (k-start x)) (b (k-end x)))
        (tagcase x
          (x-lambda (ps body xa xb xaxbk)
            (let ((c (k-as-subr expected)))
              (cond
                ((not (null? c))
                 (let ((want (extract (car c) 2)))
                   (if (not (= (k-length want) (k-length ps)))
                       (k-fail-arity (k-length want) "lambda" (k-length ps) a b)
                       (let* ((sp (k-spec-of expected))
                              (r (k-synth-lambda-as x want (extract (car c) 3) sp)))
                         (k-as-expected x r expected)))))
                ((k-some-untyped? ps) (k-fail-ty "a `lambda` cannot be a " expected a b))
                (else (otherwise)))))
          (x-rlambda (r l xa xb xaxbk)
            (if (null? (k-as-subr expected))
                (otherwise)
                (let ((sp (k-spec-of expected)))
                  (k-as-expected x (k-synth-rlambda-by x r l expected sp k-synth k-synth-lambda-as)
                                 expected))))
          (x-app (f args xa xb xaxbk)
            (k-as-expected-call x (k-synth-app x f args expected) expected))
          (x-bloblet (op i args xa xb xaxbk)
            (k-as-expected x (k-synth-bloblet x op i args expected) expected))
          (x-tagcase (s arms els xa xb xaxbk) (extract (k-synth-tagcase x s arms els expected) 2))
          (x-product (fs xa xb xaxbk)
            (tagcase et
              (ty-product (want)
                (if (k-same-labels? fs want)
                    (k-mask x (k-check-fields fs want) expected)
                    (otherwise)))
              (else y (otherwise))))
          (x-sum (l e xa xb xaxbk)
            (tagcase et
              (ty-sum (vs)
                (let ((t (k-part-find vs l)))
                  (if (>= t 0) (k-mask x (k-check e t) expected) (otherwise))))
              (else y (otherwise))))
          ;; A natural literal is a `nat`, and a `(nat k)`.
          ;; `#f` where `false` is expected, or a union with it.
          (x-const (ty k xa xb xaxbk)
            (if (or (and (= ty k-int) (k-literal-within? et k x))
                    (and (= ty k-bool) (= k 0) (k-false-expected? expected)))
                nil
                (otherwise)))
          (x-var (s xa xb xaxbk)
            (let ((t (k-lookup s)))
              (cond
               ;; `nil` is a `nlist` of no elements, or of some.
               ((and (string=? (symbol->string s) "nil") (>= t 0) (k-std-binding? s t)
                     (k-may-be-empty? et))
                nil)
               ((and (>= t 0) (tagcase (k-get t) (ty-poly (bs body) #t) (else y #f)))
                (let ((inst (k-instantiate-against t expected a b)))
                  (begin (k-expect x inst expected) (k-naming-effect s t))))
               (else (otherwise)))))
          (x-with (m body xa xb xaxbk)
            (let ((r (k-fx-poly-check x m body expected)))
              (cond ((not (null? r)) (begin (k-note-fx-plain body (k-at-of x)) (car r)))
                    ((k-fx-module? m) (otherwise))
                    (else (extract (k-synth-with x m body a b expected) 2)))))
          (x-if (p c d xa xb xaxbk)
            (let* ((pe (k-check p k-bool))
                   (tested (k-enter-then p))
                   (ce (k-check c expected))
                   (between (k-enter-else tested))
                   (de (k-check d expected))
                   (left (k-leave-test tested)))
              (k-mask x (k-union pe (k-union ce de)) expected)))
          (x-begin (xs xa xb xaxbk)
            (let ((e (k-check-seq xs expected nil)))
              (k-mask x e expected)))
          ;; A `letrec`'s body, as a `let`'s, against what is expected.
          (x-letrec (bs0 body xa xb xaxbk)
            (let ((saved (k-mark)) (rsaved (get k-recursive)) (bs (k-letrec-selected bs0 a b)))
              (begin
                (let* ((ie (k-letrec-checked bs saved rsaved k-check k-check-letrec
                                             k-synth-lambda-as))
                       (restored (set k-recursive rsaved))
                       (e (k-check body expected)))
                  (begin (k-unbind-to saved) (k-mask x (k-union ie e) expected))))))
          (x-let (bs body xa xb xaxbk)
            (let* ((inits (k-synth-lets bs)) (saved (k-mark)) (named (get k-skolems)))
              (begin
                (k-bind-named (extract inits 1))
                (k-note-let-lambdas bs)
                (let ((e (k-check body expected)))
                  (begin (k-unbind-to saved)
                         (set k-skolems named)
                         (k-mask x (k-union (extract inits 2) e) expected))))))
          (else y (otherwise))))))))
  (k-check-seq (->* (kxs int k-eff) k-eff)
    (lambda (xs expected e)
      (if (null? (cdr xs))
          (k-union e (k-check (car xs) expected))
          (let ((r (k-synth (car xs))))
            (k-check-seq (cdr xs) expected (k-union e (extract r 2)))))))
  (k-check-fields (->* (k-let-bs k-parts) k-eff)
    (lambda (fs ps)
      (if (null? fs)
          nil
          (let* ((e (k-check (extract (car fs) 2) (extract (car ps) 2)))
                 (rest (k-check-fields (cdr fs) (cdr ps))))
            (k-union e rest)))))
  ;; `body`'s type and effect: checked against `expected` if that is given (≥ 0), found if not.
  (k-synth-as (->* (kx int) k-te)
    (lambda (body expected)
      (if (>= expected 0) (k-te expected (k-check body expected)) (k-synth body))))
  (k-synth-tagcase (->* (kx kx k-arms k-let-bs int) k-te)
    (lambda (x s arms els expected)
      (let* ((r0 (k-synth s)) (rs (k-flat-view (k-at-of x) r0)) (st (extract rs 1)))
        (tagcase (k-get st)
          (ty-sum (variants)
            (let* ((arm-results (k-tagcase-arms arms variants st expected))
                   (rest (k-variants-not-named variants arms))
                   (e (k-union (extract rs 2) (extract arm-results 2)))
                   (armed (product (1 (extract arm-results 1)) (2 e)))
                   (both (k-tagcase-else x armed rest els expected (extract r0 1)))
                   (t (k-arms-type x (extract both 1) expected)))
              (k-te-masked x t (extract both 2))))
          (else y (k-fail-ty-at "a sum is expected here, and this is a " st s))))))
  ;; A `tagcase`'s arms' types and effect, `armed`, with its `else`, `els`, if any, for the
  ;; variants `rest` not named; an error at `x` if it has none, and some are not named.
  (k-tagcase-else
    (->* (kx k-types-eff k-parts k-let-bs int int) k-types-eff)
    (lambda (x armed rest els expected st)
      (if (null? els)
          (if (null? rest) armed (k-fail-no-arm rest x))
          (let* ((y (extract (car els) 1)) (body (extract (car els) 2))
                 (rest-ty (k-else-type st rest))
                 (r (k-in-scope-check y rest-ty body expected k-synth-as)))
            (product (1 (k-push-ids (extract armed 1) (cons (extract r 1) nil)))
                     (2 (k-union (extract armed 2) (extract r 2))))))))
  ;; Each arm: its type and the effects of all.
  (k-tagcase-arms (->* (k-arms k-parts int int) k-types-eff)
    (lambda (arms variants st expected)
      (if (null? arms)
          (product (1 nil) (2 nil))
          (let* ((arm (car arms)) (tag (extract arm 1)) (body (extract arm 4))
                 (t (k-part-find variants tag)))
            (if (< t 0)
                (k-fail-no-part st " has no tag " tag (k-start body) (k-end body))
                (let* ((bound (if (extract arm 2)
                                  (tagcase (k-get t)
                                    (ty-product (fs)
                                      (if (= (k-length fs) (k-length (extract arm 3)))
                                          (k-zip-fields (extract arm 3) fs)
                                          (k-cannot-take-apart tag t (extract arm 3) body)))
                                    (else y (k-cannot-take-apart tag t (extract arm 3) body)))
                                  (the k-bindings (cons (cons (car (extract arm 3)) t) nil))))
                       (saved (k-mark))
                       (r (begin
                            (k-bind-all bound)
                            (k-synth-as body expected)))
                       (restored (k-unbind-to saved))
                       (rest (k-tagcase-arms (cdr arms) variants st expected)))
                  (k-te-onto r rest)))))))
  ;;; ------------------------------------------------------------ bloblets
  (k-synth-bloblet (->* (kx symbol int kxs int) k-te)
    (lambda (x op i args expected)
      (let ((name (symbol->string op)))
        (if (k-op-either? name "make-bloblet" "rmake-bloblet")
            ;; `rmake-bloblet`'s region is its first operand's; `make-bloblet`'s
            ;; the type it is checked against, or a fresh one.
            (k-make-bloblet x (string=? name "rmake-bloblet") args expected)
            (if (string=? (substring name 0 5) "blobr")
                (k-blobref-op x name args expected k-synth k-check)
                (k-bloblet-op x name i args k-synth k-check))))))
  ;; `(make-bloblet n f …)`, or, if `rm`, `(rmake-bloblet r n f …)`.
  (k-make-bloblet (->* (kx bool kxs int) k-te)
    (lambda (x rm args expected)
      (let* ((a (k-start x)) (b (k-end x))
             (gr (if rm (k-synth (car args)) (k-te k-unit (the k-eff nil))))
             (given (the k-regions (if rm (cons (k-place-region (extract gr 1) a b) nil) nil)))
             (args (if rm (cdr args) args))
             (e (k-union (extract gr 2) (k-check (car args) k-int)))
             (fields (cdr args))
             (want (k-bloblet-want expected fields given))
             (made (if (null? want)
                       (let ((r (k-synth-each fields)))
                         (product (1 (extract r 1)) (2 (extract r 2))
                                  (3 (if (null? given) (k-fresh-region "bloblet") (car given)))))
                       (tagcase (car want)
                         (ty-bloblet (fs z r) (product (1 fs) (2 (k-check-each fields fs)) (3 r)))
                         (else y (k-fail "a bloblet" a b)))))
             (region (extract made 3))
             (e (k-insert (a-alloc region) (k-union e (extract made 2))))
             (t (k-ty-new (ty-bloblet (extract made 1) #f region)))
             (unknotted (k-no-knot t a b)))
        (k-te-masked x t e))))
  (k-synth-each (->* (kxs) k-types-eff)
    (lambda (xs)
      (if (null? xs)
          (product (1 nil) (2 nil))
          (let* ((r (k-synth (car xs))) (rest (k-synth-each (cdr xs))))
            (k-te-onto r rest)))))
  (k-check-each (->* (kxs k-ids) k-eff)
    (lambda (xs ts)
      (if (null? xs)
          nil
          (let* ((e (k-check (car xs) (car ts))) (rest (k-check-each (cdr xs) (cdr ts))))
            (k-union e rest)))))
  ;;; ------------------------------------------------------------ prompts
  ;;; The tag's type fixes what crosses the prompt, and the body's effect must
  ;;; be within the tag's bound apart from control on its region. Then the
  ;;; prompt delimits: that control is removed, if the body can reach no other
  ;;; tag in the region.
  (k-synth-prompt (->* (kx kx kx kx) k-te)
    (lambda (x tag body handler)
      (let* ((rt (k-synth tag)) (tt (extract rt 1)) (parts (k-tag-parts tt)))
        (if (null? parts)
            (k-fail-ty-at "a prompt needs a prompt tag, not a " tt tag)
            (let* ((p (car parts)) (answer (extract p 1)) (payload (extract p 2))
                   (bound (extract p 3)) (region (extract p 4)) (be (k-prompt-body body answer))
                   (own (k-insert (a-goto region) (k-one (a-comefrom region))))
                   (beyond (if (extract p 5) (k-beyond be bound own) nil)))
              (if (not (null? beyond))
                  (k-fail-beyond body bound beyond)
                  (let* ((rh (k-synth-handler handler payload answer))
                         (c (k-handler-callable handler (extract rh 1) payload answer))
                         (only (k-reaches-only? body tag region))
                         (delimited (if only (k-beyond be nil own) be))
                         (e (k-union (extract rh 2) (k-union (extract c 1) delimited))))
                    (k-te-masked x answer (k-union (extract rt 2) e)))))))))
  ;; A prompt's body's effect, checked as an `answer`, the type the tag's prompts deliver.
  (k-prompt-body (->* (kx int) k-eff)
    (lambda (body answer)
      (let ((r (k-rewriting (lambda () (k-te answer (k-check body answer)))
                            (k-start body) (k-end body)
                            (lambda (m want got) (k-prompt-body-error want got)))))
        (extract r 2))))
  ;; A handler written as a `lambda` of one parameter is told what it takes
  ;; and gives.
  (k-synth-handler (->* (kx int int) k-te)
    (lambda (h payload answer)
      (tagcase h
        (x-lambda (ps hbody a b abk)
          (if (= (k-length ps) 1)
              (k-rewriting (lambda () (k-synth-lambda-as h (cons payload nil) answer nil))
                           (k-start hbody) (k-end hbody)
                           (lambda (m want got) (k-handler-gives payload answer got)))
              (k-synth h)))
        (else y (k-synth h)))))
  ;;; ----------------------------------------------- `module` and `with`
  ;; The effect of `name`, the lambda `x` of `define*` or `->*` (`how`),
  ;; checked again at `tf`, the type found.
  (k-star-checked (->* (string symbol int kx) k-eff)
    (lambda (how name tf x)
      (let ((r (k-saying (lambda () (k-te tf (k-check-declared name tf x)))
                         (lambda (m) (k-star-mistake how name tf m)))))
        (extract r 2))))
  ;; An abstract type `t`, its representation seen only through its own
  ;; conversions, which stay inside the module: each the identity, made as a
  ;; closure is, checked on its representation and bound at `t`. A type
  ;; constructor's representation is a `dlambda` of its parameters: its
  ;; conversions are polymorphic in them, as FX-91's at a higher kind.
  (k-module-abs (->* (k-item int int k-made) k-made)
    (lambda (it a b made)
      (let* ((n (car (extract it 2)))
             (v (extract it 3))
             (whole (car (extract it 4)))
             (bs (tagcase (k-get whole) (ty-lam (bs body) bs) (else x (the k-binders nil))))
             (inner (tagcase (k-get whole)
                      (ty-lam (bs body) (tagcase body (dt (t) t) (else x whole)))
                      (else x whole)))
             (rep (k-resolve-selects inner a b))
             (var (k-ty-new (ty-var v)))
             (t (if (null? bs) var (k-ty-new (ty-app var (k-binders-as-descs bs)))))
             (identity (k-new-subr nil (the k-ids (cons rep nil)) rep))
             (fns (extract it 5))
             (up (k-check (car fns) identity))
             (down (k-check (car (cdr fns)) identity))
             (up-t (k-new-subr nil (the k-ids (cons rep nil)) t))
             (down-t (k-new-subr nil (the k-ids (cons t nil)) rep)))
        (begin
          (k-bind (k-conversion-name "up-" n) (if (null? bs) up-t (k-ty-new (ty-poly bs up-t))))
          (k-bind (k-conversion-name "down-" n)
                  (if (null? bs) down-t (k-ty-new (ty-poly bs down-t))))
          (k-made-of (k-part-onto n v (extract made 1)) (extract made 2) (extract made 3)
                     (extract made 4))))))
  ;; A value: checked against its type, if it has one, or found; bound, its
  ;; sizes and abstract types named for it, for the items after it.
  (k-module-val (->* (k-item int int k-made) k-made)
    (lambda (it a b made)
      (let* ((n (car (extract it 2)))
             (ts (extract it 4))
             (init (car (extract it 5)))
             (r (if (null? ts)
                    (k-synth init)
                    (let ((t (k-resolve-selects (car ts) a b))) (k-te t (k-check init t)))))
             (bound (k-bind n (k-name-nat n (extract r 1)))))
        (k-made-of (extract made 1) (extract made 2) (k-part-onto n (extract r 1) (extract made 3))
                   (k-union (extract made 4) (extract r 2))))))
  ;; Lambda `init`, `n`'s, checked against `t`; a `define-rec` member's
  ;; error said as of its declared type.
  (k-mod-check-one (->* (symbol int kx bool) k-eff)
    (lambda (n t init rec) (if rec (k-check-declared n t init) (k-settled-or init t k-check))))
  ;; A module's `define*` `n`, its lambda `init`, of type `decl` as written:
  ;; checked at `w`, its type reading any global, then at the type with the
  ;; globals its body read, found, its binding given that type, as a
  ;; top-level `define*` is. Only in a group of one (itself, if it calls
  ;; itself), as at the top level, where a `define*` is in no `define-rec`.
  ;; The effect, and the type found.
  (k-mod-star (->* (symbol int kx int k-letrec-bs string) k-eff-ty)
    (lambda (n w init decl group why)
      (let ((other (k-other-member group n)))
        (if (not (null? other))
            (begin (k-fail-at (k-cat5 "`define*` `" (symbol->string n)
                                      "` is in a recursive group with `"
                                      (symbol->string (extract (car other) 1)) "`: use `define`")
                              init)
                   (product (1 (the k-eff nil)) (2 w)))
            (let* ((rsaved (get k-recursive))
                   ;; Bound at its type as written while it is first checked,
                   ;; as a top-level `define*` is: a call of itself reads
                   ;; nothing more.
                   (as-written (k-rebind-top n decl))
                   (noted (if (null? group) #u (k-note-ending group why)))
                   (e0 (k-check-declared n w init))
                   (restored (set k-recursive rsaved))
                   (f (k-with-latent decl (k-globals-of (get k-last-latent))))
                   (rebound (k-rebind-top n f))
                   (again (the k-letrec-bs (cons (product (1 n) (2 f) (3 init)) nil)))
                   (renoted (if (null? group) #u (k-note-ending again why)))
                   (e (k-star-checked "`define*`" n f init))
                   (back (set k-recursive rsaved)))
              (product (1 e) (2 f)))))))
  (k-mod-check-lambdas
    (->* (k-letrec-bs k-mlams k-groups k-ends k-ids) k-mod-checked)
    (lambda (bs ls gs ws ds)
      (if (null? bs)
          (product (1 (the k-eff nil)) (2 (the k-letrec-bs nil)))
          (let* ((n (extract (car bs) 1)) (t (extract (car bs) 2)) (init (extract (car bs) 3))
                 (group (car gs))
                 (whys (k-ends-with ws group))
                 (why (if (null? group) "" (k-group-end whys group)))
                 (r (if (extract (car ls) 6)
                        (k-mod-star n t init (car ds) group why)
                        (let* ((rsaved (get k-recursive))
                               (noted (if (null? group) #u (k-note-ending group why)))
                               (e (k-mod-check-one n t init (extract (car ls) 5)))
                               (restored (set k-recursive rsaved)))
                          (product (1 e) (2 t)))))
                 (rest (k-mod-check-lambdas (cdr bs) (cdr ls) (cdr gs) whys (cdr ds))))
            (product (1 (k-union (extract r 1) (extract rest 1)))
                     (2 (the k-letrec-bs (cons (product (1 n) (2 (extract r 2)) (3 init))
                                               (extract rest 2)))))))))
  ;; Items `items` but typed lambdas, each in the scope of those before it
  ;; and of the typed lambdas.
  (k-module-items (->* (k-items int int k-made) k-made)
    (lambda (items a b made)
      (if (null? items)
          made
          (let* ((it (car items))
                 (k (extract it 1))
                 (next (cond
                         ((= k 0) (k-module-abs it a b made))
                         ((or (< k 0) (> k 3)) made)
                         ((= k 1)
                          (let ((t (k-resolve-selects (car (extract it 4)) a b)))
                            (k-made-of (extract made 1)
                                       (k-part-onto (car (extract it 2)) t (extract made 2))
                                       (extract made 3) (extract made 4))))
                         ;; Typed lambdas are checked after the rest; early ones before.
                         ((k-lambda-item? it) made)
                         ((>= (k-part-of (extract made 3) (car (extract it 2))) 0) made)
                         ((= k 2) (k-module-val it a b made))
                         (else made))))
            (k-module-items (cdr items) a b next)))))
  ;; `(module item …)`, as a `letrec*` (`check-modorder.fx`): its typed
  ;; lambdas bound first, at their written types; every other item checked in
  ;; order, in the scope of those and the items before it; then the lambdas,
  ;; in the scope of everything. The module's type, its abstract types bound
  ;; in it.
  (k-synth-module-here (->* (kx k-items int int) k-te)
    (lambda (x items a b)
      (let* ((saved (k-mark))
             (named (get k-skolems))
             (ls (k-mod-lambdas items))
             (stars (k-mod-star-lambdas items))
             (recs (k-mod-recs-lambdas ls))
             ;; Its modules as written first, for its lambdas' types to select from.
             (early (k-mod-early items (k-early-modules items)
                                 (lambda (it m) (k-module-val it a b m))
                                 (k-made-of nil nil nil nil)))
             (hazards (k-mod-hazards items ls (k-parts-modules (extract early 3))))
             (bound-ds (k-mod-bindings ls a b))
             (bs (extract bound-ds 1))
             (bound (k-mod-bind bs ls))
             (made (k-module-items items a b early))
             (es (k-mod-edges ls ls))
             (g (k-mod-star-groups es bs k-synth-lambda-as))
             (checked (k-mod-check-lambdas (extract g 1) ls (extract g 2) nil (extract bound-ds 2)))
             (le (extract checked 1))
             (unbound (k-unbind-to saved))
             (vs (k-parts-reversed (k-mod-vals items (extract made 3) (extract checked 2) nil) nil))
             ;; A component's module, bound inside, has abstract types no one
             ;; outside can name.
             (known (k-vals-known vs (k-named-since named (get k-skolems) nil) a b))
             (popped (set k-skolems named))
             (abs (k-parts-reversed (extract made 1) nil))
             (t (k-module-type items abs (k-parts-reversed (extract made 2) nil) vs (k-at-of x))))
        (k-te-masked x t (k-union (extract made 4) le)))))
  ;; The same; a module read from a file (`load-module`, M7) seeing only the
  ;; standard environment, what is wrong in it said where it is read.
  (k-synth-module (->* (kx k-items int int) k-te)
    (lambda (x items a b)
      (let ((k (if (null? items) 0 (extract (car items) 1))))
        (if (< k 4)
            (k-synth-module-here x items a b)
            (let ((got (the (ref k-te @t) (new (k-te 0 nil)))) (hid (get k-hide-mark)))
              (begin (set k-hide-mark (k-mark))
                     (k-in-loaded (lambda () (set got (k-synth-module-here x items a b))) k a b)
                     (set k-hide-mark hid)
                     (get got)))))))
  ;; `(with m body)`: the body with `m`'s values in scope, by name, at their
  ;; types for `m`; checked against `expected` if given (≥ 0).
  (k-synth-with (->* (kx symbol kx int int int) k-te)
    (lambda (x m body a b expected)
      (let ((mt (k-lookup m)) (shown (symbol->string m)) (lt (k-library-type m body)))
        (if (k-fx-module? m)
            (k-synth-fx x mt body a b)
        (if (and (>= lt 0) (>= mt 0))
            (k-library-with mt body lt x)
        (if (< mt 0)
            (k-fail (k-cat3 "`" shown "` is not bound") a b)
            (tagcase (k-get mt)
              (ty-module (abs ds vs)
                (let* ((used (k-with-used vs (k-include-free m (k-free-vars body)) 0))
                       (noted (k-note-with
                                (product (1 (k-at-of x)) (2 (k-comp-names (extract used 1)))
                                         (3 (extract used 2)))))
                       (naming (k-naming-effect m mt))
                       (r (k-in-scope-parts (extract used 1) body expected k-synth-as
                                            a b (k-start body) (k-end body))))
                  (k-te-masked x (extract r 1) (k-union naming (extract r 2)))))
              (else y (k-fail (k-with-not-module shown (k-show-ty mt)) a b)))))))))
  (k-module-rule (->* (kx) k-te)
    (lambda (x)
      (tagcase x
        (x-module (items a b abk) (k-synth-module x items a b))
        (x-with (m body a b abk) (k-synth-with x m body a b -1))
        (else y (k-fail-at "a module" x)))))))))

;;; Composable continuations that cross machines: native code and cellular
;;; code (made so by `stay-cellular`) between a prompt and the capture,
;;; each way round, through several machines, in tail position at each
;;; boundary, and deep; the marks such a continuation took; an abort from
;;; inside one, given a value, to the prompt outside it; and marks one
;;; machine set, read by another.
(define-effect marking (maxeff (read @m) (write @m) (alloc @m)))
(define-effect grabbing (maxeff (goto @p) (comefrom @p) (read @globals) marking spin))
(define u (prompt-tag int int grabbing @p) (make-continuation-prompt-tag))
;; The capture, native and cellular; each runs `k` twice.
(define* grab-n (subr grabbing () int)
  (lambda () (call-with-composable-continuation (lambda (k) (k (k 1))) u)))
(define* grab-c (subr grabbing () int)
  (lambda ()
    (begin (stay-cellular #u) (call-with-composable-continuation (lambda (k) (k (k 1))) u))))
;; Frames between, native and cellular, the capture not in tail position.
(define* climb-n (subr grabbing ((subr grabbing () int) int) int)
  (lambda (g d) (if (= d 0) (g) (+ 1 (climb-n g (- d 1))))))
(define* climb-c (subr grabbing ((subr grabbing () int) int) int)
  (lambda (g d) (begin (stay-cellular #u) (if (= d 0) (g) (+ 1 (climb-c g (- d 1)))))))
;; Native, then cellular, then native, each a few frames deep.
(define* mix (subr grabbing ((subr grabbing () int) int) int)
  (lambda (g d) (+ 100 (climb-n (lambda () (+ 10 (climb-c g d))) d))))
;; The same in tail position at each boundary.
(define* tail-c (subr grabbing ((subr grabbing () int)) int)
  (lambda (g) (begin (stay-cellular #u) (g))))
(define* tail-n (subr grabbing ((subr grabbing () int)) int)
  (lambda (g) (g)))
(define* under-n (subr grabbing ((subr grabbing () int)) int)
  (lambda (b) (prompt u (b) (lambda (v) v))))
(define* under-c (subr grabbing ((subr grabbing () int)) int)
  (lambda (b) (begin (stay-cellular #u) (prompt u (b) (lambda (v) v)))))
(list (under-n (lambda () (climb-c grab-c 3)))
      (under-c (lambda () (climb-n grab-n 3)))
      (under-n (lambda () (climb-c grab-n 3)))
      (under-c (lambda () (climb-n grab-c 3)))
      (under-n (lambda () (mix grab-c 2)))
      (under-n (lambda () (mix grab-n 2)))
      (under-c (lambda () (mix grab-c 2)))
      (under-c (lambda () (mix grab-n 2)))
      (under-n (lambda () (+ 5 (tail-c (lambda () (tail-n grab-c))))))
      (under-c (lambda () (+ 5 (tail-n (lambda () (tail-c grab-n))))))
      (under-n (lambda () (climb-c grab-c 20000)))
      (under-c (lambda () (climb-n grab-n 20000))))
;; The marks a crossing continuation took, in each machine's frames; an
;; abort from inside one to the prompt outside.
(define m (mark-key int @m) (make-continuation-mark-key))
(define* count (subr (maxeff (read @m) spin) ((listof int @m) int) int)
  (lambda (xs n) (if (null? xs) n (count (cdr xs) (+ (car xs) n)))))
(define* grab-marks (subr grabbing () int)
  (lambda () (begin (stay-cellular #u)
    (call-with-composable-continuation (lambda (k) (count (marks-of k m) 0)) u))))
(define-type stepper (subr grabbing ((subr grabbing () int) int) int))
(define* mark-c (subr grabbing ((subr grabbing () int) int stepper) int)
  (lambda (g d next) (begin (stay-cellular #u)
    (if (= d 0) (g) (+ 1 (with-mark m (* 100 d) (lambda () (+ 0 (next g (- d 1))))))))))
(define* mark-n (subr grabbing ((subr grabbing () int) int) int)
  (lambda (g d) (if (= d 0) (g) (+ 1 (with-mark m d (lambda () (+ 0 (mark-c g (- d 1) mark-n))))))))
(define* mark-c0 (subr grabbing ((subr grabbing () int) int) int)
  (lambda (g d) (mark-c g d mark-n)))
(define* under-1000 (subr grabbing ((subr grabbing () int)) int)
  (lambda (b) (prompt u (b) (lambda (v) (+ v 1000)))))
(define* bail (subr grabbing ((subr grabbing () int)) int)
  (lambda (g) (let ((v (g))) (if (> v 5) (abort-current-continuation u v) v))))
(list (under-1000 (lambda () (mark-n grab-marks 6)))
      (under-1000 (lambda () (mark-c0 grab-marks 6)))
      (under-1000 (lambda () (mark-n (lambda () (bail grab-c)) 4)))
      (under-1000 (lambda () (mark-c0 (lambda () (bail grab-n)) 4)))
      (under-1000 (lambda () (mark-c0 (lambda () (bail grab-c)) 4))))
;; Marks one machine set, read in another's code, each way round.
(define* look-c (subr grabbing () int)
  (lambda () (begin (stay-cellular #u) (+ (* 10 (count (current-marks m) 0)) (first-mark m 0)))))
(define* look-n (subr grabbing () int)
  (lambda () (+ (* 10 (count (current-marks m) 0)) (first-mark m 0))))
(define* in-n (subr grabbing ((subr grabbing () int)) int)
  (lambda (g) (+ 0 (with-mark m 7 (lambda () (+ 0 (g)))))))
(define* in-c (subr grabbing ((subr grabbing () int)) int)
  (lambda (g) (begin (stay-cellular #u) (+ 0 (with-mark m 8 (lambda () (+ 0 (g))))))))
(list (in-n look-c) (in-c look-n) (in-n (lambda () (in-c look-n))) (in-c (lambda () (in-n look-c))))

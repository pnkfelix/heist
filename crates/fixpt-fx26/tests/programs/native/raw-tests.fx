;;; `i64` and `u64` comparisons that only a branch reads, branched on the
;;; flags (TODO.md §121): each kind, signed and not, on values either side
;;; of zero and of the sign bit; in an `and` before a `string=?`, so that the
;;; branch's other way begins by loading a register, not by setting
;;; `RESULT`; and under `not`, the other way round.
(define-type i64s (listof i64 @heap))
(define-type u64s (listof u64 @heap))
(define* bump (subr pure (int int) int) (lambda (acc k) (+ (* acc 3) k)))
(define* signed-tests (subr spin (i64 i64 string int) int)
  (lambda (x y w acc)
    (let* ((a (if (and (i64< x y) (string=? w "w")) (bump acc 1) acc))
           (b (if (and (i64<= x y) (string=? w "w")) (bump a 2) a))
           (c (if (and (i64> x y) (string=? w "w")) (bump b 3) b))
           (d (if (and (i64>= x y) (string=? w "w")) (bump c 4) c))
           (e (if (not (i64= x y)) (bump d 6) d)))
      (if (and (i64= x y) (string=? w "w")) (bump e 5) e))))
(define* unsigned-tests (subr spin (u64 u64 string int) int)
  (lambda (x y w acc)
    (let* ((a (if (and (u64< x y) (string=? w "w")) (bump acc 1) acc))
           (b (if (and (u64<= x y) (string=? w "w")) (bump a 2) a))
           (c (if (and (u64> x y) (string=? w "w")) (bump b 3) b))
           (d (if (and (u64>= x y) (string=? w "w")) (bump c 4) c))
           (e (if (not (u64= x y)) (bump d 6) d)))
      (if (and (u64= x y) (string=? w "w")) (bump e 5) e))))
(define* each-i64 (subr (maxeff (read @heap) spin) (i64 i64s int) int)
  (lambda (x ys acc)
    (if (null? ys)
        acc
        (each-i64 x (cdr ys) (remainder (signed-tests x (car ys) "w" acc) 1000003)))))
(define* all-i64 (subr (maxeff (read @heap) spin) (i64s i64s int) int)
  (lambda (xs ys acc)
    (if (null? xs) acc (all-i64 (cdr xs) ys (each-i64 (car xs) ys acc)))))
(define* each-u64 (subr (maxeff (read @heap) spin) (u64 u64s int) int)
  (lambda (x ys acc)
    (if (null? ys)
        acc
        (each-u64 x (cdr ys) (remainder (unsigned-tests x (car ys) "w" acc) 1000003)))))
(define* all-u64 (subr (maxeff (read @heap) spin) (u64s u64s int) int)
  (lambda (xs ys acc)
    (if (null? xs) acc (all-u64 (cdr xs) ys (each-u64 (car xs) ys acc)))))
(define* raw-tests (subr (maxeff (alloc @heap) (read @heap) spin) (int) int)
  (lambda (n)
    (let* ((top (u64-shl (int->u64 1) 63))
           (is (the i64s (list (int->i64 (- 0 n)) (int->i64 -1) (int->i64 0) (int->i64 1)
                               (int->i64 n) (i64-shl (int->i64 1) 62))))
           (us (the u64s (list (int->u64 0) (int->u64 1) (int->u64 n) top
                               (u64-or top (int->u64 1)) (u64-not (int->u64 0))))))
      (+ (all-i64 is is 1) (all-u64 us us 1)))))
(raw-tests 1000)

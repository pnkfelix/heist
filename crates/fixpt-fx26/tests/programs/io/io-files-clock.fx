; Accepted: files, the clock and the arguments (TODO.md §84) at their
; types: what they make at the region given, each effect in its kind.
(define-type strs (listof string @l))
(define size (subr (maxeff (io fs-read) (alloc @b)) (string) int)
  (lambda (path)
    (tagcase (the (sumof (data (bytevectorof @b)) (failed io-error)) (read-file path))
      (data b (bytevector-length b))
      (failed e -1))))
(define names (subr (maxeff (io fs-read) (alloc @l)) (string) strs)
  (lambda (dir)
    (tagcase (the (sumof (names strs) (failed io-error)) (list-dir dir))
      (names ns ns)
      (failed e nil))))
(define save (subr (maxeff (io fs-write) (alloc @b) (read @b)) (string) bool)
  (lambda (path)
    (tagcase (write-file path (the (bytevectorof @b) (make-bytevector 3 (int->u8 65))))
      (done u #t)
      (failed e #f))))
(define later (subr (io clock) (int) unit)
  (lambda (ms) (sleep-until (i64+ (clock) (int->i64 (* ms 1000000))))))
(define first-arg (subr (maxeff (io args) (alloc @l) (read @l)) () string)
  (lambda () (let ((xs (the strs (args)))) (if (null? xs) "" (car xs)))))

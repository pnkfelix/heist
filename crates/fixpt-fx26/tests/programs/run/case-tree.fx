(define* sum-i
  (subr (maxeff spin (read @globals)) ((subr pure (int) int) (listof int acyclic) int) int)
  (lambda (f xs acc) (if (null? xs) acc (sum-i f (cdr xs) (+ acc (f (car xs)))))))
(define* sum-s
  (subr (maxeff spin (read @globals)) ((subr pure (symbol) int) (listof symbol acyclic) int) int)
  (lambda (f xs acc) (if (null? xs) acc (sum-s f (cdr xs) (+ acc (f (car xs)))))))
(define* sum-t
  (subr (maxeff spin (read @globals)) ((subr pure (string) int) (listof string acyclic) int) int)
  (lambda (f xs acc) (if (null? xs) acc (sum-t f (cdr xs) (+ acc (f (car xs)))))))
(define* score (subr (maxeff spin (read @globals)) () (listof int acyclic))
  (lambda ()
    (let ((is (the (listof int acyclic) (list -30 -23 -16 -9 -2 5 12 19 26 33 40 47 54 61 68 75
          82 89 96 103 110 117 124 131 138 145 152 159 166 173 180 187 194 201 208 215 222 229
          236 243 1000 -1000 6)))
          (ss (the (listof symbol acyclic) (list 's00 's01 's02 's03 's04 's05 's06 's07 's08
          's09 's10 's11 's12 's13 's14 's15 's16 's17 's18 's19 's20 's21 's22 's23 's24 's25
          's26 's27 's28 's29 's30 's31 's32 's33 's34 's35 's36 's37 's38 's39 's40 's41 's42
          's43 's44 's45 's46 's47 's48 's49 's50 's51 's52 's53 's54 's55 's56 's57 's58 's59
          's60 's61 's62 's63 's64 's65 's66 's67 's68 's69 'zz 's99)))
          (ts (the (listof string acyclic) (list "k00" "k01" "k02" "k03" "k04" "k05" "k06"
          "k07" "k08" "k09" "k10" "k11" "k12" "k13" "k14" "k15" "k16" "k17" "k18" "k19" "k20"
          "k21" "k22" "k23" "zz" ""))))
      (list (sum-i ci1 is 0) (sum-i ci2 is 0) (sum-s cs1 ss 0) (sum-s cs2 ss 0)
            (sum-t ct1 ts 0) (sum-t ct2 ts 0)))))
(score)

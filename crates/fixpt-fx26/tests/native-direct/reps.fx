;;; The analysis of representations' modules, and what `tests/native_reps.rs`
;;; calls of them: each step on a register word, its results as lists of ints.
(define dl (load-module "fx26:native-direct-x64-layout.fx"))
(define layout (load-module "fx26:layout.fx"))
(define reps ((load-input "fx26:native-reps.fx") dl layout))
(define-effect t-does (maxeff (read @globals) (read @k) (write @k) (alloc @k) spin))
(define-type t-ints (arrayof int @k))
(define-type t-bools (arrayof bool @k))
(define-type t-list (listof int @k))
(define-type t-cells (productof (1 t-ints) (2 t-bools)))
(define nr-split-slots (with reps nr-split-slots))
(define nr-starts (with reps nr-starts))
(define nr-raw-slots (with reps nr-raw-slots))
(define nr-raw-params (with reps nr-raw-params))
(define nr-raw-refs (with reps nr-raw-refs))
(define nr-live-in (with reps nr-live-in))
(define nr-web-names (with reps nr-web-names))
(define nr-reps-of (with reps nr-reps-of))
(define nr-step (with reps nr-step))
(define nr-join (with reps nr-join))
(define nr-unboxes (with reps nr-unboxes))
(define nr-checks (with reps nr-checks))
(define nr-raw-op (with reps nr-raw-op))
(define cell0 int (with layout word-cell0))
(define rop-invoke int (with layout rop-invoke))
(define rop-tailinvoke int (with layout rop-tailinvoke))

(define t-cells-of (subr t-does (tword) t-cells)
  (lambda (rw)
    (let* ((n (- (+ (tword-fields rw) 1) cell0))
           (fix (the t-ints (make-array n 0)))
           (is (the t-bools (make-array n #f))))
      (letrec ((go (subr t-does (int) unit)
                 (lambda (i)
                   (if (= i n)
                       #u
                       (begin (array-set! fix i (tword-int rw (+ cell0 i)))
                              (array-set! is i (tword-int? rw (+ cell0 i)))
                              (go (+ i 1)))))))
        (begin (go 0) (nr-split-slots (product (1 fix) (2 is))))))))
(define t-ints-list (subr t-does (t-ints int t-list) t-list)
  (lambda (a i acc) (if (< i 0) acc (t-ints-list a (- i 1) (cons (array-ref a i) acc)))))
(define t-ints (subr t-does (t-ints) t-list)
  (lambda (a) (t-ints-list a (- (array-length a) 1) nil)))
(define t-bools-list (subr t-does (t-bools int t-list) t-list)
  (lambda (a i acc)
    (if (< i 0) acc (t-bools-list a (- i 1) (cons (if (array-ref a i) 1 0) acc)))))
(define t-bools (subr t-does (t-bools) t-list)
  (lambda (a) (t-bools-list a (- (array-length a) 1) nil)))
(define t-count (subr t-does (t-list) int)
  (lambda (l) (if (null? l) 0 (+ 1 (t-count (cdr l))))))
(define t-fill (subr t-does (t-ints t-list int) unit)
  (lambda (a l i) (if (null? l) #u (begin (array-set! a i (car l)) (t-fill a (cdr l) (+ i 1))))))
(define t-array (subr t-does (t-list int) t-ints)
  (lambda (l n) (let ((a (the t-ints (make-array n 0)))) (begin (t-fill a l 0) a))))
(define t-raw-of (subr t-does (t-cells t-ints int) t-bools)
  (lambda (c starts slots)
    (if (< slots 0) (the t-bools (make-array 0 #f)) (nr-raw-slots c starts slots))))

(define t-split (subr t-does (tword) t-list) (lambda (rw) (t-ints (extract (t-cells-of rw) 1))))
(define t-starts (subr t-does (tword) t-list) (lambda (rw) (t-ints (nr-starts (t-cells-of rw)))))
(define t-raw (subr t-does (tword int) t-list)
  (lambda (rw slots)
    (let ((c (t-cells-of rw))) (t-bools (t-raw-of c (nr-starts c) slots)))))
(define t-params (subr t-does (tword int) int)
  (lambda (rw slots)
    (let* ((c (t-cells-of rw)) (s (nr-starts c))) (nr-raw-params c s (t-raw-of c s slots)))))
(define t-refs (subr t-does (tword int) t-list)
  (lambda (rw slots)
    (let* ((c (t-cells-of rw)) (s (nr-starts c)))
      (t-bools (nr-raw-refs c s (t-raw-of c s slots))))))
(define t-live (subr t-does (tword int) t-list)
  (lambda (rw slots)
    (let* ((c (t-cells-of rw)) (s (nr-starts c))) (t-ints (nr-live-in c s (t-raw-of c s slots))))))
;; Every call's callee taking REG1 and REG3 raw, if `known`.
(define t-callees (subr t-does (t-cells t-ints bool) t-ints)
  (lambda (c starts known)
    (let* ((ns (array-length starts)) (a (the t-ints (make-array ns 0))))
      (letrec ((go (subr t-does (int) unit)
                 (lambda (si)
                   (if (= si ns)
                       #u
                       (let ((op (array-ref (extract c 1) (array-ref starts si))))
                         (begin
                           (if (and known (or (= op rop-invoke) (= op rop-tailinvoke)))
                               (array-set! a si 5)
                               #u)
                           (go (+ si 1))))))))
        (begin (go 0) a)))))
;; The representations where each instruction starts, then where each ends;
;; then each one's conversions, each list of them ended by -1.
(define t-version (subr t-does (tword int int int) t-list)
  (lambda (rw slots fast known)
    (let* ((c (t-cells-of rw))
           (s (nr-starts c))
           (raw (t-raw-of c s slots))
           (params (nr-raw-params c s raw))
           (refs (nr-raw-refs c s raw))
           (callees (t-callees c s (= known 1)))
           (io (nr-reps-of c s (= fast 1) raw params callees))
           (ns (array-length s)))
      (letrec ((steps (subr t-does (int) t-list)
                 (lambda (si)
                   (if (= si ns)
                       nil
                       (append (extract (nr-step c (array-ref s si) (array-ref refs si) (= fast 1)
                                                 raw params (array-ref callees si)
                                                 (array-ref (extract io 1) si))
                                        1)
                               (cons -1 (steps (+ si 1))))))))
        (append (t-ints (extract io 1)) (append (t-ints (extract io 2)) (steps 0)))))))
;; One version's representations and conversions, as `t-version`'s, of the
;; pass's results computed once.
(define t-version-of (subr t-does (t-cells t-ints t-bools int t-bools bool bool) t-list)
  (lambda (c s raw params refs fast known)
    (let* ((callees (t-callees c s known))
           (io (nr-reps-of c s fast raw params callees))
           (ns (array-length s)))
      (letrec ((steps (subr t-does (int) t-list)
                 (lambda (si)
                   (if (= si ns)
                       nil
                       (append (extract (nr-step c (array-ref s si) (array-ref refs si) fast raw
                                                 params (array-ref callees si)
                                                 (array-ref (extract io 1) si))
                                        1)
                               (cons -1 (steps (+ si 1))))))))
        (append (t-ints (extract io 1)) (append (t-ints (extract io 2)) (steps 0)))))))
;; Everything of a word at once, each part ended by -1000000007: the cells split,
;; the starts, the raw slots, the raw parameters, the raw references, what
;; is live, the webs, then the four versions (fixnum then general, each with no
;; callee known, then with them).
(define t-all (subr t-does (tword int) t-list)
  (lambda (rw slots)
    (let* ((c (t-cells-of rw))
           (s (nr-starts c))
           (raw (t-raw-of c s slots))
           (params (nr-raw-params c s raw))
           (refs (nr-raw-refs c s raw)))
     (letrec ((end (subr t-does (t-list t-list) t-list)
                (lambda (a rest) (append a (cons -1000000007 rest))))
              (v (subr t-does (bool bool) t-list)
                (lambda (fast known) (t-version-of c s raw params refs fast known))))
      (end (t-ints (extract c 1))
           (end (t-ints s)
                (end (t-bools raw)
                     (end (cons params nil)
                          (end (t-bools refs)
                               (end (t-ints (nr-live-in c s raw))
                                    (end (if (< slots 0) nil (t-ints (nr-web-names c s slots)))
                                         (end (v #t #f)
                                              (end (v #t #t)
                                                   (end (v #f #f)
                                                        (end (v #f #t) nil)))))))))))))))
(define t-raw-op (subr t-does (string) string)
  (lambda (name)
    (let ((r (nr-raw-op name)))
      (string-append (int->string (extract r 1))
                     (string-append (if (extract r 2) " #t " " #f ") (extract r 3))))))

;;; The raw values' pieces' wrappers: the pieces of their own shapes
;;; (`tests/native_direct_x64_raw.rs`), `{EFF}` their effect.
(define t-raw-entry-skip (subr {EFF} (int) (listof int @k))
  (lambda (p) (begin (da-reset 0)
    (let ((n (dr-raw-entry-skip p)))
      (t-out (cons (modulo n 256) (cons (quotient n 256) nil)) nil)))))
(define t-float-test (subr {EFF} (bool string) (listof int @k))
  (lambda (d w)
    (begin (da-reset 0) (let ((b (dr-float-test d w))) (t-out (cons (t-bit b) nil) nil)))))
(define t-f32-fast (subr {EFF} (int string) (listof int @k))
  (lambda (y w)
    (begin (da-reset 0) (let ((b (dr-f32-fast w y))) (t-out (cons (t-bit b) nil) nil)))))
(define t-narrow-fast (subr {EFF} (int string) (listof int @k))
  (lambda (y w) (begin (da-reset 0)
    (let* ((l0 (da-label)) (b (dr-narrow-fast w y l0)))
      (t-out (cons (t-bit b) nil) (cons l0 nil))))))
(define t-int-slow (subr {EFF} (bool int int int int int bool bool bool) (listof int @k))
  (lambda (ov x y imm into prim sub br when)
    (begin (da-reset 0)
      (let* ((entry (da-label)) (o (if ov (da-label) -1)) (back (da-label))
             (b (if br (da-label) -1)))
        (begin
          (dr-int-slow (product (1 entry) (2 o) (3 back) (4 x) (5 y) (6 imm) (7 into) (8 prim)
                                (9 sub) (10 b) (11 when)))
          (t-out nil (if br (cons back (cons b nil)) (cons back nil))))))))

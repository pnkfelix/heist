;;; prims.fx: the procedures written in FX-26.
;;;
;;; Each takes its arguments as a list, their number checked first by the
;;; machine (`min`, `max`), and gives a value or raises a condition; none
;;; may fail in FX-26's sense (`car` of nil, an index out of range), since
;;; the editor runs them in a command, where nothing catches a failure.
;;; What calls procedures back (`map`, `for-each`, …) is in prelude.fx, in
;;; Scheme; what moves the machine itself (`call/cc`, `apply`,
;;; `dynamic-wind`, …) is numbered here and done in machine.fx.

(define-type s7-fn (subr s7-eff (s7-values) s7-out))

(define* s7-prim! (subr s7-eff (string int int s7-fn) unit)
  (lambda (name min max f)
    (s7-define-global! name (sum prim (product (name name) (min min) (max max) (op (sum fn f)))))))
"An operation of the machine's own, numbered (machine.fx's `s7-control`)."
(define* s7-ctl! (subr s7-eff (string int int int) unit)
  (lambda (name min max op)
    (s7-define-global! name (sum prim (product (name name) (min min) (max max) (op (sum ctl op)))))))
"Global `new` defined as global `old` is."
(define* s7-alias! (subr s7-eff (string string) unit)
  (lambda (new old) (s7-define-global! new (get (extract (s7-global-cell (string->symbol old)) value)))))

(define* s7-wrong (subr s7-eff (string string s7-value) s7-out)
  (lambda (who what v) (s7-fail (string-append who ": not " what) (list v))))
(define* s7-arg2 (subr pure (s7-values) s7-value)
  (lambda (a) (if (and (pair? a) (pair? (cdr a))) (car (cdr a)) s7-undefined)))
(define* s7-arg3 (subr pure (s7-values) s7-value)
  (lambda (a) (if (and (pair? a) (pair? (cdr a)) (pair? (cdr (cdr a)))) (car (cdr (cdr a))) s7-undefined)))
"Argument `i` (from 0), or `default` if there are not that many."
(define* s7-opt (subr spin (s7-values int s7-value) s7-value)
  (lambda (a i default)
    (cond ((null? a) default) ((= i 0) (car a)) (else (s7-opt (cdr a) (- i 1) default)))))
(define* s7-bool (subr pure (bool) s7-out) (lambda (b) (sum ok (sum bool b))))
(define* s7-ok-int (subr pure (int) s7-out) (lambda (i) (sum ok (sum int i))))

;;; ------------------------------------------------------------ numbers

(define* s7-number? (subr pure (s7-value) bool)
  (lambda (v) (tagcase v (int i #t) (ratio q #t) (real r #t) (else y #f))))
(define* s7-exact-number? (subr pure (s7-value) bool)
  (lambda (v) (tagcase v (int i #t) (ratio q #t) (else y #f))))
(define* s7-real-of (subr spin (s7-value) f64)
  (lambda (v) (tagcase v (int i (int->f64 i)) (ratio q (s7-ratio->f64 (extract q num) (extract q den))) (real r r) (else y 0.0))))
"An exact number's numerator and denominator."
(define* s7-num (subr pure (s7-value) int)
  (lambda (v) (tagcase v (int i i) (ratio q (extract q num)) (else y 0))))
(define* s7-den (subr pure (s7-value) int)
  (lambda (v) (tagcase v (ratio q (extract q den)) (else y 1))))
(define-type s7-qop (subr (maxeff spin (read @globals)) (int int int int) s7-value))
(define* s7-q+ (subr spin (int int int int) s7-value) (lambda (a b c d) (s7-make-ratio (+ (* a d) (* c b)) (* b d))))
(define* s7-q- (subr spin (int int int int) s7-value) (lambda (a b c d) (s7-make-ratio (- (* a d) (* c b)) (* b d))))
(define* s7-q* (subr spin (int int int int) s7-value) (lambda (a b c d) (s7-make-ratio (* a c) (* b d))))
"`a` and `b` combined: by `iop` if both are ints; by `qop` (numerators and
denominators) if both are exact; else as floats, by `rop`."
(define* s7-arith (subr s7-eff (string (subr pure (int int) int) s7-qop (subr pure (f64 f64) f64) s7-value s7-value) s7-out)
  (lambda (who iop qop rop a b)
    (cond ((not (s7-number? a)) (s7-wrong who "a number" a))
          ((not (s7-number? b)) (s7-wrong who "a number" b))
          (else (tagcase a
                  (int i (tagcase b
                           (int j (sum ok (sum int (iop i j))))
                           (else y (if (s7-exact-number? b) (sum ok (qop i 1 (s7-num b) (s7-den b)))
                                       (sum ok (sum real (rop (int->f64 i) (s7-real-of b))))))))
                  (else x (if (and (s7-exact-number? a) (s7-exact-number? b))
                              (sum ok (qop (s7-num a) (s7-den a) (s7-num b) (s7-den b)))
                              (sum ok (sum real (rop (s7-real-of a) (s7-real-of b)))))))))))
(define* s7-fold-arith (subr s7-eff (string (subr pure (int int) int) s7-qop (subr pure (f64 f64) f64) s7-value s7-values) s7-out)
  (lambda (who iop qop rop acc l)
    (if (null? l) (sum ok acc)
        (tagcase (s7-arith who iop qop rop acc (car l))
          (ok v (s7-fold-arith who iop qop rop v (cdr l)))
          (raise e (sum raise e))))))
"Whether numbers `a` and `b` stand in `iop` (as exact numbers, by cross
multiplication) or `rop` (as floats, if either is one)."
(define* s7-relates? (subr spin ((subr pure (int int) bool) (subr pure (f64 f64) bool) s7-value s7-value) bool)
  (lambda (iop rop a b)
    (if (and (s7-exact-number? a) (s7-exact-number? b))
        (iop (* (s7-num a) (s7-den b)) (* (s7-num b) (s7-den a)))
        (rop (s7-real-of a) (s7-real-of b)))))
(define* s7-less? (subr spin (s7-value s7-value) bool)
  (lambda (a b) (s7-relates? < f64< a b)))
"Whether each of `l` stands in `iop` (exact) or `rop` to the next."
(define* s7-compare (subr s7-eff (string (subr pure (int int) bool) (subr pure (f64 f64) bool) s7-values) s7-out)
  (lambda (who iop rop l)
    (letrec ((check (subr s7-eff (s7-values) s7-out)
               (lambda (l) (cond ((null? l) (s7-bool #t))
                                 ((s7-number? (car l)) (check (cdr l)))
                                 (else (s7-wrong who "a number" (car l))))))
             (go (subr s7-eff (s7-values) bool)
               (lambda (l)
                 (or (null? l) (null? (cdr l))
                     (and (s7-relates? iop rop (car l) (car (cdr l))) (go (cdr l)))))))
      (tagcase (check l)
        (ok v (s7-bool (go l)))
        (raise e (sum raise e))))))
"An int's digits in `radix`."
(define* s7-int->string (subr spin (int int) string)
  (lambda (i radix)
    (if (= radix 10) (int->string i)
        (letrec ((go (subr spin (int (listof char acyclic)) (listof char acyclic))
                   (lambda (n acc)
                     (let ((c (string-ref "0123456789abcdefghijklmnopqrstuvwxyz" (remainder n radix))))
                       (if (< n radix) (cons c acc) (go (quotient n radix) (cons c acc)))))))
          (if (< i 0) (string-append "-" (list->string (go (- 0 i) nil))) (list->string (go i nil)))))))
"The largest int whose square is at most `n` (n ≥ 0): Newton's method."
(define* s7-isqrt (subr spin (int) int)
  (lambda (n)
    (if (< n 2) n
        (letrec ((go (subr spin (int) int)
                   (lambda (x)
                     (let ((y (quotient (+ x (quotient n x)) 2)))
                       (if (>= y x) x (go y))))))
          (go n)))))
"`b` to the `e`, `e` ≥ 0, by squaring."
(define* s7-expt-int (subr spin (int int) int)
  (lambda (b e)
    (cond ((= e 0) 1)
          ((= (remainder e 2) 0) (let ((h (s7-expt-int b (quotient e 2)))) (* h h)))
          (else (* b (s7-expt-int b (- e 1)))))))
"Integer `v`'s value, or #f: an int, or a float with no fraction."
(define* s7-integer-of (subr pure (s7-value) (union false int))
  (lambda (v)
    (tagcase v
      (int i i)
      (real r (if (and (f64-finite? r) (f64= r (f64-round r))) (f64->int r) #f))
      (else y #f))))
"A division of integers: `iop` on ints (by zero, an error); on floats with
no fraction, `rop`, inexact."
(define* s7-int-div (subr s7-eff (string (subr pure (int int) int) s7-value s7-value) s7-out)
  (lambda (who iop a b)
    (typecase (s7-integer-of a)
      (int i (typecase (s7-integer-of b)
               (int j (if (= j 0) (s7-fail (string-append who ": division by zero") (list a))
                          (tagcase a
                            (int x (tagcase b (int y (s7-ok-int (iop i j))) (else z (sum ok (sum real (int->f64 (iop i j)))))))
                            (else z (sum ok (sum real (int->f64 (iop i j))))))))
               (else z (s7-wrong who "an integer" b))))
      (else z (s7-wrong who "an integer" a)))))
"The floor of `a / b`, of ints, `b` not 0."
(define* s7-floor-quotient (subr pure (int int) int)
  (lambda (a b) (let ((q (quotient a b))) (if (and (not (= (remainder a b) 0)) (not (bool=? (< a 0) (< b 0)))) (- q 1) q))))

"A one-float function on a number."
(define* s7-float-fn (subr s7-eff (string (subr pure (f64) f64) s7-values) s7-out)
  (lambda (who f a)
    (if (s7-number? (car a)) (sum ok (sum real (f (s7-real-of (car a))))) (s7-wrong who "a number" (car a)))))
"A rounding: ints are themselves; a ratio rounded by `q` (of its
numerator and denominator); a float by `f`."
(define* s7-rounding (subr s7-eff (string (subr pure (f64) f64) (subr (maxeff spin (read @globals)) (int int) int) s7-values) s7-out)
  (lambda (who f q a)
    (tagcase (car a)
      (int i (sum ok (car a)))
      (ratio r (s7-ok-int (q (extract r num) (extract r den))))
      (real r (sum ok (sum real (f r))))
      (else y (s7-wrong who "a number" y)))))
(define* s7-ceiling-quotient (subr pure (int int) int)
  (lambda (n d) (- 0 (s7-floor-quotient (- 0 n) d))))
"`n/d` (d > 0) rounded, to even at a half."
(define* s7-round-quotient (subr pure (int int) int)
  (lambda (n d)
    (let* ((q (s7-floor-quotient n d)) (r2 (* 2 (- n (* q d)))))
      (cond ((< r2 d) q) ((> r2 d) (+ q 1)) ((= (remainder q 2) 0) q) (else (+ q 1))))))
"Round to even, as R7RS's `round` does."
(define* s7-round-even (subr pure (f64) f64)
  (lambda (r)
    (let* ((fl (f64-floor r)) (diff (f64- r fl)))
      (cond ((f64< diff 0.5) fl)
            ((f64> diff 0.5) (f64+ fl 1.0))
            ((f64= (f64- fl (f64* 2.0 (f64-floor (f64/ fl 2.0)))) 0.0) fl)
            (else (f64+ fl 1.0))))))

(define* s7-init-numbers! (subr s7-eff () unit)
  (lambda ()
    (begin
      (s7-prim! "+" 0 -1 (lambda ((a s7-values)) (s7-fold-arith "+" + s7-q+ f64+ (sum int 0) a)))
      (s7-prim! "*" 0 -1 (lambda ((a s7-values)) (s7-fold-arith "*" * s7-q* f64* (sum int 1) a)))
      (s7-prim! "-" 1 -1 (lambda ((a s7-values))
                           (if (null? (cdr a)) (s7-arith "-" - s7-q- f64- (sum int 0) (car a))
                               (s7-fold-arith "-" - s7-q- f64- (car a) (cdr a)))))
      (s7-prim! "/" 1 -1
                (lambda ((a s7-values))
                  (letrec ((div (subr s7-eff (s7-value s7-value) s7-out)
                             (lambda (x y)
                               (cond ((not (s7-number? x)) (s7-wrong "/" "a number" x))
                                     ((not (s7-number? y)) (s7-wrong "/" "a number" y))
                                     ((and (s7-exact-number? x) (s7-exact-number? y))
                                      (if (= (s7-num y) 0) (s7-fail "/: division by zero" (list x))
                                          (sum ok (s7-make-ratio (* (s7-num x) (s7-den y)) (* (s7-den x) (s7-num y))))))
                                     (else (sum ok (sum real (f64/ (s7-real-of x) (s7-real-of y))))))))
                           (go (subr s7-eff (s7-value s7-values) s7-out)
                             (lambda (acc l)
                               (if (null? l) (sum ok acc)
                                   (tagcase (div acc (car l)) (ok v (go v (cdr l))) (raise e (sum raise e)))))))
                    (if (null? (cdr a)) (div (sum int 1) (car a)) (go (car a) (cdr a))))))
      (s7-prim! "=" 1 -1 (lambda ((a s7-values)) (s7-compare "=" = f64= a)))
      (s7-prim! "<" 1 -1 (lambda ((a s7-values)) (s7-compare "<" < f64< a)))
      (s7-prim! ">" 1 -1 (lambda ((a s7-values)) (s7-compare ">" > f64> a)))
      (s7-prim! "<=" 1 -1 (lambda ((a s7-values)) (s7-compare "<=" <= f64<= a)))
      (s7-prim! ">=" 1 -1 (lambda ((a s7-values)) (s7-compare ">=" >= f64>= a)))
      (s7-prim! "quotient" 2 2 (lambda ((a s7-values)) (s7-int-div "quotient" quotient (car a) (s7-arg2 a))))
      (s7-prim! "remainder" 2 2 (lambda ((a s7-values)) (s7-int-div "remainder" remainder (car a) (s7-arg2 a))))
      (s7-prim! "modulo" 2 2 (lambda ((a s7-values)) (s7-int-div "modulo" modulo (car a) (s7-arg2 a))))
      (s7-alias! "truncate-quotient" "quotient")
      (s7-alias! "truncate-remainder" "remainder")
      (s7-alias! "floor-remainder" "modulo")
      (s7-prim! "floor-quotient" 2 2 (lambda ((a s7-values)) (s7-int-div "floor-quotient" s7-floor-quotient (car a) (s7-arg2 a))))
      (s7-prim! "number?" 1 1 (lambda ((a s7-values)) (s7-bool (s7-number? (car a)))))
      (s7-alias! "complex?" "number?")
      (s7-prim! "real?" 1 1 (lambda ((a s7-values)) (s7-bool (s7-number? (car a)))))
      (s7-prim! "rational?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (int i #t) (ratio q #t) (real r (f64-finite? r)) (else y #f)))))
      (s7-prim! "integer?" 1 1 (lambda ((a s7-values)) (s7-bool (typecase (s7-integer-of (car a)) (int i #t) (else y #f)))))
      (s7-prim! "exact?" 1 1 (lambda ((a s7-values)) (tagcase (car a) (int i (s7-bool #t)) (ratio q (s7-bool #t)) (real r (s7-bool #f)) (else y (s7-wrong "exact?" "a number" y)))))
      (s7-prim! "inexact?" 1 1 (lambda ((a s7-values)) (tagcase (car a) (int i (s7-bool #f)) (ratio q (s7-bool #f)) (real r (s7-bool #t)) (else y (s7-wrong "inexact?" "a number" y)))))
      (s7-prim! "exact-integer?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (int i #t) (else y #f)))))
      (s7-prim! "nan?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (real r (f64-nan? r)) (else y #f)))))
      (s7-prim! "infinite?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (real r (f64-infinite? r)) (else y #f)))))
      (s7-prim! "finite?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (real r (f64-finite? r)) (else y #t)))))
      (s7-prim! "zero?" 1 1 (lambda ((a s7-values)) (s7-compare "zero?" = f64= (list (car a) (sum int 0)))))
      (s7-prim! "positive?" 1 1 (lambda ((a s7-values)) (s7-compare "positive?" > f64> (list (car a) (sum int 0)))))
      (s7-prim! "negative?" 1 1 (lambda ((a s7-values)) (s7-compare "negative?" < f64< (list (car a) (sum int 0)))))
      (s7-prim! "odd?" 1 1 (lambda ((a s7-values)) (typecase (s7-integer-of (car a)) (int i (s7-bool (not (= (remainder i 2) 0)))) (else y (s7-wrong "odd?" "an integer" (car a))))))
      (s7-prim! "even?" 1 1 (lambda ((a s7-values)) (typecase (s7-integer-of (car a)) (int i (s7-bool (= (remainder i 2) 0))) (else y (s7-wrong "even?" "an integer" (car a))))))
      (s7-prim! "max" 1 -1 (lambda ((a s7-values))
                             (letrec ((go (subr s7-eff (s7-value bool s7-values) s7-out)
                                        (lambda (best inexact l)
                                          (cond ((null? l) (sum ok (if inexact (sum real (s7-real-of best)) best)))
                                                ((not (s7-number? (car l))) (s7-wrong "max" "a number" (car l)))
                                                (else (go (if (s7-less? best (car l)) (car l) best)
                                                          (or inexact (tagcase (car l) (real r #t) (else y #f))) (cdr l)))))))
                               (if (s7-number? (car a)) (go (car a) (tagcase (car a) (real r #t) (else y #f)) (cdr a)) (s7-wrong "max" "a number" (car a))))))
      (s7-prim! "min" 1 -1 (lambda ((a s7-values))
                             (letrec ((go (subr s7-eff (s7-value bool s7-values) s7-out)
                                        (lambda (best inexact l)
                                          (cond ((null? l) (sum ok (if inexact (sum real (s7-real-of best)) best)))
                                                ((not (s7-number? (car l))) (s7-wrong "min" "a number" (car l)))
                                                (else (go (if (s7-less? (car l) best) (car l) best)
                                                          (or inexact (tagcase (car l) (real r #t) (else y #f))) (cdr l)))))))
                               (if (s7-number? (car a)) (go (car a) (tagcase (car a) (real r #t) (else y #f)) (cdr a)) (s7-wrong "min" "a number" (car a))))))
      (s7-prim! "abs" 1 1 (lambda ((a s7-values))
                            (tagcase (car a)
                              (int i (s7-ok-int (if (< i 0) (- 0 i) i)))
                              (ratio q (sum ok (s7-make-ratio (let ((n (extract q num))) (if (< n 0) (- 0 n) n)) (extract q den))))
                              (real r (sum ok (sum real (f64-abs r))))
                              (else y (s7-wrong "abs" "a number" y)))))
      (s7-alias! "magnitude" "abs")
      (s7-prim! "gcd" 0 -1 (lambda ((a s7-values))
                             (letrec ((go (subr s7-eff (int s7-values) s7-out)
                                        (lambda (acc l) (if (null? l) (s7-ok-int acc)
                                                            (typecase (s7-integer-of (car l))
                                                              (int i (go (s7-gcd acc i) (cdr l)))
                                                              (else y (s7-wrong "gcd" "an integer" (car l))))))))
                               (go 0 a))))
      (s7-prim! "lcm" 0 -1 (lambda ((a s7-values))
                             (letrec ((go (subr s7-eff (int s7-values) s7-out)
                                        (lambda (acc l) (if (null? l) (s7-ok-int acc)
                                                            (typecase (s7-integer-of (car l))
                                                              (int i (go (if (or (= i 0) (= acc 0)) 0
                                                                             (let ((p (quotient (* acc i) (s7-gcd acc i)))) (if (< p 0) (- 0 p) p)))
                                                                         (cdr l)))
                                                              (else y (s7-wrong "lcm" "an integer" (car l))))))))
                               (go 1 a))))
      (s7-prim! "numerator" 1 1 (lambda ((a s7-values))
                                  (tagcase (car a)
                                    (real r (if (f64-finite? r) (sum ok (sum real (int->f64 (s7-num (s7-f64->exact r))))) (s7-wrong "numerator" "a rational" (car a))))
                                    (else y (if (s7-number? y) (s7-ok-int (s7-num y)) (s7-wrong "numerator" "a number" y))))))
      (s7-prim! "denominator" 1 1 (lambda ((a s7-values))
                                    (tagcase (car a)
                                      (real r (if (f64-finite? r) (sum ok (sum real (int->f64 (s7-den (s7-f64->exact r))))) (s7-wrong "denominator" "a rational" (car a))))
                                      (else y (if (s7-number? y) (s7-ok-int (s7-den y)) (s7-wrong "denominator" "a number" y))))))
      (s7-prim! "floor" 1 1 (lambda ((a s7-values)) (s7-rounding "floor" f64-floor s7-floor-quotient a)))
      (s7-prim! "ceiling" 1 1 (lambda ((a s7-values)) (s7-rounding "ceiling" f64-ceiling s7-ceiling-quotient a)))
      (s7-prim! "truncate" 1 1 (lambda ((a s7-values)) (s7-rounding "truncate" f64-truncate quotient a)))
      (s7-prim! "round" 1 1 (lambda ((a s7-values)) (s7-rounding "round" s7-round-even s7-round-quotient a)))
      (s7-prim! "exact" 1 1 (lambda ((a s7-values))
                              (tagcase (car a)
                                (int i (sum ok (car a)))
                                (ratio q (sum ok (car a)))
                                (real r (if (f64-finite? r) (sum ok (s7-f64->exact r))
                                            (s7-fail "exact: no exact number is infinite or NaN" (list (car a)))))
                                (else y (s7-wrong "exact" "a number" y)))))
      (s7-alias! "inexact->exact" "exact")
      (s7-prim! "inexact" 1 1 (lambda ((a s7-values)) (if (s7-number? (car a)) (sum ok (sum real (s7-real-of (car a)))) (s7-wrong "inexact" "a number" (car a)))))
      (s7-alias! "exact->inexact" "inexact")
      (s7-prim! "sqrt" 1 1 (lambda ((a s7-values))
                             (tagcase (car a)
                               (int i (let ((r (s7-isqrt i)))
                                        (if (and (>= i 0) (= (* r r) i)) (s7-ok-int r) (sum ok (sum real (f64-sqrt (int->f64 i)))))))
                               (ratio q (let ((n (s7-isqrt (extract q num))) (d (s7-isqrt (extract q den))))
                                          (if (and (> (extract q num) 0) (= (* n n) (extract q num)) (= (* d d) (extract q den)))
                                              (sum ok (s7-make-ratio n d))
                                              (sum ok (sum real (f64-sqrt (s7-real-of (car a))))))))
                               (real r (sum ok (sum real (f64-sqrt r))))
                               (else y (s7-wrong "sqrt" "a number" y)))))
      (s7-prim! "exact-integer-sqrt" 1 1 (lambda ((a s7-values))
                                           (tagcase (car a)
                                             (int i (if (< i 0) (s7-wrong "exact-integer-sqrt" "a non-negative integer" (car a))
                                                        (let ((r (s7-isqrt i))) (sum ok (sum multi (list (sum int r) (sum int (- i (* r r)))))))))
                                             (else y (s7-wrong "exact-integer-sqrt" "an exact integer" y)))))
      (s7-prim! "square" 1 1 (lambda ((a s7-values)) (s7-arith "square" * s7-q* f64* (car a) (car a))))
      (s7-prim! "expt" 2 2 (lambda ((a s7-values))
                             (let ((b (car a)) (e (s7-arg2 a)))
                               (cond ((not (s7-number? b)) (s7-wrong "expt" "a number" b))
                                     ((not (s7-number? e)) (s7-wrong "expt" "a number" e))
                                     ((and (s7-exact-number? b) (tagcase e (int j #t) (else y #f)))
                                      (let ((j (s7-num e)) (n (s7-num b)) (d (s7-den b)))
                                        (cond ((>= j 0) (sum ok (s7-make-ratio (s7-expt-int n j) (s7-expt-int d j))))
                                              ((= n 0) (s7-fail "expt: division by zero" (list b e)))
                                              (else (sum ok (s7-make-ratio (s7-expt-int d (- 0 j)) (s7-expt-int n (- 0 j))))))))
                                     (else (sum ok (sum real (f64-expt (s7-real-of b) (s7-real-of e)))))))))
      (s7-prim! "exp" 1 1 (lambda ((a s7-values)) (s7-float-fn "exp" f64-exp a)))
      (s7-prim! "log" 1 2 (lambda ((a s7-values))
                            (if (null? (cdr a)) (s7-float-fn "log" f64-log a)
                                (if (and (s7-number? (car a)) (s7-number? (s7-arg2 a)))
                                    (sum ok (sum real (f64/ (f64-log (s7-real-of (car a))) (f64-log (s7-real-of (s7-arg2 a))))))
                                    (s7-wrong "log" "a number" (car a))))))
      (s7-prim! "sin" 1 1 (lambda ((a s7-values)) (s7-float-fn "sin" f64-sin a)))
      (s7-prim! "cos" 1 1 (lambda ((a s7-values)) (s7-float-fn "cos" f64-cos a)))
      (s7-prim! "tan" 1 1 (lambda ((a s7-values)) (s7-float-fn "tan" f64-tan a)))
      (s7-prim! "asin" 1 1 (lambda ((a s7-values)) (s7-float-fn "asin" f64-asin a)))
      (s7-prim! "acos" 1 1 (lambda ((a s7-values)) (s7-float-fn "acos" f64-acos a)))
      (s7-prim! "atan" 1 2 (lambda ((a s7-values))
                             (if (null? (cdr a)) (s7-float-fn "atan" f64-atan a)
                                 (if (and (s7-number? (car a)) (s7-number? (s7-arg2 a)))
                                     (sum ok (sum real (f64-atan2 (s7-real-of (car a)) (s7-real-of (s7-arg2 a)))))
                                     (s7-wrong "atan" "a number" (car a))))))
      (s7-prim! "number->string" 1 2
                (lambda ((a s7-values))
                  (let ((radix (tagcase (s7-opt a 1 (sum int 10)) (int r r) (else y 10))))
                    (cond ((not (or (= radix 2) (= radix 8) (= radix 10) (= radix 16))) (s7-wrong "number->string" "a radix" (s7-arg2 a)))
                          (else (tagcase (car a)
                                  (int i (sum ok (s7-string (s7-int->string i radix))))
                                  (ratio q (sum ok (s7-string (string-append (s7-int->string (extract q num) radix) "/" (s7-int->string (extract q den) radix)))))
                                  (real r (sum ok (s7-string (f64->string r))))
                                  (else y (s7-wrong "number->string" "a number" y))))))))
      (s7-prim! "string->number" 1 2
                (lambda ((a s7-values))
                  (let ((radix (tagcase (s7-opt a 1 (sum int 10)) (int r r) (else y 10))))
                    (tagcase (car a)
                      (str s (typecase (s7-parse-number (get s) radix)
                               (bool b (s7-bool #f))
                               (else v (sum ok v))))
                      (else y (s7-wrong "string->number" "a string" y)))))))))

;;; ------------------------------------------------------------ equivalence

(define* s7-eqv? (subr (read @sc) (s7-value s7-value) bool)
  (lambda (a b)
    (tagcase a
      (null u (tagcase b (null v #t) (else y #f)))
      (unspec u (tagcase b (unspec v #t) (else y #f)))
      (undef u (tagcase b (undef v #t) (else y #f)))
      (eof u (tagcase b (eof v #t) (else y #f)))
      (env n (tagcase b (env m (eq? (extract n buckets) (extract m buckets))) (else y #f)))
      (bool x (tagcase b (bool y (bool=? x y)) (else y #f)))
      (int i (tagcase b (int j (= i j)) (else y #f)))
      (ratio q (tagcase b (ratio p (and (= (extract q num) (extract p num)) (= (extract q den) (extract p den)))) (else y #f)))
      (real r (tagcase b (real s (u64= (f64->bits r) (f64->bits s))) (else y #f)))
      (char c (tagcase b (char d (char=? c d)) (else y #f)))
      (sym s (tagcase b (sym t (eq? s t)) (else y #f)))
      (str s (tagcase b (str t (eq? s t)) (else y #f)))
      (pair p (tagcase b (pair q (eq? (extract p car) (extract q car))) (else y #f)))
      (vec v (tagcase b (vec w (eq? v w)) (else y #f)))
      (bytes v (tagcase b (bytes w (eq? v w)) (else y #f)))
      (proc c (tagcase b (proc d (eq? (extract c name) (extract d name))) (else y #f)))
      (prim p (tagcase b (prim q (string=? (extract p name) (extract q name))) (else y #f)))
      (cont c (tagcase b (cont d (eq? (extract c id) (extract d id))) (else y #f)))
      (record r (tagcase b (record s (eq? (extract r fields) (extract s fields))) (else y #f)))
      (rtd r (tagcase b (rtd s (eq? (extract r id) (extract s id))) (else y #f)))
      (port p (tagcase b (port q (eq? (extract p id) (extract q id))) (else y #f)))
      (table t (tagcase b (table u (eq? (extract t id) (extract u id))) (else y #f)))
      (else y #f))))
"Whether `a` and `b` are alike, part by part; `left` parts more looked at
before the answer is no (a cycle)."
(define* s7-equal? (subr s7-eff (s7-value s7-value) bool)
  (lambda (a b)
    (letrec ((go (subr s7-eff (s7-value s7-value int) int)
               ;; Parts left, or -1 if unlike.
               (lambda (a b left)
                 (cond ((< left 0) -1)
                       ((s7-eqv? a b) left)
                       (else
                        (tagcase a
                          (pair p (tagcase b
                                    (pair q (let ((l (go (get (extract p car)) (get (extract q car)) (- left 1))))
                                              (if (< l 0) -1 (go (get (extract p cdr)) (get (extract q cdr)) l))))
                                    (else y -1)))
                          (str s (tagcase b (str t (if (string=? (get s) (get t)) left -1)) (else y -1)))
                          (vec v (tagcase b
                                   (vec w (if (not (= (array-length v) (array-length w))) -1
                                              (all (array->list v) (array->list w) left)))
                                   (else y -1)))
                          (bytes v (tagcase b
                                     (bytes w (if (equal-ints? (array->list v) (array->list w)) left -1))
                                     (else y -1)))
                          (else y -1))))))
             (all (subr s7-eff (s7-values s7-values int) int)
               (lambda (l m left)
                 (cond ((or (null? l) (null? m)) left)
                       (else (let ((n (go (car l) (car m) (- left 1)))) (if (< n 0) -1 (all (cdr l) (cdr m) n)))))))
             (equal-ints? (subr s7-eff ((listof int acyclic) (listof int acyclic)) bool)
               (lambda (l m) (cond ((null? l) (null? m)) ((null? m) #f) (else (and (= (car l) (car m)) (equal-ints? (cdr l) (cdr m))))))))
      (>= (go a b 10000000) 0))))

;;; ------------------------------------------------------------ strings and characters

(define* s7-string-of (subr (read @sc) (s7-value) string)
  (lambda (v) (tagcase v (str s (get s)) (else y ""))))
"Each of `l` stands in `op` to the next, all of them strings (characters,
if `chars`), case folded if `fold`."
(define* s7-chain (subr s7-eff (string bool bool (subr pure (string string) bool) s7-values) s7-out)
  (lambda (who chars fold op l)
    (letrec ((text (subr s7-eff (s7-value) (union false string))
               (lambda (v)
                 (let ((s (the (union false string)
                              (tagcase v
                                (str s (if chars (the (union false string) #f) (get s)))
                                (char c (if chars (char->string c) (the (union false string) #f)))
                                (else y #f)))))
                   (typecase s (string t (if fold (string-downcase t) t)) (else y #f)))))
             (go (subr s7-eff (s7-values) s7-out)
               (lambda (l)
                 (if (or (null? l) (null? (cdr l))) (s7-bool #t)
                     (typecase (text (car l))
                       (string a (typecase (text (car (cdr l)))
                                   (string b (if (op a b) (go (cdr l)) (s7-bool #f)))
                                   (else y (s7-wrong who (if chars "a character" "a string") (car (cdr l))))))
                       (else y (s7-wrong who (if chars "a character" "a string") (car l))))))))
      (if (and (pair? l) (null? (cdr l)))
          (typecase (text (car l)) (string a (s7-bool #t)) (else y (s7-wrong who (if chars "a character" "a string") (car l))))
          (go l)))))
(define* s7-str=? (subr pure (string string) bool) (lambda (a b) (string=? a b)))
(define* s7-str<? (subr pure (string string) bool) (lambda (a b) (string<? a b)))
(define* s7-str>? (subr pure (string string) bool) (lambda (a b) (string>? a b)))
(define* s7-str<=? (subr pure (string string) bool) (lambda (a b) (string<=? a b)))
(define* s7-str>=? (subr pure (string string) bool) (lambda (a b) (string>=? a b)))
"A string's index or range bounds, each an int in range: start and end,
or an error."
(define* s7-range (subr s7-eff (string s7-value s7-value int) (sumof (ok (productof (start int) (end int))) (bad s7-out)))
  (lambda (who start end n)
    (let ((s (tagcase start (int i i) (undef u 0) (else y -1)))
          (e (tagcase end (int i i) (undef u n) (else y -1))))
      (if (and (<= 0 s) (<= s e) (<= e n))
          (sum ok (product (start s) (end e)))
          (sum bad (s7-fail (string-append who ": a range out of bounds") (list start end)))))))
(define* s7-map-chars (subr spin ((listof char acyclic) (subr pure (char) char)) (listof char acyclic))
  (lambda (l f) (if (null? l) nil (cons (f (car l)) (s7-map-chars (cdr l) f)))))
(define* s7-string-map-chars (subr spin (string (subr pure (char) char)) string)
  (lambda (s f) (list->string (s7-map-chars (the (listof char acyclic) (string->list s)) f))))
(define* s7-chars->values (subr spin ((listof char acyclic)) s7-values)
  (lambda (l) (if (null? l) nil (cons (sum char (car l)) (s7-chars->values (cdr l))))))
"The characters of `l`, or #f if one is not."
(define* s7-values->chars (subr spin (s7-values) (union false (listof char acyclic)))
  (lambda (l)
    (if (null? l) (the (listof char acyclic) nil)
        (tagcase (car l)
          (char c (typecase (s7-values->chars (cdr l))
                    (bool b #f)
                    (else rest (the (listof char acyclic) (cons c rest)))))
          (else y #f)))))
(define* s7-char-upper? (subr pure (char) bool)
  (lambda (c) (and (char-alphabetic? c) (not (char=? c (char-downcase c))))))
(define* s7-char-lower? (subr pure (char) bool)
  (lambda (c) (and (char-alphabetic? c) (not (char=? c (char-upcase c))))))
"`n` copies of `s`, joined."
(define* s7-repeat (subr spin (int string) string)
  (lambda (n s) (if (<= n 0) "" (string-append s (s7-repeat (- n 1) s)))))

;;; ------------------------------------------------------------ records

"A procedure written in FX-26, made at run time (a record's constructor,
predicate, accessor or modifier)."
(define* s7-made-prim (subr pure (string int int s7-fn) s7-value)
  (lambda (name min max f) (sum prim (product (name name) (min min) (max max) (op (sum fn f))))))
(define* s7-index-of (subr spin (symbol s7-symbols int) int)
  (lambda (s l i) (cond ((null? l) -1) ((string=? (s7-symbol-name (car l)) (s7-symbol-name s)) i) (else (s7-index-of s (cdr l) (+ i 1))))))
"Whether `v` is a record of type `t`."
(define* s7-record-of? (subr pure (s7-value s7-rtd) bool)
  (lambda (v t) (tagcase v (record r (eq? (extract (extract r rtd) id) (extract t id))) (else y #f))))

;;; ------------------------------------------------------------ ports

(define* s7-file-port (subr (alloc @sc) (bool string string) s7-value)
  (lambda (input text file)
    (sum port (product (id (the (ref unit @sc) (new #u))) (input input) (text text)
                       (pos (the (ref int @sc) (new 0)))
                       (out (the (ref (listof string acyclic) @sc) (new nil)))
                       (open (the (ref bool @sc) (new #t)))
                       (file file)))))
(define* s7-make-port (subr (alloc @sc) (bool string) s7-value)
  (lambda (input text) (s7-file-port input text "")))
"Where `display` and its kin write by default: what a client takes
(`s7-take-output!`)."
(define s7-console s7-value (s7-make-port #f ""))
"What `read-char` and its kin read by default: nothing."
(define s7-console-input s7-value (s7-make-port #t ""))
"What output port `p` has had written, all of it."
(define* s7-port-text (subr (maxeff spin (read @sc) (write @sc)) (s7-port) string)
  (lambda (p)
    (let ((s (s7-concat (reverse (get (extract p out))))))
      (begin (set (extract p out) (if (string=? s "") nil (list s))) s))))
"Whether what was last written to the console ended its line (or nothing
has been written since what runs began)."
(define s7-console-fresh (ref bool @sc) (new #t))
"\"\" if the console is at a line's start, else a newline: what a REPL
writes before a value, an error or a prompt."
(define* s7-fresh-line (subr (read @sc) () string)
  (lambda () (if (get s7-console-fresh) "" "\n")))
"The output ports to files opened: each written when flushed or closed,
and when what runs ends."
(define s7-file-ports (ref s7-values @sc) (new nil))
"Port `p`'s file written with all it has had written. \"\", or why not."
(define* s7-flush-port! (subr s7-eff (s7-port) string)
  (lambda (p)
    (if (or (extract p input) (string=? (extract p file) "")) ""
        (tagcase (write-file (extract p file) (the (bytevectorof @sc) (string->utf8 (s7-port-text p))))
          (done u "")
          (else y (string-append "cannot write " (extract p file)))))))
"Every file port still open, written: what runs has ended."
(define* s7-flush-files! (subr s7-eff () unit)
  (lambda ()
    (letrec ((go (subr s7-eff (s7-values) unit)
               (lambda (l)
                 (if (null? l) #u
                     (begin (tagcase (car l) (port p (if (get (extract p open)) (begin (s7-flush-port! p) #u) #u)) (else y #u))
                       (go (cdr l)))))))
      (go (get s7-file-ports)))))
"Text `s` written to port `v`, or an error."
(define* s7-port-write (subr s7-eff (string s7-value s7-value) s7-out)
  (lambda (who v s)
    (tagcase v
      (port p (cond ((extract p input) (s7-wrong who "an output port" v))
                    ((not (get (extract p open))) (s7-fail (string-append who ": the port is closed") (list v)))
                    (else (let ((text (s7-string-of s)))
                            (begin (set (extract p out) (cons text (get (extract p out))))
                              (if (and (> (string-length text) 0) (s7-eqv? v s7-console))
                                  (set s7-console-fresh (char=? (string-ref text (- (string-length text) 1)) #\newline))
                                  #u)
                              (sum ok s7-unspecified))))))
      (else y (s7-wrong who "a port" v)))))
"Input port `v`, open; or an error."
(define* s7-input-port (subr s7-eff (string s7-value) (sumof (ok s7-port) (bad s7-out)))
  (lambda (who v)
    (tagcase v
      (port p (cond ((not (extract p input)) (sum bad (s7-wrong who "an input port" v)))
                    ((not (get (extract p open))) (sum bad (s7-fail (string-append who ": the port is closed") (list v))))
                    (else (sum ok p))))
      (else y (sum bad (s7-wrong who "a port" v))))))
(define s7-eof s7-value (sum eof #u))

;;; ------------------------------------------------------------ the procedures, defined

(define* s7-init-lists! (subr s7-eff () unit)
  (lambda ()
    (begin
      (s7-prim! "eq?" 2 2 (lambda ((a s7-values)) (s7-bool (s7-eqv? (car a) (s7-arg2 a)))))
      (s7-prim! "eqv?" 2 2 (lambda ((a s7-values)) (s7-bool (s7-eqv? (car a) (s7-arg2 a)))))
      (s7-prim! "equal?" 2 2 (lambda ((a s7-values)) (s7-bool (s7-equal? (car a) (s7-arg2 a)))))
      (s7-prim! "not" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (bool b (not b)) (else y #f)))))
      (s7-prim! "boolean?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (bool b #t) (else y #f)))))
      (s7-prim! "boolean=?" 2 -1 (lambda ((a s7-values))
                                   (letrec ((go (subr s7-eff (s7-values) bool)
                                              (lambda (l) (or (null? (cdr l))
                                                              (and (tagcase (car l) (bool x (tagcase (car (cdr l)) (bool y (bool=? x y)) (else z #f))) (else z #f))
                                                                   (go (cdr l)))))))
                                     (s7-bool (go a)))))
      (s7-prim! "cons" 2 2 (lambda ((a s7-values)) (sum ok (s7-cons (car a) (s7-arg2 a)))))
      (s7-prim! "car" 1 1 (lambda ((a s7-values)) (tagcase (car a) (pair p (sum ok (get (extract p car)))) (else y (s7-wrong "car" "a pair" y)))))
      (s7-prim! "cdr" 1 1 (lambda ((a s7-values)) (tagcase (car a) (pair p (sum ok (get (extract p cdr)))) (else y (s7-wrong "cdr" "a pair" y)))))
      (s7-prim! "set-car!" 2 2 (lambda ((a s7-values)) (tagcase (car a) (pair p (begin (set (extract p car) (s7-arg2 a)) (sum ok s7-unspecified))) (else y (s7-wrong "set-car!" "a pair" y)))))
      (s7-prim! "set-cdr!" 2 2 (lambda ((a s7-values)) (tagcase (car a) (pair p (begin (set (extract p cdr) (s7-arg2 a)) (sum ok s7-unspecified))) (else y (s7-wrong "set-cdr!" "a pair" y)))))
      (s7-prim! "caar" 1 1 (lambda ((a s7-values)) (tagcase (car a) (pair p (tagcase (get (extract p car)) (pair q (sum ok (get (extract q car)))) (else y (s7-wrong "caar" "a list of lists" (car a))))) (else y (s7-wrong "caar" "a pair" y)))))
      (s7-prim! "cadr" 1 1 (lambda ((a s7-values)) (tagcase (car a) (pair p (tagcase (get (extract p cdr)) (pair q (sum ok (get (extract q car)))) (else y (s7-wrong "cadr" "a list of two" (car a))))) (else y (s7-wrong "cadr" "a pair" y)))))
      (s7-prim! "cdar" 1 1 (lambda ((a s7-values)) (tagcase (car a) (pair p (tagcase (get (extract p car)) (pair q (sum ok (get (extract q cdr)))) (else y (s7-wrong "cdar" "a list of lists" (car a))))) (else y (s7-wrong "cdar" "a pair" y)))))
      (s7-prim! "cddr" 1 1 (lambda ((a s7-values)) (tagcase (car a) (pair p (tagcase (get (extract p cdr)) (pair q (sum ok (get (extract q cdr)))) (else y (s7-wrong "cddr" "a list of two" (car a))))) (else y (s7-wrong "cddr" "a pair" y)))))
      (s7-prim! "pair?" 1 1 (lambda ((a s7-values)) (s7-bool (s7-pair? (car a)))))
      (s7-prim! "null?" 1 1 (lambda ((a s7-values)) (s7-bool (s7-null? (car a)))))
      (s7-prim! "list?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (s7-list-items (car a)) (some l #t) (none u #f)))))
      (s7-prim! "list" 0 -1 (lambda ((a s7-values)) (sum ok (s7-list a))))
      (s7-prim! "make-list" 1 2 (lambda ((a s7-values))
                                  (tagcase (car a)
                                    (int n (letrec ((go (subr s7-eff (int s7-value) s7-value)
                                                          (lambda (n acc) (if (<= n 0) acc (go (- n 1) (s7-cons (s7-opt a 1 s7-unspecified) acc))))))
                                             (sum ok (go n s7-nil))))
                                    (else y (s7-wrong "make-list" "an integer" y)))))
      (s7-prim! "length" 1 1 (lambda ((a s7-values)) (tagcase (s7-list-items (car a)) (some l (s7-ok-int (list-length l))) (none u (s7-wrong "length" "a proper list" (car a))))))
      (s7-prim! "append" 0 -1
                (lambda ((a s7-values))
                  (letrec ((go (subr s7-eff (s7-values) s7-out)
                             (lambda (l)
                               (cond ((null? l) (sum ok s7-nil))
                                     ((null? (cdr l)) (sum ok (car l)))
                                     (else (tagcase (s7-list-items (car l))
                                             (some items (tagcase (go (cdr l)) (ok rest (sum ok (s7-list* items rest))) (raise e (sum raise e))))
                                             (none u (s7-wrong "append" "a proper list" (car l)))))))))
                    (go a))))
      (s7-prim! "reverse" 1 1 (lambda ((a s7-values)) (tagcase (s7-list-items (car a)) (some l (sum ok (s7-list (reverse l)))) (none u (s7-wrong "reverse" "a proper list" (car a))))))
      (s7-prim! "list-tail" 2 2 (lambda ((a s7-values))
                                  (letrec ((go (subr s7-eff (s7-value int) s7-out)
                                             (lambda (l k) (cond ((<= k 0) (sum ok l))
                                                                 (else (tagcase l (pair p (go (get (extract p cdr)) (- k 1)))
                                                                         (else y (s7-fail "list-tail: the list is too short" (list (car a))))))))))
                                    (tagcase (s7-arg2 a) (int k (go (car a) k)) (else y (s7-wrong "list-tail" "an index" y))))))
      (s7-prim! "list-ref" 2 2 (lambda ((a s7-values))
                                 (letrec ((go (subr s7-eff (s7-value int) s7-out)
                                            (lambda (l k) (tagcase l
                                                            (pair p (if (<= k 0) (sum ok (get (extract p car))) (go (get (extract p cdr)) (- k 1))))
                                                            (else y (s7-fail "list-ref: the index is out of range" (list (s7-arg2 a))))))))
                                   (tagcase (s7-arg2 a) (int k (if (< k 0) (s7-wrong "list-ref" "an index" (s7-arg2 a)) (go (car a) k))) (else y (s7-wrong "list-ref" "an index" y))))))
      (s7-prim! "list-copy" 1 1 (lambda ((a s7-values))
                                  (let ((tt (s7-items-and-tail (car a)))) (sum ok (s7-list* (extract tt items) (extract tt tail))))))
      (s7-prim! "memq" 2 2 (lambda ((a s7-values))
                             (letrec ((go (subr s7-eff (s7-value) s7-value)
                                        (lambda (l) (tagcase l (pair p (if (s7-eqv? (car a) (get (extract p car))) l (go (get (extract p cdr))))) (else y s7-false)))))
                               (sum ok (go (s7-arg2 a))))))
      (s7-alias! "memv" "memq")
      (s7-prim! "assq" 2 2 (lambda ((a s7-values))
                             (letrec ((go (subr s7-eff (s7-value) s7-value)
                                        (lambda (l) (tagcase l

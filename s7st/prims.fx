      (s7-prim! "char>=?" 1 -1 (lambda ((a s7-values)) (s7-chain "char>=?" #t #f s7-str>=? a)))
      (s7-prim! "char-ci=?" 1 -1 (lambda ((a s7-values)) (s7-chain "char-ci=?" #t #t s7-str=? a)))
      (s7-prim! "char-ci<?" 1 -1 (lambda ((a s7-values)) (s7-chain "char-ci<?" #t #t s7-str<? a)))

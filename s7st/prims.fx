                                              (else y (s7-wrong "string-ref" "an index" y))))
                                     (else y (s7-wrong "string-ref" "a string" y)))))
      (s7-prim! "string-set!" 3 3 (lambda ((a s7-values))
                                    (tagcase (car a)
                                      (str s (tagcase (s7-arg2 a)
                                               (int k (tagcase (s7-arg3 a)
                                                        (char c (let ((t (get s)))
                                                                  (if (and (>= k 0) (< k (string-length t)))
                                                                      (begin (set s (string-append (substring t 0 k) (char->string c) (substring t (+ k 1) (string-length t))))
                                                                        (sum ok s7-unspecified))
                                                                      (s7-fail "string-set!: the index is out of range" (list (s7-arg2 a))))))
                                                        (else y (s7-wrong "string-set!" "a character" y))))
                                               (else y (s7-wrong "string-set!" "an index" y))))
                                      (else y (s7-wrong "string-set!" "a string" y)))))
      (s7-prim! "substring" 2 3 (lambda ((a s7-values))
                                  (tagcase (car a)
                                    (str s (tagcase (s7-range "substring" (s7-arg2 a) (s7-opt a 2 s7-undefined) (string-length (get s)))
                                             (ok r (sum ok (s7-string (substring (get s) (extract r start) (extract r end)))))
                                             (bad e e)))
                                    (else y (s7-wrong "substring" "a string" y)))))
      (s7-prim! "string-copy" 1 3 (lambda ((a s7-values))
                                    (tagcase (car a)
                                      (str s (tagcase (s7-range "string-copy" (s7-opt a 1 s7-undefined) (s7-opt a 2 s7-undefined) (string-length (get s)))
                                               (ok r (sum ok (s7-string (substring (get s) (extract r start) (extract r end)))))
                                               (bad e e)))
                                      (else y (s7-wrong "string-copy" "a string" y)))))
      (s7-prim! "string-append" 0 -1 (lambda ((a s7-values))
                                       (letrec ((go (subr s7-eff (s7-values (listof string acyclic)) s7-out)
                                                  (lambda (l acc)
                                                    (if (null? l) (sum ok (s7-string (string-concatenate (reverse acc))))
                                                        (tagcase (car l) (str s (go (cdr l) (cons (get s) acc))) (else y (s7-wrong "string-append" "a string" y)))))))
                                         (go a nil))))
      (s7-prim! "string->list" 1 3 (lambda ((a s7-values))
                                     (tagcase (car a)
                                       (str s (tagcase (s7-range "string->list" (s7-opt a 1 s7-undefined) (s7-opt a 2 s7-undefined) (string-length (get s)))
                                                (ok r (sum ok (s7-list (map (lambda ((c char)) (the s7-value (sum char c))) (the (listof char acyclic) (string->list (substring (get s) (extract r start) (extract r end))))))))
                                                (bad e e)))
                                       (else y (s7-wrong "string->list" "a string" y)))))
      (s7-prim! "list->string" 1 1 (lambda ((a s7-values))
                                     (tagcase (s7-list-items (car a))
                                       (some l (typecase (s7-values->chars l)
                                                 (bool b (s7-wrong "list->string" "a list of characters" (car a)))
                                                 (else cs (sum ok (s7-string (list->string cs))))))
                                       (none u (s7-wrong "list->string" "a proper list" (car a))))))
      (s7-prim! "string-fill!" 2 4 (lambda ((a s7-values))
                                     (tagcase (car a)
                                       (str s (tagcase (s7-arg2 a)
                                                (char c (tagcase (s7-range "string-fill!" (s7-opt a 2 s7-undefined) (s7-opt a 3 s7-undefined) (string-length (get s)))
                                                          (ok r (let ((t (get s)))
                                                                  (begin (set s (string-append (substring t 0 (extract r start))
                                                                                               (s7-repeat (- (extract r end) (extract r start)) (char->string c))
                                                                                               (substring t (extract r end) (string-length t))))
                                                                    (sum ok s7-unspecified))))
                                                          (bad e e)))
                                                (else y (s7-wrong "string-fill!" "a character" y))))
                                       (else y (s7-wrong "string-fill!" "a string" y)))))
      (s7-prim! "string-copy!" 3 5 (lambda ((a s7-values))
                                     (tagcase (car a)
                                       (str to (tagcase (s7-arg2 a)
                                                 (int at (tagcase (s7-arg3 a)
                                                           (str from (tagcase (s7-range "string-copy!" (s7-opt a 3 s7-undefined) (s7-opt a 4 s7-undefined) (string-length (get from)))
                                                                       (ok r (let* ((piece (substring (get from) (extract r start) (extract r end)))
                                                                                    (t (get to))
                                                                                    (n (string-length piece)))
                                                                               (if (and (>= at 0) (<= (+ at n) (string-length t)))
                                                                                   (begin (set to (string-append (substring t 0 at) piece (substring t (+ at n) (string-length t))))
                                                                                     (sum ok s7-unspecified))
                                                                                   (s7-fail "string-copy!: out of range" (list (s7-arg2 a))))))
                                                                       (bad e e)))
                                                           (else y (s7-wrong "string-copy!" "a string" y))))
                                                 (else y (s7-wrong "string-copy!" "an index" y))))
                                       (else y (s7-wrong "string-copy!" "a string" y)))))
      (s7-prim! "string=?" 1 -1 (lambda ((a s7-values)) (s7-chain "string=?" #f #f s7-str=? a)))
      (s7-prim! "string<?" 1 -1 (lambda ((a s7-values)) (s7-chain "string<?" #f #f s7-str<? a)))
      (s7-prim! "string>?" 1 -1 (lambda ((a s7-values)) (s7-chain "string>?" #f #f s7-str>? a)))
      (s7-prim! "string<=?" 1 -1 (lambda ((a s7-values)) (s7-chain "string<=?" #f #f s7-str<=? a)))
      (s7-prim! "string>=?" 1 -1 (lambda ((a s7-values)) (s7-chain "string>=?" #f #f s7-str>=? a)))
      (s7-prim! "string-ci=?" 1 -1 (lambda ((a s7-values)) (s7-chain "string-ci=?" #f #t s7-str=? a)))
      (s7-prim! "string-ci<?" 1 -1 (lambda ((a s7-values)) (s7-chain "string-ci<?" #f #t s7-str<? a)))
      (s7-prim! "string-ci>?" 1 -1 (lambda ((a s7-values)) (s7-chain "string-ci>?" #f #t s7-str>? a)))
      (s7-prim! "string-ci<=?" 1 -1 (lambda ((a s7-values)) (s7-chain "string-ci<=?" #f #t s7-str<=? a)))
      (s7-prim! "string-ci>=?" 1 -1 (lambda ((a s7-values)) (s7-chain "string-ci>=?" #f #t s7-str>=? a)))
      (s7-prim! "string-upcase" 1 1 (lambda ((a s7-values)) (tagcase (car a) (str s (sum ok (s7-string (s7-string-upcase (get s))))) (else y (s7-wrong "string-upcase" "a string" y)))))
      (s7-prim! "string-downcase" 1 1 (lambda ((a s7-values)) (tagcase (car a) (str s (sum ok (s7-string (string-downcase (get s))))) (else y (s7-wrong "string-downcase" "a string" y)))))
      (s7-prim! "string-foldcase" 1 1 (lambda ((a s7-values)) (tagcase (car a) (str s (sum ok (s7-string (s7-string-foldcase (get s))))) (else y (s7-wrong "string-foldcase" "a string" y)))))
      (s7-prim! "string-search-forward" 3 3 (lambda ((a s7-values))
                                              (tagcase (car a)
                                                (str pat (tagcase (s7-arg2 a)
                                                           (str s (tagcase (s7-arg3 a)
                                                                    (int k (if (and (>= k 0) (<= k (string-length (get s))))
                                                                               (let ((i (string-search (get s) (get pat) k))) (if (< i 0) (s7-bool #f) (s7-ok-int i)))
                                                                               (s7-wrong "string-search-forward" "an index" (s7-arg3 a))))
                                                                    (else y (s7-wrong "string-search-forward" "an index" y))))
                                                           (else y (s7-wrong "string-search-forward" "a string" y))))
                                                (else y (s7-wrong "string-search-forward" "a string" y))))))))

(define* s7-init-vectors! (subr s7-eff () unit)
  (lambda ()
    (begin
      (s7-prim! "vector?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (vec v #t) (else y #f)))))
      (s7-prim! "make-vector" 1 2 (lambda ((a s7-values))
                                    (tagcase (car a)
                                      (int n (if (< n 0) (s7-wrong "make-vector" "a length" (car a))
                                                 (sum ok (sum vec (the (arrayof s7-value @sc) (make-array n (s7-opt a 1 s7-unspecified)))))))
                                      (else y (s7-wrong "make-vector" "a length" y)))))
      (s7-prim! "vector" 0 -1 (lambda ((a s7-values)) (sum ok (sum vec (list->array a)))))
      (s7-prim! "vector-length" 1 1 (lambda ((a s7-values)) (tagcase (car a) (vec v (s7-ok-int (array-length v))) (else y (s7-wrong "vector-length" "a vector" y)))))
      (s7-prim! "vector-ref" 2 2 (lambda ((a s7-values))
                                   (tagcase (car a)
                                     (vec v (tagcase (s7-arg2 a)
                                              (int k (if (and (>= k 0) (< k (array-length v))) (sum ok (array-ref v k))
                                                         (s7-fail "vector-ref: the index is out of range" (list (s7-arg2 a)))))
                                              (else y (s7-wrong "vector-ref" "an index" y))))
                                     (else y (s7-wrong "vector-ref" "a vector" y)))))
      (s7-prim! "vector-set!" 3 3 (lambda ((a s7-values))
                                    (tagcase (car a)
                                      (vec v (tagcase (s7-arg2 a)
                                               (int k (if (and (>= k 0) (< k (array-length v))) (begin (array-set! v k (s7-arg3 a)) (sum ok s7-unspecified))
                                                          (s7-fail "vector-set!: the index is out of range" (list (s7-arg2 a)))))
                                               (else y (s7-wrong "vector-set!" "an index" y))))
                                      (else y (s7-wrong "vector-set!" "a vector" y)))))
      (s7-prim! "vector->list" 1 3 (lambda ((a s7-values))
                                     (tagcase (car a)
                                       (vec v (tagcase (s7-range "vector->list" (s7-opt a 1 s7-undefined) (s7-opt a 2 s7-undefined) (array-length v))
                                                (ok r (sum ok (s7-list (vector->list v (extract r start) (extract r end)))))
                                                (bad e e)))
                                       (else y (s7-wrong "vector->list" "a vector" y)))))
      (s7-prim! "list->vector" 1 1 (lambda ((a s7-values)) (tagcase (s7-list-items (car a)) (some l (sum ok (sum vec (list->array l)))) (none u (s7-wrong "list->vector" "a proper list" (car a))))))
      (s7-prim! "vector-copy" 1 3 (lambda ((a s7-values))
                                    (tagcase (car a)
                                      (vec v (tagcase (s7-range "vector-copy" (s7-opt a 1 s7-undefined) (s7-opt a 2 s7-undefined) (array-length v))
                                               (ok r (sum ok (sum vec (list->array (vector->list v (extract r start) (extract r end))))))
                                               (bad e e)))
                                      (else y (s7-wrong "vector-copy" "a vector" y)))))
      (s7-prim! "vector-copy!" 3 5 (lambda ((a s7-values))
                                     (tagcase (car a)
                                       (vec to (tagcase (s7-arg2 a)
                                                 (int at (tagcase (s7-arg3 a)
                                                           (vec from (tagcase (s7-range "vector-copy!" (s7-opt a 3 s7-undefined) (s7-opt a 4 s7-undefined) (array-length from))
                                                                       (ok r (let ((n (min (- (extract r end) (extract r start)) (- (array-length to) at))))
                                                                               ;; As much as fits (Larceny's tests copy a vector onto itself so).
                                                                               (if (and (>= at 0) (<= at (array-length to)))
                                                                                   (let ((items (vector->list from (extract r start) (+ (extract r start) n))))
                                                                                     (letrec ((go (subr s7-eff (s7-values int) unit)
                                                                                                (lambda (l i) (if (null? l) #u (begin (array-set! to i (car l)) (go (cdr l) (+ i 1)))))))
                                                                                       (begin (go items at) (sum ok s7-unspecified))))
                                                                                   (s7-fail "vector-copy!: out of range" (list (s7-arg2 a))))))
                                                                       (bad e e)))
                                                           (else y (s7-wrong "vector-copy!" "a vector" y))))
                                                 (else y (s7-wrong "vector-copy!" "an index" y))))
                                       (else y (s7-wrong "vector-copy!" "a vector" y)))))
      (s7-prim! "vector-fill!" 2 4 (lambda ((a s7-values))
                                     (tagcase (car a)
                                       (vec v (tagcase (s7-range "vector-fill!" (s7-opt a 2 s7-undefined) (s7-opt a 3 s7-undefined) (array-length v))
                                                (ok r (letrec ((go (subr s7-eff (int) unit)
                                                                 (lambda (i) (if (>= i (extract r end)) #u (begin (array-set! v i (s7-arg2 a)) (go (+ i 1)))))))
                                                        (begin (go (extract r start)) (sum ok s7-unspecified))))
                                                (bad e e)))
                                       (else y (s7-wrong "vector-fill!" "a vector" y)))))
      (s7-prim! "vector-append" 0 -1 (lambda ((a s7-values))
                                       (letrec ((go (subr s7-eff (s7-values s7-values) s7-out)
                                                  (lambda (l acc)
                                                    (if (null? l) (sum ok (sum vec (list->array (reverse acc))))
                                                        (tagcase (car l)
                                                          (vec v (go (cdr l) (append (reverse (array->list v)) acc)))
                                                          (else y (s7-wrong "vector-append" "a vector" y)))))))
                                         (go a nil))))
      (s7-prim! "vector->string" 1 3 (lambda ((a s7-values))
                                       (tagcase (car a)
                                         (vec v (tagcase (s7-range "vector->string" (s7-opt a 1 s7-undefined) (s7-opt a 2 s7-undefined) (array-length v))
                                                  (ok r (typecase (s7-values->chars (vector->list v (extract r start) (extract r end)))
                                                          (bool b (s7-wrong "vector->string" "a vector of characters" (car a)))
                                                          (else cs (sum ok (s7-string (list->string cs))))))
                                                  (bad e e)))
                                         (else y (s7-wrong "vector->string" "a vector" y)))))
      (s7-prim! "string->vector" 1 3 (lambda ((a s7-values))
                                       (tagcase (car a)
                                         (str s (tagcase (s7-range "string->vector" (s7-opt a 1 s7-undefined) (s7-opt a 2 s7-undefined) (string-length (get s)))
                                                  (ok r (sum ok (sum vec (list->array (map (lambda ((c char)) (the s7-value (sum char c))) (the (listof char acyclic) (string->list (substring (get s) (extract r start) (extract r end)))))))))
                                                  (bad e e)))
                                         (else y (s7-wrong "string->vector" "a string" y)))))
      (s7-prim! "bytevector?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (bytes v #t) (else y #f)))))
      (s7-prim! "make-bytevector" 1 2 (lambda ((a s7-values))
                                        (tagcase (car a)
                                          (int n (let ((fill (tagcase (s7-opt a 1 (sum int 0)) (int b (if (and (>= b -128) (< b 256)) (modulo b 256) -1)) (else y -1))))
                                                   (if (or (< n 0) (< fill 0)) (s7-wrong "make-bytevector" "a length and a byte" (s7-list a))
                                                       (sum ok (sum bytes (the (arrayof int @sc) (make-array n fill)))))))
                                          (else y (s7-wrong "make-bytevector" "a length" y)))))
      (s7-prim! "bytevector" 0 -1 (lambda ((a s7-values)) (if (every (lambda ((v s7-value)) (tagcase v (int i (and (>= i 0) (< i 256))) (else y #f))) a) (sum ok (sum bytes (list->array (map (lambda ((v s7-value)) (tagcase v (int i i) (else y 0))) a)))) (s7-wrong "bytevector" "a list of bytes" (s7-list a)))))
      (s7-prim! "bytevector-length" 1 1 (lambda ((a s7-values)) (tagcase (car a) (bytes v (s7-ok-int (array-length v))) (else y (s7-wrong "bytevector-length" "a bytevector" y)))))
      (s7-prim! "bytevector-u8-ref" 2 2 (lambda ((a s7-values))
                                          (tagcase (car a)
                                            (bytes v (tagcase (s7-arg2 a)
                                                       (int k (if (and (>= k 0) (< k (array-length v))) (s7-ok-int (array-ref v k))
                                                                  (s7-fail "bytevector-u8-ref: the index is out of range" (list (s7-arg2 a)))))
                                                       (else y (s7-wrong "bytevector-u8-ref" "an index" y))))
                                            (else y (s7-wrong "bytevector-u8-ref" "a bytevector" y)))))
      (s7-prim! "bytevector-u8-set!" 3 3 (lambda ((a s7-values))
                                           (tagcase (car a)
                                             (bytes v (tagcase (s7-arg2 a)
                                                        (int k (tagcase (s7-arg3 a)
                                                                 (int b (if (and (>= k 0) (< k (array-length v)) (>= b 0) (< b 256))
                                                                            (begin (array-set! v k b) (sum ok s7-unspecified))
                                                                            (s7-fail "bytevector-u8-set!: out of range" (list (s7-arg2 a) (s7-arg3 a)))))
                                                                 (else y (s7-wrong "bytevector-u8-set!" "a byte" y))))
                                                        (else y (s7-wrong "bytevector-u8-set!" "an index" y))))
                                             (else y (s7-wrong "bytevector-u8-set!" "a bytevector" y)))))
      (s7-prim! "bytevector-copy" 1 3 (lambda ((a s7-values))
                                        (tagcase (car a)
                                          (bytes v (tagcase (s7-range "bytevector-copy" (s7-opt a 1 s7-undefined) (s7-opt a 2 s7-undefined) (array-length v))
                                                     (ok r (letrec ((take (subr s7-eff ((listof int acyclic) int int) (listof int acyclic))
                                                                      (lambda (l s n) (cond ((or (null? l) (<= n 0)) nil)
                                                                                            ((> s 0) (take (cdr l) (- s 1) n))
                                                                                            (else (cons (car l) (take (cdr l) 0 (- n 1))))))))
                                                             (sum ok (sum bytes (list->array (take (array->list v) (extract r start) (- (extract r end) (extract r start))))))))
                                                     (bad e e)))
                                          (else y (s7-wrong "bytevector-copy" "a bytevector" y)))))
      (s7-prim! "bytevector-append" 0 -1 (lambda ((a s7-values))
                                           (letrec ((go (subr s7-eff (s7-values (listof int acyclic)) s7-out)
                                                      (lambda (l acc)
                                                        (if (null? l) (sum ok (sum bytes (list->array (reverse acc))))
                                                            (tagcase (car l)
                                                              (bytes v (go (cdr l) (append (reverse (array->list v)) acc)))
                                                              (else y (s7-wrong "bytevector-append" "a bytevector" y)))))))
                                             (go a nil))))
      (s7-prim! "utf8->string" 1 3 (lambda ((a s7-values))
                                     (tagcase (car a)
                                       (bytes v (tagcase (s7-range "utf8->string" (s7-opt a 1 s7-undefined) (s7-opt a 2 s7-undefined) (array-length v))
                                                (bad e e)
                                                (ok r
                                                  (let ((bv (the (bytevectorof @sc) (make-bytevector (- (extract r end) (extract r start)) (int->u8 0)))))
                                                    (letrec ((fill (subr s7-eff (int) unit)
                                                                   (lambda (i) (if (>= i (extract r end)) #u
                                                                                   (begin (bytevector-u8-set! bv (- i (extract r start)) (int->u8 (array-ref v i))) (fill (+ i 1)))))))
                                                      (begin (fill (extract r start))
                                                        (tagcase (utf8->string bv)
                                                          (text s (sum ok (s7-string s)))
                                                          (else y (s7-fail "utf8->string: not UTF-8" (list (car a)))))))))))
                                       (else y (s7-wrong "utf8->string" "a bytevector" y)))))
      (s7-prim! "string->utf8" 1 3 (lambda ((a s7-values))
                                     (tagcase (car a)
                                       (str s0 (tagcase (s7-range "string->utf8" (s7-opt a 1 s7-undefined) (s7-opt a 2 s7-undefined) (string-length (get s0)))
                                                (bad e e)
                                                (ok r
                                              (let ((bv (the (bytevectorof @sc) (string->utf8 (substring (get s0) (extract r start) (extract r end))))))
                                                (letrec ((go (subr s7-eff (int (listof int acyclic)) (listof int acyclic))
                                                           (lambda (i acc) (if (< i 0) acc (go (- i 1) (cons (u8->int (bytevector-u8-ref bv i)) acc))))))
                                                  (sum ok (sum bytes (list->array (go (- (bytevector-length bv) 1) nil)))))))))
                                       (else y (s7-wrong "string->utf8" "a string" y))))))))

(define* s7-init-records! (subr s7-eff () unit)
  (lambda ()
    (begin
      (s7-prim! " make-record-type" 2 2
                (lambda ((a s7-values))
                  (sum ok (sum rtd (product (name (s7-symbol-name (s7-sym (car a))))
                                            (fields (s7-symbols-of (s7-value->values (s7-arg2 a))))
                                            (id (the (ref unit @sc) (new #u))))))))
      (s7-prim! " record-constructor" 2 2
                (lambda ((a s7-values))
                  (tagcase (car a)
                    (rtd t (let* ((names (s7-symbols-of (s7-value->values (s7-arg2 a))))
                                  (n (list-length (extract t fields)))
                                  (k (list-length names)))
                             (sum ok (s7-made-prim (string-append "make-" (extract t name)) k k
                                                   (lambda ((args s7-values))
                                                     (let ((fields (the (arrayof s7-value @sc) (make-array n s7-unspecified))))
                                                       (letrec ((go (subr s7-eff (s7-symbols s7-values) unit)
                                                                  (lambda (ns vs)
                                                                    (if (or (null? ns) (null? vs)) #u
                                                                        (let ((i (let ((j (list-index (lambda ((x symbol)) (string=? (s7-symbol-name x) (s7-symbol-name (car ns)))) (extract t fields)))) (if (bool? j) -1 j))))
                                                                          (begin (if (>= i 0) (array-set! fields i (car vs)) #u)
                                                                            (go (cdr ns) (cdr vs))))))))
                                                         (begin (go names args)
                                                           (sum ok (sum record (product (rtd t) (fields fields))))))))))))
                    (else y (s7-wrong "define-record-type" "a record type" y)))))
      (s7-prim! " record-predicate" 1 1
                (lambda ((a s7-values))
                  (tagcase (car a)
                    (rtd t (sum ok (s7-made-prim (string-append (extract t name) "?") 1 1
                                                 (lambda ((args s7-values)) (s7-bool (s7-record-of? (car args) t))))))
                    (else y (s7-wrong "define-record-type" "a record type" y)))))
      (s7-prim! " record-accessor" 2 2
                (lambda ((a s7-values))
                  (tagcase (car a)
                    (rtd t (let* ((f (s7-sym (s7-arg2 a)))
                                  (i (let ((j (list-index (lambda ((x symbol)) (string=? (s7-symbol-name x) (s7-symbol-name f))) (extract t fields)))) (if (bool? j) -1 j)))
                                  (who (string-append (extract t name) "-" (s7-symbol-name f))))
                             (sum ok (s7-made-prim who 1 1
                                                   (lambda ((args s7-values))
                                                     (tagcase (car args)
                                                       (record r (if (and (s7-record-of? (car args) t) (>= i 0)) (sum ok (array-ref (extract r fields) i))
                                                                     (s7-wrong who (string-append "a " (extract t name)) (car args))))
                                                       (else y (s7-wrong who (string-append "a " (extract t name)) y))))))))
                    (else y (s7-wrong "define-record-type" "a record type" y)))))
      (s7-prim! " record-modifier" 2 2
                (lambda ((a s7-values))
                  (tagcase (car a)
                    (rtd t (let* ((f (s7-sym (s7-arg2 a)))
                                  (i (let ((j (list-index (lambda ((x symbol)) (string=? (s7-symbol-name x) (s7-symbol-name f))) (extract t fields)))) (if (bool? j) -1 j)))
                                  (who (string-append (extract t name) "-" (s7-symbol-name f) "-set!")))
                             (sum ok (s7-made-prim who 2 2
                                                   (lambda ((args s7-values))
                                                     (tagcase (car args)
                                                       (record r (if (and (s7-record-of? (car args) t) (>= i 0))
                                                                     (begin (array-set! (extract r fields) i (s7-arg2 args)) (sum ok s7-unspecified))
                                                                     (s7-wrong who (string-append "a " (extract t name)) (car args))))
                                                       (else y (s7-wrong who (string-append "a " (extract t name)) y))))))))
                    (else y (s7-wrong "define-record-type" "a record type" y)))))
      (s7-prim! "error" 1 -1 (lambda ((a s7-values))
                               (sum raise (sum errobj (product (kind 'error)
                                                               (message (tagcase (car a) (str s (get s)) (else y (s7-show y #t))))
                                                               (irritants (s7-list (cdr a))))))))
      (s7-prim! "error-object?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (errobj e #t) (else y #f)))))
      (s7-prim! "error-object-message" 1 1 (lambda ((a s7-values)) (tagcase (car a) (errobj e (sum ok (s7-string (extract e message)))) (else y (s7-wrong "error-object-message" "an error object" y)))))
      (s7-prim! "error-object-irritants" 1 1 (lambda ((a s7-values)) (tagcase (car a) (errobj e (sum ok (extract e irritants))) (else y (s7-wrong "error-object-irritants" "an error object" y)))))
      (s7-prim! "read-error?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (errobj e (eq? (extract e kind) 'read)) (else y #f)))))
      (s7-prim! "file-error?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (errobj e (eq? (extract e kind) 'file)) (else y #f)))))
      (s7-prim! "features" 0 0 (lambda ((a s7-values)) (sum ok (s7-list (list (s7-symbol "r7rs") (s7-symbol "s7st") (s7-symbol "exact-closed") (s7-symbol "full-unicode")))))))))

"A port's characters from where it is: the next `n` (all, if -1)."
(define* s7-port-peek (subr (read @sc) (s7-port int) string)
  (lambda (p n)
    (let* ((t (extract p text)) (at (get (extract p pos))) (end (string-length t)))
      (substring t at (if (or (< n 0) (> (+ at n) end)) end (+ at n))))))
(define* s7-init-ports! (subr s7-eff () unit)
  (lambda ()
    (begin
      (s7-define-global! "%console-output" s7-console)
      (s7-define-global! "%console-input" s7-console-input)
      (s7-define-global! "%console-error" s7-console-error)
      ;; Mode 0: display; 1: write; 2: write-shared; 3: write-simple.
      (s7-prim! "%write" 3 3 (lambda ((a s7-values))
                               (let ((mode (tagcase (s7-arg3 a) (int m m) (else y 1))))
                                 (s7-port-write "write" (s7-arg2 a)
                                                (s7-string (s7-show-with (car a) (not (= mode 0)) (cond ((= mode 2) 2) ((= mode 3) 0) (else 1))))))))
      (s7-prim! "%write-string" 2 4 (lambda ((a s7-values))
                                      (tagcase (car a)
                                        (str s (tagcase (s7-range "write-string" (s7-opt a 2 s7-undefined) (s7-opt a 3 s7-undefined) (string-length (get s)))
                                                 (ok r (s7-port-write "write-string" (s7-arg2 a) (s7-string (substring (get s) (extract r start) (extract r end)))))
                                                 (bad e e)))
                                        (else y (s7-wrong "write-string" "a string" y)))))
      (s7-prim! "%write-char" 2 2 (lambda ((a s7-values))
                                    (tagcase (car a)
                                      (char c (s7-port-write "write-char" (s7-arg2 a) (s7-string (char->string c))))
                                      (else y (s7-wrong "write-char" "a character" y)))))
      (s7-prim! "%read-char" 2 2 (lambda ((a s7-values))
                                   (tagcase (s7-input-port "read-char" (car a))
                                     (ok p (let ((s (s7-port-peek p 1)))
                                             (if (string=? s "") (sum ok s7-eof)
                                                 (begin (if (s7-true? (s7-arg2 a)) (set (extract p pos) (+ 1 (get (extract p pos)))) #u)
                                                   (sum ok (sum char (string-ref s 0)))))))
                                     (bad e e))))
      (s7-prim! "%read-line" 1 1 (lambda ((a s7-values))
                                   (tagcase (s7-input-port "read-line" (car a))
                                     (ok p (let* ((t (extract p text)) (at (get (extract p pos))))
                                             (if (>= at (string-length t)) (sum ok s7-eof)
                                                 ;; A line ends at a newline, a return, or a return and a newline.
                                                 (letrec ((eol (subr spin (int) int)
                                                            (lambda (j) (cond ((>= j (string-length t)) -1) ((char-in? (string-ref t j) "\n\r") j) (else (eol (+ j 1)))))))
                                                   (let ((e (eol at)))
                                                     (if (< e 0)
                                                         (begin (set (extract p pos) (string-length t)) (sum ok (s7-string (substring t at (string-length t)))))
                                                         (begin (set (extract p pos)
                                                                     (if (and (char=? (string-ref t e) #\return) (< (+ e 1) (string-length t)) (char=? (string-ref t (+ e 1)) #\newline))
                                                                         (+ e 2) (+ e 1)))
                                                           (sum ok (s7-string (substring t at e))))))))))
                                     (bad e e))))
      (s7-prim! "%read-string" 2 2 (lambda ((a s7-values))
                                     (tagcase (s7-input-port "read-string" (s7-arg2 a))
                                       (ok p (tagcase (car a)
                                               (int k (let ((s (s7-port-peek p k)))
                                                        (if (and (string=? s "") (> k 0)) (sum ok s7-eof)
                                                            (begin (set (extract p pos) (+ (get (extract p pos)) (string-length s))) (sum ok (s7-string s))))))
                                               (else y (s7-wrong "read-string" "a count" y))))
                                       (bad e e))))
      (s7-prim! "%read" 1 1 (lambda ((a s7-values))
                              (tagcase (s7-input-port "read" (car a))
                                (ok p (tagcase (s7-read-at (extract p text) (get (extract p pos)) "")
                                        (datum d (begin (set (extract p pos) (extract d end)) (sum ok (extract d value))))
                                        (none u (begin (set (extract p pos) (string-length (extract p text))) (sum ok s7-eof)))
                                        (incomplete u (sum raise (sum errobj (product (kind 'read) (message "read: the text ends inside a datum") (irritants s7-nil)))))
                                        (bad b (sum raise (sum errobj (product (kind 'read) (message (string-append "read: " (extract b message))) (irritants s7-nil)))))))
                                (bad e e))))
      (s7-prim! "%char-ready?" 1 1 (lambda ((a s7-values)) (tagcase (s7-input-port "char-ready?" (car a)) (ok p (s7-bool #t)) (bad e e))))
      (s7-prim! "open-input-string" 1 1 (lambda ((a s7-values)) (tagcase (car a) (str s (sum ok (s7-make-port #t (get s)))) (else y (s7-wrong "open-input-string" "a string" y)))))
      (s7-prim! "open-output-string" 0 0 (lambda ((a s7-values)) (sum ok (s7-make-port #f ""))))
      (s7-prim! "get-output-string" 1 1 (lambda ((a s7-values))
                                          (tagcase (car a)
                                            (port p (if (extract p input) (s7-wrong "get-output-string" "an output port" (car a)) (sum ok (s7-string (s7-port-text p)))))
                                            (else y (s7-wrong "get-output-string" "a port" y)))))
      (s7-prim! "open-input-file" 1 1 (lambda ((a s7-values))
                                        (tagcase (car a)
                                          (str s (tagcase (s7-file-text (get s))
                                                   (text t (sum ok (s7-make-port #t t)))
                                                   (failed m (sum raise (sum errobj (product (kind 'file) (message m) (irritants (s7-list (list (car a))))))))))
                                          (else y (s7-wrong "open-input-file" "a file name" y)))))
      (s7-prim! "file-exists?" 1 1 (lambda ((a s7-values))
                                     (tagcase (car a)
                                       (str s (s7-bool (s7-file-exists? (get s))))
                                       (else y (s7-wrong "file-exists?" "a file name" y)))))
      (s7-prim! "open-binary-input-file" 1 1 (lambda ((a s7-values))
                                               (tagcase (car a)
                                                 (str s (tagcase (the (sumof (data (bytevectorof @sc)) (failed io-error)) (read-file (s7-path (get s))))
                                                          (data d (sum ok (s7-file-port #t (s7-bytes->chars d) "" #t)))
                                                          (else y (sum raise (sum errobj (product (kind 'file) (message (string-append "cannot read " (get s)))
                                                                                                  (irritants (s7-list (list (car a))))))))))
                                                 (else y (s7-wrong "open-binary-input-file" "a file name" y)))))
      (s7-prim! "open-binary-output-file" 1 1 (lambda ((a s7-values))
                                                (tagcase (car a)
                                                  (str s (let ((p (s7-file-port #f "" (s7-path (get s)) #t)))
                                                           (tagcase p
                                                             (port q (let ((why (s7-flush-port! q)))
                                                                       (if (string=? why "")
                                                                           (begin (set s7-file-ports (cons p (get s7-file-ports))) (sum ok p))
                                                                           (sum raise (sum errobj (product (kind 'file) (message why) (irritants (s7-list (list (car a))))))))))
                                                             (else y (sum ok p)))))
                                                  (else y (s7-wrong "open-binary-output-file" "a file name" y)))))
      (s7-prim! "open-input-bytevector" 1 1 (lambda ((a s7-values))
                                              (tagcase (car a)
                                                (bytes v (sum ok (s7-file-port #t (list->string (letrec ((go (subr spin ((listof int acyclic)) (listof char acyclic))
                                                                                                           (lambda (l) (if (null? l) nil (cons (integer->char (car l)) (go (cdr l)))))))
                                                                                                    (go (array->list v))))
                                                                               "" #t)))
                                                (else y (s7-wrong "open-input-bytevector" "a bytevector" y)))))
      (s7-prim! "open-output-bytevector" 0 0 (lambda ((a s7-values)) (sum ok (s7-file-port #f "" "" #t))))
      (s7-prim! "get-output-bytevector" 1 1 (lambda ((a s7-values))
                                              (tagcase (car a)
                                                (port p (if (and (not (extract p input)) (extract p binary))
                                                            (sum ok (sum bytes (list->array (letrec ((go (subr spin ((listof char acyclic)) (listof int acyclic))
                                                                                                         (lambda (l) (if (null? l) nil (cons (char->integer (car l)) (go (cdr l)))))))
                                                                                                  (go (the (listof char acyclic) (string->list (s7-port-text p))))))))
                                                            (s7-wrong "get-output-bytevector" "a binary output port" (car a))))
                                                (else y (s7-wrong "get-output-bytevector" "a port" y)))))
      (s7-prim! "%write-u8" 2 2 (lambda ((a s7-values))
                                  (tagcase (car a)
                                    (int b (if (and (>= b 0) (< b 256)) (s7-port-write "write-u8" (s7-arg2 a) (s7-string (char->string (integer->char b))))
                                               (s7-wrong "write-u8" "a byte" (car a))))
                                    (else y (s7-wrong "write-u8" "a byte" y)))))
      (s7-prim! "%read-u8" 2 2 (lambda ((a s7-values))
                                 (tagcase (s7-input-port "read-u8" (car a))
                                   (ok p (let ((s (s7-port-peek p 1)))
                                           (if (string=? s "") (sum ok s7-eof)
                                               (begin (if (s7-true? (s7-arg2 a)) (set (extract p pos) (+ 1 (get (extract p pos)))) #u)
                                                 (s7-ok-int (char->integer (string-ref s 0)))))))
                                   (bad e e))))
      (s7-prim! "%read-bytevector" 2 2 (lambda ((a s7-values))
                                         (tagcase (s7-input-port "read-bytevector" (s7-arg2 a))
                                           (ok p (tagcase (car a)
                                                   (int k (let ((s (s7-port-peek p k)))
                                                            (if (and (string=? s "") (> k 0)) (sum ok s7-eof)
                                                                (begin (set (extract p pos) (+ (get (extract p pos)) (string-length s)))
                                                                  (sum ok (sum bytes (list->array (letrec ((go (subr spin ((listof char acyclic)) (listof int acyclic))
                                                                                                             (lambda (l) (if (null? l) nil (cons (char->integer (car l)) (go (cdr l)))))))
                                                                                                      (go (the (listof char acyclic) (string->list s)))))))))))
                                                   (else y (s7-wrong "read-bytevector" "a count" y))))
                                           (bad e e))))
      (s7-prim! "binary-port?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (port p (extract p binary)) (else y #f)))))
      (s7-prim! "textual-port?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (port p (not (extract p binary))) (else y #f)))))
      (s7-prim! "delete-file" 1 1 (lambda ((a s7-values))
                                    (let ((fail (lambda ((why string))
                                                  (sum raise (sum errobj (product (kind 'file) (message (string-append "delete-file: " why))
                                                                                  (irritants (s7-list (list (car a))))))))))
                                      (tagcase (car a)
                                        (str s (tagcase (process-start (the (listof string @sc) (list "/bin/rm" "--" (s7-path (get s)))) "")
                                                 (started id
                                                   (begin
                                                     (process-close-input id)
                                                     (tagcase (process-exit id)
                                                       (exited c (if (= c 0) (sum ok s7-unspecified)
                                                                     ;; What rm said: its output, all of it once
                                                                     ;; its status is no longer running (F6).
                                                                     (letrec ((said (subr s7-eff (string) string)
                                                                                (lambda (acc)
                                                                                  (let ((acc (string-append acc (process-output id))))
                                                                                    (tagcase (process-status id) (running u (said acc)) (else y acc))))))
                                                                       (let* ((out (said "")) (nl (string-search out "\n" 0)))
                                                                         (fail (if (< nl 0) out (substring out 0 nl)))))))
                                                       (else y (fail "rm did not end well")))))
                                                 (failed e (fail "cannot run rm"))))
                                        (else y (s7-wrong "delete-file" "a file name" y))))))
      (s7-prim! "command-line" 0 0 (lambda ((a s7-values))
                                     (sum ok (s7-list (cons (s7-string "s7st")
                                                            (letrec ((go (subr s7-eff ((listof string @sc)) s7-values)
                                                                       (lambda (l) (if (null? l) nil (cons (s7-string (car l)) (go (cdr l)))))))
                                                              (go (the (listof string @sc) (args)))))))))
      (s7-prim! "eof-object" 0 0 (lambda ((a s7-values)) (sum ok s7-eof)))
      (s7-prim! "eof-object?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (eof u #t) (else y #f)))))
      (s7-prim! "port?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (port p #t) (else y #f)))))
      (s7-prim! "input-port?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (port p (extract p input)) (else y #f)))))
      (s7-prim! "output-port?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (port p (not (extract p input))) (else y #f)))))
      (s7-prim! "input-port-open?" 1 1 (lambda ((a s7-values)) (tagcase (car a) (port p (s7-bool (and (extract p input) (get (extract p open))))) (else y (s7-wrong "input-port-open?" "a port" y)))))
      (s7-prim! "output-port-open?" 1 1 (lambda ((a s7-values)) (tagcase (car a) (port p (s7-bool (and (not (extract p input)) (get (extract p open))))) (else y (s7-wrong "output-port-open?" "a port" y)))))
      (s7-prim! "close-port" 1 1 (lambda ((a s7-values))
                                   (tagcase (car a)
                                     (port p (let ((why (if (get (extract p open)) (s7-flush-port! p) "")))
                                               (begin (set (extract p open) #f)
                                                 (if (string=? why "") (sum ok s7-unspecified)
                                                     (sum raise (sum errobj (product (kind 'file) (message why) (irritants s7-nil))))))))
                                     (else y (s7-wrong "close-port" "a port" y)))))
      (s7-alias! "close-input-port" "close-port")
      (s7-alias! "close-output-port" "close-port")
      (s7-prim! "%flush-output-port" 1 1 (lambda ((a s7-values))
                                           (tagcase (car a)
                                             (port p (let ((why (s7-flush-port! p)))
                                                       (if (string=? why "") (sum ok s7-unspecified)
                                                           (sum raise (sum errobj (product (kind 'file) (message why) (irritants s7-nil)))))))
                                             (else y (s7-wrong "flush-output-port" "a port" y)))))
      (s7-prim! "open-output-file" 1 1 (lambda ((a s7-values))
                                         (tagcase (car a)
                                           (str s (let ((p (s7-file-port #f "" (s7-path (get s)) #f)))
                                                    ;; Made empty at once, as opening a file for output does; or why not.
                                                    (tagcase p
                                                      (port q (let ((why (s7-flush-port! q)))
                                                                (if (string=? why "")
                                                                    (begin (set s7-file-ports (cons p (get s7-file-ports))) (sum ok p))
                                                                    (sum raise (sum errobj (product (kind 'file) (message why) (irritants (s7-list (list (car a))))))))))
                                                      (else y (sum ok p)))))
                                           (else y (s7-wrong "open-output-file" "a file name" y)))))
      (s7-prim! "current-jiffy" 0 0 (lambda ((a s7-values)) (s7-ok-int (i64->int (clock)))))
      (s7-prim! "jiffies-per-second" 0 0 (lambda ((a s7-values)) (s7-ok-int 1000000000)))
      (s7-prim! "current-second" 0 0 (lambda ((a s7-values)) (sum ok (sum real (f64/ (int->f64 (i64->int (clock))) 1000000000.0)))))
      (s7-prim! "get-environment-variable" 1 1 (lambda ((a s7-values)) (s7-bool #f)))
      (s7-prim! "get-environment-variables" 0 0 (lambda ((a s7-values)) (sum ok s7-nil))))))

"The machine's own operations, by number (machine.fx's `s7-control`)."
(define s7-op-apply int 0)
(define s7-op-call/cc int 1)
(define s7-op-values int 2)
(define s7-op-call-with-values int 3)
(define s7-op-dynamic-wind int 4)
(define s7-op-with-exception-handler int 5)
(define s7-op-raise int 6)
(define s7-op-raise-continuable int 7)
(define s7-op-eval int 8)
(define s7-op-load int 9)
(define s7-op-exit int 10)
(define* s7-init-control! (subr s7-eff () unit)
  (lambda ()
    (begin
      (s7-ctl! "apply" 1 -1 s7-op-apply)
      (s7-ctl! "call-with-current-continuation" 1 1 s7-op-call/cc)
      (s7-alias! "call/cc" "call-with-current-continuation")
      (s7-ctl! "values" 0 -1 s7-op-values)
      (s7-ctl! "call-with-values" 2 2 s7-op-call-with-values)
      (s7-ctl! "dynamic-wind" 3 3 s7-op-dynamic-wind)
      (s7-ctl! "with-exception-handler" 2 2 s7-op-with-exception-handler)
      (s7-ctl! "raise" 1 1 s7-op-raise)
      (s7-ctl! "raise-continuable" 1 1 s7-op-raise-continuable)
      (s7-ctl! "eval" 1 2 s7-op-eval)
      (s7-ctl! "load" 1 2 s7-op-load)
      (s7-ctl! "exit" 0 1 s7-op-exit)
      (s7-alias! "emergency-exit" "exit"))))

;;; ------------------------------------------------------------ fast entries

"Built-in `name` given `fast` (value.fx's `s7-prim`): the same for one or
two arguments, called by a quick evaluation with no list made."
(define* s7-fast! (subr s7-eff (string s7-fast) unit)
  (lambda (name fast)
    (let ((cell (extract (s7-global-cell (string->symbol name)) value)))
      (tagcase (get cell)
        (prim p (set cell (sum prim (product (name (extract p name)) (min (extract p min)) (max (extract p max))
                                             (op (extract p op)) (pure (extract p pure)) (fast fast)))))
        (else y #u)))))
"Two ints' `iop`; else undefined."
(define* s7-fast-int2 (subr pure ((subr pure (int int) int)) (subr (read @globals) (s7-value s7-value) s7-value))
  (lambda (iop)
    (lambda ((a s7-value) (b s7-value))
      (tagcase a (int i (tagcase b (int j (sum int (iop i j))) (else y s7-undefined))) (else y s7-undefined)))))
"Whether two ints stand in `iop`; else undefined."
(define* s7-fast-int2? (subr pure ((subr pure (int int) bool)) (subr (read @globals) (s7-value s7-value) s7-value))
  (lambda (iop)
    (lambda ((a s7-value) (b s7-value))
      (tagcase a (int i (tagcase b (int j (if (iop i j) s7-true s7-false)) (else y s7-undefined))) (else y s7-undefined)))))
(define* s7-truth (subr (read @globals) (bool) s7-value) (lambda (b) (if b s7-true s7-false)))
(define* s7-init-fast! (subr s7-eff () unit)
  (lambda ()
    (begin
      (s7-fast! "+" (sum f2 (s7-fast-int2 +)))
      (s7-fast! "-" (sum f2 (s7-fast-int2 -)))
      (s7-fast! "*" (sum f2 (s7-fast-int2 *)))
      (s7-fast! "=" (sum f2 (s7-fast-int2? =)))
      (s7-fast! "<" (sum f2 (s7-fast-int2? <)))
      (s7-fast! ">" (sum f2 (s7-fast-int2? >)))
      (s7-fast! "<=" (sum f2 (s7-fast-int2? <=)))
      (s7-fast! ">=" (sum f2 (s7-fast-int2? >=)))
      (s7-fast! "eq?" (sum f2 (lambda ((a s7-value) (b s7-value)) (s7-truth (s7-eqv? a b)))))
      (s7-fast! "eqv?" (sum f2 (lambda ((a s7-value) (b s7-value)) (s7-truth (s7-eqv? a b)))))
      (s7-fast! "cons" (sum f2 (lambda ((a s7-value) (b s7-value)) (s7-cons a b))))
      (s7-fast! "vector-ref" (sum f2 (lambda ((a s7-value) (b s7-value))
                                       (tagcase a
                                         (vec v (tagcase b (int i (if (and (>= i 0) (< i (array-length v))) (array-ref v i) s7-undefined))
                                                  (else y s7-undefined)))
                                         (else y s7-undefined)))))
      (s7-fast! "car" (sum f1 (lambda ((a s7-value)) (tagcase a (pair p (get (extract p car))) (else y s7-undefined)))))
      (s7-fast! "cdr" (sum f1 (lambda ((a s7-value)) (tagcase a (pair p (get (extract p cdr))) (else y s7-undefined)))))
      (s7-fast! "pair?" (sum f1 (lambda ((a s7-value)) (s7-truth (s7-pair? a)))))
      (s7-fast! "null?" (sum f1 (lambda ((a s7-value)) (s7-truth (s7-null? a)))))
      (s7-fast! "not" (sum f1 (lambda ((a s7-value)) (tagcase a (bool b (s7-truth (not b))) (else y s7-false)))))
      (s7-fast! "zero?" (sum f1 (lambda ((a s7-value)) (tagcase a (int i (s7-truth (= i 0))) (else y s7-undefined)))))
      (s7-fast! "vector-length" (sum f1 (lambda ((a s7-value)) (tagcase a (vec v (sum int (array-length v))) (else y s7-undefined))))))))

"Every procedure written in FX-26 defined; and those the expander's
rewritten forms call, by names no program binds (` cons`, ` memv`, …)."
(define* s7-init-prims! (subr s7-eff () unit)
  (lambda ()
    (begin
      (s7-init-numbers!)
      (s7-init-lists!)
      (s7-init-text!)
      (s7-init-vectors!)
      (s7-init-records!)
      (s7-init-ports!)
      (s7-init-control!)
      (s7-init-fast!)
      (letrec ((hidden (subr s7-eff (s7-strings) unit)
                 (lambda (l) (if (null? l) #u (begin (s7-alias! (string-append " " (car l)) (car l)) (hidden (cdr l)))))))
        (hidden (list "cons" "append" "list->vector" "memv" "list" "list-ref" "list-tail" "call-with-values"))))))

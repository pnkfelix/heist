(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(define (tak x y z) (if (not (< y x)) z (tak (tak (- x 1) y z) (tak (- y 1) z x) (tak (- z 1) x y))))
(define (count-loop n) (let loop ((i 0) (acc 0)) (if (= i n) acc (loop (+ i 1) (+ acc i)))))
(define (build n) (let loop ((i 0) (l '())) (if (= i n) (length (map (lambda (x) (* x x)) l)) (loop (+ i 1) (cons i l)))))
(define (vec-sum n) (let ((v (make-vector n 1))) (do ((i 0 (+ i 1)) (s 0 (+ s (vector-ref v i)))) ((= i n) s))))
(define (countdown n) (if (> n 0) (countdown (- n 1)) 'done))
(define (time-it name reps thunk)
  (let* ((t0 (current-jiffy))
         (r (let loop ((i 1) (r (thunk))) (if (= i reps) r (loop (+ i 1) (thunk)))))
         (t1 (current-jiffy))
         (us (round (/ (* 1000000 (- t1 t0)) (* reps (jiffies-per-second))))))
    (display name) (display " ") (display (exact (quotient us 1000))) (display ".")
    (display (exact (quotient (remainder us 1000) 100))) (display " ms") (newline)))


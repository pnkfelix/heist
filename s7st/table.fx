;;; table.fx: hash tables -- SRFI 69's and R6RS's procedures.
;;;
;;; A table compares its keys by `eq?`/`eqv?`, `equal?`, `string=?` or
;;; `string-ci=?` (its kind). Its entries are kept in order, in arrays, so
;;; that it can be walked; a deleted one's key is left undefined until the
;;; arrays are compacted. Keys are found two ways:
;;;   - by identity, for what a kind compares by identity (a pair, a
;;;     vector, a record, a procedure, … and, by `eqv?`, a string): an
;;;     `eqtable` of FX-26's, keyed by the object's own cell or array, so
;;;     no address is needed;
;;;   - by a hash of the contents, for the rest (numbers, characters,
;;;     symbols; and by `equal?`, pairs, strings and vectors), in buckets.
;;; What calls procedures back (`hash-table-update!`, `hash-table-walk`, …)
;;; is in the prelude.

(define* s7-new-ids (subr (alloc @sc) () s7-ids)
  (lambda ()
    (product (pairs (the (eqtable (ref s7-value @sc) int @sc @sc) (make-eqtable (ref-identity))))
             (cells (the (eqtable (ref string @sc) int @sc @sc) (make-eqtable (ref-identity))))
             (arrays (the (eqtable (arrayof s7-value @sc) int @sc @sc) (make-eqtable (array-identity))))
             (bytes (the (eqtable (arrayof int @sc) int @sc @sc) (make-eqtable (array-identity))))
             (units (the (eqtable (ref unit @sc) int @sc @sc) (make-eqtable (ref-identity)))))))
(define* s7-new-table (subr (alloc @sc) (symbol int) s7-table)
  (lambda (kind size)
    (let ((n (if (< size 8) 8 size)))
      (product (id (the (ref unit @sc) (new #u))) (kind kind)
               (keys (the (ref (arrayof s7-value @sc) @sc) (new (the (arrayof s7-value @sc) (make-array n s7-undefined)))))
               (vals (the (ref (arrayof s7-value @sc) @sc) (new (the (arrayof s7-value @sc) (make-array n s7-unspecified)))))
               (used (the (ref int @sc) (new 0)))
               (count (the (ref int @sc) (new 0)))
               (buckets (the (ref (arrayof (listof int acyclic) @sc) @sc)
                             (new (the (arrayof (listof int acyclic) @sc) (make-array n (the (listof int acyclic) nil))))))
               (ids (the (ref s7-ids @sc) (new (s7-new-ids))))))))

"Whether a table of `kind` finds key `v` by its identity."
(define* s7-by-identity? (subr pure (symbol s7-value) bool)
  (lambda (kind v)
    (cond ((or (eq? kind 'string) (eq? kind 'string-ci)) #f)
          ((eq? kind 'equal)
           (tagcase v (proc c #t) (record r #t) (cont c #t) (rtd r #t) (port p #t) (table t #t) (else y #f)))
          (else
           (tagcase v (pair p #t) (str s #t) (proc c #t) (vec a #t) (record r #t) (bytes b #t)
                      (cont c #t) (rtd r #t) (port p #t) (table t #t) (else y #f))))))

(define s7-hash-bound int 1000000007)
(define* s7-mix (subr pure (int int) int)
  (lambda (h x) (modulo (+ (* h 31) x) s7-hash-bound)))
"A hash of `v`'s contents, as a table of `kind` compares them; `depth`
parts deep, at most."
(define* s7-hash (subr s7-eff (symbol s7-value int) int)
  (lambda (kind v depth)
    (if (<= depth 0) 17
        (tagcase v
          (int i (modulo i s7-hash-bound))
          (ratio q (s7-mix (modulo (extract q num) s7-hash-bound) (modulo (extract q den) s7-hash-bound)))
          (real r (modulo (u64->int (f64->bits r)) s7-hash-bound))
          (char c (char->integer c))
          (bool b (if b 1 2))
          (sym s (modulo (symbol-name-hash s) s7-hash-bound))
          (str s (modulo (string-hash (if (eq? kind 'string-ci) (string-downcase (get s)) (get s))) s7-hash-bound))
          (pair p (s7-mix (s7-hash kind (get (extract p car)) (- depth 1)) (s7-hash kind (get (extract p cdr)) (- depth 1))))
          (vec a (letrec ((go (subr s7-eff (s7-values int int) int)
                                (lambda (l k h) (if (or (null? l) (<= k 0)) h (go (cdr l) (- k 1) (s7-mix h (s7-hash kind (car l) (- depth 1))))))))
                   (go (array->list a) 4 (array-length a))))
          (bytes a (letrec ((go (subr spin ((listof int acyclic) int int) int)
                                  (lambda (l k h) (if (or (null? l) (<= k 0)) h (go (cdr l) (- k 1) (s7-mix h (car l)))))))
                     (go (array->list a) 8 (array-length a))))
          (prim p (modulo (string-hash (extract p name)) s7-hash-bound))
          (null u 3) (unspec u 4) (eof u 5) (env u 6)
          (else y 7)))))

"Whether keys `a` and `b` are the same, as a table of `kind` compares."
(define* s7-same-key? (subr s7-eff (symbol s7-value s7-value) bool)
  (lambda (kind a b)
    (cond ((eq? kind 'equal) (s7-equal? a b))
          ((eq? kind 'string) (tagcase a (str s (tagcase b (str t (string=? (get s) (get t))) (else y #f))) (else y #f)))
          ((eq? kind 'string-ci) (tagcase a (str s (tagcase b (str t (string=? (string-downcase (get s)) (string-downcase (get t)))) (else y #f))) (else y #f)))
          (else (s7-eqv? a b)))))

"Where key `k`'s entry is in table `t`, or -1."
(define* s7-table-find (subr s7-eff (s7-table s7-value) int)
  (lambda (t k)
    (let ((ids (get (extract t ids))))
      (if (s7-by-identity? (extract t kind) k)
          (tagcase k
            (pair p (eqtable-ref (extract ids pairs) (extract p car) -1))
            (str s (eqtable-ref (extract ids cells) s -1))
            (proc c (eqtable-ref (extract ids cells) (extract c name) -1))
            (vec a (eqtable-ref (extract ids arrays) a -1))
            (record r (eqtable-ref (extract ids arrays) (extract r fields) -1))
            (bytes a (eqtable-ref (extract ids bytes) a -1))
            (cont c (eqtable-ref (extract ids units) (extract c id) -1))
            (rtd r (eqtable-ref (extract ids units) (extract r id) -1))
            (port p (eqtable-ref (extract ids units) (extract p id) -1))
            (table x (eqtable-ref (extract ids units) (extract x id) -1))
            (else y -1))
          (let* ((bs (get (extract t buckets)))
                 (h (modulo (s7-hash (extract t kind) k 4) (array-length bs))))
            (letrec ((go (subr s7-eff ((listof int acyclic)) int)
                       (lambda (l)
                         (cond ((null? l) -1)
                               ((s7-same-key? (extract t kind) (array-ref (get (extract t keys)) (car l)) k) (car l))
                               (else (go (cdr l)))))))
              (go (array-ref bs h))))))))

"Entry `i`, of key `k`, put in table `t`'s index (`add`), or taken out."
(define* s7-table-index! (subr s7-eff (s7-table s7-value int bool) unit)
  (lambda (t k i add)
    (let ((ids (get (extract t ids))))
      (if (s7-by-identity? (extract t kind) k)
          (let ((put (lambda ((h (eqtable (ref s7-value @sc) int @sc @sc)) (key (ref s7-value @sc)))
                       (if add (eqtable-set! h key i) (eqtable-delete! h key)))))
            (tagcase k
              (pair p (put (extract ids pairs) (extract p car)))
              (str s (if add (eqtable-set! (extract ids cells) s i) (eqtable-delete! (extract ids cells) s)))
              (proc c (if add (eqtable-set! (extract ids cells) (extract c name) i) (eqtable-delete! (extract ids cells) (extract c name))))
              (vec a (if add (eqtable-set! (extract ids arrays) a i) (eqtable-delete! (extract ids arrays) a)))
              (record r (if add (eqtable-set! (extract ids arrays) (extract r fields) i) (eqtable-delete! (extract ids arrays) (extract r fields))))
              (bytes a (if add (eqtable-set! (extract ids bytes) a i) (eqtable-delete! (extract ids bytes) a)))
              (cont c (if add (eqtable-set! (extract ids units) (extract c id) i) (eqtable-delete! (extract ids units) (extract c id))))
              (rtd r (if add (eqtable-set! (extract ids units) (extract r id) i) (eqtable-delete! (extract ids units) (extract r id))))
              (port p (if add (eqtable-set! (extract ids units) (extract p id) i) (eqtable-delete! (extract ids units) (extract p id))))
              (table x (if add (eqtable-set! (extract ids units) (extract x id) i) (eqtable-delete! (extract ids units) (extract x id))))
              (else y #u)))
          (let* ((bs (get (extract t buckets)))
                 (h (modulo (s7-hash (extract t kind) k 4) (array-length bs)))
                 (l (array-ref bs h)))
            (array-set! bs h (if add (cons i l)
                                 (letrec ((drop (subr spin ((listof int acyclic)) (listof int acyclic))
                                            (lambda (l) (cond ((null? l) nil) ((= (car l) i) (cdr l)) (else (cons (car l) (drop (cdr l))))))))
                                   (drop l)))))))))

"Table `t`'s entries moved to arrays of `size`, its deleted ones dropped,
and its index made again, with buckets for that size."
(define* s7-table-rebuild! (subr s7-eff (s7-table int) unit)
  (lambda (t size)
    (let* ((oldk (get (extract t keys))) (oldv (get (extract t vals))) (n (get (extract t used)))
           (keys (the (arrayof s7-value @sc) (make-array size s7-undefined)))
           (vals (the (arrayof s7-value @sc) (make-array size s7-unspecified))))
      (begin
        (set (extract t keys) keys)
        (set (extract t vals) vals)
        (set (extract t buckets) (the (arrayof (listof int acyclic) @sc) (make-array size (the (listof int acyclic) nil))))
        (set (extract t ids) (s7-new-ids))
        (letrec ((go (subr s7-eff (int int) int)
                   (lambda (i j)
                     (if (>= i n) j
                         (let ((k (array-ref oldk i)))
                           (tagcase k
                             (undef u (go (+ i 1) j))
                             (else y (begin (array-set! keys j k) (array-set! vals j (array-ref oldv i))
                                       (s7-table-index! t k j #t)
                                       (go (+ i 1) (+ j 1))))))))))
          (let ((m (go 0 0)))
            (begin (set (extract t used) m) (set (extract t count) m))))))))

"Key `k` given value `v` in table `t`."
(define* s7-table-set! (subr s7-eff (s7-table s7-value s7-value) unit)
  (lambda (t k v)
    (let ((i (s7-table-find t k)))
      (if (>= i 0) (array-set! (get (extract t vals)) i v)
          (begin
            (if (>= (get (extract t used)) (array-length (get (extract t keys))))
                ;; Full: compacted, and doubled if most entries are live.
                (s7-table-rebuild! t (if (> (* 2 (get (extract t count))) (array-length (get (extract t keys))))
                                         (* 2 (array-length (get (extract t keys))))
                                         (array-length (get (extract t keys)))))
                #u)
            (let ((j (get (extract t used))))
              (begin
                (array-set! (get (extract t keys)) j k)
                (array-set! (get (extract t vals)) j v)
                (s7-table-index! t k j #t)
                (set (extract t used) (+ j 1))
                (set (extract t count) (+ (get (extract t count)) 1)))))))))
(define* s7-table-delete! (subr s7-eff (s7-table s7-value) unit)
  (lambda (t k)
    (let ((i (s7-table-find t k)))
      (if (< i 0) #u
          (begin
            (s7-table-index! t k i #f)
            (array-set! (get (extract t keys)) i s7-undefined)
            (array-set! (get (extract t vals)) i s7-unspecified)
            (set (extract t count) (- (get (extract t count)) 1)))))))
"Table `t`'s live keys or values (`keys?`), in the order they were put."
(define* s7-table-items (subr s7-eff (s7-table bool) s7-values)
  (lambda (t keys?)
    (let ((ks (get (extract t keys))) (vs (get (extract t vals))))
      (letrec ((go (subr s7-eff (int s7-values) s7-values)
                 (lambda (i acc)
                   (if (< i 0) acc
                       (tagcase (array-ref ks i)
                         (undef u (go (- i 1) acc))
                         (else k (go (- i 1) (cons (if keys? k (array-ref vs i)) acc))))))))
        (go (- (get (extract t used)) 1) nil)))))

"The kind of table an equivalence procedure makes, or ` none`."
(define* s7-kind-of (subr pure (s7-value) symbol)
  (lambda (f)
    (tagcase f
      (prim p (let ((n (extract p name)))
                (cond ((or (string=? n "eq?") (string=? n "eqv?") (string=? n "=")) 'eqv)
                      ((string=? n "equal?") 'equal)
                      ((string=? n "string=?") 'string)
                      ((string=? n "string-ci=?") 'string-ci)
                      (else (string->symbol " none")))))
      (else y (string->symbol " none")))))

(define* s7-init-tables! (subr s7-eff () unit)
  (lambda ()
    (let* ((maker (lambda ((kind symbol)) (lambda ((a s7-values)) (sum ok (sum table (s7-new-table kind (tagcase (s7-opt a 0 (sum int 8)) (int n n) (else y 8))))))))
           (table-of (lambda ((who string) (v s7-value) (k (subr s7-eff (s7-table) s7-out)))
                       (tagcase v (table t (k t)) (else y (s7-wrong who "a hash table" y)))))
           (bounded (lambda ((h int) (a s7-values))
                      (tagcase (s7-opt a 1 s7-undefined) (int b (if (> b 0) (s7-ok-int (modulo h b)) (s7-ok-int h))) (else y (s7-ok-int h))))))
      (begin
        (s7-prim! "make-hash-table" 0 2
                  (lambda ((a s7-values))
                    (let ((kind (if (null? a) 'equal (s7-kind-of (car a)))))
                      (if (eq? kind (string->symbol " none"))
                          (s7-fail "make-hash-table: only eq?, eqv?, equal?, string=? and string-ci=? are supported" (list (car a)))
                          (sum ok (sum table (s7-new-table kind 8)))))))
        (s7-prim! "make-hashtable" 2 3
                  (lambda ((a s7-values))
                    (let ((kind (s7-kind-of (s7-arg2 a))))
                      (if (eq? kind (string->symbol " none"))
                          (s7-fail "make-hashtable: only eq?, eqv?, equal?, string=? and string-ci=? are supported" (list (s7-arg2 a)))
                          (sum ok (sum table (s7-new-table kind 8)))))))
        (s7-prim! "make-eq-hashtable" 0 1 (maker 'eqv))
        (s7-prim! "make-eqv-hashtable" 0 1 (maker 'eqv))
        (s7-prim! "make-equal-hashtable" 0 1 (maker 'equal))
        (s7-prim! "make-string-hashtable" 0 1 (maker 'string))
        (s7-prim! "hash-table?" 1 1 (lambda ((a s7-values)) (s7-bool (tagcase (car a) (table t #t) (else y #f)))))
        (s7-alias! "hashtable?" "hash-table?")
        (s7-prim! "%table-ref" 3 3 (lambda ((a s7-values))
                                     (table-of "hash-table-ref" (car a)
                                               (lambda ((t s7-table))
                                                 (let ((i (s7-table-find t (s7-arg2 a))))
                                                   (sum ok (if (< i 0) (s7-arg3 a) (array-ref (get (extract t vals)) i))))))))
        (s7-alias! "hash-table-ref/default" "%table-ref")
        (s7-alias! "hashtable-ref" "%table-ref")
        (s7-prim! "hash-table-set!" 3 3 (lambda ((a s7-values))
                                          (table-of "hash-table-set!" (car a)
                                                    (lambda ((t s7-table)) (begin (s7-table-set! t (s7-arg2 a) (s7-arg3 a)) (sum ok s7-unspecified))))))
        (s7-alias! "hashtable-set!" "hash-table-set!")
        (s7-prim! "hash-table-delete!" 2 2 (lambda ((a s7-values))
                                             (table-of "hash-table-delete!" (car a)
                                                       (lambda ((t s7-table)) (begin (s7-table-delete! t (s7-arg2 a)) (sum ok s7-unspecified))))))
        (s7-alias! "hashtable-delete!" "hash-table-delete!")
        (s7-prim! "hash-table-contains?" 2 2 (lambda ((a s7-values))
                                               (table-of "hash-table-contains?" (car a)
                                                         (lambda ((t s7-table)) (s7-bool (>= (s7-table-find t (s7-arg2 a)) 0))))))
        (s7-alias! "hash-table-exists?" "hash-table-contains?")
        (s7-alias! "hashtable-contains?" "hash-table-contains?")
        (s7-prim! "hash-table-count" 1 1 (lambda ((a s7-values))
                                           (table-of "hash-table-count" (car a) (lambda ((t s7-table)) (s7-ok-int (get (extract t count)))))))
        (s7-alias! "hash-table-size" "hash-table-count")
        (s7-alias! "hashtable-size" "hash-table-count")
        (s7-prim! "hash-table-keys" 1 1 (lambda ((a s7-values))
                                          (table-of "hash-table-keys" (car a) (lambda ((t s7-table)) (sum ok (s7-list (s7-table-items t #t)))))))
        (s7-prim! "hash-table-values" 1 1 (lambda ((a s7-values))
                                            (table-of "hash-table-values" (car a) (lambda ((t s7-table)) (sum ok (s7-list (s7-table-items t #f)))))))
        (s7-prim! "hashtable-keys" 1 1 (lambda ((a s7-values))
                                         (table-of "hashtable-keys" (car a) (lambda ((t s7-table)) (sum ok (sum vec (list->array (s7-table-items t #t))))))))
        (s7-prim! "hashtable-entries" 1 1 (lambda ((a s7-values))
                                            (table-of "hashtable-entries" (car a)
                                                      (lambda ((t s7-table))
                                                        (sum ok (sum multi (list (sum vec (list->array (s7-table-items t #t)))
                                                                                 (sum vec (list->array (s7-table-items t #f))))))))))
        (s7-prim! "hash-table->alist" 1 1 (lambda ((a s7-values))
                                            (table-of "hash-table->alist" (car a)
                                                      (lambda ((t s7-table))
                                                        (letrec ((go (subr s7-eff (s7-values s7-values) s7-values)
                                                                   (lambda (ks vs) (if (or (null? ks) (null? vs)) nil (cons (s7-cons (car ks) (car vs)) (go (cdr ks) (cdr vs)))))))
                                                          (sum ok (s7-list (go (s7-table-items t #t) (s7-table-items t #f)))))))))
        (s7-prim! "hash-table-clear!" 1 2 (lambda ((a s7-values))
                                            (table-of "hash-table-clear!" (car a)
                                                      (lambda ((t s7-table))
                                                        (begin (set (extract t used) 0) (set (extract t count) 0) (s7-table-rebuild! t 8)
                                                          (sum ok s7-unspecified))))))
        (s7-alias! "hashtable-clear!" "hash-table-clear!")
        (s7-prim! "hash-table-copy" 1 2 (lambda ((a s7-values))
                                          (table-of "hash-table-copy" (car a)
                                                    (lambda ((t s7-table))
                                                      (let ((c (s7-new-table (extract t kind) (get (extract t count)))))
                                                        (letrec ((go (subr s7-eff (s7-values s7-values) unit)
                                                                   (lambda (ks vs) (if (or (null? ks) (null? vs)) #u (begin (s7-table-set! c (car ks) (car vs)) (go (cdr ks) (cdr vs)))))))
                                                          (begin (go (s7-table-items t #t) (s7-table-items t #f)) (sum ok (sum table c)))))))))
        (s7-alias! "hashtable-copy" "hash-table-copy")
        (s7-prim! "hash" 1 2 (lambda ((a s7-values)) (bounded (s7-hash 'equal (car a) 4) a)))
        (s7-alias! "equal-hash" "hash")
        (s7-prim! "string-hash" 1 2 (lambda ((a s7-values))
                                      (tagcase (car a) (str s (bounded (s7-hash 'string (car a) 4) a)) (else y (s7-wrong "string-hash" "a string" y)))))
        (s7-prim! "string-ci-hash" 1 2 (lambda ((a s7-values))
                                         (tagcase (car a) (str s (bounded (s7-hash 'string-ci (car a) 4) a)) (else y (s7-wrong "string-ci-hash" "a string" y)))))
        (s7-prim! "symbol-hash" 1 2 (lambda ((a s7-values))
                                      (tagcase (car a) (sym s (bounded (s7-hash 'eqv (car a) 4) a)) (else y (s7-wrong "symbol-hash" "a symbol" y)))))))))

; Tail calls, continuations, dynamic-wind, exceptions, parameters.
(define (show . xs) (for-each display xs) (newline))
;; A million iterations in constant space: tail calls, named let, do.
(define (count-to n) (let loop ((i 0)) (if (< i n) (loop (+ i 1)) i)))
(show (count-to 1000000))
(define (even2? n) (if (= n 0) #t (odd2? (- n 1))))
(define (odd2? n) (if (= n 0) #f (even2? (- n 1))))
(show (even2? 100001))
(show (do ((i 0 (+ i 1))) ((= i 100000) 'done)))
;; Escaping.
(show (call/cc (lambda (k) (+ 1 (k 42)))))
(show (+ 1 (call-with-current-continuation (lambda (k) (for-each (lambda (x) (if (negative? x) (k x))) '(1 -2 3)) 0))))
;; Re-entering: a continuation resumed twice.
(define r '())
(define k2 #f)
(set! r (cons (call/cc (lambda (k) (set! k2 k) 1)) r))
(if (< (length r) 3) (k2 (+ (car r) 1)))
(show r)
;; A generator by continuations.
(define (make-gen lst)
  (define return #f)
  (define resume #f)
  (lambda ()
    (call/cc (lambda (r)
      (set! return r)
      (if resume
          (resume #f)
          (begin
            (for-each (lambda (x) (call/cc (lambda (next) (set! resume next) (return x)))) lst)
            (return 'done)))))))
(define g (make-gen '(a b c)))
(show (g) (g) (g) (g))
;; dynamic-wind: the order of before, thunk and after, and an escape through it.
(define trace '())
(define (note x) (set! trace (cons x trace)))
(dynamic-wind (lambda () (note 'before)) (lambda () (note 'during)) (lambda () (note 'after)))
(show (reverse trace))
(set! trace '())
(call/cc (lambda (k) (dynamic-wind (lambda () (note 'in)) (lambda () (k 'out) (note 'never)) (lambda () (note 'out)))))
(show (reverse trace))
(set! trace '())
(define reenter #f)
(define n 0)
(dynamic-wind (lambda () (note 'enter)) (lambda () (call/cc (lambda (k) (set! reenter k))) (set! n (+ n 1))) (lambda () (note 'exit)))
(if (< n 2) (reenter #f))
(show (reverse trace))
;; Exceptions.
(show (guard (e (#t (list 'caught e))) (raise 'oops)))
(show (guard (e ((symbol? e) (list 'sym e)) ((string? e) (list 'str e))) (raise "boom")))
(show (guard (e ((error-object? e) (list (error-object-message e) (error-object-irritants e)))) (error "bad thing:" 1 2)))
(show (guard (e (#t (error-object-message e))) (car '())))
(show (guard (e ((assq 'a e) => cdr) ((assq 'b e))) (raise (list (cons 'a 42)))))
(show (guard (e ((assq 'a e) => cdr) ((assq 'b e))) (raise (list (cons 'b 23)))))
(show (with-exception-handler (lambda (e) 10) (lambda () (+ 1 (raise-continuable 'c)))))
(show (guard (e (#t 'outer)) (guard (e ((number? e) 'inner)) (raise 'not-a-number))))
(show (call/cc (lambda (k) (with-exception-handler (lambda (e) (k (list 'handled e))) (lambda () (raise 'x))))))
(define t2 '())
(guard (e (#t (set! t2 (cons 'handler t2))))
  (dynamic-wind (lambda () (set! t2 (cons 'in t2))) (lambda () (raise 'x)) (lambda () (set! t2 (cons 'out t2)))))
(show (reverse t2))
;; Parameters.
(define p (make-parameter 10 (lambda (x) (* x 2))))
(show (p))
(parameterize ((p 3)) (show (p)))
(show (p))
(show (with-output-to-string (lambda () (display "inside") (display 42))))
;; Promises.
(define pr (delay (begin (show "forced once") 7)))
(show (force pr) (force pr))
(define (stream-from n) (cons n (delay (stream-from (+ n 1)))))
(define (stream-ref s k) (if (= k 0) (car s) (stream-ref (force (cdr s)) (- k 1))))
(show (stream-ref (stream-from 0) 1000))
(define (loop n) (delay-force (if (= n 0) (delay 'end) (loop (- n 1)))))
(show (force (loop 10000)))
(show (force 5) (promise? (make-promise 1)))
;; eval.
(show (eval '(* 6 7) (interaction-environment)))
(eval '(define evald 9))
(show evald)

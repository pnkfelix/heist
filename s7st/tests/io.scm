; String ports, reading, and writing.
(define (show . xs) (for-each display xs) (newline))
(define in (open-input-string "hello (a . b) 42 \"str\" #\\x"))
(show (read-char in) (peek-char in) (read-char in))
(show (read in))
(show (read in))
(write (read in)) (newline)
(write (read in)) (newline)
(write (read in)) (newline)
(show (eof-object? (read in)))
(define out (open-output-string))
(write 'sym out)
(write-char #\space out)
(write "q\"uote" out)
(write-string " tail" out)
(newline out)
(write (get-output-string out)) (newline)
(define lines (open-input-string "one\ntwo\n"))
(show (read-line lines) "|" (read-line lines) "|" (eof-object? (read-line lines)))
(show (read-string 3 (open-input-string "abcdef")))
(show (call-with-output-string (lambda (p) (display "x" p) (display 1 p))))
(write (list "a\nb" #\newline #\x7f '|a b| (string->symbol "") 1.5e10 -0.0 (/ 0. 0.)))
(newline)
(display (list "a" #\b))
(newline)
(write '(quote x)) (newline)
(write (vector 'a "b" #\c)) (newline)
(let ((l (list 1 2 3))) (set-cdr! (cddr l) l) (display (list-copy '(1 2))) (newline))

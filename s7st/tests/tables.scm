; Hash tables: by eqv?, equal?, string=?; growing, deleting, walking.
(define (show . xs) (for-each (lambda (x) (write x) (display " ")) xs) (newline))
(define t (make-equal-hashtable))
(hashtable-set! t '(1 2) 'list)
(hashtable-set! t "str" 'string)
(hashtable-set! t 3/4 'ratio)
(show (hashtable-ref t (list 1 2) #f) (hashtable-ref t (string #\s #\t #\r) #f) (hashtable-ref t 6/8 #f) (hashtable-ref t 'nope 'absent))
(define e (make-eq-hashtable))
(define k1 (list 'a))
(define k2 (list 'a))
(hashtable-set! e k1 1)
(hashtable-set! e 'sym 2)
(hashtable-set! e 42 3)
(show (hashtable-ref e k1 #f) (hashtable-ref e k2 #f) (hashtable-ref e 'sym #f) (hashtable-ref e 42 #f) (hashtable-contains? e k2))
(define h (make-hash-table))
(do ((i 0 (+ i 1))) ((= i 1000)) (hash-table-set! h i (* i i)))
(show (hash-table-count h) (hash-table-ref h 999) (hash-table-ref/default h 1000 'none))
(do ((i 0 (+ i 2))) ((>= i 1000)) (hash-table-delete! h i))
(show (hash-table-count h) (hash-table-ref/default h 2 'gone) (hash-table-ref h 3))
(do ((i 0 (+ i 1))) ((= i 2000)) (hash-table-set! h (number->string i) i))
(show (hash-table-count h) (hash-table-ref h "1999"))
(define s (make-hash-table string=?))
(hash-table-set! s "x" 1)
(hash-table-update! s "x" (lambda (v) (+ v 10)))
(hash-table-update!/default s "y" (lambda (v) (cons 'y v)) '())
(show (hash-table-ref s "x") (hash-table-ref s "y") (hash-table-ref s "z" (lambda () 'thunk)))
(show (sort (hash-table-keys s) string<?) (hash-table->alist (alist->hash-table '((a . 1) (b . 2) (a . 3)) eq?)))
(define total 0)
(hash-table-walk (alist->hash-table '((1 . 10) (2 . 20))) (lambda (k v) (set! total (+ total k v))))
(show total (hash-table-fold (alist->hash-table '((1 . 10) (2 . 20))) (lambda (k v acc) (+ acc v)) 0))
(define r (make-equal-hashtable))
(define-record-type point (make-point x y) point? (x px))
(define p1 (make-point 1 2))
(hashtable-set! r p1 'p1)
(show (hashtable-ref r p1 #f) (hashtable-ref r (make-point 1 2) #f))
(call-with-values (lambda () (hashtable-entries (alist->hash-table '((k . v)))))
  (lambda (ks vs) (show ks vs)))
(show (hash-table? h) (hash-table? '()) (= (hash "abc") (hash (string-append "a" "bc"))) (guard (e (#t (error-object-message e))) (hash-table-ref h 'missing)))
(show (hash-table-copy s) (hash-table-ref (hash-table-copy s) "x"))

; Basic forms, data, and procedures.
(define (show . xs) (for-each display xs) (newline))
(show (+ 1 2) " " (- 10 4 3) " " (* 2 3 4) " " (/ 12 4) " " (/ 1 3) " " (- 5))
(show (expt 2 100))
(show (* 99999999999 99999999999))
(show (exact->inexact 1/3) " " (sqrt 16) " " (sqrt 2) " " (exact (floor 2.5)) " " (round 2.5) " " (round 3.5))
(show (quotient 17 5) " " (remainder -17 5) " " (modulo -17 5) " " (gcd 12 18) " " (lcm 4 6))
(show (number->string 255 16) " " (string->number "ff" 16) " " (string->number "1e3") " " (string->number "abc"))
(show (max 1 2.0) " " (min 1 2) " " (abs -7) " " (exact-integer? 5) " " (exact? 1.5) " " (integer? 2.0))
(write (list 1 2.5 "str" #\a #\space 'sym '|odd sym| #t #f '() (vector 1 2) (bytevector 1 2)))
(newline)
(show (let ((x 1) (y 2)) (+ x y)) " " (let* ((x 1) (y (+ x 1))) (* x y)))
(show (letrec ((even? (lambda (n) (if (= n 0) #t (odd? (- n 1))))) (odd? (lambda (n) (if (= n 0) #f (even? (- n 1)))))) (even? 100)))
(show (let loop ((i 0) (acc '())) (if (= i 5) (reverse acc) (loop (+ i 1) (cons i acc)))))
(show (do ((i 0 (+ i 1)) (s 0 (+ s i))) ((= i 5) s)))
(define (f x) (define y (* x 2)) (define (g z) (+ y z)) (g 1))
(show (f 10))
(show (cond ((assv 'b '((a 1) (b 2))) => cadr) (else 'none)))
(show (case (* 2 3) ((2 3 5 7) 'prime) ((1 4 6 8 9) 'composite) (else 'other)))
(show (case 'x ((a) 1) (else => (lambda (k) (list k 'fallback)))))
(show (and 1 2 3) " " (and) " " (or #f 2) " " (or))
(show (when (> 1 0) 'yes) " " (if #f #f 'no))
(show `(1 ,(+ 1 1) ,@(list 3 4) 5) " " `#(a ,(+ 1 1)) " " `(nested `(a ,(b ,(+ 1 2)))))
(show (map + '(1 2 3) '(10 20 30)) " " (map (lambda (x) (* x x)) '(1 2 3)))
(let ((acc '())) (for-each (lambda (x y) (set! acc (cons (+ x y) acc))) '(1 2) '(3 4)) (show acc))
(show (apply + 1 2 '(3 4)) " " (apply max '(3 1 4 1 5)))
(show (append '(1) '(2 3) '() '(4 . 5)) " " (list-tail '(a b c d) 2) " " (list-ref '(a b c) 1) " " (length '(1 2 3)))
(show (memq 'c '(a b c d)) " " (member "b" '("a" "b")) " " (assoc 2.0 '((1 one) (2 two)) =))
(show (vector-map + #(1 2) #(10 20)) " " (vector->list #(1 2 3) 1) " " (list->vector '(a b)))
(define v (make-vector 3 0))
(vector-set! v 0 'x)
(vector-fill! v 'y 1)
(show v " " (vector-length v) " " (vector-append #(1) #(2 3)))
(show (string-append "foo" "bar") " " (substring "hello" 1 3) " " (string-upcase "abc") " " (string->list "abc"))
(define s (make-string 3 #\a))
(string-set! s 1 #\b)
(show s " " (string-length s) " " (string=? "a" "a" "a") " " (string<? "a" "b") " " (string->symbol "xyz"))
(show (char->integer #\A) " " (integer->char 97) " " (char-upcase #\a) " " (char-numeric? #\5) " " (digit-value #\7))
(show (symbol->string 'abc) " " (string->number "#x1F") " " (exact 3.0) " " (inexact 3))
(show (eq? 'a 'a) " " (eqv? 1.5 1.5) " " (equal? '(1 #(2 "x")) '(1 #(2 "x"))) " " (eq? '() '()) " " (equal? "a" "b"))
(show (boolean? #f) " " (null? '()) " " (pair? '(1)) " " (list? '(1 . 2)) " " (procedure? car) " " (procedure? 'car))
(define-values (q r) (floor/ 17 5))
(show q " " r)
(show (call-with-values (lambda () (values 1 2 3)) list))
(show (let-values (((a b) (values 1 2)) ((c) (values 3))) (list a b c)))
(define plus (case-lambda ((a) a) ((a b) (+ a b)) ((a . rest) (apply + a rest))))
(show (plus 1) " " (plus 1 2) " " (plus 1 2 3))
(show (string->utf8 "aé") " " (utf8->string (bytevector 104 105)))
(show (exact-integer-sqrt 17))
(show (char-upcase #\ä) " " (string-length "héllo"))

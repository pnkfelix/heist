(define m-sat (load-module "../../combo/sat.fx"))
(define m-circuit ((load-module "../circuit.fx") m-sat))
(import m-sat (effect cb-eff))
(import m-circuit make-circuit c-input! c-and2 c-or2 c-not c-and c-assert! c-solve! c-value c-exactly-one c-true c-false c-iff)
(define* say (subr (io stdout) (string) unit) (lambda (s) (tagcase (write-out s) (done u #u) (failed e #u))))
(define* yes (subr pure (bool) string) (lambda (b) (if b "1" "0")))
(define main (subr (maxeff cb-eff (io stdout)) () int)
  (lambda ()
    (let* ((c (make-circuit)) (x (c-input! c)) (y (c-input! c)) (z (c-input! c)))
      (begin
        (say (string-append "same gate: " (yes (= (c-and2 c x y) (c-and2 c y x))) "\n"))
        (say (string-append "x and not x: " (int->string (c-and2 c x (c-not x))) "\n"))
        (c-assert! c (c-exactly-one c (list x y z)))
        (c-assert! c (c-not x))
        (c-assert! c (c-or2 c (c-not y) (c-iff c z x)))
        (say (string-append "sat: " (yes (c-solve! c nil)) " x" (yes (c-value c x)) " y" (yes (c-value c y)) " z" (yes (c-value c z)) "\n"))
        (say (string-append "with z: " (yes (c-solve! c (list z))) "\n"))
        0))))
